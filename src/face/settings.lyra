module face
//! The Settings tab on `ui`: the page is markup (`../settings_page.lui`), its events carried
//! out here on the window's settings. **A change takes at once** — the theme rebuilt and told to
//! every tab, the font measured again at its size and spacing, a family not loaded yet added to
//! the window's fonts (`LoadFonts`) under a name of its own — **and is kept a moment after the
//! last** ([SAVE_DELAY_MS]), so a slider's drag writes the file once, not at every step.

import ui.app.{ Command, ChooseFile, LoadFonts, After, WindowSeeThrough, WindowBlur }
import ui.backend.{ FileDialog }
import ui.text.{ FontFile, FontSpec }
import settings.{
  defaults,
  theme_colors,
  save_theme,
  delete_theme,
  edit_colors,
  can_save,
  saved_colors,
  with_color,
  with_ansi,
  family_for,
  preview_name,
  with_blur,
  RULE_WIDTH_RANGE,
  with_backing,
  with_backing_kind,
  gradient_named,
  image_named,
  with_gradient_shape,
  settled_gradient,
  fit_named,
  BackingStop,
  BackingImage,
  GradientBacking,
  ImageBacking,
  GRADIENT_STOPS,
  save_settings,
  settings_to_json,
  FONT_SIZE_RANGE,
}
import settings_page.{
  SettingsEvent,
  SetFill,
  SetGradientShape,
  SetGradientAngle,
  SetStopColor,
  SetStopAt,
  AddStop,
  RemoveStop,
  ChooseFillImage,
  SetImageFit,
  UseFamily,
  ChooseFontFile,
  SetFontSize,
  SetLineSpacing,
  SetColor,
  SetAnsi,
  UseTheme,
  UseSavedTheme,
  NameTheme,
  SaveThemeAs,
  SaveTheme,
  DeleteSavedTheme,
  ToggleBoldBright,
  ToggleRememberWindow,
  SetBlur,
  SetTabRuleWidth,
  ResetSettings,
  OpenSwatch,
  CloseSwatch,
  KeepSetting,
}
import term.{ theme_of }

/// How long after the last change the settings are written.
const SAVE_DELAY_MS: i64 = 500

/// One of the Settings tab's events carried out; the work it asks for.
pub let settings_asked = (t: mut Term, e: SettingsEvent) -> []Command<TermEvent> => {
  let faces_were = faces_of(t)
  match e {
    // A fill changed: the colors' own, so the theme is the user's (`edit_colors`).
    SetFill(field, kind) => {
      t.settings.colors = with_backing_kind(t.settings.colors, field, kind)
      edit_colors(t.settings)
    },
    SetGradientShape(field, shape) =>
      gradient_edited(t, field, (g) => with_gradient_shape(g, shape)),
    SetGradientAngle(field, angle) =>
      gradient_edited(t, field, (g) => BackingGradient { g | angle: f32(angle.round()) }),
    SetStopColor(field, k, rgb) => gradient_edited(t, field, (g) => {
      var stops = [...g.stops]
      if k >= 0 && k < stops.len() { stops[k] = BackingStop { stops[k] | color: rgb } }
      BackingGradient { g | stops: stops }
    }),
    SetStopAt(field, k, at) => gradient_edited(t, field, (g) => {
      var stops = [...g.stops]
      if k >= 0 && k < stops.len() { stops[k] = BackingStop { stops[k] | at: at } }
      BackingGradient { g | stops: stops }
    }),
    // A stop added at the end, as the last is, at the far end.
    AddStop(field) => gradient_edited(t, field, (g) => {
      if g.stops.len() >= GRADIENT_STOPS.1 { return g }
      let last = g.stops[g.stops.len() - 1]
      BackingGradient { g | stops: [...g.stops, BackingStop { last | at: 1.0 }] }
    }),
    RemoveStop(field, k) => gradient_edited(t, field, (g) => {
      if g.stops.len() <= GRADIENT_STOPS.0 { return g }
      BackingGradient { g | stops: [i in 0..<g.stops.len() | i != k | g.stops[i]] }
    }),
    ChooseFillImage(field) => {
      return [ChooseFile(
        FileDialog { filters: [("Images", "png;jpg;jpeg;svg")] },
        (path: Maybe<string>) -> TermEvent => FillImageChosen(field, path)
      )]
    },
    SetImageFit(field, k) => {
      let Some(i) = image_named(t.settings.colors, field) else { return [] }
      let fit = fit_named(if k == 0 { "tile" } else if k == 1 { "stretch" } else { "cover" })
      t.settings.colors = with_backing(
        t.settings.colors,
        field,
        ImageBacking(BackingImage { i | fit: fit })
      )
      edit_colors(t.settings)
    },
    // Picking a family goes back to families from a chosen file.
    UseFamily(name) => {
      t.settings.font_family = name
      t.settings.font_file = ""
    },
    ChooseFontFile => {
      return [ChooseFile(
        FileDialog { filters: [("Fonts", "ttf;otf;ttc")] },
        FontFileChosen
      )]
    },
    // Whole points: a fractional size blurs every glyph.
    SetFontSize(size) => { t.settings.font_size = f32(size.round()) },
    SetLineSpacing(spacing) => { t.settings.line_spacing = spacing },
    // A color changed by hand makes the theme the user's own (`edit_colors`).
    SetColor(field, rgb) => {
      t.settings.colors = with_color(t.settings.colors, field, rgb)
      edit_colors(t.settings)
    },
    SetAnsi(k, rgb) => {
      t.settings.colors = with_ansi(t.settings.colors, k, rgb)
      edit_colors(t.settings)
    },
    UseTheme(name) => {
      t.settings.theme_name = name
      t.settings.colors = theme_colors(name)
      t.settings.edited_from = ""
    },
    UseSavedTheme(name) => {
      let Some(saved) = saved_colors(t.settings.themes, name) else { return [] }
      t.settings.theme_name = name
      t.settings.colors = saved
      t.settings.edited_from = ""
    },
    NameTheme(text) => {
      t.typed = text
      return []
    },
    // The colors as they are, under a name of the user's — one of theirs replaced, Termina's
    // own not.
    SaveThemeAs => {
      save_theme(t.settings, t.typed)
      t.typed = ""
    },
    // The colors over the saved theme they were changed from.
    SaveTheme =>
      if can_save(t.settings) { save_theme(t.settings, t.settings.edited_from) },
    DeleteSavedTheme => delete_theme(t.settings, t.settings.theme_name),
    ToggleBoldBright => { t.settings.bold_is_bright = !t.settings.bold_is_bright },
    // Kept as it closes: the place itself is taken then (termina.lyra's `place_of`).
    ToggleRememberWindow => { t.settings.remember_window = !t.settings.remember_window },
    SetBlur(field, radius) => with_blur(t.settings, field, radius),
    // Whole points, as a cell is.
    SetTabRuleWidth(width) => {
      t.settings.tab_rule_width = f32(width.round()).clamp(
        RULE_WIDTH_RANGE.0,
        RULE_WIDTH_RANGE.1
      )
    },
    ResetSettings => { t.settings = defaults() },
    OpenSwatch(key) => {
      t.swatch = key
      return []
    },
    CloseSwatch => {
      t.swatch = ""
      return []
    },
    KeepSetting => { return [] },
  }
  applied(t, faces_were)
}

/// The font a point bigger or smaller (`by`), within the settings' range, or (`by` 0) back to
/// the default size — View's items, kept as any setting is.
pub let font_stepped = (t: mut Term, by: f32) -> []Command<TermEvent> => {
  let faces_were = faces_of(t)
  let size = if by.abs() < 0.5 { defaults().font_size } else { t.settings.font_size + by }
  t.settings.font_size = size.clamp(FONT_SIZE_RANGE.0, FONT_SIZE_RANGE.1)
  applied(t, faces_were)
}

/// A font file chosen in the system's dialog: the font, from now on.
/// The gradient filling the background `field` names changed by `change`, kept to the stops it
/// may have ([settled_gradient]); nothing where no gradient fills it.
let gradient_edited = (
  t: mut Term,
  field: string,
  change: (BackingGradient) -> BackingGradient
) -> void => {
  let Some(g) = gradient_named(t.settings.colors, field) else { return }
  let changed = GradientBacking(settled_gradient(change(g)))
  t.settings.colors = with_backing(t.settings.colors, field, changed)
  edit_colors(t.settings)
}

/// The image file chosen for the background `field` names: its fill that image, at the fit it
/// had; nothing for a dialog dismissed.
pub let fill_image_chosen = (
  t: mut Term,
  field: string,
  path: Maybe<string>
) -> []Command<TermEvent> => {
  let Some(chosen) = path else { return [] }
  let fit = match image_named(t.settings.colors, field) {
    Some(i) => i.fit,
    None => fit_named("cover"),
  }
  let faces_were = faces_of(t)
  t.settings.colors = with_backing(
    t.settings.colors,
    field,
    ImageBacking(BackingImage { path: chosen, fit: fit })
  )
  edit_colors(t.settings)
  applied(t, faces_were)
}

pub let font_file_chosen = (t: mut Term, path: Maybe<string>) -> []Command<TermEvent> => {
  let Some(chosen) = path else { return [] }
  let faces_were = faces_of(t)
  t.settings.font_file = chosen
  applied(t, faces_were)
}

/// The settings written, if save `n` is the last asked for and they changed since last written.
pub let save_due = (t: mut Term, n: i64) -> void => {
  if n == t.saves { save_now(t) }
}

/// The settings written now if they changed since last written — as the window closes, a save
/// still due.
pub let save_now = (t: mut Term) -> void => {
  if t.settings_file == "" { return }
  let text = settings_to_json(t.settings)
  if text != t.saved && save_settings(t.settings_file, t.settings) { t.saved = text }
}

/// The settings as they now are, taken: the theme told to every tab, the font's family —
/// loaded first if it is not yet — measured at its size and spacing, and a save asked for.
let applied = (t: mut Term, faces_were: string) -> []Command<TermEvent> => {
  t.theme = theme_of(t.settings)
  for i in 0..<t.tabs.len() { told_colors(t.tabs[i], t.theme) }
  fill_images(t.settings.colors, t.images, t.image_revision)
  t.spacing = t.settings.line_spacing
  var out: []Command<TermEvent> = []
  let faces = faces_of(t)
  if faces != faces_were {
    if !t.loaded.contains(faces) {
      out.push(LoadFonts(
        family_files(t, faces),
        (_: bool) -> TermEvent => FontsLoaded(faces)
      ))
      t.loaded.push(faces)
    }
    t.grid = Grid { t.grid | font: FontSpec { t.grid.font | family: faces } }
  }
  t.saves += 1
  [
    ...out,
    ...resized(t, t.settings.font_size),
    ...see_through(t),
    After(SAVE_DELAY_MS, SaveDue(t.saves))
  ]
}

/// The window see-through while the background is not opaque, and what is behind it blurred
/// as the settings say: asked of the system each change (on Linux a window is see-through only
/// if it opened so, which the next start does).
pub let see_through = pure (t: Term) -> []Command<TermEvent> => {
  let on = (t.theme.bg >> 24) != 0xFF
  [WindowSeeThrough(on), WindowBlur(if on { t.settings.background_blur } else { 0.0 })]
}

/// The Settings tab opened: the Family list's fonts loaded, the first time, so each family is
/// shown in itself (`preview_name`, a family's regular face alone).
pub let settings_opened = (t: mut Term) -> []Command<TermEvent> => {
  t.settings_open = true
  t.on_settings = true
  if t.previews_loaded { return [] }
  t.previews_loaded = true
  let files = [
    f in t.families |
      FontFile { family: preview_name(f), path: f.regular, weight: 400, italic: false }
  ]
  [LoadFonts(files, (_: bool) -> TermEvent => FontsLoaded("previews"))]
}

/// The name the settings' faces are loaded as: the family's, or the file's.
let faces_of = pure (t: Term) -> string => match family_for(t.settings, t.families) {
  Some(f) => "family ${f.name} ${f.regular}",
  None => t.grid.font.family,
}

/// The settings' family's faces as files to load as `name`: its regular, bold, italic and
/// bold italic where it has them.
let family_files = pure (t: Term, name: string) -> []FontFile => {
  let Some(f) = family_for(t.settings, t.families) else { return [] }
  [
    face in [
      (f.regular, 400, false),
      (f.bold, 700, false),
      (f.italic, 400, true),
      (f.bold_italic, 700, true)
    ] |
      face.0 != "" |
      FontFile { family: name, path: face.0, weight: face.1, italic: face.2 }
  ]
}
