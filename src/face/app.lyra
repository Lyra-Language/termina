module face
//! Termina on `ui` (`../termina.lyra` opens it): a window of tabs, each a painted element
//! (`paint.lyra`) taking input raw — every key, the text typed and the pointer, handed to the
//! tab's command line at a prompt or to its program otherwise (`input.lyra`) — and each tab's
//! terminal read when it has written (`Readable`), so an idle window draws nothing.
//!
//! **The terminal scrolls itself** rather than sitting in a `ui` scroller: its columns and
//! rows are the view's, which a scroller's content never learns, and the box at the view's
//! foot is drawn where the view is. A tab's view sticks to the bottom ([View.sticking]) until
//! scrolled up, and a command run or typed at the prompt takes it back there.

import bindings.sdl3.{ platform }
import ui.app.{
  Command,
  QuitApp,
  MeasureFont,
  FocusKeyed,
  Subscription,
  Readable,
  OnFocus,
  OnWindowState,
  Shortcut,
  PasteText,
  WindowMinimize,
  WindowMaximize,
  WindowRestore,
  EditField,
}
import ui.interact.{
  FieldEdit,
  FieldSelectAll,
  FieldCopy,
  FieldCut,
  FieldPaste,
  FieldUndo
}
import ui.draw.{ Size, Rect, radius }
import ui.backend.{ Modifiers, Character, PageUp, PageDown, WindowState }
import ui.text.{ FontSpec, FontMetrics }
import ui.layout.{
  Node,
  PaintArea,
  PaintOp,
  RawInput,
  KeyInput,
  TextInput,
  PointerInput,
  MainStart,
  CrossStretch,
  column,
  expanded,
  painted,
  stack,
  themed,
}
import session.{
  Session,
  FrameLayout,
  open_session,
  close_session,
  directory,
  frame_layout,
}
import term.{
  Theme,
  report_of,
  TabCommand,
  NewTab,
  CloseTab,
  ShowTab,
  FontBigger,
  FontSmaller,
  FontDefault,
  OpenSettings,
  NoCommand,
  EditAction,
  Copy,
  Cut,
  Paste,
}
import editor.{ position }
import settings.{ Settings, FontFamily, defaults, PlainBacking }
import settings_page.{ SettingsEvent, settings_page }
import ui.style.{ Style }
import std.collections.{ HashMap, hashmap_new }

/// The window: its tabs and each one's view, the one shown, the next tab's identity, the home
/// directory (a tab's name for it), the theme and the grid's font, the painter's size, the
/// modifiers as the last key left them (typed text carries none), whether the window has the
/// keyboard, and what a press on the painter took hold of.
pub struct Term {
  tabs: []Session,
  views: []View,
  active: i64 = 0,
  next_id: i64 = 1,
  home: string = "",
  theme: Theme,
  grid: Grid,
  default_size: f32 = 14.0,
  spacing: f32 = 1.2,
  size: Size = Size {},
  mods: Modifiers = Modifiers {},
  focused: bool = true,
  mac: bool = false,
  /// Whether the window is maximized, as last heard ([TermEvent.WindowChanged]).
  maximized: bool = false,
  /// What a press holds until it is let go: nothing (0), the grid's selection (1), the command
  /// line (2), or a program's mouse report (3, `button` the button held).
  holding: i64 = 0,
  button: i64 = -1,
  /// The last tab's screen as its program ended — what `termina --print` prints.
  closed_screen: []string = [],
  /// The user's settings, the file they are kept in (`""` for none: nothing is written) and
  /// their text as last written, the font families on offer, and what is typed to save a
  /// theme as.
  settings: Settings = defaults(),
  settings_file: string = "",
  saved: string = "",
  families: []FontFamily = [],
  typed: string = "",
  /// The Settings tab: open, shown, and the swatch whose picker is open (`""` for none).
  settings_open: bool = false,
  on_settings: bool = false,
  swatch: string = "",
  /// Saves asked for; only the last is carried out (`settings.lyra`).
  saves: i64 = 0,
  /// The families loaded into the window's fonts, by the name each was loaded as.
  loaded: []string = [],
  /// Whether the Family list's fonts are loaded (`settings_opened`).
  previews_loaded: bool = false,
  /// The images the backgrounds' fills name, decoded, by path, and how many decodes there have
  /// been — each a new picture's revision (`fill_images`).
  images: HashMap<string, PictureSource>,
  image_revision: i64 = 0,
}

/// A tab's view: how far it is scrolled down, and whether it sticks to the bottom as output
/// comes.
pub struct View {
  scroll: f32 = 0.0,
  sticking: bool = true,
}

/// What happens to the window.
pub data TermEvent =
  /// Tab `i`'s terminal has something to read.
  PtyReadable(i64)
  /// The painter was laid out at this size.
  | ViewSized(Size)
  | KeyHeard(KeyInput)
  | TextHeard(TextInput)
  | PointerHeard(PointerInput)
  /// The clipboard's text, for a paste asked for.
  | ClipboardRead(string)
  /// The window gained or lost the keyboard.
  | WindowFocus(bool)
  /// A shortcut, a menu's item or the tab bar's choice.
  | TabAsked(TabCommand)
  /// Tab `i`'s ×, or a middle click on it.
  | TabClosed(i64)
  /// Tab `from` dragged to `to`'s place.
  | TabMoved(i64, i64)
  /// An Edit menu item, on the shown tab.
  | EditAsked(EditAction)
  /// Quit, and the window minimized or maximized (Window's items and the header bar's).
  | Quit
  | Minimize
  | ToggleMaximize
  /// What the window went through.
  | WindowChanged(WindowState)
  /// The Settings tab's events; it shown, or closed.
  | SettingsAsked(SettingsEvent)
  | ShowSettings
  | CloseSettings
  /// A font file chosen in the system's dialog, or none.
  | FontFileChosen(Maybe<string>)
  /// The image file chosen for a background's fill, by its color's field.
  | FillImageChosen(string, Maybe<string>)
  /// A family's faces loaded under this name.
  | FontsLoaded(string)
  /// Save `n` due ([SettingsEvent]s ask one each).
  | SaveDue(i64)
  /// The font measured again, at a new size.
  | FontMeasured(FontMetrics)

/// A window over `tabs` (one, usually: the login shell) in `theme`, drawn with `grid`.
pub let term_of = (
  tabs: []Session,
  theme: Theme,
  grid: Grid,
  spacing: f32,
  home: string
) -> Term => {
  var told: []Session = []
  for given in tabs {
    var s = given
    told_colors(s, theme)
    told.push(s)
  }
  Term {
    tabs: told,
    views: [s in tabs | View {}],
    next_id: tabs.len(),
    home: home,
    images: hashmap_new(),
    theme: theme,
    grid: grid,
    default_size: grid.font.size,
    spacing: spacing,
    mac: platform() == "macOS",
  }
}

/// Where everything of the shown tab goes in a painter `size` large, as it is scrolled.
pub let layout_at = pure (t: Term, size: Size) -> FrameLayout => {
  let scroll = t.views[t.active].scroll
  frame_layout(
    t.tabs[t.active],
    t.grid.cell_x,
    t.grid.cell_y,
    PAD - scroll,
    scroll,
    size.h - 2.0 * PAD
  )
}

// ── The view ─────────────────────────────────────────────────────────────────

/// The window, in the theme's colours: on a Mac the tab bar (`window.lyra`), elsewhere the
/// header bar over it; then the shown tab, painted and taking input raw.
pub let view = pure (t: Term) -> Node<TermEvent> => {
  if t.tabs.len() == 0 { return column::<TermEvent>([]) }
  let raw = RawInput {
    on_key: (k: KeyInput) -> Maybe<TermEvent> => Some(KeyHeard(k)),
    on_text: (x: TextInput) -> Maybe<TermEvent> => Some(TextHeard(x)),
    on_pointer: (p: PointerInput) -> Maybe<TermEvent> => Some(PointerHeard(p)),
    caret: Some(caret_of(t)),
  }
  let terminal = expanded(painted(
    (area: PaintArea) -> []PaintOp =>
      paint_tab(
        t.tabs[t.active],
        layout_at(t, area.size),
        t.grid,
        t.theme,
        Fills {
          input: t.settings.colors.input_fill,
          output: t.settings.colors.output_fill,
          images: t.images,
          scale: area.scale,
        },
        t.focused,
        area
      ),
    Some(ViewSized)
  ).takes_input(raw).keyed("term"))
  let strip = [tab_strip(t), tab_rule(t.theme)]
  let bars = if t.mac { strip } else { [header_bar(t), ...strip] }
  // The Settings tab in place of the terminal while it is shown; the terminals go on being
  // read behind it.
  let body = if t.on_settings {
    expanded(settings_page(
      t.settings,
      t.families,
      t.typed,
      t.swatch
    ).map(SettingsAsked).keyed("settings"))
  } else { terminal }
  // The window cleared to the theme's background, which `App.background` keeps as it opened:
  // the root's color, or — filled with a gradient or an image — a layer under everything.
  let root = column([...bars, body]).aligned(MainStart, CrossStretch)
  let window = match t.settings.colors.bg_fill {
    PlainBacking => root.with_style(Style { background: Some(color(t.theme.bg)) }),
    fill => stack([
      painted::<TermEvent>((area: PaintArea) -> []PaintOp =>
        fill_ops(fill, t.theme.bg, Rect { w: area.size.w, h: area.size.h }, radius(0.0), t.images, area.scale)),
      root,
    ]),
  }
  themed(chrome_theme(t.theme), chrome_sheet(t.theme), [window])
}

/// Where typed text goes — the command line's caret at a prompt, the cursor otherwise — for the
/// input method's window.
let caret_of = pure (t: Term) -> Rect => {
  let s = t.tabs[t.active]
  let f = layout_at(t, t.size)
  let g = t.grid
  match f.prompt {
    Some(_) => {
      let at = place_of(f, g)
      let (r, c) = position(s.line.edit.text, at.wrap, s.line.edit.cursor)
      Rect {
        x: at.origin.x + f32(c) * g.cell_x,
        y: at.origin.y + f32(r) * g.cell_y,
        w: 1.0,
        h: g.cell_y
      }
    },
    None => Rect {
      x: INSET + f32(s.shown.x) * g.cell_x,
      y: f.rows.y_of(s.shown.scrollback_len() + s.shown.y),
      w: 1.0,
      h: g.cell_y,
    },
  }
}

/// What the window hears of besides its input: each tab's terminal when it has written, the
/// window's focus, and what it went through (Window's Maximize or Restore says which).
pub let subscriptions = pure (t: Term) -> []Subscription<TermEvent> => [
  ...[i in 0..<t.tabs.len() | Readable(t.tabs[i].pty.fd, PtyReadable(i))],
  OnFocus(WindowFocus),
  OnWindowState(WindowChanged),
]

/// The window's shortcuts, taken before the tab hears the key: on a Mac ⌘T, ⌘W, ⌘1–⌘9,
/// ⌘⇧[ ⌘⇧], ⌘= ⌘- ⌘0; elsewhere Ctrl+Shift+T and W, Alt+1–9, Ctrl+PageUp/PageDown and
/// Ctrl+Shift+= - 0, Ctrl alone being the shell's.
pub let shortcuts = pure (t: Term) -> []Shortcut<TermEvent> => {
  let n = t.tabs.len().max(1)
  let previous = ShowTab((t.active - 1) %% n)
  let next = ShowTab((t.active + 1) %% n)
  let chord = if t.mac { Modifiers { primary: true } } else { Modifiers {
    primary: true,
    shift: true
  } }
  let shifted = Modifiers { chord | shift: true }
  var out: []Shortcut<TermEvent> = [
    Shortcut { key: Character('t'), mods: chord, event: TabAsked(NewTab) },
    Shortcut { key: Character('w'), mods: chord, event: TabAsked(CloseTab) },
    Shortcut { key: Character('='), mods: chord, event: TabAsked(FontBigger) },
    Shortcut { key: Character('-'), mods: chord, event: TabAsked(FontSmaller) },
    Shortcut { key: Character('0'), mods: chord, event: TabAsked(FontDefault) },
  ]
  if t.mac {
    out.push(Shortcut { key: Character('['), mods: shifted, event: TabAsked(previous) })
    out.push(Shortcut { key: Character(']'), mods: shifted, event: TabAsked(next) })
  } else {
    out.push(Shortcut {
      key: PageUp,
      mods: Modifiers { primary: true },
      event: TabAsked(previous)
    })
    out.push(Shortcut {
      key: PageDown,
      mods: Modifiers { primary: true },
      event: TabAsked(next)
    })
  }
  // The tabs by number: ⌘1–⌘9 on a Mac, Alt+1–9 elsewhere.
  let by_number = if t.mac { Modifiers { primary: true } } else { Modifiers { alt: true } }
  for k in 0..<9 {
    out.push(Shortcut {
      key: Character(rune(i64('1') + k)),
      mods: by_number,
      event: TabAsked(ShowTab(k))
    })
  }
  out
}

// ── Update ───────────────────────────────────────────────────────────────────

/// The window after `e`, and the work it asks for.
pub let update = (t: Term, e: TermEvent) -> (Term, []Command<TermEvent>) => {
  var n = t
  var commands: []Command<TermEvent> = []
  match e {
    PtyReadable(i) => {
      if i < n.tabs.len() {
        n.tabs[i].step(i == n.active)
        if !n.tabs[i].alive { commands = close_tab(n, i) }
      }
    },
    ViewSized(size) => {
      // Laid out the first time: the terminal takes the keyboard, as a window opening on it.
      if n.size == Size {} { commands = [FocusKeyed("term")] }
      n.size = size
    },
    KeyHeard(k) => { commands = key_heard(n, k) },
    TextHeard(x) => text_heard(n, x),
    PointerHeard(p) => pointer_heard(n, p),
    ClipboardRead(text) => {
      if n.tabs.len() > 0 {
        let _ = n.tabs[n.active].edit_action(Paste, text)
        n.views[n.active].sticking = true
      }
    },
    WindowFocus(on) => {
      n.focused = on
      if n.tabs.len() > 0 { n.tabs[n.active].focus_report(on) }
    },
    TabAsked(c) => { commands = tab_asked(n, c) },
    TabClosed(i) => { if i >= 0 && i < n.tabs.len() { commands = close_tab(n, i) } },
    TabMoved(from, to) => tab_moved(n, from, to),
    EditAsked(a) => { commands = edit_asked(n, a) },
    Quit => { commands = [QuitApp] },
    Minimize => { commands = [WindowMinimize] },
    ToggleMaximize => { commands = [if n.maximized { WindowRestore } else { WindowMaximize }] },
    WindowChanged(w) => { n.maximized = w.maximized },
    SettingsAsked(s) => { commands = settings_asked(n, s) },
    ShowSettings => { commands = settings_opened(n) },
    CloseSettings => { commands = settings_closed(n) },
    FontFileChosen(path) => { commands = font_file_chosen(n, path) },
    FillImageChosen(field, path) => { commands = fill_image_chosen(n, field, path) },
    FontsLoaded(_) => {},
    SaveDue(k) => save_due(n, k),
    FontMeasured(m) => { n.grid = grid_of(n.grid.font, m, n.spacing) },
  }
  settle(n)
  (n, commands)
}

/// How many whole cells a painter of `size` holds — the shown tab's fit, and the first
/// tab's start, measured before its program can read the size it was given.
pub let cells_in = pure (size: Size, cell_x: f32, cell_y: f32) -> (i64, i64) => {
  let cols = i64(((size.w - 2.0 * INSET) / cell_x).floor()).max(2)
  let rows = i64(((size.h - 2.0 * PAD) / cell_y).floor()).max(1)
  (cols, rows)
}

/// The shown tab fitted to the painter — as many whole cells as it holds — and its view kept to
/// the page: at the bottom while it sticks there, never past either end.
let settle = (t: mut Term) -> void => {
  if t.tabs.len() == 0 || t.size.w <= 0.0 { return }
  let i = t.active
  let (cols, rows) = cells_in(t.size, t.grid.cell_x, t.grid.cell_y)
  t.tabs[i].fit(cols, rows)
  let f = layout_at(t, t.size)
  let most = (f.page - (t.size.h - 2.0 * PAD)).max(0.0)
  if t.views[i].sticking { t.views[i].scroll = most }
  t.views[i].scroll = t.views[i].scroll.clamp(0.0, most)
}

/// A shortcut, a tab's button or a menu's choice carried out.
let tab_asked = (t: mut Term, c: TabCommand) -> []Command<TermEvent> => match c {
  NewTab => {
    let dir = if t.tabs.len() > 0 { directory(t.tabs[t.active]) } else { None }
    if let Some(opened) = open_session([], dir, t.next_id) {
      var s = opened
      told_colors(s, t.theme)
      t.tabs.push(s)
      t.views.push(View {})
      t.next_id += 1
      t.active = t.tabs.len() - 1
    }
    [FocusKeyed("term")]
  },
  // ⌘W on the Settings tab closes it, not the terminal behind it.
  CloseTab => if t.on_settings { settings_closed(t) } else if t.tabs.len() > 0 { close_tab(t, t.active) } else { [] },
  ShowTab(i) => {
    if i >= 0 && i < t.tabs.len() {
      t.active = i
      t.on_settings = false
    }
    [FocusKeyed("term")]
  },
  FontBigger => font_stepped(t, 1.0),
  FontSmaller => font_stepped(t, -1.0),
  FontDefault => font_stepped(t, 0.0),
  OpenSettings => settings_opened(t),
  NoCommand => [],
}

/// Tab `from` to `to`'s place, its view with it; the shown tab stays shown.
let tab_moved = (t: mut Term, from: i64, to: i64) -> void => {
  let n = t.tabs.len()
  if from < 0 || from >= n || to < 0 || to >= n || from == to { return }
  let shown = t.tabs[t.active].id
  let order = [k in 0..<n | k != from | k]
  var placed: []i64 = []
  for k, i in order {
    if k == to { placed.push(from) }
    placed.push(i)
  }
  if to >= order.len() { placed.push(from) }
  t.tabs = [i in placed | t.tabs[i]]
  t.views = [i in placed | t.views[i]]
  for k, s in t.tabs { if s.id == shown { t.active = k } }
}

/// An Edit menu item on the shown tab, as its key would do it: a copy or cut put on the
/// clipboard, a paste asked of it.
let edit_asked = (t: mut Term, a: EditAction) -> []Command<TermEvent> => {
  // The Settings tab's: its focused field's — a colour's text, a theme's name — which never
  // hears the keys the Mac's bar holds.
  if t.on_settings {
    return match field_edit(a) {
      Some(edit) => [EditField(edit)],
      None => [],
    }
  }
  if t.tabs.len() == 0 { return [] }
  let i = t.active
  t.views[i].sticking = true
  match a {
    Paste => [PasteText(ClipboardRead)],
    Copy => copied(t.tabs[i].edit_action(Copy)),
    Cut => copied(t.tabs[i].edit_action(Cut)),
    other => {
      let _ = t.tabs[i].edit_action(other)
      []
    },
  }
}

/// What Edit's item `a` is to a text field; `None` for Redo, which a field has not.
pub let field_edit = pure (a: EditAction) -> Maybe<FieldEdit> => match a {
  SelectAll => Some(FieldSelectAll),
  Copy => Some(FieldCopy),
  Cut => Some(FieldCut),
  Paste => Some(FieldPaste),
  Undo => Some(FieldUndo),
  Redo => None,
}

/// The Settings tab closed, the terminal shown again.
let settings_closed = (t: mut Term) -> []Command<TermEvent> => {
  t.settings_open = false
  t.on_settings = false
  t.swatch = ""
  [FocusKeyed("term")]
}

/// Tab `i` closed, its program hung up on; the window with the last.
let close_tab = (t: mut Term, i: i64) -> []Command<TermEvent> => {
  if t.tabs.len() == 1 { t.closed_screen = screen_text(t.tabs[i]) }
  close_session(t.tabs[i])
  t.tabs = [k in 0..<t.tabs.len() | k != i | t.tabs[k]]
  t.views = [k in 0..<t.views.len() | k != i | t.views[k]]
  if t.tabs.len() == 0 { return [QuitApp] }
  t.active = t.active.min(t.tabs.len() - 1)
  [FocusKeyed("term")]
}

/// The font at `size` points (between 6 and 72), measured again.
let resized = (t: mut Term, size: f32) -> []Command<TermEvent> => {
  let font = FontSpec { t.grid.font | size: size.clamp(6.0, 72.0) }
  t.grid = Grid { t.grid | font: font }
  [MeasureFont(font, FontMeasured)]
}

/// A tab's lines — its scrollback and the screen's rows in use — as text, trailing blanks
/// dropped.
pub let screen_text = pure (s: Session) -> []string => {
  var out: []string = []
  for i in 0..<(s.shown.scrollback_len() + s.shown.used_rows()) {
    var runes: []rune = []
    for c in s.shown.line(i) { if c.ch != '\x00' { runes.push(c.ch) } }
    out.push(runes.join().trim_end())
  }
  // The cursor's row is in use, and after a last newline it is empty.
  var n = out.len()
  while n > 0 && out[n - 1] == "" { n -= 1 }
  out.slice(0, n)
}

/// What a program asking (vim) is told the colors are: the theme's.
let told_colors = (s: mut Session, theme: Theme) -> void => {
  s.shown.fg_report = report_of(theme.fg)
  s.shown.bg_report = report_of(theme.bg)
}
