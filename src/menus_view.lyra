/// From menus_view.lui, line 127.
pub let window_items = pure (tabs: []TabLabel, active: i64, maximized: bool) -> Node<MenuChoice> =>
  Component(Sheet {}, [
    MenuItem(MenuItemAttrs { label: "Minimize", on_select: MinimizeWindow }), // menus_view.lui:128
    MenuItem(MenuItemAttrs { label: "${if maximized { "Restore" } else { "Maximize" }}", id: "Maximize", on_select: ToggleMaximized }), // menus_view.lui:129
    Separator, // menus_view.lui:130
    ...[k in 0..<tabs.len() | MenuItem(MenuItemAttrs { label: "${tabs[k].name}###menutab${tabs[k].id}", id: tabs[k].name, shortcut: tab_key(k), checked: k == active, on_select: Tabs(ShowTab(k)) })], // menus_view.lui:131
  ])
