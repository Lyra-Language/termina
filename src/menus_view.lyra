    MenuItem(MenuItemAttrs { label: "Redo", shortcut: key("z", true), enabled: can.contains(Redo), on_select: Edit(Redo) }), // menus_view.lui:110
    Separator, // menus_view.lui:111
    MenuItem(MenuItemAttrs { label: "Cut", shortcut: own(mac, "x"), enabled: can.contains(Cut), on_select: Edit(Cut) }), // menus_view.lui:112
    MenuItem(MenuItemAttrs { label: "Copy", shortcut: own(mac, "c"), enabled: can.contains(Copy), on_select: Edit(Copy) }), // menus_view.lui:113
    MenuItem(MenuItemAttrs { label: "Paste", shortcut: own(mac, "v"), enabled: can.contains(Paste), on_select: Edit(Paste) }), // menus_view.lui:114
    MenuItem(MenuItemAttrs { label: "Select All", shortcut: own(mac, "a"), enabled: can.contains(SelectAll), on_select: Edit(SelectAll) }), // menus_view.lui:115
  ])

