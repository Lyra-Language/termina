import bindings.imgui.ui.{ Shortcut }
import term.{
  TabLabel,
  TabCommand,
  NewTab,
  CloseTab,
  ShowTab,
  OpenSettings,
  FontBigger,
  FontSmaller,
  FontDefault,
  EditAction,
