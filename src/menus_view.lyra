/// From menus_view.lui, line 95.
pub let shell_items = pure (tabs: []TabLabel, mac: bool) -> Node<MenuChoice> =>
  Component(Sheet {}, [
    MenuItem(MenuItemAttrs { label: "New Tab", shortcut: own(mac, "t"), on_select: Tabs(NewTab) }), // menus_view.lui:96
    Separator, // menus_view.lui:97
    MenuItem(MenuItemAttrs { label: "Show Previous Tab", shortcut: if mac { key("{", false) } else { key("PgUp", false) }, enabled: tabs.len() > 1, on_select: PreviousTab }), // menus_view.lui:100
    MenuItem(MenuItemAttrs { label: "Show Next Tab", shortcut: if mac { key("}", false) } else { key("PgDn", false) }, enabled: tabs.len() > 1, on_select: NextTab }), // menus_view.lui:101
    Separator, // menus_view.lui:102
    MenuItem(MenuItemAttrs { label: "Close Tab", shortcut: own(mac, "w"), on_select: Tabs(CloseTab) }), // menus_view.lui:103
  ])

