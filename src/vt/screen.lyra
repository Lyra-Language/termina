module vt
//! The screen a program draws on: a grid of cells, a cursor, and the lines that have scrolled
//! off the top. [Screen.apply] carries out the parser's [Action]s; nothing here reads bytes.
//!
//! **What it models**: text in colour with attributes (`style.lyra`), the cursor movements
//! and erases a shell's line editor uses (`\r`, backspace, tabs, `\e[K`, `\e[J`, cursor
//! positioning), scrolling with a scroll region, xterm's deferred wrap at the last column,
//! the window title, the shell's marks, and the DEC private modes full-screen programs use:
//! the alternate screen, application cursor keys, autowrap, the cursor's shape and
//! visibility, bracketed paste and the mouse's reporting modes.

import std.collections.{ HashMap, hashmap_new }

/// The screen, its cursor and its scrollback.
pub struct Screen {
  cols: i64,
  rows: i64,
  /// `rows` lines of `cols` cells. Each line its own array: see [blank_line].
  lines: [][]Cell,
  /// Lines scrolled off the top, a ring of at most [SCROLLBACK] — the oldest at
  /// `scrollback_start` once it is full.
  scrollback: [][]Cell,
  scrollback_start: i64,
  /// The cursor, 0-based.
  x: i64,
  y: i64,
  /// The cursor has written the last column and the next character starts a new line —
  /// xterm's deferred wrap, without which a prompt exactly a line wide scrolls one line
  /// too early.
  wrap_pending: bool,
  /// The scroll region's first and last lines, inclusive (`\e[r`).
  top: i64,
  bottom: i64,
  /// The style the next character is written in.
  pen: Pen,
  saved_x: i64,
  saved_y: i64,
  saved_pen: Pen,
  /// The window title the program last set (OSC 0 or 2).
  title: string,
  /// The directory the shell last reported (OSC 7), or `""`.
  cwd: string,
  /// What the shell's integration has reported since [Screen.take_marks] last asked.
  marks: []Mark,
  /// The completions the shell is reporting (OSC 7770 `m`), until its `e`.
  completing: []Completion,
  /// Lists of completions the shell has finished reporting, since [Screen.take_completions].
  completed: [][]Completion,
  /// Keys typed ahead that the shell found waiting at a new line (OSC 7770 `t`), raw, since
  /// [Screen.take_typed_ahead].
  typed_ahead: []string,
  /// Lines dropped off the top of a full scrollback: what makes an [Screen.absolute] line
  /// number stay the same line while the ring turns.
  dropped: i64,
  /// DEC private modes: bracketed paste (`?2004`) and the cursor shown (`?25`).
  bracketed_paste: bool,
  cursor_visible: bool,
  /// Application cursor keys (`?1`): arrows send `\eOA` rather than `\e[A`.
  cursor_keys: bool,
  /// Autowrap (`?7`): text reaching the last column goes on to the next line; off, the last
  /// column is written over.
  autowrap: bool,
  /// Application keypad (`\e=`, `\e>`).
  keypad: bool,
  /// The cursor's shape, as DECSCUSR (`\e[N q`) last set it: 0–2 a block, 3–4 an underline,
  /// 5–6 a bar (odd numbers blink).
  cursor_shape: i64,
  /// The alternate screen (`?1049`, `?1047`, `?47`): a full-screen program's, with no
  /// scrollback, the main screen kept to come back to — its lines, and for `?1049` the
  /// cursor and pen.
  alt: bool,
  main_lines: [][]Cell,
  main_x: i64,
  main_y: i64,
  main_pen: Pen,
  /// The mouse reports a program asked for: 0 none, 1000 presses, 1002 drags too, 1003 all
  /// motion; in SGR's encoding (`?1006`) or X10's; the wheel as arrow keys on the alternate
  /// screen when unreported (`?1007`, on by default as in most terminals); and focus
  /// reports (`?1004`).
  mouse_mode: i64,
  mouse_sgr: bool,
  alternate_scroll: bool,
  focus_events: bool,
  /// Answers to the program's questions — what terminal this is, where the cursor is,
  /// which colours — waiting to be written to it ([Screen.take_replies]).
  replies: []string,
  /// The colours reported to a program that asks (OSC 10, 11, 12), as `rgb:` triples of
  /// 16-bit hex: the theme's text and background. vim and neovim ask, to choose a dark or a
  /// light scheme.
  fg_report: string,
  bg_report: string,
  /// The combining marks written after cells' runes — accents, joiners, variation
  /// selectors — each run of them once, its index what a cell's `attrs` holds
  /// ([marks_of]); the first is none. `combining_ids` finds a run already kept.
  combining: []string,
  combining_ids: HashMap<string, i64>,
}

/// One completion the shell offered for the word at the caret (`../shell/shell.lyra`): the
/// word becomes `prefix`, `insert`, `suffix` — the part of the word kept before the match
/// (an opening quote, a `$`), the match as it goes into the line (quoted), and what follows
/// it (a space, a `/`, a closing quote) — and the menu shows `shown` and `description`.
pub struct Completion {
  prefix: string,
  insert: string,
  suffix: string,
  shown: string,
  description: string,
}

/// Where a shell with Sulafat's integration is (OSC 133 — `shell/shell.lyra`).
pub data Mark =
  /// A prompt is being drawn (`A`), from this absolute line and column.
  PromptStart(i64, i64)
  /// The prompt is drawn, and the command typed begins at this absolute line and column
  /// (`B`): where the command line's editor goes.
  | InputStart(i64, i64)
  /// The command is running; its output begins (`C`).
  | OutputStart
  /// The command ended, with this exit status (`D`), or -1 when none was reported.
  | CommandEnd(i64)

/// A blank screen `cols` × `rows`.
pub let screen = pure (cols: i64, rows: i64) -> Screen => Screen {
  cols: cols,
  rows: rows,
  lines: [row in 0..<rows | blank_line(cols, DEFAULT)],
  scrollback: [],
  scrollback_start: 0,
  x: 0,
  y: 0,
  wrap_pending: false,
  top: 0,
  bottom: rows - 1,
  pen: plain_pen(),
  saved_x: 0,
  saved_y: 0,
  saved_pen: plain_pen(),
  title: "",
  cwd: "",
  marks: [],
  completing: [],
  completed: [],
  typed_ahead: [],
  dropped: 0,
  bracketed_paste: false,
  cursor_visible: true,
  cursor_keys: false,
  autowrap: true,
  keypad: false,
  cursor_shape: 0,
  alt: false,
  main_lines: [],
  main_x: 0,
  main_y: 0,
  main_pen: plain_pen(),
  mouse_mode: 0,
  mouse_sgr: false,
  alternate_scroll: true,
  focus_events: false,
  replies: [],
  fg_report: "e6e6/e1e1/dcdc",
  bg_report: "1818/1a1a/1e1e",
  combining: [""],
  combining_ids: hashmap_new(),
}

/// The most lines kept above the screen.
pub const SCROLLBACK: i64 = 10000

impl Screen {
  /// Carry out what the program's output asked for.
  pub let apply = (self: mut, actions: []Action) -> void => {
    for a in actions {
      match a {
        Print(text) => self.print(text),
        Execute(c) => self.execute(c),
        Csi(seq) => self.csi(seq),
        Esc(seq) => self.esc(seq),
        Osc(text) => self.osc(text),
      }
    }
  }

  /// The marks reported since the last call, oldest first; the list is emptied.
  pub let take_marks = (self: mut) -> []Mark => {
    let out = self.marks
    self.marks = []
    out
  }

  /// The answers waiting for the program, oldest first; emptied. Written to it as typed.
  pub let take_replies = (self: mut) -> []string => {
    let out = self.replies
    self.replies = []
    out
  }

  /// The completion lists the shell has finished reporting since the last call, oldest
  /// first; emptied.
  pub let take_completions = (self: mut) -> [][]Completion => {
    let out = self.completed
    self.completed = []
    out
  }

  /// The keys typed ahead the shell has reported since the last call, raw, oldest first;
  /// emptied.
  pub let take_typed_ahead = (self: mut) -> []string => {
    let out = self.typed_ahead
    self.typed_ahead = []
    out
  }

  /// The absolute number of everything's line `i` ([line]'s numbering): it counts lines
  /// from the first the screen ever had, so it names the same line however much has
  /// scrolled since — until it leaves the scrollback, when [line_at] answers `None`.
  pub let absolute = pure (self, i: i64) -> i64 => i + self.dropped

  /// The line whose absolute number is `n`, as an index for [line]; `None` once it has left
  /// the scrollback.
  pub let line_at = pure (self, n: i64) -> Maybe<i64> => {
    let i = n - self.dropped
    if i < 0 || i >= self.scrollback.len() + self.rows { None } else { Some(i) }
  }

  /// The cursor's absolute line.
  pub let cursor_line = pure (self) -> i64 =>
    self.dropped + self.scrollback.len() + self.y

  /// How many lines there are above the screen.
  pub let scrollback_len = pure (self) -> i64 => self.scrollback.len()

  /// Line `i` of everything — the scrollback's, oldest first, then the screen's.
  pub let line = pure (self, i: i64) -> []Cell => {
    let n = self.scrollback.len()
    if i < n { self.scrollback[(self.scrollback_start + i) % n] }
    else { self.lines[i - n] }
  }

  /// Make the screen `cols` × `rows`, keeping what fits: lines cut or padded on the right,
  /// and the screen's top lines moved into the scrollback when it loses rows (so the
  /// cursor's line stays on it). Text is not reflowed.
  pub let resize = (self: mut, cols: i64, rows: i64) -> void => {
    if cols == self.cols && rows == self.rows { return }
    var kept: [][]Cell = []
    for l in self.lines { kept.push(fit(l, cols)) }
    // Losing rows: push lines off the top while the cursor's line would fall off the bottom.
    var y = self.y
    while kept.len() > rows && y > 0 {
      self.push_scrollback(kept[0])
      kept = kept.slice(1, kept.len())
      y -= 1
    }
    if kept.len() > rows { kept = kept.slice(0, rows) }
    while kept.len() < rows { kept.push(blank_line(cols, DEFAULT)) }
    self.lines = kept
    // The main screen kept behind the alternate one is fitted too, to come back to.
    if self.alt {
      var main: [][]Cell = []
      for l in self.main_lines { main.push(fit(l, cols)) }
      if main.len() > rows { main = main.slice(main.len() - rows, main.len()) }
      while main.len() < rows { main.push(blank_line(cols, DEFAULT)) }
      self.main_lines = main
      self.main_x = self.main_x.min(cols - 1)
      self.main_y = self.main_y.min(rows - 1)
    }
    self.cols = cols
    self.rows = rows
    self.y = y.min(rows - 1)
    self.x = self.x.min(cols - 1)
    self.wrap_pending = false
    self.top = 0
    self.bottom = rows - 1
  }

  // Text at the cursor, a cell a rune — two for a wide one (`width.lyra`), its second a
  // [SPACER]; a zero-width rune joins the cell before it ([combine]).
  let print = (self: mut, text: []rune) -> void => {
    for r in text {
      let w = width_of(r)
      if w == 0 && i64(r) >= 0x300 { self.combine(r) }
      if w > 0 {
        if self.wrap_pending {
          self.mark_wrapped()
          self.x = 0
          self.linefeed()
          self.wrap_pending = false
        }
        // A wide rune with one column left: on to the next line, the column left blank.
        var fits = true
        if w == 2 && self.x == self.cols - 1 {
          if self.autowrap && self.cols > 1 {
            self.clear_wide_at(self.y, self.x)
            self.lines[self.y][self.x] = blank_cell(self.pen.bg)
            self.mark_wrapped()
            self.x = 0
            self.linefeed()
          } else {
            fits = false
          }
        }
        if fits { self.put(r, w) }
      }
    }
  }

  // `r`, `w` cells wide, at the cursor, which moves past it — or, at the last column, stays
  // there with the wrap pending (without autowrap, to be written over).
  let put = (self: mut, r: rune, w: i64) -> void => {
    self.clear_wide_at(self.y, self.x)
    self.lines[self.y][self.x] = self.pen.cell(r)
    if w == 2 {
      self.clear_wide_at(self.y, self.x + 1)
      self.lines[self.y][self.x + 1] = self.pen.cell(SPACER)
    }
    let last = self.x + w - 1
    if last >= self.cols - 1 {
      self.x = self.cols - 1
      self.wrap_pending = self.autowrap
    } else {
      self.x = last + 1
    }
  }

  // A zero-width rune — a combining mark, a joiner, a variation selector — onto the cell
  // just written (the first of a wide rune's two), as one more of its marks; dropped with
  // no cell before it on the line, or once [COMBINING_LIMIT] runs of marks are kept.
  let combine = (self: mut, r: rune) -> void => {
    var x = if self.wrap_pending { self.x } else { self.x - 1 }
    if x > 0 && self.lines[self.y][x].ch == SPACER { x -= 1 }
    if x < 0 { return }
    let c = self.lines[self.y][x]
    let marks = "${self.combining[marks_of(c)]}${r}"
    var id = 0
    match self.combining_ids.get(marks) {
      Some(n) => { id = n },
      None => {
        if self.combining.len() >= COMBINING_LIMIT { return }
        id = self.combining.len()
        self.combining.push(marks)
        self.combining_ids.insert(marks, id)
      },
    }
    self.lines[self.y][x].attrs = (c.attrs & STYLE_BITS) | (u32(id) << MARKS_SHIFT)
  }

  // The cursor's line goes on to the next: its last cell says so.
  let mark_wrapped = (self: mut) -> void => {
    let last = self.cols - 1
    self.lines[self.y][last].attrs = self.lines[self.y][last].attrs | WRAPPED
  }

  // Before cell `x` of line `y` is written: if it is half of a wide rune, the other half
  // made blank, so that no half rune is left.
  let clear_wide_at = (self: mut, y: i64, x: i64) -> void => {
    if x < 0 || x >= self.cols { return }
    if self.lines[y][x].ch == SPACER && x > 0 {
      self.lines[y][x - 1] = blank_cell(self.lines[y][x - 1].bg)
    }
    if x + 1 < self.cols && self.lines[y][x + 1].ch == SPACER {
      self.lines[y][x + 1] = blank_cell(self.lines[y][x + 1].bg)
    }
  }

  let execute = (self: mut, c: u8) -> void => {
    if c == 8 {
      if self.x > 0 { self.x -= 1 }
      self.wrap_pending = false
    } else if c == 9 {
      self.x = ((self.x / 8 + 1) * 8).min(self.cols - 1)
    } else if c == 10 || c == 11 || c == 12 {
      self.linefeed()
    } else if c == 13 {
      self.x = 0
      self.wrap_pending = false
    }
  }

  let csi = (self: mut, seq: CsiSequence) -> void => {
    if seq.marker == "?" && seq.intermediates == "" && (seq.final == 'h' || seq.final == 'l') {
      for mode in seq.params { self.set_private_mode(mode, seq.final == 'h') }
      return
    }
    if self.report(seq) { return }
    // DECSCUSR, the cursor's shape: `\e[N q`.
    if seq.marker == "" && seq.intermediates == " " && seq.final == 'q' {
      self.cursor_shape = seq.param_or(0, 0)
      return
    }
    if seq.marker != "" || seq.intermediates != "" { return }
    let f = seq.final
    if f == 'm' { return self.pen.sgr(seq.params, seq.sub) }
    let n = seq.param_or(0, 1)
    if f == 'A' { self.move_to(self.x, (self.y - n).max(self.top.min(self.y))) }
    else if f == 'B' || f == 'e' { self.move_to(
      self.x,
      (self.y + n).min(self.bottom.max(self.y))
    ) }
    else if f == 'C' || f == 'a' { self.move_to(self.x + n, self.y) }
    else if f == 'D' { self.move_to(self.x - n, self.y) }
    else if f == 'E' { self.move_to(0, self.y + n) }
    else if f == 'F' { self.move_to(0, self.y - n) }
    else if f == 'G' || f == '`' { self.move_to(n - 1, self.y) }
    else if f == 'd' { self.move_to(self.x, n - 1) }
    else if f == 'H' || f == 'f' { self.move_to(seq.param_or(1, 1) - 1, n - 1) }
    else if f == 'J' { self.erase_display(seq.param_or(0, 0)) }
    else if f == 'K' { self.erase_line(seq.param_or(0, 0)) }
    else if f == 'X' { self.blank(self.y, self.x, (self.x + n).min(self.cols)) }
    else if f == 'P' { self.delete_chars(n) }
    else if f == '@' { self.insert_chars(n) }
    else if f == 'L' { self.insert_lines(n) }
    else if f == 'M' { self.delete_lines(n) }
    else if f == 'S' { for _ in 0..<n { self.scroll_up() } }
    else if f == 'T' { for _ in 0..<n { self.scroll_down() } }
    else if f == 'r' { self.set_region(
      seq.param_or(0, 1) - 1,
      seq.param_or(1, self.rows) - 1
    ) }
    else if f == 's' { self.save_cursor() }
    else if f == 'u' { self.restore_cursor() }
    // `m` (colours) and everything else: not yet.
  }

  let esc = (self: mut, seq: EscSequence) -> void => {
    if seq.intermediates != "" { return }
    let f = seq.final
    if f == '7' { self.save_cursor() }
    else if f == '8' { self.restore_cursor() }
    else if f == 'D' { self.linefeed() }
    else if f == 'E' {
      self.x = 0
      self.linefeed()
    } else if f == 'M' { self.reverse_index() }
    else if f == 'c' { self = screen(self.cols, self.rows) }
    else if f == '=' { self.keypad = true }
    else if f == '>' { self.keypad = false }
  }

  let osc = (self: mut, text: string) -> void => {
    if text.starts_with("0;") || text.starts_with("2;") {
      self.title = text.slice(2, text.len())
    } else if text.starts_with("7;") {
      self.cwd = file_url_path(text.slice(2, text.len()))
    } else if text.starts_with("133;") {
      self.shell_mark(text.slice(4, text.len()))
    } else if text == "10;?" || text == "11;?" || text == "12;?" {
      // A colour asked for: the text's (10, and the cursor's, 12) or the background's (11).
      let triple = if text == "11;?" { self.bg_report } else { self.fg_report }
      self.replies.push("\e]${text.slice(0, 2)};rgb:${triple}\e\\")
    } else if text.starts_with("7770;") {
      self.completion_report(text.slice(5, text.len()))
    }
  }

  // An OSC 133 mark. Input begins where the cursor is — on the next line when the prompt
  // filled the last column and the wrap is still pending.
  let shell_mark = (self: mut, mark: string) -> void => {
    if mark.starts_with("A") {
      if self.wrap_pending { self.marks.push(PromptStart(self.cursor_line() + 1, 0)) }
      else { self.marks.push(PromptStart(self.cursor_line(), self.x)) }
    }
    else if mark.starts_with("B") {
      if self.wrap_pending { self.marks.push(InputStart(self.cursor_line() + 1, 0)) }
      else { self.marks.push(InputStart(self.cursor_line(), self.x)) }
    } else if mark.starts_with("C") { self.marks.push(OutputStart) }
    else if mark.starts_with("D") {
      let status = if mark.starts_with("D;") { mark.slice(
        2,
        mark.len()
      ).parse_i64() ?? -1 } else { -1 }
      self.marks.push(CommandEnd(status))
    }
  }

  // OSC 7770, Sulafat's own: the shell reporting completions.
  let completion_report = (self: mut, report: string) -> void => {
    if report.starts_with("t;") { self.typed_ahead.push(percent_decode(report.slice(
      2,
      report.len()
    ))) }
    else if report == "b" { self.completing = [] }
    else if report == "e" {
      self.completed.push(self.completing)
      self.completing = []
    } else if report.starts_with("m;") {
      let f = report.slice(2, report.len()).split(";")
      if f.len() == 5 {
        self.completing.push(Completion {
          prefix: percent_decode(f[0]),
          insert: percent_decode(f[1]),
          suffix: percent_decode(f[2]),
          shown: percent_decode(f[3]),
          description: percent_decode(f[4]),
        })
      }
    }
  }

  // A question the program asks the terminal, answered; whether `seq` was one.
  let report = (self: mut, seq: CsiSequence) -> bool => {
    let f = seq.final
    let plain = seq.intermediates == ""
    // DA1 — what this is: a VT220 with ANSI colour, as most terminals answer.
    if seq.marker == "" && plain && f == 'c' && seq.param_or(0, 0) == 0 {
      self.replies.push("\e[?62;22c")
    } else if seq.marker == ">" && plain && f == 'c' {
      // DA2 — which terminal and version: a VT220, version 1.
      self.replies.push("\e[>1;1;0c")
    } else if seq.marker == ">" && plain && f == 'q' {
      // XTVERSION — its name and version.
      self.replies.push("\eP>|Sulafat 0.1\e\\")
    } else if seq.marker == "" && plain && f == 'n' && seq.param_or(0, 0) == 5 {
      // DSR — all is well.
      self.replies.push("\e[0n")
    } else if plain && f == 'n' && seq.param_or(
      0,
      0
    ) == 6 && (seq.marker == "" || seq.marker == "?") {
      // DSR — the cursor's place, 1-based, row first.
      self.replies.push("\e[${seq.marker}${self.y + 1};${self.x + 1}R")
    } else if seq.marker == "?" && seq.intermediates == "$" && f == 'p' {
      // DECRQM — whether a private mode is set (1), reset (2), or not known here (0).
      let mode = seq.param_or(0, 0)
      self.replies.push("\e[?${mode};${self.mode_state(mode)}$y")
    } else {
      return false
    }
    true
  }

  // A private mode's state for DECRQM: 1 set, 2 reset, 0 a mode this terminal does not have.
  let mode_state = pure (self, mode: i64) -> i64 => {
    let set = if mode == 1 { Some(self.cursor_keys) }
    else if mode == 7 { Some(self.autowrap) }
    else if mode == 25 { Some(self.cursor_visible) }
    else if mode == 1049 || mode == 1047 || mode == 47 { Some(self.alt) }
    else if mode == 1000 || mode == 1002 || mode == 1003 { Some(self.mouse_mode == mode) }
    else if mode == 1004 { Some(self.focus_events) }
    else if mode == 1006 { Some(self.mouse_sgr) }
    else if mode == 1007 { Some(self.alternate_scroll) }
    else if mode == 2004 { Some(self.bracketed_paste) }
    else { None }
    match set {
      Some(on) => if on { 1 } else { 2 },
      None => 0,
    }
  }

  let set_private_mode = (self: mut, mode: i64, on: bool) -> void => {
    if mode == 2004 { self.bracketed_paste = on }
    else if mode == 25 { self.cursor_visible = on }
    else if mode == 1 { self.cursor_keys = on }
    else if mode == 7 { self.autowrap = on }
    else if mode == 1049 {
      if on {
        self.main_x = self.x
        self.main_y = self.y
        self.main_pen = self.pen
        self.enter_alt()
      } else {
        self.leave_alt()
        self.move_to(self.main_x, self.main_y)
        self.pen = self.main_pen
      }
    } else if mode == 47 || mode == 1047 {
      if on { self.enter_alt() } else { self.leave_alt() }
    } else if mode == 1048 {
      if on { self.save_cursor() } else { self.restore_cursor() }
    } else if mode == 1000 || mode == 1002 || mode == 1003 {
      self.mouse_mode = if on { mode } else { 0 }
    } else if mode == 1006 { self.mouse_sgr = on }
    else if mode == 1007 { self.alternate_scroll = on }
    else if mode == 1004 { self.focus_events = on }
  }

  // To the alternate screen, blank, the main one kept. Twice in a row is once.
  let enter_alt = (self: mut) -> void => {
    if self.alt { return }
    self.main_lines = self.lines
    self.lines = [row in 0..<self.rows | blank_line(self.cols, DEFAULT)]
    self.alt = true
    self.top = 0
    self.bottom = self.rows - 1
    self.wrap_pending = false
  }

  // Back to the main screen, as it was; the alternate one is gone.
  let leave_alt = (self: mut) -> void => {
    if !self.alt { return }
    self.lines = self.main_lines
    self.main_lines = []
    self.alt = false
    self.top = 0
    self.bottom = self.rows - 1
    self.wrap_pending = false
  }

  let move_to = (self: mut, x: i64, y: i64) -> void => {
    self.x = x.clamp(0, self.cols - 1)
    self.y = y.clamp(0, self.rows - 1)
    self.wrap_pending = false
  }

  // Down a line, scrolling the region when the cursor is on its last line.
  let linefeed = (self: mut) -> void => {
    if self.y == self.bottom { self.scroll_up() }
    else if self.y < self.rows - 1 { self.y += 1 }
  }

  let reverse_index = (self: mut) -> void => {
    if self.y == self.top { self.scroll_down() }
    else if self.y > 0 { self.y -= 1 }
  }

  // The region's lines up one, a blank at its bottom. A line leaving the top of the whole
  // screen goes to the scrollback; one leaving a region lower down is gone, as in xterm.
  let scroll_up = (self: mut) -> void => {
    // A full-screen program's lines are not history: the alternate screen keeps none.
    if self.top == 0 && !self.alt { self.push_scrollback(self.lines[0]) }
    for i in self.top..<self.bottom { self.lines[i] = self.lines[i + 1] }
    self.lines[self.bottom] = blank_line(self.cols, self.pen.bg)
  }

  let scroll_down = (self: mut) -> void => {
    var i = self.bottom
    while i > self.top {
      self.lines[i] = self.lines[i - 1]
      i -= 1
    }
    self.lines[self.top] = blank_line(self.cols, self.pen.bg)
  }

  let push_scrollback = (self: mut, line: []Cell) -> void => {
    if self.scrollback.len() < SCROLLBACK { self.scrollback.push(line) }
    else {
      self.scrollback[self.scrollback_start] = line
      self.scrollback_start = (self.scrollback_start + 1) % SCROLLBACK
      self.dropped += 1
    }
  }

  let set_region = (self: mut, top: i64, bottom: i64) -> void => {
    let t = top.clamp(0, self.rows - 1)
    let b = bottom.clamp(0, self.rows - 1)
    if t < b {
      self.top = t
      self.bottom = b
      self.move_to(0, 0)
    }
  }

  let erase_display = (self: mut, mode: i64) -> void => {
    if mode == 0 {
      self.erase_line(0)
      for y in (self.y + 1)..<self.rows { self.lines[y] = blank_line(
        self.cols,
        self.pen.bg
      ) }
    } else if mode == 1 {
      self.erase_line(1)
      for y in 0..<self.y { self.lines[y] = blank_line(self.cols, self.pen.bg) }
    } else if mode == 2 || mode == 3 {
      for y in 0..<self.rows { self.lines[y] = blank_line(self.cols, self.pen.bg) }
    }
  }

  let erase_line = (self: mut, mode: i64) -> void => {
    if mode == 0 { self.blank(self.y, self.x, self.cols) }
    else if mode == 1 { self.blank(self.y, 0, self.x + 1) }
    else if mode == 2 { self.blank(self.y, 0, self.cols) }
  }

  // Cells `from` up to `to` of line `y` made blank.
  let blank = (self: mut, y: i64, from: i64, to: i64) -> void => {
    let empty = blank_cell(self.pen.bg)
    for x in from..<to { self.lines[y][x] = empty }
  }

  let delete_chars = (self: mut, n: i64) -> void => {
    let k = n.min(self.cols - self.x)
    for x in self.x..<(self.cols - k) { self.lines[self.y][x] = self.lines[self.y][x + k] }
    self.blank(self.y, self.cols - k, self.cols)
  }

  let insert_chars = (self: mut, n: i64) -> void => {
    let k = n.min(self.cols - self.x)
    var x = self.cols - 1
    while x >= self.x + k {
      self.lines[self.y][x] = self.lines[self.y][x - k]
      x -= 1
    }
    self.blank(self.y, self.x, self.x + k)
  }

  // Lines inserted or deleted at the cursor, within the scroll region, as if the region
  // began at the cursor's line.
  let insert_lines = (self: mut, n: i64) -> void => {
    if self.y < self.top || self.y > self.bottom { return }
    let top = self.top
    self.top = self.y
    for _ in 0..<n.min(self.bottom - self.y + 1) { self.scroll_down() }
    self.top = top
    self.x = 0
  }

  let delete_lines = (self: mut, n: i64) -> void => {
    if self.y < self.top || self.y > self.bottom { return }
    let top = self.top
    self.top = self.y
    // Deleted lines are not scrollback, even when the region starts at the top.
    for _ in 0..<n.min(self.bottom - self.y + 1) {
      for i in self.top..<self.bottom { self.lines[i] = self.lines[i + 1] }
      self.lines[self.bottom] = blank_line(self.cols, self.pen.bg)
    }
    self.top = top
    self.x = 0
  }

  // The cursor and the pen, as DECSC saves them.
  let save_cursor = (self: mut) -> void => {
    self.saved_x = self.x
    self.saved_y = self.y
    self.saved_pen = self.pen
  }

  let restore_cursor = (self: mut) -> void => {
    self.move_to(self.saved_x, self.saved_y)
    self.pen = self.saved_pen
  }
}

/// A line of `cols` blank cells on `bg` — a new array each call: lines are written in place,
/// so two lines sharing one array would show each other's text.
let blank_line = pure (cols: i64, bg: u32) -> []Cell => [blank_cell(bg); cols]

/// `line` made `cols` cells long: cut, or padded with blanks.
let fit = pure (line: []Cell, cols: i64) -> []Cell => {
  if line.len() >= cols { return line.slice(0, cols) }
  var out = line.slice(0, line.len())
  while out.len() < cols { out.push(blank_cell(DEFAULT)) }
  out
}

/// A line's runes, its styles and the spacers after wide runes left behind.
pub let runes_of = pure (line: []Cell) -> []rune => {
  var out: []rune = []
  for c in line { if c.ch != SPACER { out.push(c.ch) } }
  out
}

/// The second cell of a wide rune: no rune of its own, drawn as part of the first.
pub const SPACER: rune = '\x00'

/// The runs of combining marks a screen keeps at most: what the bits above [MARKS_SHIFT]
/// can count.
const COMBINING_LIMIT: i64 = 1 << 20

/// The bits of `attrs` below [MARKS_SHIFT]: the attributes themselves.
const STYLE_BITS: u32 = 0xFFF

/// The path of a `file://host/path` URL (OSC 7's form), its `%XX` escapes decoded; `""`
/// when it is not one.
let file_url_path = pure (url: string) -> string => {
  if !url.starts_with("file://") { return "" }
  let rest = url.slice(7, url.len())
  let Some(slash) = rest.index("/") else { return "" }
  percent_decode(rest.slice(slash, rest.len()))
}

/// `s` with each `%XX` escape decoded to its byte; a `%` not followed by two hex digits is
/// itself.
let percent_decode = pure (s: string) -> string => {
  let raw = s.encode_utf8()
  var out: []u8 = []
  var i = 0
  while i < raw.len() {
    if raw[i] == 0x25 && i + 2 < raw.len() {
      match (hex_digit(raw[i + 1]), hex_digit(raw[i + 2])) {
        (Some(hi), Some(lo)) => {
          out.push(u8(hi * 16 + lo))
          i += 3
        },
        _ => {
          out.push(raw[i])
          i += 1
        },
      }
    } else {
      out.push(raw[i])
      i += 1
    }
  }
  out.decode_utf8()
}

let hex_digit = pure (b: u8) -> Maybe<i64> =>
  if b >= 0x30 && b <= 0x39 { Some(i64(b - 0x30)) }
  else if b >= 0x61 && b <= 0x66 { Some(i64(b - 0x61) + 10) }
  else if b >= 0x41 && b <= 0x46 { Some(i64(b - 0x41) + 10) }
  else { None }
