let main = () -> u8 => {
  var failed = 0
  failed += check_parser()
  failed += check_desktop_entry()
  failed += check_window_place()
  failed += check_color_alpha()
  failed += check_saved_themes()
  failed += check_fills()
  failed += check_theme()
  failed += check_typeahead_lines()
  failed += check_sessions()
  failed += check_mouse_reports()
  failed += check_meta_and_bright()
  failed += check_screen()
  failed += check_style()
  failed += check_modes()
  failed += check_reports()
  failed += check_wide()
  failed += check_selection()
  failed += check_pty()
  failed += check_typing()
  failed += check_editor()
  failed += check_syntax()
  failed += check_marks()
  failed += check_words()
  failed += check_completion_reports()
  failed += check_command_reports()
  // The integration's checks need the shell itself: a machine without it skips them, and
  // says so. bash's need 4.4 or newer, which macOS's own /bin/bash is not.
  if installed(["/bin/zsh"], "the zsh checks") {
    failed += check_shell("/bin/zsh")
    failed += check_completion("/bin/zsh")
    failed += check_commands("/bin/zsh")
    failed += check_typed_ahead("/bin/zsh")
  }
  let bashes = if platform() == "macOS" {
    ["/opt/homebrew/bin/bash", "/usr/local/bin/bash"]
  } else { ["/bin/bash", "/usr/bin/bash"] }
  if installed(bashes, "the bash checks (bash 4.4 or newer)") {
    var bash = bashes[0]
    for b in bashes { if is_executable(b) && !is_executable(bash) { bash = b } }
    failed += check_shell(bash)
    failed += check_completion(bash)
    failed += check_commands(bash)
    failed += check_typed_ahead(bash)
    failed += check_bash_history()
  }
  failed += check_full_screen()
  if failed == 0 {
    println("vttest: all passed")
    0
  } else {
    println("vttest: ${failed} failed")
    1
  }
}

/// Whether one of `paths` is an installed program; when none is, `what` is reported as
/// skipped.
let installed = (paths: []string, what: string) -> bool => {
  for p in paths { if is_executable(p) { return true } }
  println("vttest: skipped ${what}: ${paths.join(" or ")} not installed")
  false
}

// The command line's coloring: each rune's kind, a letter each — P plain, C command, O
// option, Q quoted, V variable, X operator, # comment.
let check_syntax = () -> i64 => {
  var failed = 0
  failed += check("a command and options", syntax("ls -la x"), "CCPOOOPP")
  failed += check("quotes and a variable", syntax("echo \"a $B\" 'c'"), "CCCCPQQQVVQPQQQ")
  failed += check("a pipe begins a command", syntax("a | grep x"), "CPXPCCCCPP")
  failed += check("an assignment before it", syntax("X=1 make"), "PPPPCCCC")
  failed += check("sudo's command", syntax("sudo rm -f"), "CCCCPCCPOO")
  failed += check("a redirection's file", syntax("cat >out"), "CCCPXPPP")
  failed += check("a comment", syntax("ls # hi"), "CCP####")
  failed += check("a command inside $(…)", syntax("echo $(pwd)"), "CCCCPXXCCCX")
  failed += check("braces and $?", syntax(`x ${A}$?`), "CPVVVVVV")
  failed += check("an unclosed $(", syntax("x $(pw"), "CPXXCC")
  // The command words the shell is asked about: whole and plain ones only.
  failed += check("words: a pipe's two", words("ls -la | grp x"), "ls|grp")
  failed += check("words: after sudo", words("sudo nosuch -f"), "sudo|nosuch")
  failed += check("words: past an assignment, not a variable", words("X=1 make && $ED f"), "make")
  failed += check("words: not quoted", words("\"ec\"ho x; e'c'ho"), "")
  failed += check("words: not a ~ path, a ./ one", words("~/bin/x; ./run"), "./run")
  failed += check("words: inside $(…)", words("echo $(whoami)"), "echo|whoami")
  failed += check("words: [[ and a glob", words("[[ -f x ]] && l*"), "[[")
  failed
}

let words = pure (text: string) -> string => {
  let runes = text.to_runes()
  [w in command_words(runes) | text_of_runes(runes.slice(w.0, w.1))].join("|")
}

let syntax = pure (text: string) -> string => [k in kinds(text.to_runes()) | match k {
  Plain => "P",
  Command => "C",
  Option => "O",
  Quoted => "Q",
  Variable => "V",
  Operator => "X",
  Comment => "#",
}].join("")

let check_parser = () -> i64 => {
  var failed = 0
  failed += check("text and controls", describe(feed_all(["ab\r\n"])), "P(ab) X13 X10")
  failed += check("CSI with params", describe(feed_all(["\e[12;5H"])), "C(;12,5;H)")
  failed += check("private marker", describe(feed_all(["\e[?1049h"])), "C(?;1049;h)")
  failed += check("no params", describe(feed_all(["\e[m"])), "C(;0;m)")
  failed += check("sub-parameters", subs(feed_all(["\e[38:2::1:2:3m"])), "FTTTTT")
  failed += check("OSC by BEL", describe(feed_all(["\e]0;hi\x07"])), "O(0;hi)")
  failed += check("OSC by ST", describe(feed_all(["\e]2;yo\e\\"])), "O(2;yo)")
  failed += check("ESC sequence", describe(feed_all(["\e7\e(B"])), "E(;7) E((;B)")
  // The same stream cut at every byte: the actions' content is the same.
  failed += check(
    "split across reads",
    describe(feed_all(["\e", "[", "3", "1", ";", "4", "m", "x"])),
    "C(;31,4;m) P(x)"
  )
  failed += check("UTF-8 whole", describe(feed_all(["é→"])), "P(é→)")
  failed += check(
    "UTF-8 split",
    describe(feed_bytes([[0xC3], [0xA9], [0xE2, 0x86], [0x92]])),
    "P(é) P(→)"
  )
  failed += check("bad UTF-8", describe(feed_bytes([[0xFF, 0x41]])), "P(\uFFFDA)")
  failed += check("CAN aborts", describe(feed_all(["\e[1\x18x"])), "P(x)")
  failed += check(
    "huge param",
    describe(feed_all(["\e[99999999999999999999A"])),
    "C(;0;A)"
  )
  failed
}

let check_screen = () -> i64 => {
  var failed = 0
  failed += check("print", rows(run(5, 2, "ab")), "ab   |     ")
  failed += check("CR overwrites", rows(run(5, 2, "abc\rX")), "Xbc  |     ")
  failed += check("deferred wrap", rows(run(3, 2, "abc")), "abc|   ")
  failed += check("wrap on next", rows(run(3, 2, "abcd")), "abc|d  ")
  failed += check("erase line", rows(run(5, 1, "abcde\r\e[2C\e[K")), "ab   ")
  failed += check("cursor position", rows(run(4, 2, "\e[2;3Hx")), "    |  x ")
  failed += check("backspace", rows(run(4, 1, "ab\x08c")), "ac  ")
  failed += check("tab", rows(run(12, 1, "a\tb")), "a       b   ")
  failed += check("delete chars", rows(run(5, 1, "abcde\r\e[2P")), "cde  ")
  failed += check("insert chars", rows(run(5, 1, "abcde\r\e[2@")), "  abc")
  let scrolled = run(3, 2, "1\r\n2\r\n3")
  failed += check("scroll", rows(scrolled), "2  |3  ")
  failed += check(
    "scrollback",
    "${scrolled.scrollback_len()}:${line_text(scrolled.line(0))}",
    "1:1  "
  )
  failed += check("region", rows(run(2, 3, "a\r\nb\r\nc\e[1;2r\e[2Hz\nq")), "z | q|c ")
  failed += check("title", run(4, 1, "\e]0;hello\x07").title, "hello")
  failed
}

// SGR: colors in each spelling, attributes set and cleared, and erases on the pen's
// background.
let check_style = () -> i64 => {
  var failed = 0
  failed += check("bold red", style_at("\e[1;31mR", 0), style(indexed(1), DEFAULT, BOLD))
  failed += check("reset", style_at("\e[1;31mR\e[0mx", 1), style(DEFAULT, DEFAULT, 0))
  failed += check(
    "empty SGR resets",
    style_at("\e[7mR\e[mx", 1),
    style(DEFAULT, DEFAULT, 0)
  )
  failed += check("bright", style_at("\e[91;103mx", 0), style(indexed(9), indexed(11), 0))
  failed += check("256", style_at("\e[38;5;208mx", 0), style(indexed(208), DEFAULT, 0))
  failed += check(
    "24-bit",
    style_at("\e[38;2;10;20;30mx", 0),
    style(rgb(10, 20, 30), DEFAULT, 0)
  )
  failed += check(
    "24-bit, colons",
    style_at("\e[38:2::10:20:30mx", 0),
    style(rgb(10, 20, 30), DEFAULT, 0)
  )
  failed += check(
    "24-bit, colons, no color space",
    style_at("\e[48:2:10:20:30mx", 0),
    style(DEFAULT, rgb(10, 20, 30), 0)
  )
  failed += check(
    "256 background, colons",
    style_at("\e[48:5:17mx", 0),
    style(DEFAULT, indexed(17), 0)
  )
  failed += check(
    "codes around a color",
    style_at("\e[1;38;5;9;4mx", 0),
    style(indexed(9), DEFAULT, BOLD | UNDERLINE)
  )
  failed += check(
    "curly underline",
    style_at("\e[4:3mx", 0),
    style(DEFAULT, DEFAULT, CURLY_UNDERLINE)
  )
  failed += check(
    "underline off by 4:0",
    style_at("\e[4m\e[4:0mx", 0),
    style(DEFAULT, DEFAULT, 0)
  )
  failed += check(
    "double underline",
    style_at("\e[21mx", 0),
    style(DEFAULT, DEFAULT, DOUBLE_UNDERLINE)
  )
  failed += check(
    "22 clears bold and dim",
    style_at("\e[1;2;3m\e[22mx", 0),
    style(DEFAULT, DEFAULT, ITALIC)
  )
  failed += check(
    "inverse, strike",
    style_at("\e[7;9mx", 0),
    style(DEFAULT, DEFAULT, INVERSE | STRIKE)
  )
  failed += check(
    "39 and 49",
    style_at("\e[31;42m\e[39;49mx", 0),
    style(DEFAULT, DEFAULT, 0)
  )
  failed += check(
    "a color cut short",
    style_at("\e[38;5mx", 0),
    style(DEFAULT, DEFAULT, 0)
  )
  failed += check("dim", style_at("\e[2mx", 0), style(DEFAULT, DEFAULT, DIM))
  // Erases take the pen's background, and nothing else of it.
  failed += check(
    "erase line on blue",
    style_at("\e[1;44mA\e[K", 3),
    style(DEFAULT, indexed(4), 0)
  )
  failed += check(
    "clear on blue",
    style_at("\e[44m\e[2J", 5),
    style(DEFAULT, indexed(4), 0)
  )
  failed += check(
    "written after reset",
    style_at("\e[44m\e[0m\e[K", 2),
    style(DEFAULT, DEFAULT, 0)
  )
  // DECSC keeps the pen, and DECRC brings it back.
  failed += check(
    "save and restore the pen",
    style_at("\e[31m\e7\e[32m\e8x", 0),
    style(indexed(1), DEFAULT, 0)
  )
  failed
}

// A selection's text and words, on the screen and its scrollback.
let check_selection = () -> i64 => {
  var failed = 0
  let s = run(8, 3, "one two\r\nfoo.bar\r\n中x  end")
  failed += check("within a line", selection_text(s, at(0, 4), at(0, 7)), "two")
  failed += check(
    "across lines, blanks dropped",
    selection_text(s, at(0, 4), at(1, 3)),
    "two\nfoo"
  )
  failed += check(
    "backwards is the same",
    selection_text(s, at(1, 3), at(0, 4)),
    "two\nfoo"
  )
  failed += check("a wide rune once", selection_text(s, at(2, 0), at(2, 3)), "中x")
  failed += check(
    "whole lines",
    selection_text(s, at(0, 0), at(2, 8)),
    "one two\nfoo.bar\n中x  end"
  )
  failed += check("a word", span(word_span(s, 0, 5)), "4,7")
  failed += check("punctuation", span(word_span(s, 1, 3)), "3,4")
  failed += check("a word beside it", span(word_span(s, 1, 5)), "4,7")
  failed += check("blanks", span(word_span(s, 2, 4)), "3,5")
  failed += check("the second half of a wide rune", span(word_span(s, 2, 1)), "0,3")
  failed += check(
    "selected on a middle line",
    span(selected_on(at(0, 4), at(2, 2), 1, 8)),
    "0,8"
  )
  failed += check(
    "selected on another line",
    span(selected_on(at(0, 4), at(0, 6), 1, 8)),
    "0,0"
  )
  // Lines that have left the scrollback are skipped.
  var small = run(4, 1, "a\r\nb\r\nc")
  failed += check("lines gone", selection_text(small, at(-5, 0), at(2, 4)), "a\nb\nc")
  // A line the text wrapped off copies as one; one that only filled its row does not.
  let wrapped = run(5, 3, "abcdefgh\r\nxy")
  failed += check(
    "a soft wrap joined",
    selection_text(wrapped, at(0, 0), at(2, 5)),
    "abcdefgh\nxy"
  )
  failed += check(
    "from inside a wrapped line",
    selection_text(wrapped, at(0, 3), at(1, 2)),
    "defg"
  )
  let filled = run(5, 2, "abcde\r\nxy")
  failed += check(
    "a full line, not wrapped",
    selection_text(filled, at(0, 0), at(1, 5)),
    "abcde\nxy"
  )
  let spaced = run(5, 2, "ab   cd")
  failed += check(
    "blanks kept before a wrap",
    selection_text(spaced, at(0, 0), at(1, 5)),
    "ab   cd"
  )
  // A wide rune at the last column wraps whole, the column it left blank: the join drops
  // that blank, which the screen wrote, not the program.
  let early = run(5, 2, "abcd中xy")
  failed += check(
    "the filler before a wrapped wide rune",
    selection_text(early, at(0, 0), at(1, 5)),
    "abcd中xy"
  )
  // Combining marks stay with the rune before them: its cell, and copied after it. The
  // screen keeps "", the acute, the diaeresis, and the two together.
  let marked = run(6, 2, "éẍ́中́")
  failed += check(
    "marks in their cells",
    "${marked.line(0)[0].ch}|${marked.combining[marks_of(marked.line(0)[0])]}|${marked.combining[marks_of(marked.line(0)[1])]}",
    "e|́|̈́"
  )
  failed += check(
    "a mark on a wide rune",
    marked.combining[marks_of(marked.line(0)[2])],
    "́"
  )
  failed += check("marks copied", selection_text(marked, at(0, 0), at(0, 6)), "éẍ́中́")
  failed += check(
    "each run of marks kept once",
    "${marked.combining.len()}",
    "4"
  )
  let edge = run(2, 2, "ab́")
  failed += check(
    "a mark at the last column",
    edge.combining[marks_of(edge.line(0)[1])],
    "́"
  )
  let alone = run(4, 2, "́a")
  failed += check("a mark with nothing before it", "${marks_of(alone.line(0)[0])}", "0")
  failed
}

let at = pure (line: i64, col: i64) -> Spot => Spot { line: line, col: col }

let span = pure (p: (i64, i64)) -> string => "${p.0},${p.1}"

// Wide runes take two cells; zero-width ones none.
let check_wide = () -> i64 => {
  var failed = 0
  failed += check(
    "widths",
    "${width_of('a')} ${width_of('中')} ${width_of('😀')} ${width_of(rune(0x301))} ${width_of('é')}",
    "1 2 2 0 1"
  )
  let s = run(6, 2, "a中b")
  failed += check(
    "a wide rune and a spacer",
    "${s.line(0)[1].ch == '中'} ${s.line(0)[2].ch == SPACER}",
    "true true"
  )
  failed += check("the cursor past both cells", "${s.x}", "4")
  failed += check("its text, spacer unseen", line_text(s.line(0)), "a中b  ")
  failed += check(
    "one column left: on to the next line",
    rows(run(3, 2, "ab中")),
    "ab |中 "
  )
  failed += check("filling the last two columns", rows(run(4, 2, "ab中x")), "ab中|x   ")
  // Writing over half a wide rune blanks the other half.
  failed += check("over its first half", rows(run(4, 1, "中\rx")), "x   ")
  failed += check("over its second half", rows(run(4, 1, "中\e[2Gx")), " x  ")
  failed += check("a combining mark is dropped", rows(run(4, 1, "e\u0301x")), "ex  ")
  failed
}

// The program's questions, answered.
let check_reports = () -> i64 => {
  var failed = 0
  failed += check("DA1", replies("\e[c"), "\\e[?62;22c")
  failed += check("DA1 with a 0", replies("\e[0c"), "\\e[?62;22c")
  failed += check("DA2", replies("\e[>c"), "\\e[>1;1;0c")
  failed += check("XTVERSION", replies("\e[>q"), "\\eP>|Termina 0.4.1\\e\\")
  failed += check("DSR status", replies("\e[5n"), "\\e[0n")
  failed += check("cursor position", replies("ab\r\nc\e[6n"), "\\e[2;2R")
  failed += check("DECRQM set", replies("\e[?2004h\e[?2004$p"), "\\e[?2004;1$y")
  failed += check("DECRQM reset", replies("\e[?1$p"), "\\e[?1;2$y")
  failed += check("DECRQM unknown", replies("\e[?9999$p"), "\\e[?9999;0$y")
  failed += check(
    "background color",
    replies("\e]11;?\x07"),
    "\\e]11;rgb:1818/1a1a/1e1e\\e\\"
  )
  failed += check("text color", replies("\e]10;?\e\\"), "\\e]10;rgb:e6e6/e1e1/dcdc\\e\\")
  failed += check("several, in order", replies("\e[c\e[5n"), "\\e[?62;22c|\\e[0n")
  failed += check("no question, no answer", replies("hello\e[m"), "")
  failed
}

/// The answers to `input`, joined by `|`, with ESC shown as `\e`.
let replies = pure (input: string) -> string => {
  var s = run(10, 3, input)
  [r in s.take_replies() | r.replace("\e", "\\e")].join("|")
}

// The DEC private modes full-screen programs set.
let check_modes = () -> i64 => {
  var failed = 0
  // The alternate screen: blank, the main one kept with its cursor, no scrollback while on.
  var p = parser()
  var s = screen(6, 2)
  s.apply(p.feed("main\r\nhere".encode_utf8()))
  s.apply(p.feed("\e[?1049h".encode_utf8()))
  failed += check("alt is blank", rows(s), "      |      ")
  failed += check("alt keeps the cursor's place", "${s.x},${s.y}", "4,1")
  s.apply(p.feed("\e[HALT\r\n1\r\n2\r\n3".encode_utf8()))
  failed += check("alt scrolls without scrollback", "${s.scrollback_len()}", "0")
  s.resize(4, 2)
  s.apply(p.feed("\e[?1049l".encode_utf8()))
  failed += check("main comes back, fitted", rows(s), "main|here")
  failed += check("and its cursor", "${s.x},${s.y}", "3,1")
  failed += check("alt flag", "${s.alt}", "false")
  // ?47 switches without the cursor; entering twice is entering once.
  var q = parser()
  var t = screen(4, 1)
  t.apply(q.feed("ab\e[?47h\e[?47hx\e[?47l".encode_utf8()))
  failed += check("?47 back to the main screen", rows(t), "ab  ")
  // Autowrap off: the last column is written over.
  failed += check("no autowrap", rows(run(3, 2, "\e[?7labcde")), "abe|   ")
  failed += check("autowrap back on", rows(run(3, 2, "\e[?7l\e[?7habcd")), "abc|d  ")
  // Keys, cursor shape, mouse.
  let m = run(4, 1, "\e[?1h\e=\e[5 q\e[?1002h\e[?1006h\e[?1004h")
  failed += check("cursor keys, keypad", "${m.cursor_keys} ${m.keypad}", "true true")
  failed += check("cursor shape", "${m.cursor_shape}", "5")
  failed += check(
    "mouse modes",
    "${m.mouse_mode} ${m.mouse_sgr} ${m.focus_events}",
    "1002 true true"
  )
  let n = run(4, 1, "\e[?1h\e=\e[?1002h\e[?1l\e>\e[?1002l")
  failed += check(
    "and off again",
    "${n.cursor_keys} ${n.keypad} ${n.mouse_mode}",
    "false false 0"
  )
  failed
}

/// The style of cell `col` on the first line after `input`, as `fg/bg/attrs`.
let style_at = pure (input: string, col: i64) -> string => {
  let c = run(8, 2, input).line(0)[col]
  style(c.fg, c.bg, c.attrs)
}

let style = pure (fg: u32, bg: u32, attrs: u32) -> string => "${fg}/${bg}/${attrs}"

// `printf` on a pseudo-terminal: a real program's bytes through the PTY, parser and screen.
let check_pty = () -> i64 => {
  let Some(pty) = spawn(
    ["/bin/sh", "-c", "printf 'one\\ntwo\\033[1Gx\\n'; stty size"],
    20,
    4
  ) else {
    return check("spawn", "failed", "spawned")
  }
  var p = parser()
  var s = screen(20, 4)
  var going = true
  let deadline = wall_clock_nanos() + 10000000000
  while going && wall_clock_nanos() < deadline {
    match pty.read() {
      None => { going = false },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
      },
    }
  }
  // The terminal closes as the program ends, a moment before the program can be reaped.
  var status = pty.exit_status()
  var waits = 0
  while status == None && waits < 1000000 {
    status = pty.exit_status()
    waits += 1
  }
  close(pty)
  var failed = 0
  // The terminal turns `\n` into `\r\n` (onlcr), and `stty size` reads the size it was given.
  failed += check(
    "pty output",
    "${line_text(s.line(0)).trim()}|${line_text(s.line(1)).trim()}",
    "one|xwo"
  )
  failed += check("pty size", line_text(s.line(2)).trim(), "4 20")
  failed += check("exit status", "${status ?? -1}", "0")
  failed
}

// Keys written to a program and echoed by the terminal's line discipline, as the shell's
// line editor would see them: Return as `\r`, turned into `\r\n` on the way back.
let check_typing = () -> i64 => {
  let Some(pty) = spawn(
    ["/bin/cat"],
    20,
    4
  ) else { return check("spawn cat", "failed", "spawned") }
  var p = parser()
  var s = screen(20, 4)
  let wrote = pty.write("héllo\r")
  var deadline = wall_clock_nanos() + 10000000000
  while line_text(s.line(1)).trim() != "héllo" && wall_clock_nanos() < deadline {
    match pty.read() {
      None => { deadline = 0 },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
      },
    }
  }
  let _ = pty.write("\x04")
  close(pty)
  var failed = check("write", "${wrote}", "true")
  failed += check(
    "echo",
    "${line_text(s.line(0)).trim()}|${line_text(s.line(1)).trim()}",
    "héllo|héllo"
  )
  failed
}

// The command line's editor, on text alone.
let check_editor = () -> i64 => {
  var failed = 0
  var e = editor()
  e.type_text("git commit -m msg")
  e.word_left(false)
  failed += check("word left", "${e.cursor}", "14")
  e.word_left(false)
  failed += check("word left stops at a word", "${e.cursor}", "12")
  e.word_left(false)
  failed += check("word left over punctuation", "${e.cursor}", "4")
  e.text_end(false)
  e.delete_word_back()
  failed += check("delete word back", e.content(), "git commit -m ")
  e.line_start(false)
  e.word_right(true)
  failed += check("select word right", e.selected_text(), "git")
  e.type_text("jj")
  failed += check("type over selection", e.content(), "jj commit -m ")

  // Double-click selects the word under the pointer — not the run beside it.
  var d = with_text("echo hello-world  next")
  d.select_word(11)
  failed += check("double-click a word", d.selected_text(), "world")
  d.select_word(5)
  failed += check("double-click its first letter", d.selected_text(), "hello")
  d.select_word(9)
  failed += check("double-click its last letter", d.selected_text(), "hello")
  d.select_word(10)
  failed += check("double-click punctuation", d.selected_text(), "-")
  d.select_word(16)
  failed += check("double-click spaces", d.selected_text(), "  ")
  d.select_word(99)
  failed += check("double-click past the end", d.selected_text(), "next")
  var m = with_text("one\ntwo three")
  m.select_word(4)
  failed += check("double-click on a second line", m.selected_text(), "two")
  m.select_word(3)
  failed += check("double-click a line break", "${m.has_selection()}", "false")
  var u = with_text("über_cool größe")
  u.select_word(2)
  failed += check("double-click non-ASCII", u.selected_text(), "über_cool")
  var w = with_text("aa bb cc dd")
  w.select_word(3)
  w.select_words(3, 5, 7)
  failed += check("drag by words, right", w.selected_text(), "bb cc")
  w.select_words(3, 5, 0)
  failed += check("drag by words, left", w.selected_text(), "aa bb")
  var l = with_text("first\nsecond")
  l.select_line(8)
  failed += check("triple-click a line", l.selected_text(), "second")

  // A double-click past a line's end is on that line's last rune.
  let wrap = Wrap { first: 0, cols: 80 }
  let runes = "ab cd\nef".to_runes()
  failed += check("rune under a cell", "${rune_at(runes, wrap, 0, 3)}", "3")
  failed += check("rune past a line's end", "${rune_at(runes, wrap, 0, 40)}", "5")

  // Undo takes back a run of typing, split where a word ends.
  var h = editor()
  h.type_text("a")
  h.type_text("b")
  h.type_text(" ")
  h.type_text("c")
  let _ = h.undo()
  failed += check("undo a word", h.content(), "ab")
  let _ = h.undo()
  failed += check("undo the first", h.content(), "")
  let _ = h.redo()
  failed += check("redo", h.content(), "ab")
  h.text_end(false)
  h.backspace()
  h.backspace()
  let _ = h.undo()
  failed += check("undo deletes together", h.content(), "ab")

  // Rows as laid out after a five-column prompt, ten columns wide.
  let narrow = Wrap { first: 5, cols: 10 }
  var v = with_text("abcdefghij")
  failed += check("wrapped end", pos(position(v.text, narrow, 10)), "1,5")
  failed += check(
    "up a wrapped row",
    "${v.vertical(narrow, -1, false)}:${v.cursor}",
    "true:0"
  )
  failed += check("nothing above", "${v.vertical(narrow, -1, false)}", "false")
  var g = with_text("ab\ncdef")
  failed += check(
    "up to a shorter line",
    "${g.vertical(wrap, -1, false)}:${g.cursor}",
    "true:2"
  )
  failed += check(
    "back down to the goal column",
    "${g.vertical(wrap, 1, false)}:${g.cursor}",
    "true:7"
  )
  failed += check("click past a row's end", "${index_at(g.text, wrap, 0, 50.0)}", "2")
  failed += check("click below the text", "${index_at(g.text, wrap, 9, 0.0)}", "7")
  // A wide rune takes two columns, and one with no room for both starts the next row.
  let tight = Wrap { first: 0, cols: 5 }
  let wide = "ab中文".to_runes()
  failed += check("after a wide rune", pos(position(wide, tight, 3)), "1,0")
  failed += check("a wide rune wrapped whole", pos(position(wide, tight, 4)), "1,2")
  failed += check("a wide rune's second cell", "${rune_at(wide, tight, 0, 3)}", "2")
  let pair = "中x".to_runes()
  failed += check(
    "click past a wide rune's middle",
    "${index_at(pair, wrap, 0, 1.6)}",
    "1"
  )
  failed += check("click before its middle", "${index_at(pair, wrap, 0, 0.9)}", "0")
  failed += check(
    "a combining mark takes no column",
    pos(position("éx".to_runes(), wrap, 2)),
    "0,1"
  )

  var p = editor()
  p.paste("a\r\nb\rc")
  failed += check("paste line ends", p.content(), "a\nb\nc")
  p.select_all()
  failed += check("cut", "${p.cut()}|${p.content()}", "a\nb\nc|")
  failed
}

let pos = pure (p: (i64, i64)) -> string => "${p.0},${p.1}"

let with_text = pure (s: string) -> Editor => {
  var e = editor()
  e.paste(s)
  e
}

// zsh with Termina's integration: its marks arrive, and input begins after the prompt.
let check_marks = () -> i64 => {
  var p = parser()
  var s = screen(40, 4)
  s.apply(p.feed("\e]133;A\x07me ~ % \e]133;B\x07\e[?2004h\e]7;file://host/Users/me/a%20b\x07".encode_utf8()))
  var failed = check("marks", "${describe_marks(s)}", "A B(0,7)")
  failed += check("cwd", s.cwd, "/Users/me/a b")
  failed += check("bracketed paste", "${s.bracketed_paste}", "true")
  s.apply(p.feed("\e]133;C\x07out\r\n\e]133;D;3\x07".encode_utf8()))
  failed += check("run and end", "${describe_marks(s)}", "C D(3)")
  // A prompt after output that did not end its line begins partway along it.
  s.apply(p.feed("half\e]133;A\x07".encode_utf8()))
  let starts = [m in s.take_marks() | match m {
    PromptStart(l, c) => "${l - s.absolute(s.scrollback_len())},${c}",
    _ => "",
  }]
  failed += check("where a prompt begins", starts.join(" "), "1,4")
  // The rows in use: to the cursor's, or below it to the last with anything on it.
  var used = run(10, 6, "a\r\nb")
  failed += check("rows in use, to the cursor", "${used.used_rows()}", "2")
  used.apply(p.feed("\e[5;1Hz\e[1;1H".encode_utf8()))
  failed += check("rows in use, to the last written", "${used.used_rows()}", "5")
  failed
}

// A shell with the integration, end to end: the prompt's mark arrives, a two-line command
// sent as the command line sends it runs as one, and its end reports the last line's
// status.
let check_shell = (shell: string) -> i64 => {
  let name = shell.base()
  let Some(i) = integration(shell, "vttest") else {
    return check("${name} integration", "not written", "written")
  }
  let env = ["TERM=xterm-256color", ...i.env]
  let Some(pty) = spawn(i.args, 60, 10, None, env) else {
    return check("spawn ${name}", "failed", "spawned")
  }
  var p = parser()
  var s = screen(60, 10)
  var seen: []string = []
  var sent = false
  var at_prompt = false
  var from = (-1, -1)
  var a_at = (-1, -1)
  var b_line = -1
  let deadline = wall_clock_nanos() + 20000000000
  var done = false
  while !done && wall_clock_nanos() < deadline {
    // The shell draws the prompt (and its mark) a moment before it turns bracketed paste on; a
    // person's Return comes long after both, and this waits for the second as they do.
    if at_prompt && !sent && s.bracketed_paste {
      let _ = pty.write(submission("echo one\necho two; false", s.bracketed_paste))
      sent = true
    }
    match pty.read() {
      None => { done = true },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
        for m in s.take_marks() {
          match m {
            // The prompt redrawn where the command was sent from (bash's readline, on a
            // paste of several lines) is not a new one, as a session has it.
            InputStart(at, col) => if !(sent && at == from.0 && col == from.1) {
              seen.push("B")
              if sent { done = true } else {
                at_prompt = true
                from = (at, col)
                b_line = at
              }
            },
            PromptStart(at, col) => if !at_prompt { a_at = (at, col) },
            OutputStart(_) => seen.push("C"),
            CommandEnd(status, _) => seen.push("D${status}"),
            _ => {},
          }
        }
      },
    }
  }
  close(pty)
  var output: []string = []
  for row in 0..<(s.scrollback_len() + s.rows) {
    let t = line_text(s.line(row)).trim()
    if t == "one" || t == "two" { output.push(t) }
  }
  var failed = check("${name} marks", seen.join(" "), "B C D1 B")
  // A is the start of PS1: the prompt's first line, from its first column.
  failed += check(
    "${name}: A where the prompt begins",
    "${a_at.1}|${a_at.0 <= b_line}",
    "0|true"
  )
  failed += check("${name} ran both lines", output.join(","), "one,two")
  failed
}

// bash's history file: its time lines are not commands, and a repeat in a row is kept once.
let check_bash_history = () -> i64 =>
  check(
    "bash history",
    parse_bash_history("#1700000000\nls\n#1700000001\nls\nmake test\n".encode_utf8()).join("|"),
    "ls|make test"
  )

// The shell word a completion replaces: quotes and escapes keep a word together.
let check_words = () -> i64 => {
  var failed = 0
  failed += check("plain word", word("ls lyra/bi", 10), "lyra/bi")
  failed += check("caret inside a word", word("cat foo.txt bar", 6), "foo.txt")
  failed += check("escaped space", word("cat a\\ b", 8), "a\\ b")
  failed += check("open quote", word("cat \"sp a", 9), "\"sp a")
  failed += check("after a pipe", word("ls | gr", 7), "gr")
  failed += check("empty word", word("ls ", 3), "")
  failed
}

let word = pure (text: string, at: i64) -> string => {
  let runes = text.to_runes()
  let (a, b) = shell_word_at(runes, at)
  text_of_runes(runes.slice(a, b))
}

let text_of_runes = pure (r: []rune) -> string => text(r)

// OSC 7770: a list begun, matches with percent-encoded fields, and its end.
let check_completion_reports = () -> i64 => {
  var p = parser()
  var s = screen(20, 2)
  s.apply(p.feed("\e]7770;b\x07\e]7770;m;$;HOME; ;HOME;\x07\e]7770;m;;a%3Bb%25; ;a%3Bb%25;semi%0Acolon\x07\e]7770;e\x07".encode_utf8()))
  let lists = s.take_completions()
  var failed = check("one list", "${lists.len()}", "1")
  if lists.len() == 1 {
    let l = lists[0]
    failed += check("two matches", "${l.len()}", "2")
    if l.len() == 2 {
      failed += check(
        "variable",
        "${l[0].prefix}|${l[0].insert}|${l[0].suffix}",
        "$|HOME| "
      )
      failed += check(
        "decoded",
        "${l[1].insert}|${l[1].shown}|${l[1].description}",
        "a;b%|a;b%|semi\ncolon"
      )
    }
  }
  failed
}

// OSC 7770 `c`: what the shell said of command words, and the answer's end.
let check_command_reports = () -> i64 => {
  var p = parser()
  var s = screen(20, 2)
  s.apply(p.feed("\e]7770;c;ls;1\x07\e]7770;c;a%3Bb;0\x07".encode_utf8()))
  let (first, ended_first) = s.take_commands()
  s.apply(p.feed("\e]7770;c\x07".encode_utf8()))
  let (second, ended) = s.take_commands()
  var failed = check(
    "commands: found and not, decoded",
    [a in first | "${a.0}=${a.1}"].join(","),
    "ls=true,a;b=false"
  )
  failed += check("commands: not ended before its c", "${ended_first}", "false")
  failed += check("commands: ended", "${second.len()} ${ended}", "0 true")
  failed
}

// Which commands the live shell can run, through the integration: one, a builtin, a keyword,
// an alias and a function the first command made, one that does not exist, a path to nothing.
let check_commands = (shell: string) -> i64 => {
  let name = shell.base()
  let Some(i) = integration(shell, "vttest-commands") else {
    return check("${name} integration", "not written", "written")
  }
  let Some(pty) = spawn(i.args, 80, 10, None, ["TERM=xterm-256color", ...i.env]) else {
    return check("spawn ${name}", "failed", "spawned")
  }
  var p = parser()
  var s = screen(80, 10)
  let asks = ["ls", "cd", "if", "termina_alias", "termina_fn", "termina_no_such", "./termina_nope"]
  var heard: []string = []
  var prompts = 0
  var defined = false
  var asked = false
  var ended = false
  var deadline = wall_clock_nanos() + 20000000000
  while !ended && wall_clock_nanos() < deadline {
    // At bracketed paste, as `check_completion` waits: the first prompt defines the alias and
    // the function, the second is asked.
    if prompts == 1 && s.bracketed_paste && !defined {
      let _ = pty.write(submission("alias termina_alias=true; termina_fn() { :; }", true))
      defined = true
    } else if prompts >= 2 && s.bracketed_paste && !asked {
      match commands_request(i, asks) {
        Some(key) => {
          let _ = pty.write(key)
        },
        None => {},
      }
      asked = true
    }
    match pty.read() {
      None => { deadline = 0 },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
        for m in s.take_marks() {
          match m {
            InputStart(_, _) => { prompts += 1 },
            _ => {},
          }
        }
        let (answers, done) = s.take_commands()
        for (w, found) in answers { heard.push("${w}=${if found { 1 } else { 0 }}") }
        if done { ended = true }
      },
    }
  }
  close(pty)
  let _ = remove_file(i.commands)
  check(
    "${name}: which commands exist",
    heard.join(" "),
    "ls=1 cd=1 if=1 termina_alias=1 termina_fn=1 termina_no_such=0 ./termina_nope=0"
  )
}

// The shell's own completions through the integration, in a directory of known files: zsh's
// and bash's give the same answers.
let check_completion = (shell: string) -> i64 => {
  let name = shell.base()
  let dir = (lookup("TMPDIR") ?? "/tmp").join("termina-vttest-${wall_clock_nanos()}")
  if !create_dir_all(dir.join("sub dir")) { return check(
    "scratch dir",
    "not made",
    "made"
  ) }
  let _ = write_file(dir.join("plain.txt"), "")
  let _ = write_file(dir.join("a b.txt"), "")
  let Some(i) = integration(shell, "vttest-complete") else {
    return check("${name} integration", "not written", "written")
  }
  let Some(pty) = spawn(
    i.args,
    80,
    10,
    Some(dir),
    ["TERM=xterm-256color", ...i.env]
  ) else {
    return check("spawn ${name}", "failed", "spawned")
  }
  var p = parser()
  var s = screen(80, 10)
  let asks = ["cat pl", "cd su", "cat a", "ech", "echo $HO", "cat \"a", "dd if=pl"]
  var answers: []string = []
  var asked = 0
  var at_prompt = false
  var deadline = wall_clock_nanos() + 20000000000
  while answers.len() < asks.len() && wall_clock_nanos() < deadline {
    // After bracketed paste, as `check_shell` waits: zsh turns it on once its zle-line-init
    // has read what was typed ahead, and a key sent at `B` alone, before that, would be read
    // as typed ahead rather than run (as CI's x86_64 runner did).
    if at_prompt && s.bracketed_paste && asked == answers.len() {
      let ask = asks[asked]
      match completion_request(i, ask, ask.len()) {
        Some(key) => {
          let _ = pty.write(key)
        },
        None => {},
      }
      asked += 1
    }
    match pty.read() {
      None => { deadline = 0 },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
        for m in s.take_marks() {
          match m {
            InputStart(_, _) => { at_prompt = true },
            _ => {},
          }
        }
        for l in s.take_completions() {
          answers.push([c in l | "${c.prefix}${c.insert}${c.suffix}"].join(","))
        }
      },
    }
  }
  close(pty)
  // What the check made, removed: the request file, the scratch directory's files.
  let _ = remove_file(i.request)
  let _ = remove_file(dir.join("plain.txt"))
  let _ = remove_file(dir.join("a b.txt"))
  var failed = check("${name}: asked them all", "${answers.len()}", "${asks.len()}")
  // What the shell showed, for a failure on a machine no one can look at (a CI runner).
  if answers.len() < asks.len() {
    println("  at a prompt: ${at_prompt}, asked: ${asked}; the screen:")
    for row in 0..<(s.scrollback_len() + s.rows) {
      let t = line_text(s.line(row)).trim()
      if t != "" { println("  | ${t}") }
    }
  }
  if answers.len() == asks.len() {
    failed += check("${name}: a file", answers[0], "plain.txt ")
    failed += check("${name}: a directory", answers[1], "sub\\ dir/")
    failed += check("${name}: a name with a space", answers[2], "a\\ b.txt ")
    failed += check("${name}: a command", "${answers[3].contains("echo ")}", "true")
    failed += check("${name}: a variable", "${answers[4].contains("$HOME ")}", "true")
    failed += check("${name}: inside quotes", answers[5], "\"a b.txt\" ")
    failed += check("${name}: a value after =", answers[6], "if=plain.txt ")
  }
  failed
}

// Keys typed while a command runs, unread by it, reach the next line's report and not
// zsh's hidden buffer.
let check_typed_ahead = (shell: string) -> i64 => {
  let name = shell.base()
  let Some(i) = integration(shell, "vttest-ahead") else {
    return check("${name} integration", "not written", "written")
  }
  let Some(pty) = spawn(i.args, 60, 10, None, ["TERM=xterm-256color", ...i.env]) else {
    return check("spawn ${name}", "failed", "spawned")
  }
  var p = parser()
  var s = screen(60, 10)
  var prompts = 0
  var sent = false
  var reports: []string = []
  var deadline = wall_clock_nanos() + 20000000000
  while prompts < 2 && wall_clock_nanos() < deadline {
    if prompts == 1 && !sent && s.bracketed_paste {
      // The command, then keys typed while it runs.
      let _ = pty.write(submission("sleep 1", true))
      let _ = pty.write("echo ahead\rech")
      sent = true
    }
    match pty.read() {
      None => { deadline = 0 },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
        for m in s.take_marks() {
          match m {
            InputStart(_, _) => { prompts += 1 },
            _ => {},
          }
        }
        for t in s.take_typed_ahead() { reports.push(t) }
      },
    }
  }
  // The report follows the second prompt's mark: read on for it.
  var more = 0
  while reports.len() == 0 && more < 2000000 {
    match pty.read() {
      None => { more = 2000000 },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
        for t in s.take_typed_ahead() { reports.push(t) }
        more += 1
      },
    }
  }
  close(pty)
  // Return arrives as \r or \n, by when it was typed (the terminal translates it only once
  // readline has given it back); both end a line for the command line.
  check(
    "${name}: typed ahead, reported",
    reports.join("|").replace("\r", "\n"),
    "echo ahead\nech"
  )
}

// vim, less and top (htop when there is one) on a pseudo-terminal: each drawn as it should
// be, on the alternate screen (but procps's top, Linux's, which draws on the main one), its
// questions answered — then quit, and the main screen back. vim is skipped where it is not
// installed (a minimal Ubuntu has only vi).
let check_full_screen = () -> i64 => {
  let dir = (lookup("TMPDIR") ?? "/tmp").join("termina-full-${wall_clock_nanos()}")
  if !create_dir_all(dir) { return check("scratch dir", "not made", "made") }
  let file = dir.join("words.txt")
  let _ = write_file(file, "alpha\nbeta\ngamma\n")
  var failed = 0
  if installed(["/usr/bin/vim", "/opt/homebrew/bin/vim"], "the vim checks") {
    failed += check_vim(dir, file)
  }
  failed += check_less_and_top(dir)
  let _ = remove_file(file)
  failed
}

let check_vim = (dir: string, file: string) -> i64 => {
  var failed = 0
  let (vim_seen, vim_after, vim_ended) = full_screen(
    ["vim", "-u", "NONE", "-N", "-i", "NONE", file],
    dir,
    (s) => s.alt && screen_row(s, 0) == "alpha",
    (s) => "${screen_row(s, 0)}|${screen_row(s, 1)}|${screen_row(s, 2)}|${screen_row(s, 3)}|${s.cursor_keys}",
    ":q!\r"
  )
  failed += check(
    "vim draws the file, and a ~ past its end",
    vim_seen,
    "alpha|beta|gamma|~|true"
  )
  failed += check(
    "vim quits back to the main screen",
    "${vim_ended} ${vim_after.alt}",
    "true false"
  )
  failed
}

let check_less_and_top = (dir: string) -> i64 => {
  var failed = 0
  let (less_seen, less_after, less_ended) = full_screen(
    // In the file's directory, so its status line is short: a status exactly as wide as the
    // screen, then `\e[K` at the pending wrap, loses its last character here as in xterm.
    ["less", "words.txt"],
    dir,
    // A file shorter than the screen is drawn above less's status line, wherever that is:
    // less 668 moves to the last row and lets the lines scroll up, less 590 (Ubuntu
    // 24.04's, macOS 15's) draws from the top with `(END)` just below.
    (s) => s.alt && end_row(s) >= 3,
    (s) => {
      let e = end_row(s)
      "${screen_row(s, e - 3)}|${screen_row(s, e - 2)}|${screen_row(s, e - 1)}"
    },
    "q"
  )
  failed += check("less draws the file above (END)", less_seen, "alpha|beta|gamma")
  failed += check(
    "less quits back to the main screen",
    "${less_ended} ${less_after.alt}",
    "true false"
  )

  let top = if is_executable("/usr/bin/htop") || is_executable("/opt/homebrew/bin/htop") { "htop" } else { "top" }
  let (top_seen, top_after, top_ended) = full_screen(
    [top],
    dir,
    (s) => drawn_rows(s) >= 5,
    (s) => "${drawn_rows(s) >= 5}",
    "q"
  )
  failed += check("${top} fills its screen", top_seen, "true")
  failed += check(
    "${top} quits back to the main screen",
    "${top_ended} ${top_after.alt}",
    "true false"
  )
  failed
}

/// `args` run in `dir` on a 60 × 12 pseudo-terminal until `ready` says its screen is drawn, `look`
/// read off the screen then, and `quit` typed; its questions answered throughout, as a tab
/// answers them. The look, the screen at the end, and whether the program ended — within
/// ten seconds for each half.
let full_screen = (
  args: []string,
  dir: string,
  ready: (Screen) -> bool,
  look: (Screen) -> string,
  quit: string
) -> (string, Screen, bool) => {
  var s = screen(60, 12)
  let Some(pty) = spawn(args, 60, 12, Some(dir), ["TERM=xterm-256color", "LESS="]) else {
    return ("could not start", s, false)
  }
  var p = parser()
  var seen = "never ready"
  var ended = false
  var quitting = false
  var deadline = wall_clock_nanos() + 10000000000
  while !ended && wall_clock_nanos() < deadline {
    match pty.read() {
      None => { ended = true },
      Some(bytes) => {
        if bytes.len() > 0 { s.apply(p.feed(bytes)) }
        for reply in s.take_replies() {
          let _ = pty.write(reply)
        }
        if !quitting && ready(s) {
          seen = look(s)
          let _ = pty.write(quit)
          quitting = true
          deadline = wall_clock_nanos() + 10000000000
        }
      },
    }
  }
  close(pty)
  // What was on the screen instead, for the failure to say.
  if !quitting {
    seen = "never ready; the screen: ${[y in 0..<s.rows | screen_row(s, y)].join("|")}"
  }
  (seen, s, ended)
}

/// The screen's row ending in less's `(END)`, or -1.
let end_row = pure (s: Screen) -> i64 => {
  for y in 0..<s.rows { if screen_row(s, y).ends_with("(END)") { return y } }
  -1
}

/// Row `y` of the screen (not the scrollback), its trailing blanks off.
let screen_row = pure (s: Screen, y: i64) -> string =>
  line_text(s.line(s.scrollback_len() + y)).trim_end()

/// How many of the screen's rows have something on them.
let drawn_rows = pure (s: Screen) -> i64 =>
  [y in 0..<s.rows | screen_row(s, y) != "" | 1].len()

let describe_marks = (s: mut Screen) -> string => [m in s.take_marks() | match m {
  PromptStart(_, _) => "A",
  InputStart(line, col) => "B(${line},${col})",
  OutputStart(_) => "C",
  CommandEnd(status, _) => "D(${status})",
  Cleared(_) => "cleared",
}].join(" ")

// ── The window's logic, needing no window ───────────────────────────────────

// Alt as Meta, and bold as bright.
let check_meta_and_bright = () -> i64 => {
  var failed = 0
  failed += check("meta", meta("bf").replace("\e", "^"), "^b^f")
  let off = dark_theme()
  let on = Theme { off | bold_is_bright: true }
  let bold_red = Cell { ch: 'x', fg: indexed(1), bg: DEFAULT, attrs: BOLD }
  failed += check("bold red, as asked", hex(off.colors(bold_red).0), hex(off.palette[1]))
  failed += check("bold red, bright", hex(on.colors(bold_red).0), hex(off.palette[9]))
  let bold_208 = Cell { ch: 'x', fg: indexed(208), bg: DEFAULT, attrs: BOLD }
  failed += check(
    "past the first eight, as asked",
    hex(on.colors(bold_208).0),
    hex(off.palette[208])
  )
  let plain_red = Cell { ch: 'x', fg: indexed(1), bg: DEFAULT, attrs: 0 }
  failed += check("not bold, as asked", hex(on.colors(plain_red).0), hex(off.palette[1]))
  failed
}

// The mouse as a program that asked is told of it.
let check_mouse_reports = () -> i64 => {
  var failed = 0
  failed += check(
    "SGR press",
    shown_bytes(mouse_report(0, 4, 9, true, true)),
    "\\e[<0;5;10M"
  )
  failed += check(
    "SGR release",
    shown_bytes(mouse_report(2, 0, 0, false, true)),
    "\\e[<2;1;1m"
  )
  failed += check(
    "SGR wheel down, ctrl",
    shown_bytes(mouse_report(65 + 16, 1, 1, true, true)),
    "\\e[<81;2;2M"
  )
  failed += check(
    "SGR drag",
    shown_bytes(mouse_report(32, 300, 1, true, true)),
    "\\e[<32;301;2M"
  )
  failed += check(
    "X10 press",
    shown_bytes(mouse_report(0, 4, 9, true, false)),
    "\\e[M 32 37 42"
  )
  failed += check(
    "X10 release is button 3",
    shown_bytes(mouse_report(2, 0, 0, false, false)),
    "\\e[M 35 33 33"
  )
  failed += check(
    "X10 stops at 223",
    shown_bytes(mouse_report(0, 400, 0, true, false)),
    "\\e[M 32 255 33"
  )
  failed += check("wheel up as arrows", wheel_keys(1, false), "\e[A\e[A\e[A")
  failed += check("wheel down, cursor keys", wheel_keys(-1, true), "\eOB\eOB\eOB")
  failed
}

/// Bytes as text: an ESC as `\e`, the printable rest as itself, other bytes after `[M` by
/// their numbers (X10's place bytes).
let shown_bytes = pure (bytes: []u8) -> string => {
  if bytes.len() == 6 && bytes[2] == 0x4D {
    return "\\e[M ${bytes[3]} ${bytes[4]} ${bytes[5]}"
  }
  bytes.decode_utf8().replace("\e", "\\e")
}

// Real tabs: a tab named by its program's title, then by its directory, and one whose
// program ends found ended.
/// `m` rendered as its value or `none`.
let fold_str = pure (m: Maybe<bool>) -> string => match m {
  Some(f) => "${f}",
  None => "none",
}

let check_sessions = () -> i64 => {
  var failed = 0
  let Some(titled) = open_session(
    ["/bin/sh", "-c", "printf '\\033]0;builds\\007'; sleep 2"],
    None,
    1
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var a = titled
  failed += check("a program's name first", tab_title(a, "/home/me"), "sh")
  for _ in 0..<2000000 { if a.shown.title == "" { a.step(true) } }
  failed += check("its title once set", tab_title(a, "/home/me"), "builds")
  close_session(a)
  let Some(placed) = open_session(
    ["/bin/sh", "-c", "printf '\\033]7;file://host/Users/me/dev%%20box\\007'; sleep 2"],
    None,
    2
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var b = placed
  for _ in 0..<2000000 { if b.shown.cwd == "" { b.step(false) } }
  failed += check("named by its directory", tab_title(b, "/Users/me"), "dev box")
  failed += check(
    "a tab beside it starts there",
    "${directory(b) ?? "none"}",
    "/Users/me/dev box"
  )
  failed += check("output unseen while hidden", "${b.unseen}", "true")
  b.step(true)
  failed += check("seen once shown", "${b.unseen}", "false")
  close_session(b)
  // A command's block, from a shell's marks: its prompt's line, where its output began and
  // ended, its status. A screen erased whole takes the blocks on it.
  let marks = "printf '\\033]133;A\\007$ \\033]133;B\\007ls\\r\\n\\033]133;C\\007out\\r\\n\\033]133;D;2\\007\\033]133;A\\007$ \\033]133;B\\007'"
  let Some(blocked) = open_session(["/bin/sh", "-c", "${marks}; sleep 2"], None, 5) else {
    return check("open a tab", "failed", "opened")
  }
  var e = blocked
  for _ in 0..<2000000 { if e.blocks.len() == 0 { e.step(true) } }
  failed += check(
    "a command's block",
    [x in e.blocks | "${x.prompt}-${x.output}-${x.end} ${x.status}"].join(","),
    "0-1-2 2"
  )
  // A right click on the block's input copies the command, past the prompt; on its output,
  // the output; off the block, nothing.
  failed += check("a block's command", "${e.block_copy_at(0) ?? "none"}", "ls")
  failed += check("a block's output", "${e.block_copy_at(1) ?? "none"}", "out")
  failed += check("off a block", "${e.block_copy_at(2) ?? "none"}", "none")
  // Selecting the block whole takes the command (past the prompt) and the output.
  failed += check("a block selected whole", "${e.select_block_at(1)} ${e.selected_text()}", "true ls\nout")
  // A one-line output is not foldable; the fold stays off.
  failed += check("a line's output not foldable", "${fold_str(e.fold_at(1))}", "none")
  failed += check("fold refused on a line", "${e.toggle_fold_at(1)}", "false")
  // Its room, a row 20 points high: above its input the margin and padding (16), between
  // input and output the padding of each (12), below the output padding (6).
  let laid = block_rows_layout(e, 0.0, 0, 20.0, 3)
  failed += check(
    "a block's rows",
    "${laid.y_of(0)} ${laid.y_of(1)} ${laid.y_of(2)} ${laid.line_at_y(50.0, 3)}",
    "16 48 74 1"
  )
  // Laying out the rows, a running block among them, leaves the session's blocks as they
  // were — a frame's layout once added the running block to them, a block a frame.
  var busy = Session {
    e |
    running_block: Some(Block {
      prompt: 2,
      cmd_line: 2,
      cmd_col: 0,
      output: 3,
      end: -1,
      status: -1,
      started: 0,
      ended: 0,
    }),
  }
  for _ in 0..<3 { let _ = block_rows_layout(busy, 0.0, 0, 20.0, 4) }
  failed += check("layout leaves the blocks be", "${busy.blocks.len()}", "1")
  close_session(e)
  // Two more of the marks' cases: a command of two lines and an output of two lines — each
  // copied whole, the prompt's `$` out of the command's.
  let long_marks = "printf '\\033]133;A\\007$ \\033]133;B\\007echo a b\\r\\nc d\\r\\n\\033]133;C\\007one\\r\\ntwo\\r\\n\\033]133;D;0\\007'"
  let Some(longed) = open_session(["/bin/sh", "-c", "${long_marks}; sleep 2"], None, 8) else {
    return check("open a tab", "failed", "opened")
  }
  var m = longed
  for _ in 0..<2000000 { if m.blocks.len() == 0 { m.step(true) } }
  failed += check(
    "a block's command, wrapped",
    "${m.block_copy_at(0) ?? "none"}",
    "echo a b\nc d"
  )
  failed += check(
    "a block's output, two lines",
    "${m.block_copy_at(2) ?? "none"}",
    "one\ntwo"
  )
  failed += check("its output's last line", "${m.block_copy_at(3) ?? "none"}", "one\ntwo")
  // Folding: the output's lines past the first are hidden, and their room leaves the layout.
  let laid_open = block_rows_layout(m, 0.0, 0, 20.0, 5)
  failed += check(
    "unfolded rows",
    "${laid_open.y_of(4)} ${laid_open.is_hidden(3)}",
    "114 false"
  )
  failed += check("a foldable block folds", "${m.toggle_fold_at(3)}", "true")
  failed += check("its fold state", "${fold_str(m.fold_at(0))}", "true")
  let laid_folded = block_rows_layout(m, 0.0, 0, 20.0, 5)
  failed += check(
    "a folded block's rows",
    "${laid_folded.y_of(0)} ${laid_folded.y_of(2)} ${laid_folded.y_of(4)} ${laid_folded.line_at_y(78.0, 5)}",
    "16 68 94 2"
  )
  failed += check("a folded line hidden", "${laid_folded.is_hidden(3)}", "true")
  failed += check("a kept line shown", "${laid_folded.is_hidden(2)}", "false")
  // Whole-block selection is unaffected by the fold: it reads the screen, not the layout.
  failed += check(
    "a folded block, selected whole",
    "${m.select_block_at(2)} ${m.selected_text()}",
    "true echo a b\nc d\none\ntwo"
  )
  failed += check("a fold un-folds", "${m.toggle_fold_at(3)}", "true")
  failed += check("its fold state after un-fold", "${fold_str(m.fold_at(3))}", "false")
  close_session(m)
  // A block still running: its command whole, its output so far.
  let Some(working) = open_session(
    [
      "/bin/sh",
      "-c",
      "printf '\\033]133;A\\007$ \\033]133;B\\007long\\r\\n\\033]133;C\\007working\\r\\n'; sleep 2",
    ],
    None,
    9
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var r = working
  for _ in 0..<4000000 {
    if r.running_block.is_some() && r.shown.used_rows() >= 3 { break }
    r.step(true)
  }
  failed += check("a running block's command", "${r.block_copy_at(0) ?? "none"}", "long")
  failed += check("a running block's output", "${r.block_copy_at(1) ?? "none"}", "working")
  // A running block is selected whole through its output so far, but is not foldable.
  failed += check(
    "a running block, selected whole",
    "${r.select_block_at(1)} ${r.selected_text().trim()}",
    "true long\nworking"
  )
  failed += check("a running block not foldable", "${fold_str(r.fold_at(1))}", "none")
  failed += check("fold refused while running", "${r.toggle_fold_at(1)}", "false")
  close_session(r)
  let Some(cleared) = open_session(
    ["/bin/sh", "-c", "${marks}; sleep 0.3; printf '\\033[2J'; sleep 2"],
    None,
    6
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var f = cleared
  var seen_block = false
  for _ in 0..<4000000 {
    if f.blocks.len() > 0 { seen_block = true }
    if !(seen_block && f.blocks.len() == 0) { f.step(true) }
  }
  failed += check(
    "erased whole, its blocks go",
    "${seen_block}|${f.blocks.len()}",
    "true|0"
  )
  close_session(f)
  let Some(brief) = open_session(["/bin/sh", "-c", "exit 0"], None, 3) else {
    return check("open a tab", "failed", "opened")
  }
  // A tab the user closes stays closed, though its program is still running.
  let Some(running) = open_session(["/bin/sh", "-c", "sleep 5"], None, 4) else {
    return check("open a tab", "failed", "opened")
  }
  var d = running
  d.step(true)
  d.request_close()
  for _ in 0..<1000 { d.step(true) }
  failed += check("a closed tab stays closed", "${d.alive}", "false")
  close_session(d)
  // A tab's grid: Select All takes everything, and Copy is then there to choose.
  let Some(printing) = open_session(
    ["/bin/sh", "-c", "printf 'first\\nsecond\\n'; sleep 5"],
    None,
    5
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var e = printing
  // Read until the second line has arrived.
  for _ in 0..<2000000 { if e.shown.line(1)[0].ch != 's' { e.step(true) } }
  failed += check(
    "nothing selected yet",
    "${e.has_selection()} ${e.can(Copy)}",
    "false false"
  )
  let _ = e.edit_action(SelectAll)
  failed += check("select all", e.selected_text().trim(), "first\nsecond")
  failed += check("copy then", "${e.can(Copy)} ${e.can(SelectAll)}", "true true")
  close_session(e)
  var c = brief
  for _ in 0..<2000000 { if c.alive { c.step(true) } }
  failed += check("a tab whose program ended", "${c.alive}", "false")
  close_session(c)
  // A program that ends without its shell's `D` mark: the block it left open ends with the
  // program's status, once the program can be reaped.
  let Some(dead) = open_session(
    ["/bin/sh", "-c", "printf '\\033]133;A\\007$ \\033]133;B\\007x\\r\\n\\033]133;C\\007out\\n'; exit 3"],
    None,
    7
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var g = dead
  for _ in 0..<4000000 {
    if !g.alive && g.blocks.len() > 0 { break }
    g.step(true)
  }
  failed += check("the program's status", "${g.exit ?? -1}", "3")
  failed += check(
    "the block left open ends with it",
    "${g.blocks.len()}|${g.blocks[0].status}",
    "1|3"
  )
  close_session(g)
  failed
}

// Keys typed ahead: raw keys made into lines, and the lines handed to prompts in turn.
let check_typeahead_lines = () -> i64 => {
  var failed = 0
  failed += check("text and backspace", typed_lines("git statx\x7fus"), "git status")
  failed += check("an arrow is dropped", typed_lines("ab\e[Dc"), "abc")
  failed += check("return ends a line", typed_lines("make\nls -l"), "make\nls -l")
  failed += check("carriage return too", typed_lines("make\rls"), "make\nls")
  failed += check("ctrl-u clears the line", typed_lines("oops\x15ls"), "ls")
  failed += check(
    "ctrl-w takes a word",
    typed_lines("git push --force\x17--dry-run"),
    "git push --dry-run"
  )
  failed += check("non-ASCII", typed_lines("echo größe"), "echo größe")
  failed += check("backspace on nothing", typed_lines("\x7f\x7fx"), "x")

  var line = command_line([])
  line.typed_ahead("make\nls -l\ngit st")
  let one = line.take_typed_ahead() ?? "none"
  let two = line.take_typed_ahead() ?? "none"
  let three = line.take_typed_ahead() ?? "none"
  failed += check("commands in turn", "${one}|${two}|${three}", "make|ls -l|none")
  failed += check("then the rest in the editor", line.edit.content(), "git st")
  failed += check("and nothing after", "${line.take_typed_ahead() ?? "none"}", "none")
  line.typed_ahead("us")
  let _ = line.take_typed_ahead()
  failed += check("more joins at the caret", line.edit.content(), "git stus")
  failed
}

// The theme: what a cell's recorded colors look like.
let check_theme = () -> i64 => {
  let t = dark_theme()
  var failed = 0
  failed += check("256 entries", "${t.palette.len()}", "256")
  // The cube's corner and the greys' first step, as xterm has them.
  failed += check("cube white", hex(t.palette[231]), hex(abgr(0xFFFFFF)))
  failed += check("cube 0,95,135", hex(t.palette[16 + 1 * 6 + 2]), hex(abgr(0x005F87)))
  failed += check("first grey", hex(t.palette[232]), hex(abgr(0x080808)))
  failed += check("24-bit", hex(t.color(rgb(1, 2, 3), 0)), hex(abgr(0x010203)))
  let (fg, bg) = t.colors(Cell { ch: 'x', fg: DEFAULT, bg: DEFAULT, attrs: 0 })
  failed += check("plain", "${hex(fg)} ${bg == None}", "${hex(t.fg)} true")
  let (ifg, ibg) = t.colors(Cell { ch: 'x', fg: DEFAULT, bg: DEFAULT, attrs: INVERSE })
  failed += check(
    "inverse of the defaults",
    "${hex(ifg)} ${hex(ibg ?? 0)}",
    "${hex(t.bg)} ${hex(t.fg)}"
  )
  let (
    rfg,
    rbg
  ) = t.colors(Cell { ch: 'x', fg: indexed(1), bg: indexed(4), attrs: INVERSE })
  failed += check(
    "inverse of colors",
    "${hex(rfg)} ${hex(rbg ?? 0)}",
    "${hex(t.palette[4])} ${hex(t.palette[1])}"
  )
  let (
    hfg,
    _
  ) = t.colors(Cell { ch: 'x', fg: indexed(1), bg: indexed(4), attrs: HIDDEN })
  failed += check("hidden is the background", hex(hfg), hex(t.palette[4]))
  let (dfg, _) = t.colors(Cell { ch: 'x', fg: DEFAULT, bg: DEFAULT, attrs: DIM })
  failed += check("dim is nearer the background", "${hex(dfg) != hex(t.fg)}", "true")
  failed
}

let hex = pure (c: u32) -> string => "${c}"

// The window's place in the settings file (Settings ▸ Window): written and read back whole; a
// place the system never said (Wayland) left out and read as none; a size no window could be,
// or none, read as no place; and the option off kept.
let check_window_place = () -> i64 => {
  var failed = 0
  let placed = Settings { defaults() | window: Some(WindowPlace {
    x: 120.0,
    y: -40.0,
    placed: true,
    width: 960.0,
    height: 600.0,
    maximized: true
  }) }
  failed += check(
    "window place: kept whole",
    describe_place(settings_from_json(settings_to_json(placed))),
    "on 120,-40 960×600 maximized"
  )
  let unplaced = Settings { defaults() | window: Some(WindowPlace {
    width: 800.0,
    height: 500.0
  }) }
  failed += check(
    "window place: a size alone",
    describe_place(settings_from_json(settings_to_json(unplaced))),
    "on nowhere 800×500"
  )
  failed += check(
    "window place: a size no window could be",
    describe_place(settings_from_json("{\"window\": {\"x\": 1, \"y\": 2, \"width\": 5, \"height\": 600}}")),
    "on none"
  )
  failed += check(
    "window place: none written",
    describe_place(settings_from_json("{}")),
    "on none"
  )
  let off = Settings { defaults() | remember_window: false }
  failed += check(
    "window place: the option off",
    describe_place(settings_from_json(settings_to_json(off))),
    "off none"
  )
  failed
}

// A colour's alpha (Settings ▸ Colors, a background swatch's opacity): `#rrggbbaa` read as how
// transparent it is in the top byte and written back so, an opaque one as `#rrggbb`; a theme's
// alpha from it; only the backgrounds' kept, from a file or a swatch; the sections made from
// a translucent background opaque; and each background's blur kept, within its range.
let check_color_alpha = () -> i64 => {
  var failed = 0
  let half = color_of("#1b1d2280") ?? 0
  failed += check("color alpha: read", half.to_hex(8), "7f1b1d22")
  failed += check("color alpha: written", hex_of(half), "#1b1d2280")
  failed += check(
    "color alpha: opaque written short",
    hex_of(color_of("#1b1d22ff") ?? 0),
    "#1b1d22"
  )
  failed += check("color alpha: a theme's", abgr(half).to_hex(8), "80221d1b")
  failed += check(
    "color alpha: an opaque theme colour",
    abgr(0x1b1d22).to_hex(8),
    "ff221d1b"
  )
  // Only the backgrounds — the window's and the sections' — may be translucent: the file's
  // other #rrggbbaa read opaque.
  let read = settings_from_json("{\"theme\": \"Custom\", \"colors\": {\"background\": \"#1b1d2280\", \"input\": \"#3a4a6080\", \"output\": \"#2a2e36c0\", \"foreground\": \"#e6e6e680\"}}")
  failed += check(
    "color alpha: the backgrounds' kept, the text's dropped",
    "${hex_of(read.colors.bg)} ${hex_of(read.colors.input)} ${hex_of(read.colors.output)} ${hex_of(read.colors.fg)}",
    "#1b1d2280 #3a4a6080 #2a2e36c0 #e6e6e6"
  )
  let picked = with_color(with_color(read.colors, "output", half), "tab", half)
  failed += check(
    "color alpha: a section's swatch keeps it, a tab's does not",
    "${hex_of(picked.output)} ${hex_of(picked.tab)}",
    "#1b1d2280 #1b1d22"
  )
  // Each background's blur by its color's field, written and read, within its range.
  var blurred = defaults()
  with_blur(blurred, "bg", 8.4)
  with_blur(blurred, "input", 12.0)
  with_blur(blurred, "output", 500.0)
  with_blur(blurred, "tab", 30.0)
  let back = settings_from_json(settings_to_json(blurred))
  failed += check(
    "blurs: set by field, whole points, within the range, written and read",
    "${blur_named(back, "bg")} ${blur_named(back, "input")} ${blur_named(back, "output")} ${blur_named(back, "tab")}",
    "8 12 64 0"
  )
  // The tab bar's underline: its color one of the theme's, opaque, and its thickness.
  var ruled = defaults()
  ruled.colors = with_color(ruled.colors, "tab_rule", half)
  ruled.tab_rule_width = 3.0
  let ruled_back = settings_from_json(settings_to_json(ruled))
  failed += check(
    "tab rule: its color, opaque, and thickness written and read",
    "${hex_of(ruled_back.colors.tab_rule)} ${ruled_back.tab_rule_width}",
    "#1b1d22 3"
  )
  failed += check(
    "tab rule: 1 where a file has none, kept within its range",
    "${settings_from_json("{}").tab_rule_width} ${settings_from_json("{\"tab_rule_width\": 40}").tab_rule_width}",
    "1 6"
  )
  let fresh = settings_from_json("{}")
  failed += check(
    "blurs: the sections' 16 where a file has none",
    "${fresh.input_blur} ${fresh.output_blur}",
    "16 16"
  )
  let (input, output) = sections_of(half)
  failed += check(
    "color alpha: the sections opaque on a translucent background",
    "${(input >> 24).to_hex(2)} ${(output >> 24).to_hex(2)}",
    "00 00"
  )
  failed += check(
    "color alpha: none of 7 digits",
    "${color_of("#1b1d228") == None}",
    "true"
  )
  failed
}

// A saved theme edited by hand: the colors Custom, the theme they came from kept for Save
// (`edited_from`) through another change, and Save putting the colors over it — still one
// theme of that name, and the current one again. One of Termina's own themes edited has no
// Save; the file keeps where an edit came from, and drops it where that theme is gone.
let check_saved_themes = () -> i64 => {
  var failed = 0
  var s = defaults()
  save_theme(s, "Mine")
  s.colors = with_color(s.colors, "fg", 0x112233)
  edit_colors(s)
  failed += check(
    "saved theme: an edit",
    "${s.theme_name} ${s.edited_from} ${can_save(s)}",
    "Custom Mine true"
  )
  s.colors = with_color(s.colors, "cursor", 0x445566)
  edit_colors(s)
  failed += check(
    "saved theme: a second edit",
    "${s.edited_from} ${can_save(s)}",
    "Mine true"
  )
  let reread = settings_from_json(settings_to_json(s))
  failed += check(
    "saved theme: the edit's source kept in the file",
    reread.edited_from,
    "Mine"
  )
  save_theme(s, s.edited_from)
  let colors = saved_colors(s.themes, "Mine") ?? defaults().colors
  failed += check(
    "saved theme: Save overwrites it",
    "${s.themes.len()} ${s.theme_name} ${s.edited_from == ""} ${hex_of(colors.fg)} ${hex_of(colors.cursor)}",
    "1 Mine true #112233 #445566"
  )
  var own = defaults()
  edit_colors(own)
  failed += check(
    "saved theme: none to Save from Termina's own",
    "${own.edited_from == ""} ${can_save(own)}",
    "true false"
  )
  s.colors = with_color(s.colors, "fg", 0x778899)
  edit_colors(s)
  delete_theme(s, "Mine")
  failed += check(
    "saved theme: deleted, nothing to Save",
    "${s.edited_from == ""} ${can_save(s)}",
    "true false"
  )
  let stale = settings_from_json("{\"theme\": \"Custom\", \"edited_from\": \"Gone\"}")
  failed += check(
    "saved theme: a source no longer saved dropped",
    "${stale.edited_from == ""}",
    "true"
  )
  failed
}

// The backgrounds' fills (settings/backing.lyra): each kind written and read back; a gradient
// kept to 2 to 8 stops, each place within 0 to 1; switching kinds keeping a fill of the kind
// and starting a gradient from the color; and an image with no file read back as the color
// alone.
let check_fills = () -> i64 => {
  var failed = 0
  let stops = [i in 0..<10 | BackingStop { color: 0x102030, at: f32(i) / 5.0 }]
  let kept = settled_gradient(BackingGradient {
    radial: true,
    circle: true,
    stops: stops
  })
  failed += check(
    "fills: a gradient's stops kept to 8, each place within 0 to 1",
    "${kept.stops.len()} ${kept.stops[7].at}",
    "8 1"
  )
  failed += check(
    "fills: a gradient of one stop given a second",
    "${settled_gradient(BackingGradient { stops: [stops[0]] }).stops.len()}",
    "2"
  )
  var s = defaults()
  s.colors = with_backing(s.colors, "bg", GradientBacking(kept))
  s.colors = with_backing(
    s.colors,
    "output",
    ImageBacking(BackingImage { path: "/tmp/a.png", fit: StretchImage })
  )
  let back = settings_from_json(settings_to_json(s))
  failed += check(
    "fills: a gradient and an image written and read back",
    "${describe_fill(back.colors.bg_fill)} | ${describe_fill(back.colors.output_fill)} | ${describe_fill(back.colors.input_fill)}",
    "radial circle 8 stops | image a.png stretch | color"
  )
  let unchosen = with_backing(
    defaults().colors,
    "input",
    ImageBacking(BackingImage { path: "" })
  )
  let none = settings_from_json(settings_to_json(Settings { defaults() | colors: unchosen }))
  failed += check(
    "fills: an image not chosen read back as the color",
    describe_fill(none.colors.input_fill),
    "color"
  )
  let switched = with_backing_kind(defaults().colors, "input", 1)
  failed += check(
    "fills: a gradient begun from the color, kept when chosen again",
    "${describe_fill(switched.input_fill)} ${backing_kind(with_backing_kind(switched, "input", 1).input_fill)}",
    "linear 180 2 stops 1"
  )
  failed
}

/// A fill as a check compares it.
let describe_fill = pure (b: Backing) -> string => match b {
  PlainBacking => "color",
  GradientBacking(g) =>
    if g.radial { "radial${if g.circle { " circle" } else { "" }} ${g.stops.len()} stops" } else {
      "linear ${g.angle.round()} ${g.stops.len()} stops"
    },
  ImageBacking(i) => "image ${i.path.base()} ${fit_name(i.fit)}",
}

/// The option and the place, as a check compares them.
let describe_place = pure (s: Settings) -> string => {
  let option = if s.remember_window { "on" } else { "off" }
  match s.window {
    Some(w) => "${option} ${if w.placed { "${w.x},${w.y}" } else { "nowhere" }} ${w.width}×${w.height}${if w.maximized { " maximized" } else { "" }}",
    None => "${option} none",
  }
}

// The desktop entry an AppImage installs: the id the window goes by in its file name, its
// icon and its class; the AppImage's path in `Exec`, quoted as the Desktop Entry
// Specification has it, and plain in `TryExec`.
let check_desktop_entry = () -> i64 => {
  var failed = 0
  let entry = desktop_entry("/home/me/Apps/Termina.AppImage")
  failed += check(
    "the entry's keys",
    [l in entry.lines() | l.starts_with("Exec=") || l.starts_with("TryExec=") || l.starts_with("Icon=") || l.starts_with("StartupWMClass=") | l].join("|"),
    "Exec=\"/home/me/Apps/Termina.AppImage\"|TryExec=/home/me/Apps/Termina.AppImage|Icon=${APP_ID}|StartupWMClass=${APP_ID}"
  )
  failed += check(
    "a path quoted for Exec",
    exec_quoted("/a b/\"q\" $x `y` \\z"),
    "\"/a b/\\\\\"q\\\\\" \\\\$x \\\\`y\\\\` \\\\\\\\z\""
  )
  failed
}

let check = (name: string, got: string, want: string) -> i64 => {
  if got == want { 0 } else {
    println("FAIL ${name}: got «${got}», want «${want}»")
    1
  }
}

let feed_all = pure (pieces: []string) -> []Action =>
  feed_bytes([p in pieces | p.encode_utf8()])

let feed_bytes = pure (pieces: [][]u8) -> []Action => {
  var p = parser()
  var out: []Action = []
  for piece in pieces {
    for a in p.feed(piece) { out.push(a) }
  }
  out
}

let run = pure (cols: i64, rows: i64, input: string) -> Screen => {
  var p = parser()
  var s = screen(cols, rows)
  s.apply(p.feed(input.encode_utf8()))
  s
}

let rows = pure (s: Screen) -> string =>
  [y in 0..<s.rows | line_text(s.line(s.scrollback_len() + y))].join("|")

/// A screen line's text.
let line_text = pure (line: []Cell) -> string => text(runes_of(line))

let text = pure (line: []rune) -> string => [r in line | "${r}"].join("")

let describe = pure (actions: []Action) -> string =>
  [a in actions | describe_one(a)].join(" ")

let describe_one = pure (a: Action) -> string => match a {
  Print(t) => "P(${text(t)})",
  Execute(c) => "X${c}",
  Csi(seq) => "C(${seq.marker};${[n in seq.params | "${n}"].join(",")};${seq.intermediates}${seq.final})",
  Esc(seq) => "E(${seq.intermediates};${seq.final})",
  Osc(t) => "O(${t})",
}

let subs = pure (actions: []Action) -> string => match actions[0] {
  Csi(seq) => [s in seq.sub | if s { "T" } else { "F" }].join(""),
  _ => "not a CSI",
}
