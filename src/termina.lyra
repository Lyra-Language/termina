// termina — a terminal: the user's shell on a pseudo-terminal, its output drawn in a window
// and the keyboard sent back to it.
//
//   build/termina              the login shell ($SHELL, else /bin/sh), in the home directory
//   build/termina CMD [ARG…]   that program instead, in this directory (as `xterm -e`)
//
// A classic terminal, in color, in tabs, whose command line is an editor of its own while
// zsh is at a prompt (its integration says when — shell/shell.lyra; the keys are in
// ui/command_line.lyra). Each tab is a session (session/session.lyra); a tab closes when
// its program ends, and the window with its last. ⌘V (Ctrl+Shift+V off macOS) pastes; the
// wheel scrolls back.
//
// Tabs, on a Mac: ⌘T opens one (in the shown tab's directory), ⌘W closes the shown one,
// ⌘1–⌘8 show that one and ⌘9 the last, ⌘⇧[ and ⌘⇧] the one before and after. Elsewhere
// Ctrl+Shift+T and Ctrl+Shift+W, Alt+1–9, Ctrl+PageUp and Ctrl+PageDown.

import std.env.{ lookup }
import bindings.imgui.{
  HOST_CUSTOM_TITLE_BAR,
  has_custom_title_bar,
  request_quit,
  minimize,
  toggle_maximized,
  is_maximized,
  create_host,
  begin_frame,
  end_frame,
  destroy_host,
  set_redraw,
  set_window_title,
  font_file,
  merge_font_file,
  set_font_hinting,
  push_font_float,
  pop_font,
  begin,
  end,
  begin_child,
  end_child,
  get_main_viewport,
  set_next_window_pos,
  set_next_window_size,
  get_io,
  push_style_var_vec2,
  pop_style_var,
  calc_text_size,
  get_font_size,
  is_window_focused,
  Vec2,
  Host,
  Font,
  WINDOW_FLAGS_NO_DECORATION,
  WINDOW_FLAGS_NO_NAV_INPUTS,
  WINDOW_FLAGS_NO_BACKGROUND,
  WINDOW_FLAGS_NO_SAVED_SETTINGS,
  WINDOW_FLAGS_NO_SCROLLBAR,
  WINDOW_FLAGS_NO_SCROLL_WITH_MOUSE,
  WINDOW_FLAGS_NO_BRING_TO_FRONT_ON_FOCUS,
  is_mouse_down,
  show_open_dialog,
  poll_dialog,
  FileFilter,
  Chosen,
  STYLE_VAR_WINDOW_PADDING,
  CONFIG_FLAGS_NAV_ENABLE_KEYBOARD,
  FOCUSED_FLAGS_ROOT_AND_CHILD_WINDOWS,
  CHILD_FLAGS_ALWAYS_USE_WINDOW_PADDING,
}
import session.{
  open_session,
  close_session,
  tab_title,
  directory,
  Session,
}
import menus.{
  install_native,
  sync_native,
  native_choices,
  draw_menu_bar,
  draw_header_bar,
  tab_command_of
}
import menus_view.{
  menus_view,
  header_menu,
  MenuChoice,
  Edit,
  QuitApp,
  MinimizeWindow,
  ToggleMaximized,
  EDIT_ACTIONS
}
import bindings.sdl3.{ platform, set_hint }
import desktop.{ APP_ID, install_desktop_entry }
import settings.{
  settings_path,
  load_settings,
  save_settings,
  settings_to_json,
  font_families,
  fallback_fonts,
  family_for,
  defaults,
  Settings,
  FontFamily,
  FONT_SIZE_RANGE,
}
import term.{
  theme_of,
  clear_color,
  OpenSettings,
  FontBigger,
  FontSmaller,
  FontDefault,
  TabLabel,
  Theme,
  TabCommand,
  NoCommand,
  NewTab,
  CloseTab,
  ShowTab,
}
import gui.{
  draw_session,
  Look,
  edit_session,
  settings_panel,
  SettingsAsk,
  tab_command,
  tab_bar,
  TabBar,
  Fonts,
}

let main = () -> void => {
  // On Linux, the id the desktop knows the window by — so the dock shows the entry's icon
  // — and, run as an AppImage, that entry installed for the launcher to find.
  if platform() == "Linux" {
    let _ = set_hint("SDL_APP_ID", APP_ID)
    for path in install_desktop_entry() { println("termina: wrote ${path}") }
  }
  // Off macOS Termina draws the window's title bar itself, as a GNOME header bar holding
  // its menus (`menus.draw_header_bar`); a Mac's title bar is the system's.
  let flags = if platform() == "Linux" { HOST_CUSTOM_TITLE_BAR } else { 0 }
  let Some(host) = create_host("Termina", 960, 600, flags) else { return }
  // The keyboard is the shell's: ImGui's own navigation would take the arrows and Tab.
  let io = get_io()
  io.set_config_flags(io.config_flags() & ~CONFIG_FLAGS_NAV_ENABLE_KEYBOARD)
  // Text hinted off macOS — FreeType's hinting, as the Linux desktop draws its own — where a
  // display is most often a pixel a point and unhinted glyphs are soft. A Mac draws text
  // unhinted, and so does Termina there.
  if platform() != "macOS" { set_font_hinting(host, true) }
  // On a Mac, Termina's own menu bar in place of SDL's, whose Window ▸ Close takes ⌘W and
  // would close the window, and so quit, rather than the tab; elsewhere Termina draws it.
  let installed = if platform() == "macOS" {
    install_native([menus_view([], 0, [], true, false)])
  } else {
    None
  }
  // The user's settings, the font families on offer, and the faces and theme made of them.
  let settings_file = settings_path()
  let settings = load_settings(settings_file)
  let families = font_families()
  // A program given on the command line runs in the first tab instead of the shell,
  // without the shell's integration, where Termina was started; tabs opened after it run
  // the shell.
  let given = program_args().slice(1, program_args().len())
  var sessions: []Session = []
  match open_session(given, if given.len() > 0 { lookup("PWD") } else { None }, 0) {
    Some(s) => sessions.push(s),
    None => {},
  }
  app = Some(App {
    host: host,
    installed: installed,
    menus: installed != None,
    header: has_custom_title_bar(host),
    settings_file: settings_file,
    settings: settings,
    saved: settings_to_json(settings),
    families: families,
    fonts: load_fonts(host, families, settings),
    theme: theme_of(settings),
    home: lookup("HOME") ?? "",
    sessions: sessions,
  })
  // The window's contents follow its edge as it is resized, rather than stretching.
  unsafe { set_redraw(host, redraw) }
  while frame() {}
  if let Some(a) = app { for s in a.sessions { close_session(s) } }
  destroy_host(host)
}

/// What the window keeps from one frame to the next: everything [frame] reads and changes.
/// A module-level value, as the host draws frames of its own while the window is resized
/// ([redraw]) — called back from C, which keeps no closure's captures.
struct App {
  host: Host,
  /// The Mac's own menu bar's items, when it has one (`menus`); off macOS Termina draws
  /// the bar.
  installed: Maybe<[]MenuChoice>,
  menus: bool,
  /// Whether the menus are a header bar Termina draws as the window's title bar.
  header: bool,
  settings_file: string,
  settings: Settings,
  /// The settings as last written to the file.
  saved: string,
  families: []FontFamily,
  fonts: Fonts,
  theme: Theme,
  /// The Settings tab: whether it is open, to be made the one shown, or the one shown.
  settings_open: bool = false,
  select_settings: bool = false,
  on_settings: bool = false,
  /// What is typed in the settings window to save the colors as a theme.
  theme_name_typed: string = "",
  home: string,
  sessions: []Session,
  /// The next tab's id; the first tab's is 0.
  next_id: i64 = 1,
  active: i64 = 0,
  /// A tab to show, chosen by a key or opened, for the tab bar to select this frame.
  select: Maybe<i64> = Some(0),
  title: string = "",
}

/// The window's state, once `main` has made it.
var app: Maybe<App> = None

/// A frame the host draws while the window is resized.
let redraw = () -> void => { let _ = frame() }

/// One frame of the window: the tabs read, the menus and keys carried out, the window
/// drawn. Whether the window goes on — a tab left, and no quit asked.
let frame = () -> bool => {
  let Some(before) = app else { return false }
  if before.sessions.len() == 0 || !begin_frame(before.host) { return false }
  // Read again: frames drawn during a resize, inside begin_frame's pump, changed it.
  let Some(current) = app else { return false }
  var win = current
  let going = frame_of(win)
  app = Some(win)
  going
}

/// [frame]'s work on `win`; whether the window goes on.
let frame_of = (win: mut App) -> bool => {
  // Every tab is read every frame, shown or not, so that a program writing in a hidden
  // one never waits on a full terminal.
  for k in 0..<win.sessions.len() { win.sessions[k].step(k == win.active) }
  // A tab whose program has ended closes.
  var k = win.sessions.len() - 1
  while k >= 0 {
    if !win.sessions[k].alive {
      close_session(win.sessions[k])
      win.sessions = [
        ...win.sessions.slice(0, k),
        ...win.sessions.slice(k + 1, win.sessions.len())
      ]
      if win.active > k || win.active >= win.sessions.len() { win.active = (win.active - 1).max(0) }
      win.select = Some(win.active)
    }
    k -= 1
  }
  if win.sessions.len() == 0 { return false }

  var command = tab_command(win.active, win.sessions.len(), win.menus)
  // The menus' choices: the Mac's bar, or off macOS the one Termina draws — one tree, its
  // items carried out the same. Edit's would-do-nothing items are greyed either way.
  let can = [a in EDIT_ACTIONS | win.sessions[win.active].can(a) | a]
  let tree = [
    menus_view(
      tab_labels(win.sessions, win.home),
      win.active,
      can,
      win.menus,
      is_maximized(win.host)
    )
  ]
  let chosen = match win.installed {
    Some(choices) => {
      sync_native(tree)
      native_choices(choices)
    },
    None => if win.header {
      draw_header_bar(
        win.host,
        win.title,
        [
          header_menu(
            tab_labels(win.sessions, win.home),
            win.active,
            can,
            is_maximized(win.host)
          )
        ],
        (_) => {},
        (_) => {}
      )
    } else {
      draw_menu_bar(tree, (_) => {})
    },
  }
  for choice in chosen {
    match choice {
      // Edit's items act on the tab shown.
      Edit(a) => edit_session(win.sessions[win.active], a),
      QuitApp => request_quit(win.host),
      MinimizeWindow => minimize(win.host),
      ToggleMaximized => toggle_maximized(win.host),
      _ => match tab_command_of(choice, win.active, win.sessions.len()) {
        NoCommand => {},
        c => { command = c },
      },
    }
  }
  match command {
    NewTab => {
      match open_session([], directory(win.sessions[win.active]), win.next_id) {
        Some(s) => {
          win.sessions.push(s)
          win.active = win.sessions.len() - 1
          win.select = Some(win.active)
        },
        None => {},
      }
      win.next_id += 1
    },
    // ⌘W on the Settings tab closes it, not the terminal behind it.
    CloseTab => if win.on_settings { win.settings_open = false } else { win.sessions[win.active].request_close() },
    ShowTab(n) => {
      win.active = n
      win.select = Some(n)
    },
    OpenSettings => {
      win.settings_open = true
      win.select_settings = true
    },
    // A point at a time, within the settings' range; kept as any setting is.
    FontBigger => { win.settings.font_size = (win.settings.font_size + 1.0).min(FONT_SIZE_RANGE.1) },
    FontSmaller => { win.settings.font_size = (win.settings.font_size - 1.0).max(FONT_SIZE_RANGE.0) },
    FontDefault => { win.settings.font_size = defaults().font_size },
    NoCommand => {},
  }
  // The faces are drawn at the size pushed: a new one takes at once.
  win.fonts.size = win.settings.font_size

  // The window: the tabs, and the one shown — a terminal, or the settings, whose change
  // takes at once and is kept once the mouse is let go (not every frame of a slider's
  // drag).
  let faces_were = "${win.settings.font_family}|${win.settings.font_file}"
  let (bar, ask) = draw_window(
    win.sessions,
    win.active,
    win.select,
    win.fonts,
    win.theme,
    win.home,
    command,
    win.menus,
    !win.header,
    SettingsTab { open: win.settings_open, select: win.select_settings },
    win.settings,
    win.families,
    win.theme_name_typed
  )
  win.select_settings = false
  if bar.settings_closed { win.settings_open = false }
  win.on_settings = bar.settings_shown && win.settings_open
  if ask.choose_file {
    let _ = show_open_dialog(
      win.host,
      FONT_DIALOG,
      [FileFilter { name: "Fonts", extensions: "ttf;otf;ttc" }]
    )
  }
  // A font file chosen in the system's dialog becomes the font.
  match poll_dialog(win.host) {
    Some(Chosen(tag, path)) => if tag == FONT_DIALOG { win.settings.font_file = path },
    _ => {},
  }
  if ask.changed || "${win.settings.font_family}|${win.settings.font_file}" != faces_were {
    win.theme = theme_of(win.settings)
    if "${win.settings.font_family}|${win.settings.font_file}" != faces_were {
      win.fonts = load_fonts(win.host, win.families, win.settings)
    }
    win.fonts.size = win.settings.font_size
  }
  let now_json = settings_to_json(win.settings)
  if now_json != win.saved && !is_mouse_down(0) {
    let _ = save_settings(win.settings_file, win.settings)
    win.saved = now_json
  }
  win.select = None
  win.active = bar.shown
  match bar.closing {
    Some(n) => win.sessions[n].request_close(),
    None => {},
  }
  // Tabs dragged into a new order: the list put in it, the shown tab still the same one.
  if !in_order(bar.order) {
    var moved: []Session = []
    for old in bar.order { moved.push(win.sessions[old]) }
    win.sessions = moved
    for i in 0..<bar.order.len() {
      if bar.order[i] == win.active {
        win.active = i
      }
    }
  }
  if bar.add {
    match open_session([], directory(win.sessions[win.active]), win.next_id) {
      Some(s) => {
        win.sessions.push(s)
        win.active = win.sessions.len() - 1
        win.select = Some(win.active)
      },
      None => {},
    }
    win.next_id += 1
  }
  let now = tab_title(win.sessions[win.active], win.home)
  if now != win.title {
    win.title = now
    set_window_title(win.host, win.title)
  }
  let clear = clear_color(win.theme)
  end_frame(win.host, clear.0, clear.1, clear.2)
  true
}

/// The window: the tab bar, and the tab shown below it, drawn and given the keys — unless a
/// tab shortcut took them this frame. Answers what was done to the bar (`ui.tab_bar`).
let draw_window = (
  sessions: mut []Session,
  active: i64,
  select: Maybe<i64>,
  fonts: Fonts,
  theme: Theme,
  home: string,
  command: TabCommand,
  menus: bool,
  // The tab bar's own `+`: not where the header bar has one.
  plus: bool,
  settings_tab: SettingsTab,
  settings: mut Settings,
  families: []FontFamily,
  theme_name: mut string
) -> (TabBar, SettingsAsk) => {
  let line_spacing = settings.line_spacing
  let viewport = get_main_viewport()
  set_next_window_pos(viewport.work_pos())
  set_next_window_size(viewport.work_size())
  push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, Vec2 { x: PADDING, y: PADDING })
  let flags = WINDOW_FLAGS_NO_DECORATION | WINDOW_FLAGS_NO_NAV_INPUTS |
    WINDOW_FLAGS_NO_BACKGROUND | WINDOW_FLAGS_NO_SAVED_SETTINGS | WINDOW_FLAGS_NO_SCROLLBAR |
    WINDOW_FLAGS_NO_SCROLL_WITH_MOUSE | WINDOW_FLAGS_NO_BRING_TO_FRONT_ON_FOCUS
  let _ = begin("terminal", flags)
  pop_style_var()

  let bar = tab_bar(
    tab_labels(sessions, home),
    active,
    select,
    theme,
    settings_tab.open,
    settings_tab.select,
    plus
  )
  let shown = bar.shown

  // The shown tab fills the rest of the window, in a child that scrolls on its own.
  push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, Vec2 { x: PADDING, y: PADDING / 2.0 })
  let _ = begin_child(
    "grid",
    Vec2 { x: 0.0, y: 0.0 },
    CHILD_FLAGS_ALWAYS_USE_WINDOW_PADDING,
    WINDOW_FLAGS_NO_NAV_INPUTS | WINDOW_FLAGS_NO_BACKGROUND
  )
  pop_style_var()
  // The Settings tab shown: the settings in its area, in the interface's font.
  if bar.settings_shown && settings_tab.open {
    let ask = settings_panel(settings, families, theme_name)
    end_child()
    end()
    return (bar, ask)
  }
  match fonts.regular {
    Some(f) => push_font_float(f, fonts.size),
    None => {},
  }
  // A cell is one advance wide, measured over a long run: ImGui rounds a measured width up
  // to a whole pixel, which over one character overstates the advance by up to a pixel and
  // put the cursor cells to the right of the text it follows.
  let cell = Vec2 {
    x: calc_text_size(MEASURE).x / f32(MEASURE.len()),
    y: f32((get_font_size() * line_spacing).round()),
  }
  let look = Look {
    cell: cell,
    text_dy: f32(((cell.y - get_font_size()) / 2.0).floor()),
    // One display pixel, in points: what a drawn bold is offset by.
    pixel: 1.0 / get_io().display_framebuffer_scale().x.max(1.0),
    fonts: fonts,
    theme: theme,
  }
  let keys_taken = match command {
    NoCommand => false,
    _ => true,
  }
  let focused = is_window_focused(FOCUSED_FLAGS_ROOT_AND_CHILD_WINDOWS) && !keys_taken
  draw_session(sessions[shown], look, focused, menus)
  match fonts.regular {
    Some(_) => pop_font(),
    None => {},
  }
  end_child()
  end()
  (bar, SettingsAsk { changed: false, choose_file: false })
}

/// The Settings tab: whether it is open, and whether to make it the one shown this frame.
struct SettingsTab {
  open: bool,
  select: bool,
}

/// The tabs' names on the bar and in the menus — a `•` for output not yet seen — and their
/// identities.
let tab_labels = pure (sessions: []Session, home: string) -> []TabLabel =>
  [k in 0..<sessions.len() | TabLabel {
    name: "${if sessions[k].unseen { "• " } else { "" }}${tab_title(sessions[k], home)}",
    id: sessions[k].id,
  }]

/// Whether `order` is 0, 1, 2, … — the tabs as they were.
let in_order = pure (order: []i64) -> bool => {
  for i in 0..<order.len() { if order[i] != i { return false } }
  true
}

/// The tag the font file dialog's answer comes back under.
const FONT_DIALOG: i32 = 1

/// Points between the window's edge and the grid.
const PADDING: f32 = 10.0

/// The run of characters a cell's width is measured over.
const MEASURE: string = "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"

/// Reads per frame at most — a megabyte — so that a program writing without end (`yes`)
/// cannot stop the window drawing.
const READS_PER_FRAME: i64 = 16

/// The faces the settings choose (a chosen file's, else the family's — the first family when
/// it is not installed), at the settings' size; ImGui's own face (monospaced) alone when no family is found.
let load_fonts = (host: Host, families: []FontFamily, s: Settings) -> Fonts => {
  let none = Fonts {
    regular: None,
    bold: None,
    italic: None,
    bold_italic: None,
    size: s.font_size
  }
  let Some(family) = family_for(s, families) else { return none }
  match face(host, family.regular, s.font_size) {
    Some(regular) => {
      let fonts = Fonts {
        regular: Some(regular),
        bold: face(host, family.bold, s.font_size),
        italic: face(host, family.italic, s.font_size),
        bold_italic: face(host, family.bold_italic, s.font_size),
        size: s.font_size,
      }
      // What the family lacks — CJK, symbols — drawn from the fallback fonts, in every face.
      let fallbacks = fallback_fonts()
      for f in [fonts.regular, fonts.bold, fonts.italic, fonts.bold_italic] {
        match f {
          Some(font) =>
            for path in fallbacks { let _ = merge_font_file(host, font, path) },
          None => {},
        }
      }
      fonts
    },
    None => none,
  }
}

/// A face from `path` (`None` for `""`, or a file that cannot be read). ImGui keeps one per
/// file, and a size is chosen as it is pushed, so the size here is only its first.
let face = (host: Host, path: string, size: f32) -> Maybe<Font> =>
  if path == "" { None } else { font_file(host, path, size) }
