// termina — a terminal: the user's shell on a pseudo-terminal, in a window of tabs drawn with
// lyra's `ui` — the grid, the blocks, the command line and its box Termina's own (`session`,
// `term`, `face`), the tab bar, the menus (the Mac's own bar; a header bar's ☰ elsewhere) and
// the Settings tab `ui`'s.
//
//     build/termina                # the login shell, in a window of tabs
//     build/termina CMD [ARG…]     # that program instead, where Termina was started (as xterm -e)
//     build/termina --print CMD …  # and when it ends, its screen printed
//     build/termina --script STEPS [--png FILE] [CMD …]
//                                  # played headless (SDL_VIDEODRIVER=dummy) through SDL's 2D
//                                  #   renderer, `ui.script`'s steps — a `wait:N` taking N real
//                                  #   milliseconds, for the shell — and the last frame written
//                                  #   to FILE
//     build/termina --header …     # the window as off a Mac, on a Mac too: the header bar, its ☰
//                                  #   the menus, no system frame — for checks
//
// Termina's flags come before the command, whose own are its: `std.collections.parse_args`
// would take `ls -la`'s `-la` for one of Termina's.

import ui.gpu
import ui.sdl3
import ui.sdl3.{ SdlRenderer, capture }
import ui.app.{
  App,
  Running,
  run,
  running,
  step_running,
  Shortcuts,
  Menus,
  DrawnTitleBar,
  SystemTitleBar
}
import ui.script.{ ScriptPlatform, timed_platform, parse_steps, Step, Waited }
import ui.draw.{ Point, Size, Color }
import ui.backend.{ Platform, ToMaximized }
import ui.text.{ Fonts, FontSpec, FontMetrics, fonts_new, glyph_atlas }
import ui.style.{ OverflowVisible }
import ui.layout.{ paint }
import bindings.sdl3.{ platform, set_hint }
import bindings.freetype.{ HintNone, HintLight }
import std.env.{ lookup, program_args }
import std.io.{ write_bytes, sleep_ms }
import std.png.{ write_png }
import settings.{
  WindowPlace,
  load_settings,
  settings_path,
  settings_to_json,
  font_families,
  family_for,
  fallback_fonts,
  Settings
}
import session.{ open_session, close_session }
import term.{ Theme, theme_of }
import desktop.{ APP_ID, install_desktop_entry }
import face.{
  Term,
  fill_images,
  TermEvent,
  term_of,
  screen_text,
  view,
  update,
  subscriptions,
  shortcuts,
  menus_of,
  save_now,
  grid_of,
  color
}

const WIDTH: f32 = 960.0
const HEIGHT: f32 = 600.0

/// What a script's `wait:` is played in: a pass a slice, so the shell's output is read as
/// it comes rather than once at the end.
const SLICE_MS: i64 = 10

let main = () -> u8 => {
  var args = program_args().slice(1, program_args().len())
  var printing = false
  var header = false
  var script: Maybe<string> = None
  var png: Maybe<string> = None
  while args.len() > 0 && args[0].starts_with("--") {
    let flag = args[0]
    if flag == "--print" || flag == "--header" {
      if flag == "--print" { printing = true } else { header = true }
      args = args.slice(1, args.len())
    } else if (flag == "--script" || flag == "--png") && args.len() > 1 {
      if flag == "--script" { script = Some(args[1]) } else { png = Some(args[1]) }
      args = args.slice(2, args.len())
    } else {
      println("termina: ${flag}? (--print, --header, --script STEPS, --png FILE)")
      return 2
    }
  }
  // On Linux, the id the desktop knows the window by — so the dock shows the entry's icon —
  // and, run as an AppImage, that entry installed for the launcher to find.
  if platform() == "Linux" {
    let _ = set_hint("SDL_APP_ID", APP_ID)
    for path in install_desktop_entry() { println("termina: wrote ${path}") }
  }
  let settings = load_settings(settings_path())
  let theme = theme_of(settings)
  var fonts = fonts_new()
  // A Mac draws text unhinted; elsewhere a pixel is most often a point, and unhinted stems
  // straddle two of them.
  fonts.hinting = if platform() == "macOS" { HintNone } else { HintLight }
  let _ = fonts.add_system_font()
  add_family(fonts, settings)
  for k, path in fallback_fonts() {
    let family = "fallback ${k}"
    if fonts.add(family, path) { fonts.add_fallback(family) }
  }
  // On a Mac the menus are the system's bar, and the title bar the system's; elsewhere the
  // window has a header bar of Termina's (face/window.lyra), its ☰ the menus.
  let mac = platform() == "macOS" && !header
  let app = App {
    view: view,
    update: update,
    subscriptions: subscriptions,
    // Cleared to nothing: the view's root paints the theme's background, which a see-through
    // window shows the desktop through.
    background: Color { r: 0, g: 0, b: 0, a: 0 },
    window_overflow: OverflowVisible,
    shortcuts: [Shortcuts { of: shortcuts }],
    menus: if mac { [Menus { of: menus_of }] } else { [] },
    title_bar: if mac { SystemTitleBar } else { DrawnTitleBar },
  }
  let status = match script {
    Some(steps) => scripted(app, steps, png, args, settings, theme, fonts, mac),
    None => windowed(app, args, settings, theme, fonts, mac),
  }
  if status.0 != 0 { return status.0 }
  if printing { print_last(status.1) }
  0
}

/// The window on the GPU, until it is closed: its status, and the window as it was left.
let windowed = (
  app: App<Term, TermEvent>,
  args: []string,
  settings: Settings,
  theme: Theme,
  given: Fonts,
  mac: bool
) -> (u8, Term) => {
  var fonts = given
  // Where it was last closed, if the settings remember it: its size, its place, maximized.
  let place = if settings.remember_window { settings.window } else { None }
  let size = match place {
    Some(p) => Size { w: p.width, h: p.height },
    None => Size { w: WIDTH, h: HEIGHT },
  }
  // See-through while the background is not opaque — on Linux only a window opened so can be.
  let see_through = (theme.bg >> 24) != 0xFF
  let window = match gpu.open("Termina", size.w, size.h, see_through) {
    Ok(w) => w,
    Err(why) => {
      println("termina: ${why}")
      fonts.close()
      return (2, empty_term(theme, settings))
    },
  }
  var platform_ = window.platform
  var renderer = window.renderer
  if see_through { let _ = platform_.set_backdrop_blur(settings.background_blur) }
  if let Some(p) = place {
    if p.placed { platform_.set_window_position(Point { x: p.x, y: p.y }) }
    if p.maximized { platform_.change_window(ToMaximized) }
  }
  let Some(start) = started(args, settings, theme, fonts, platform_.scale(), mac) else {
    gpu.close(platform_, renderer)
    fonts.close()
    return (1, empty_term(theme, settings))
  }
  var last = run(app, start, platform_, renderer, fonts)
  if last.settings.remember_window { last.settings.window = Some(place_of(
    platform_,
    last.settings.window
  )) }
  save_now(last)
  gpu.close(platform_, renderer)
  for s in last.tabs { close_session(s) }
  fonts.close()
  (0, last)
}

/// Where the window is as it closes: its place and size — or, maximized or minimized, the place
/// and size it had before (`before`'s, the size the system no longer says), and that it was
/// maximized.
let place_of<p> where p: Platform = (
  platform: p,
  before: Maybe<WindowPlace>
) -> WindowPlace => {
  let state = platform.window_state()
  let size = platform.window_size()
  let at = platform.window_position()
  if state.maximized || state.minimized {
    let kept = before ?? WindowPlace { width: WIDTH, height: HEIGHT }
    return WindowPlace { kept | maximized: state.maximized }
  }
  WindowPlace {
    x: match at {
      Some(pt) => pt.x,
      None => 0.0,
    },
    y: match at {
      Some(pt) => pt.y,
      None => 0.0,
    },
    placed: at.is_some(),
    width: size.w,
    height: size.h,
  }
}

/// `steps` played headless through SDL's 2D renderer, the last frame written to `png`: its
/// status, and the window as the script left it.
let scripted = (
  app: App<Term, TermEvent>,
  steps: string,
  png: Maybe<string>,
  args: []string,
  settings: Settings,
  theme: Theme,
  given: Fonts,
  mac: bool
) -> (u8, Term) => {
  var fonts = given
  let parsed = match parse_steps(steps) {
    Ok(p) => p,
    Err(why) => {
      println("termina: the script: ${why}")
      fonts.close()
      return (2, empty_term(theme, settings))
    },
  }
  let window = match sdl3.open("Termina", WIDTH, HEIGHT) {
    Ok(w) => w,
    Err(why) => {
      println("termina: ${why}")
      fonts.close()
      return (2, empty_term(theme, settings))
    },
  }
  var renderer = window.renderer
  let Some(start) = started(args, settings, theme, fonts, 1.0, mac) else {
    sdl3.close(window.platform, renderer)
    fonts.close()
    return (1, empty_term(theme, settings))
  }
  let played = running(
    app,
    start,
    timed_platform(sliced(parsed), Size { w: WIDTH, h: HEIGHT }),
    renderer,
    fonts
  )
  loop {
    let p = played.platform
    if p.next < p.steps.len() {
      if let Waited(_) = p.steps[p.next] { sleep_ms(SLICE_MS) }
    }
    if !step_running(played) { break }
  }
  var status: u8 = 0
  if let Some(path) = png {
    if !save(played, path) {
      println("termina: the frame could not be written to ${path}")
      status = 1
    }
  }
  var last = played.host.state
  save_now(last)
  for s in last.tabs { close_session(s) }
  sdl3.close(window.platform, played.renderer)
  played.fonts.close()
  (status, last)
}

/// Each `wait:` cut into slices of `SLICE_MS`, each a pass of its own.
let sliced = pure (steps: []Step) -> []Step => {
  var out: []Step = []
  for step in steps {
    match step {
      Waited(ms) => {
        var left = ms
        while left > 0 {
          out.push(Waited(left.min(SLICE_MS)))
          left -= SLICE_MS
        }
      },
      other => out.push(other),
    }
  }
  out
}

/// The first tab, running `args` — a program instead of the shell, without its integration,
/// where Termina was started — or the login shell, in a window drawn as on a Mac or not;
/// `None`, said why, if it could not start.
let started = (
  args: []string,
  settings: Settings,
  theme: Theme,
  fonts: mut Fonts,
  scale: f32,
  mac: bool
) -> Maybe<Term> => {
  let spec = FontSpec { family: "mono", size: settings.font_size }
  let grid = grid_of(spec, fonts.metrics(spec, scale), settings.line_spacing)
  let Some(s) = open_session(
    args,
    if args.len() > 0 { lookup("PWD") } else { None },
    0
  ) else {
    println("termina: the shell could not start")
    return None
  }
  // The settings, which the Settings tab edits and keeps in their file.
  var made = Term {
    term_of([s], theme, grid, settings.line_spacing, lookup("HOME") ?? "") |
    mac: mac,
    settings: settings,
    settings_file: settings_path(),
    saved: settings_to_json(settings),
    families: font_families(),
  }
  // The backgrounds' images, decoded before the first frame draws them.
  fill_images(made.settings.colors, made.images, made.image_revision)
  Some(made)
}

/// A window of no tabs, for a status returned before any opened: nothing is drawn in it, so
/// its font is not measured.
let empty_term = (theme: Theme, settings: Settings) -> Term => {
  let spec = FontSpec { family: "mono", size: settings.font_size }
  term_of(
    [],
    theme,
    grid_of(spec, FontMetrics {}, settings.line_spacing),
    settings.line_spacing,
    ""
  )
}

/// The frame the host last laid out, drawn without showing it and written as a PNG.
let save = (
  played: shared Running<Term, TermEvent, ScriptPlatform, SdlRenderer>,
  path: string
) -> bool => {
  var atlas = glyph_atlas()
  var f = played.fonts
  var r = played.renderer
  let ops = paint(played.host.shown[0], Point {}, 1.0, f, atlas, r)
  let Some(frame) = capture(
    r,
    color(played.host.state.theme.bg),
    ops
  ) else { return false }
  var bytes: []u8 = []
  for p in frame.argb {
    bytes.push(u8((p >> 16) & 0xFF))
    bytes.push(u8((p >> 8) & 0xFF))
    bytes.push(u8(p & 0xFF))
    bytes.push(u8((p >> 24) & 0xFF))
  }
  match write_png(frame.width, frame.height, bytes) {
    Ok(image) => write_bytes(path, image),
    Err(_) => false,
  }
}

/// The settings' family — a chosen font file's, else the family named, else the first found —
/// as `mono`'s faces: its regular, bold, italic and bold italic where it has them.
let add_family = (fonts: mut Fonts, s: Settings) -> void => {
  let Some(family) = family_for(s, font_families()) else { return }
  for (path, weight, italic) in [
    (family.regular, 400, false),
    (family.bold, 700, false),
    (family.italic, 400, true),
    (family.bold_italic, 700, true),
  ] {
    if path != "" { let _ = fonts.add("mono", path, 0, weight, italic) }
  }
}

/// The shown tab's screen, a line a row, trailing blanks dropped — or, with every tab closed,
/// the one the last tab's program left.
let print_last = (t: Term) -> void => {
  let lines = if t.tabs.len() > 0 { screen_text(t.tabs[t.active]) } else { t.closed_screen }
  println("termina: ${lines.len()} lines")
  for line in lines { println(line) }
}
