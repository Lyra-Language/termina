// menutest — Termina's menu bar on a Mac, the tree of `menus_view.lui` installed and read
// back: Shell's tab items and Edit's with their keys, greying from the tree, and none of
// SDL's own Window ▸ Close, whose ⌘W closed the window, and with it the app, rather than
// the tab. Needs SDL's real video driver (AppKit's application),
// not the dummy one; no window is opened. Elsewhere there is no menu bar, and it passes.
//
//   build/menutest             exits 1 naming each check that failed

import bindings.sdl3.{ init, quit, platform, INIT_VIDEO }
import bindings.menubar.{ describe }
import menus.{ install_native, sync_native }
import menus_view.{ menus_view, EDIT_ACTIONS }
import ui.{ TabLabel }

let main = () -> u8 => {
  if platform() != "macOS" {
    println("menutest: no menu bar here")
    return 0
  }
  if !init(INIT_VIDEO) {
    println("menutest: SDL's video did not start")
    return 1
  }
  var failed = 0
  let tabs = [TabLabel { name: "one", id: 1 }, TabLabel { name: "two", id: 2 }]
  if install_native([menus_view(tabs, 0, EDIT_ACTIONS, true, false)]) != None {
    let bar = describe()
    failed += check("New Tab on cmd-t", key_of(bar, "New Tab") == "Cmd+T", bar)
    failed += check("Close Tab on cmd-w", key_of(bar, "Close Tab") == "Cmd+W", bar)
    failed += check(
      "previous and next tab",
      "${key_of(bar, "Show Previous Tab")} ${key_of(bar, "Show Next Tab")}" == "Cmd+{ Cmd+}",
      bar
    )
    failed += check("no window Close", key_of(bar, "Close") == "missing", bar)
    failed += check("the standard Window menu", key_of(bar, "Minimize") == "Cmd+M", bar)
    failed += check("Undo", key_of(bar, "Undo") == "Cmd+Z", bar)
    failed += check("Redo", key_of(bar, "Redo") == "Shift+Cmd+Z", bar)
    failed += check(
      "Cut, Copy, Paste",
      "${key_of(bar, "Cut")} ${key_of(bar, "Copy")} ${key_of(bar, "Paste")}" == "Cmd+X Cmd+C Cmd+V",
      bar
    )
    failed += check("Select All", key_of(bar, "Select All") == "Cmd+A", bar)
    failed += check(
      "View's font sizes",
      "${key_of(bar, "Default Font Size")} ${key_of(bar, "Bigger")} ${key_of(bar, "Smaller")}" == "Cmd+0 Cmd+= Cmd+-",
      bar
    )
    failed += check(
      "Settings in the application menu",
      key_of(bar, "Settings…") == "Cmd+,",
      bar
    )
    failed += check("none greyed", !bar.contains("(off)"), bar)
    // An item that would do nothing is greyed, as the tree says this frame: Edit's with
    // nothing to act on, the previous and next tab with one tab.
    sync_native([menus_view([tabs[0]], 0, [], true, false)])
    let greyed = describe()
    failed += check("a greyed item", greyed.contains("Undo\tCmd+Z (off)"), greyed)
    failed += check(
      "one tab: no next",
      greyed.contains("Show Next Tab\tCmd+} (off)"),
      greyed
    )
  } else {
    failed += check("the menu bar installs", false, "")
  }
  quit()
  if failed == 0 {
    println("menutest: all passed")
    0
  } else {
    println("menutest: ${failed} failed")
    1
  }
}

/// The key equivalent of the bar's item titled exactly `title` — `describe` writes each as
/// `title<tab>key` — `""` for an item without one, `"missing"` for no such item.
let key_of = pure (bar: string, title: string) -> string => {
  for line in bar.split("\n") {
    let parts = line.trim().split("\t")
    if parts[0] == title { return if parts.len() > 1 { parts[1] } else { "" } }
  }
  "missing"
}

let check = (name: string, ok: bool, bar: string) -> i64 => {
  if ok { 0 } else {
    println("FAIL ${name}; the bar:\n${bar}")
    1
  }
}
