import bindings.imgui.ui.{ Node, Button, Checkbox, Combo, Selectable, InputText, Slot, Form, Field, Text, Separator, SeparatorText, Component, ButtonAttrs, CheckboxAttrs, ComboAttrs, SelectableAttrs, InputTextAttrs, FieldAttrs, TextAttrs, Style, Sheet, StyleRule }
import bindings.imgui.{ col32 }

// settings_view.lui:9
import settings.{ Settings, FontFamily, file_family, can_save_as, saved_colours, THEME_NAMES }

/// What the settings can be asked to do; the Settings tab carries it out. The sliders and
/// colours are drawn in Slots and change the settings themselves.
pub data SettingsEvent =
  UseFamily(string)
  | ChooseFontFile
  | UseTheme(string)
  | UseSavedTheme(string)
  | NameTheme(string)
  | SaveThemeAs
  | DeleteSavedTheme
  | ToggleBoldBright
  | ResetSettings

/// The font the Family list shows: a chosen file's own name, else the family's.
let family_shown = pure (s: Settings) -> string =>
  if s.font_file != "" { file_family(s.font_file).name } else { s.font_family }

/// The colours the settings edit, by label and the Slot drawing each (`colour <name>`),
/// in their groups: the grid's own, the sections', the tabs', the command line's.
const COLOURS = [("Text", "fg"), ("Background", "bg"), ("Cursor", "cursor"), ("Selection", "selection")]
const SECTION_COLOURS = [("Input", "input"), ("Output", "output"), ("Input text", "input_text")]
const TAB_COLOURS = [("Tab", "tab"), ("Under the pointer", "tab_hovered"), ("Shown", "tab_selected")]
const COMMAND_LINE_COLOURS = [("Text", "editor_text"), ("Completion menu", "menu"), ("Chosen completion", "menu_chosen")]

/// Whether the theme in use is one the user saved.
let is_saved = pure (s: Settings) -> bool => saved_colours(s.themes, s.theme_name) != None

/// From settings_view.lui, line 41.
pub let settings_view = pure (s: Settings, families: []FontFamily, typed: string) -> Node<SettingsEvent> =>
  Component(settings_view_sheet, [
    SeparatorText("Font"), // settings_view.lui:45
    Form([ // settings_view.lui:46
      Field(FieldAttrs { label: "Family" }, [ // settings_view.lui:47
        Combo(ComboAttrs { label: "##family", id: "combo Family", preview: family_shown(s) }, [ // settings_view.lui:48
          ...[f in families | Selectable(SelectableAttrs { label: "${f.name}", selected: s.font_file == "" && f.name == s.font_family, on_select: UseFamily(f.name) })], // settings_view.lui:49
        ]),
        Button(ButtonAttrs { label: "Other Font File…", id: "button Other Font File", on_click: ChooseFontFile }), // settings_view.lui:53
      ]),
      Field(FieldAttrs { label: "Size" }, [ // settings_view.lui:55
        Slot("font size"), // settings_view.lui:56
      ]),
      Field(FieldAttrs { label: "Line spacing" }, [ // settings_view.lui:58
        Slot("line spacing"), // settings_view.lui:59
      ]),
    ]),
    SeparatorText("Colours"), // settings_view.lui:63
    Form([ // settings_view.lui:64
      Field(FieldAttrs { label: "Theme" }, [ // settings_view.lui:65
        Combo(ComboAttrs { label: "##theme", id: "combo Theme", preview: s.theme_name }, [ // settings_view.lui:66
          ...[name in THEME_NAMES | Selectable(SelectableAttrs { label: "${name}", selected: name == s.theme_name, on_select: UseTheme(name) })], // settings_view.lui:67
          ...(if s.themes.len() > 0 { // settings_view.lui:70
            [
              Separator, // settings_view.lui:71
            ]
          } else {
            []
          }),
          ...[t in s.themes | Selectable(SelectableAttrs { label: "${t.name}", id: "saved ${t.name}", selected: t.name == s.theme_name, on_select: UseSavedTheme(t.name) })], // settings_view.lui:73
        ]),
      ]),
      Field(FieldAttrs { label: "Theme name" }, [ // settings_view.lui:78
        InputText(InputTextAttrs { label: "##themename", id: "field Theme name", value: typed, on_change: (value: string) -> SettingsEvent => NameTheme(value), style: Style { width_em: Some(14.0) } }), // settings_view.lui:79
        Button(ButtonAttrs { label: "Save Theme As…", id: "button Save Theme As", enabled: can_save_as(typed), on_click: SaveThemeAs }), // settings_view.lui:80
        ...(if is_saved(s) { // settings_view.lui:81
          [
            Button(ButtonAttrs { label: "Delete", id: "button Delete Theme", on_click: DeleteSavedTheme }), // settings_view.lui:82
          ]
        } else {
          []
        }),
      ]),
      ...[c in COLOURS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:85
          Slot("colour ${c.1}"), // settings_view.lui:86
        ])],
      Text(TextAttrs { text: "Sections", class: "group" }), // settings_view.lui:88
      ...[c in SECTION_COLOURS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:89
          Slot("colour ${c.1}"), // settings_view.lui:90
        ])],
      Text(TextAttrs { text: "Tabs", class: "group" }), // settings_view.lui:92
      ...[c in TAB_COLOURS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:93
          Slot("colour ${c.1}"), // settings_view.lui:94
        ])],
      Text(TextAttrs { text: "Command line", class: "group" }), // settings_view.lui:96
      ...[c in COMMAND_LINE_COLOURS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:97
          Slot("colour ${c.1}"), // settings_view.lui:98
        ])],
    ]),
    Text(TextAttrs { text: "ANSI colours", class: "group" }), // settings_view.lui:101
    Slot("ansi"), // settings_view.lui:102
    Checkbox(CheckboxAttrs { label: "Draw bold text in bright colours", id: "checkbox Bold is bright", checked: s.bold_is_bright, on_toggle: ToggleBoldBright }), // settings_view.lui:103
    Separator, // settings_view.lui:105
    Button(ButtonAttrs { label: "Reset to Defaults", id: "button Reset", on_click: ResetSettings }), // settings_view.lui:106
  ])

let settings_view_sheet = Sheet { // settings_view.lui:42
  rules: [
    StyleRule { selector: "Text.group", style: Style { color: Some(col32(154, 160, 166)) } },
  ],
