/// From settings_view.lui, line 134.
pub let color = pure (s: Settings, field: string) -> Node<SettingsEvent> =>
  Component(Sheet {}, [
    ColorEdit(ColorEditAttrs { label: "##${field}", id: "color ${field}", value: color_named(s.colors, field), inputs: false, on_change: (v: u32) -> SettingsEvent => SetColor(field, v) }), // settings_view.lui:135
  ])

/// From settings_view.lui, line 139.
pub let ansi = pure (s: Settings, k: i64) -> Node<SettingsEvent> =>
  Component(Sheet {}, [
    ColorEdit(ColorEditAttrs { label: "##ansi${k}", id: "color ansi ${k}", value: s.colors.ansi[k], inputs: false, on_change: (v: u32) -> SettingsEvent => SetAnsi(k, v) }), // settings_view.lui:140
  ])

let settings_view_sheet = Sheet { // settings_view.lui:57
  rules: [
    StyleRule { selector: "Text.group", style: Style { color: Some(col32(154, 160, 166)) } },
  ],
}
