// settings_view.lui:8
import settings.{
  Settings,
  FontFamily,
  file_family,
  can_save_as,
  saved_colors,
  color_named,
  THEME_NAMES,
  FONT_SIZE_RANGE,
  LINE_SPACING_RANGE,
}

/// What the settings can be asked to do; the Settings tab carries it out.
pub data SettingsEvent =
  UseFamily(string)
  | ChooseFontFile
  /// The font's size or the line spacing, as the slider is dragged.
  | SetFontSize(f32)
  | SetLineSpacing(f32)
  /// A color, by its field's name (`fg`, `tab_hovered`, …), as it is picked.
  | SetColor(string, u32)
  /// ANSI color `k`, 0 to 15.
  | SetAnsi(i64, u32)
  | UseTheme(string)
  | UseSavedTheme(string)
  | NameTheme(string)
  | SaveThemeAs
  | DeleteSavedTheme
  | ToggleBoldBright
  | ResetSettings

/// The font the Family list shows: a chosen file's own name, else the family's.
let family_shown = pure (s: Settings) -> string =>
  if s.font_file != "" { file_family(s.font_file).name } else { s.font_family }

/// The colors the settings edit, by label and field (`settings.color_named`), in their
/// groups: the grid's own, the sections', the tabs', the command line's.
const COLORS = [("Text", "fg"), ("Background", "bg"), ("Cursor", "cursor"), ("Selection", "selection")]
const SECTION_COLORS = [("Input", "input"), ("Output", "output"), ("Input text", "input_text")]
const TAB_COLORS = [("Tab", "tab"), ("Under the pointer", "tab_hovered"), ("Shown", "tab_selected")]
const COMMAND_LINE_COLORS = [("Text", "editor_text"), ("Completion menu", "menu"), ("Chosen completion", "menu_chosen")]

/// Whether the theme in use is one the user saved.
let is_saved = pure (s: Settings) -> bool => saved_colors(s.themes, s.theme_name) != None

/// From settings_view.lui, line 56.
pub let settings_view = pure (s: Settings, families: []FontFamily, typed: string) -> Node<SettingsEvent> =>
  Component(settings_view_sheet, [
    SeparatorText("Font"), // settings_view.lui:60
    Form([ // settings_view.lui:61
      Field(FieldAttrs { label: "Family" }, [ // settings_view.lui:62
        Combo(ComboAttrs { label: "##family", id: "combo Family", preview: family_shown(s) }, [ // settings_view.lui:63
          ...[f in families | Selectable(SelectableAttrs { label: "${f.name}", selected: s.font_file == "" && f.name == s.font_family, on_select: UseFamily(f.name) })], // settings_view.lui:64
        ]),
        Button(ButtonAttrs { label: "Other Font File…", id: "button Other Font File", on_click: ChooseFontFile }), // settings_view.lui:68
      ]),
      Field(FieldAttrs { label: "Size" }, [ // settings_view.lui:70
        Slider(SliderAttrs { label: "##size", id: "slider Size", value: s.font_size, min: FONT_SIZE_RANGE.0, max: FONT_SIZE_RANGE.1, format: "%.0f pt", on_change: (value: f32) -> SettingsEvent => SetFontSize(value) }), // settings_view.lui:71
      ]),
      Field(FieldAttrs { label: "Line spacing" }, [ // settings_view.lui:73
        Slider(SliderAttrs { label: "##spacing", id: "slider Line spacing", value: s.line_spacing, min: LINE_SPACING_RANGE.0, max: LINE_SPACING_RANGE.1, format: "%.2f", on_change: (value: f32) -> SettingsEvent => SetLineSpacing(value) }), // settings_view.lui:74
      ]),
    ]),
    SeparatorText("Colors"), // settings_view.lui:78
    Form([ // settings_view.lui:79
      Field(FieldAttrs { label: "Theme" }, [ // settings_view.lui:80
        Combo(ComboAttrs { label: "##theme", id: "combo Theme", preview: s.theme_name }, [ // settings_view.lui:81
          ...[name in THEME_NAMES | Selectable(SelectableAttrs { label: "${name}", selected: name == s.theme_name, on_select: UseTheme(name) })], // settings_view.lui:82
          ...(if s.themes.len() > 0 { // settings_view.lui:85
            [
              Separator, // settings_view.lui:86
            ]
          } else {
            []
          }),
          ...[t in s.themes | Selectable(SelectableAttrs { label: "${t.name}", id: "saved ${t.name}", selected: t.name == s.theme_name, on_select: UseSavedTheme(t.name) })], // settings_view.lui:88
        ]),
      ]),
      Field(FieldAttrs { label: "Theme name" }, [ // settings_view.lui:93
        InputText(InputTextAttrs { label: "##themename", id: "field Theme name", hint: "Theme name", value: typed, on_change: (value: string) -> SettingsEvent => NameTheme(value), style: Style { width_em: Some(14.0) } }), // settings_view.lui:94
        Button(ButtonAttrs { label: "Save Theme As…", id: "button Save Theme As", enabled: can_save_as(typed), on_click: SaveThemeAs }), // settings_view.lui:95
        ...(if is_saved(s) { // settings_view.lui:96
          [
            Button(ButtonAttrs { label: "Delete", id: "button Delete Theme", on_click: DeleteSavedTheme }), // settings_view.lui:97
          ]
        } else {
          []
        }),
      ]),
      ...[c in COLORS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:100
          color(s, c.1), // settings_view.lui:101
        ])],
      Text(TextAttrs { text: "Sections", class: "group" }), // settings_view.lui:103
      ...[c in SECTION_COLORS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:104
          color(s, c.1), // settings_view.lui:105
        ])],
      Text(TextAttrs { text: "Tabs", class: "group" }), // settings_view.lui:107
      ...[c in TAB_COLORS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:108
          color(s, c.1), // settings_view.lui:109
        ])],
      Text(TextAttrs { text: "Command line", class: "group" }), // settings_view.lui:111
      ...[c in COMMAND_LINE_COLORS | Field(FieldAttrs { label: c.0 }, [ // settings_view.lui:112
