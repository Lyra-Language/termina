/// From settings_view.lui, line 165.
pub let color = pure (s: Settings, field: string) -> Node<SettingsEvent> =>
  Component(Sheet {}, [
    ColorEdit(ColorEditAttrs { label: "##${field}", id: "color ${field}", value: color_named(s.colors, field), inputs: false, on_change: (v: u32) -> SettingsEvent => SetColor(field, v) }), // settings_view.lui:166
  ])

/// From settings_view.lui, line 170.
pub let ansi = pure (s: Settings, k: i64) -> Node<SettingsEvent> =>
  Component(Sheet {}, [
    ColorEdit(ColorEditAttrs { label: "##ansi${k}", id: "color ansi ${k}", value: s.colors.ansi[k], inputs: false, on_change: (v: u32) -> SettingsEvent => SetAnsi(k, v) }), // settings_view.lui:171
  ])

let settings_view_sheet = Sheet { // settings_view.lui:71
  rules: [
    StyleRule { selector: "Group.settings", style: Style { gap: Some(18.0) } },
    StyleRule { selector: "Text.group", style: Style { color: Some(col32(154, 160, 166)) } },
    StyleRule { selector: "Form", style: Style { gap: Some(12.0) } },
    StyleRule { selector: "Row.columns", style: Style { gap: Some(32.0) } },
  ],
}
