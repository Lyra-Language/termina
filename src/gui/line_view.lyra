module gui
//! The command line on ImGui (`../term/line.lyra` is the command line itself): each frame
//! ImGui's typed text, keys and mouse handed to it as its inputs — the text first, as typing
//! comes first — and it drawn into the grid's draw list.

import bindings.sdl3.{ platform }
import bindings.imgui.{
  typed_text,
  is_key_pressed,
  is_mouse_clicked,
  is_mouse_down,
  get_mouse_clicked_count,
  get_mouse_pos,
  is_window_hovered,
  set_mouse_cursor,
  get_clipboard_text,
  set_clipboard_text,
  request_text_input,
  Vec2,
  DrawList,
  MOUSE_CURSOR_TEXT_INPUT,
  KEY_A,
  KEY_C,
  KEY_D,
  KEY_E,
  KEY_K,
  KEY_L,
  KEY_U,
  KEY_V,
  KEY_W,
  KEY_X,
  KEY_Z,
  KEY_R,
  KEY_S,
  KEY_G,
  KEY_LEFT_ARROW,
  KEY_RIGHT_ARROW,
  KEY_UP_ARROW,
  KEY_DOWN_ARROW,
  KEY_HOME,
  KEY_END,
  KEY_DELETE,
  KEY_BACKSPACE,
  KEY_ENTER,
  KEY_KEYPAD_ENTER,
  KEY_ESCAPE,
  KEY_TAB,
}
import ui.draw.{ Point }
import ui.backend.{
  Key,
  Modifiers,
  Character,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  ArrowDown,
  Home,
  End,
  Delete,
  Backspace,
  Enter,
  Escape,
  Tab,
}
import editor.{
  layout,
  position,
  cells_of,
  kinds,
  Kind,
  Plain,
  Command,
  Option,
  Quoted,
  Variable,
  Operator,
  Comment,
}
import term.{
  CommandLine,
  Place,
  Outcome,
  Nothing,
  Clip,
  PasteWanted,
  LineInput,
  LineKey,
  LineText,
  Paste,
  cell_pos,
  push_rune,
  MENU_PAD,
  MENU_SHOWN,
}

/// How the command line looks.
pub struct Style {
  text: u32,
  caret: u32,
  selection: u32,
  /// The completion menu: its background, the chosen row's, and descriptions' text (and
  /// comments').
  menu: u32,
  menu_chosen: u32,
  faint: u32,
  /// The syntax's colors (`../editor/syntax.lyra`): commands, options, quoted text,
  /// variables, operators and redirections.
  command: u32,
  option: u32,
  quoted: u32,
  variable: u32,
  operator: u32,
}

/// This frame's mouse and keys (when `focused`) handed to the command line, then it drawn
/// into `list`: what it asks of the terminal. A copy or cut is put on the clipboard here, and
/// a paste read from it.
pub let update_line = (
  line: mut CommandLine,
  at: Place,
  list: DrawList,
  style: Style,
  focused: bool
) -> Outcome => {
  mouse(line, at)
  var outcome = Nothing
  if focused {
    for i in inputs(line.menu_keys) {
      match line.input(at.wrap, i) {
        Nothing => {},
        Clip(text) => set_clipboard_text(text),
        PasteWanted => {
          let _ = line.edit_action(Paste, get_clipboard_text())
        },
        other => { outcome = other },
      }
    }
    let (row, col) = position(line.edit.text, at.wrap, line.edit.cursor)
    request_text_input(vec(cell_pos(at, row, col)), at.cell.y)
  }
  draw(line, at, list, style, focused)
  outcome
}

/// The modifiers as pressed (`held`, ImGui's macOS swap undone), as the command line takes
/// them.
pub let modifiers_now = () -> Modifiers => {
  let h = held()
  let mac = platform() == "macOS"
  Modifiers {
    shift: h.shift,
    control: h.control,
    alt: h.alt,
    command: h.command,
    primary: if mac { h.command } else { h.control },
  }
}

/// This frame's inputs: the text typed, then each key the command line reads that was pressed
/// — ⌘'s A, C, X, V and Z left out when a menu bar's Edit menu has them (`menu_keys`).
let inputs = (menu_keys: bool) -> []LineInput => {
  let mods = modifiers_now()
  var out: []LineInput = []
  let typed = typed_text()
  if typed != "" { out.push(LineText(typed, mods)) }
  for (code, key) in KEYS {
    if !is_key_pressed(code) { continue }
    let edit_menus = menu_keys && mods.primary && (
      code == KEY_A || code == KEY_C || code == KEY_X || code == KEY_V || code == KEY_Z
    )
    if !edit_menus { out.push(LineKey(key, mods)) }
  }
  out
}

/// The ImGui keys the command line reads, and what each is.
const KEYS: [](i32, Key) = [
  (KEY_A, Character('a')),
  (KEY_C, Character('c')),
  (KEY_D, Character('d')),
  (KEY_E, Character('e')),
  (KEY_G, Character('g')),
  (KEY_K, Character('k')),
  (KEY_L, Character('l')),
  (KEY_R, Character('r')),
  (KEY_S, Character('s')),
  (KEY_U, Character('u')),
  (KEY_V, Character('v')),
  (KEY_W, Character('w')),
  (KEY_X, Character('x')),
  (KEY_Z, Character('z')),
  (KEY_LEFT_ARROW, ArrowLeft),
  (KEY_RIGHT_ARROW, ArrowRight),
  (KEY_UP_ARROW, ArrowUp),
  (KEY_DOWN_ARROW, ArrowDown),
  (KEY_HOME, Home),
  (KEY_END, End),
  (KEY_DELETE, Delete),
  (KEY_BACKSPACE, Backspace),
  (KEY_ENTER, Enter),
  (KEY_KEYPAD_ENTER, Enter),
  (KEY_ESCAPE, Escape),
  (KEY_TAB, Tab),
]

/// This frame's mouse handed to the command line: a click, a drag with the button held, the
/// button let go.
let mouse = (line: mut CommandLine, at: Place) -> void => {
  let m = get_mouse_pos()
  // ImGui's pointer is at -FLT_MAX when it is nowhere (outside the window, or no mouse
  // yet), which no cell arithmetic survives — floor traps on it.
  if m.x < -1.0e30 || m.y < -1.0e30 {
    if !is_mouse_down(0) { line.release() }
    return
  }
  let p = Point { x: m.x, y: m.y }
  let over = is_window_hovered() && m.y >= at.origin.y
  if over { set_mouse_cursor(MOUSE_CURSOR_TEXT_INPUT) }
  if is_mouse_clicked(0) {
    let _ = line.press(at, p, i64(get_mouse_clicked_count(0)), held().shift, over)
  } else if is_mouse_down(0) {
    line.drag(at, p)
  } else {
    line.release()
  }
}

/// A point as ImGui's.
pub let vec = pure (p: Point) -> Vec2 => Vec2 { x: p.x, y: p.y }

/// The command line drawn into `list`: its text in runs of its syntax's colors, the
/// selection under it, the caret when `focused`, and the completion menu.
let draw = (
  self: CommandLine,
  at: Place,
  list: DrawList,
  style: Style,
  focused: bool
) -> void => {
  let text = self.edit.text
  let (a, b) = self.edit.selection()
  let places = layout(text, at.wrap)
  let kind = kinds(text)
  // Text in runs of one kind, of runes a cell wide on one row; a wide rune alone, across
  // its two cells, as the grid draws one — a run's glyphs are spaced by the font, not the
  // grid.
  var run: []u8 = []
  var run_row = 0
  var run_col = 0
  var run_end = 0
  var run_color = style.text
  for k in 0..<text.len() {
    let (row, col) = places[k]
    let r = text[k]
    let w = cells_of(r)
    if k >= a && k < b {
      // A selected line break shows as a sliver, so the selection visibly spans it.
      let width = if r == '\n' { at.cell.x * 0.5 } else { f32(w) * at.cell.x }
      let p = vec(cell_pos(at, row, col))
      list.add_rect_filled(
        p,
        Vec2 { x: p.x + width, y: p.y + at.cell.y },
        style.selection
      )
    }
    let paint = color_of(style, kind[k])
    let apart = r == '\n' ||
      w == 2 ||
      row != run_row ||
      col != run_end ||
      paint != run_color
    if apart && run.len() > 0 {
      flush(list, at, run_row, run_col, run, run_color)
      run = []
    }
    if r != '\n' {
      if run.len() == 0 {
        run_row = row
        run_col = col
        run_color = paint
      }
      push_rune(run, i64(r))
      run_end = col + w
      if w == 2 {
        flush(list, at, run_row, run_col, run, run_color)
        run = []
      }
    }
  }
  flush(list, at, run_row, run_col, run, run_color)
  if focused {
    let (r, c) = position(text, at.wrap, self.edit.cursor)
    let p = vec(cell_pos(at, r, c))
    list.add_rect_filled(p, Vec2 { x: p.x + 2.0, y: p.y + at.cell.y }, style.caret)
  }
  if self.menu_rows() > 0 { draw_menu(self, at, list, style) }
}

/// The completion menu: a row each, the chosen one marked, descriptions fainter.
let draw_menu = (self: CommandLine, at: Place, list: DrawList, style: Style) -> void => {
  let (corner, _, width) = self.menu_layout(at)
  let top = vec(corner)
  let shown_rows = self.menu_rows()
  let pad = at.cell.x * 0.5
  list.add_rect_filled(
    Vec2 { x: top.x - pad, y: top.y - MENU_PAD },
    Vec2 {
      x: top.x + f32(width) * at.cell.x + pad,
      y: top.y + f32(shown_rows) * at.cell.y + MENU_PAD,
    },
    style.menu,
    6.0
  )
  var shown_w = 0
  for c in self.menu { shown_w = shown_w.max(c.shown.len().min(MENU_SHOWN)) }
  if self.menu.len() == 0 {
    list.add_text(
      Vec2 { x: top.x + at.cell.x, y: top.y + at.text_dy },
      style.faint,
      "No command in the history has that in it"
    )
    return
  }
  // A history entry is shown as wide as the list allows; a completion to its limit.
  let limit = if self.searching != None { width - 2 } else { MENU_SHOWN }
  for k in 0..<shown_rows {
    let c = self.menu[self.menu_top + k]
    let y = top.y + f32(k) * at.cell.y
    if self.menu_top + k == self.chosen {
      list.add_rect_filled(
        Vec2 { x: top.x - pad, y: y },
        Vec2 { x: top.x + f32(width) * at.cell.x + pad, y: y + at.cell.y },
        style.menu_chosen,
        4.0
      )
    }
    let shown = if c.shown.len() > limit { c.shown.slice(0, limit) } else { c.shown }
    list.add_text(Vec2 { x: top.x + at.cell.x, y: y + at.text_dy }, style.text, shown)
    if c.description != "" {
      let room = width - shown_w - 4
      if room > 0 {
        let d = if c.description.len() > room { c.description.slice(
          0,
          room
        ) } else { c.description }
        list.add_text(
          Vec2 { x: top.x + f32(shown_w + 3) * at.cell.x, y: y + at.text_dy },
          style.faint,
          d
        )
      }
    }
  }
}

/// The color a rune of `kind` is drawn in.
let color_of = pure (style: Style, kind: Kind) -> u32 => match kind {
  Plain => style.text,
  Command => style.command,
  Option => style.option,
  Quoted => style.quoted,
  Variable => style.variable,
  Operator => style.operator,
  Comment => style.faint,
}

let flush = (
  list: DrawList,
  at: Place,
  row: i64,
  col: i64,
  run: []u8,
  color: u32
) -> void => {
  if run.len() == 0 { return }
  let p = vec(cell_pos(at, row, col))
  list.add_text(Vec2 { x: p.x, y: p.y + at.text_dy }, color, run.decode_utf8())
}
