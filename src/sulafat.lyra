// sulafat — a terminal: the user's shell on a pseudo-terminal, its output drawn in a window
// and the keyboard sent back to it.
//
//   build/sulafat              the login shell ($SHELL, else /bin/sh), in the home directory
//   build/sulafat CMD [ARG…]   that program instead, in this directory (as `xterm -e`)
//
// A classic terminal, in colour, in tabs, whose command line is an editor of its own while
// zsh is at a prompt (its integration says when — shell/shell.lyra; the keys are in
// ui/command_line.lyra). Each tab is a session (session/session.lyra); a tab closes when
// its program ends, and the window with its last. ⌘V (Ctrl+Shift+V off macOS) pastes; the
// wheel scrolls back.
//
// Tabs, on a Mac: ⌘T opens one (in the shown tab's directory), ⌘W closes the shown one,
// ⌘1–⌘8 show that one and ⌘9 the last, ⌘⇧[ and ⌘⇧] the one before and after. Elsewhere
// Ctrl+Shift+T and Ctrl+Shift+W, Alt+1–9, Ctrl+PageUp and Ctrl+PageDown.

import std.env.{ lookup }
import bindings.imgui.{
  create_host,
  begin_frame,
  end_frame,
  destroy_host,
  set_window_title,
  font_file,
  push_font_float,
  pop_font,
  begin,
  end,
  begin_child,
  end_child,
  get_main_viewport,
  set_next_window_pos,
  set_next_window_size,
  get_io,
  push_style_var_vec2,
  pop_style_var,
  calc_text_size,
  get_font_size,
  is_window_focused,
  Vec2,
  Host,
  Font,
  WINDOW_FLAGS_NO_DECORATION,
  WINDOW_FLAGS_NO_NAV_INPUTS,
  WINDOW_FLAGS_NO_BACKGROUND,
  WINDOW_FLAGS_NO_SAVED_SETTINGS,
  WINDOW_FLAGS_NO_SCROLLBAR,
  WINDOW_FLAGS_NO_SCROLL_WITH_MOUSE,
  WINDOW_FLAGS_NO_BRING_TO_FRONT_ON_FOCUS,
  is_mouse_down,
  show_open_dialog,
  poll_dialog,
  FileFilter,
  Chosen,
  STYLE_VAR_WINDOW_PADDING,
  CONFIG_FLAGS_NAV_ENABLE_KEYBOARD,
  FOCUSED_FLAGS_ROOT_AND_CHILD_WINDOWS,
  CHILD_FLAGS_ALWAYS_USE_WINDOW_PADDING,
}
import session.{
  open_session,
  close_session,
  draw_session,
  tab_title,
  directory,
  Session,
  Look,
}
import bindings.menubar.{ poll_menu, set_enabled }
import settings.{
  settings_path,
  load_settings,
  save_settings,
  settings_to_json,
  font_families,
  family_for,
  Settings,
  FontFamily,
}
import ui.{
  settings_window,
  theme_of,
  clear_colour,
  OpenSettings,
  tab_command,
  menu_command,
  install_menus,
  tab_bar,
  TabBar,
  TabLabel,
  edit_action_of,
  EDIT_ITEMS,
  Fonts,
  Theme,
  TabCommand,
  NoCommand,
  NewTab,
  CloseTab,
  ShowTab
}

let main = () -> void => {
  let Some(host) = create_host("Sulafat", 960, 600, 0) else { return }
  // The keyboard is the shell's: ImGui's own navigation would take the arrows and Tab.
  let io = get_io()
  io.set_config_flags(io.config_flags() & ~CONFIG_FLAGS_NAV_ENABLE_KEYBOARD)
  // On a Mac, Sulafat's own menu bar in place of SDL's, whose Window ▸ Close takes ⌘W and
  // would close the window, and so quit, rather than the tab.
  let menus = install_menus()
  // The user's settings, the font families on offer, and the faces and theme made of them.
  let settings_file = settings_path()
  var settings = load_settings(settings_file)
  var saved = settings_to_json(settings)
  let families = font_families()
  var fonts = load_fonts(host, families, settings)
  var theme = theme_of(settings)
  var settings_open = false
  let home = lookup("HOME") ?? ""
  // A program given on the command line runs in the first tab instead of the shell,
  // without the shell's integration, where Sulafat was started; tabs opened after it run
  // the shell.
  let given = program_args().slice(1, program_args().len())
  var next_id = 0
  var sessions: []Session = []
  match open_session(given, if given.len() > 0 { lookup("PWD") } else { None }, next_id) {
    Some(s) => sessions.push(s),
    None => {},
  }
  next_id += 1
  var active = 0
  // A tab to show, chosen by a key or opened, for the tab bar to select this frame.
  var select: Maybe<i64> = Some(0)
  var title = ""
  while sessions.len() > 0 && begin_frame(host) {
    // Every tab is read every frame, shown or not, so that a program writing in a hidden
    // one never waits on a full terminal.
    for k in 0..<sessions.len() { sessions[k].step(k == active) }
    // A tab whose program has ended closes.
    var k = sessions.len() - 1
    while k >= 0 {
      if !sessions[k].alive {
        close_session(sessions[k])
        sessions = [...sessions.slice(0, k), ...sessions.slice(k + 1, sessions.len())]
        if active > k || active >= sessions.len() { active = (active - 1).max(0) }
        select = Some(active)
      }
      k -= 1
    }
    if sessions.len() == 0 { break }

    var command = tab_command(active, sessions.len(), menus)
    while let Some(tag) = poll_menu() {
      match edit_action_of(tag) {
        // Edit's items act on the tab shown.
        Some(a) => sessions[active].edit_action(a),
        None => match menu_command(tag, active, sessions.len()) {
          NoCommand => {},
          c => { command = c },
        },
      }
    }
    match command {
      NewTab => {
        match open_session([], directory(sessions[active]), next_id) {
          Some(s) => {
            sessions.push(s)
            active = sessions.len() - 1
            select = Some(active)
          },
          None => {},
        }
        next_id += 1
      },
      CloseTab => sessions[active].request_close(),
      ShowTab(n) => {
        active = n
        select = Some(n)
      },
      OpenSettings => { settings_open = true },
      NoCommand => {},
    }

    let bar = draw_window(
      sessions,
      active,
      select,
      fonts,
      theme,
      settings.line_spacing,
      home,
      command,
      menus
    )
    // The settings window, over the terminal: a change takes at once, and is kept once the
    // mouse is let go (not every frame of a slider's drag).
    let faces_were = "${settings.font_family}|${settings.font_file}"
    let ask = settings_window(settings_open, settings, families)
    if ask.choose_file {
      let _ = show_open_dialog(
        host,
        FONT_DIALOG,
        [FileFilter { name: "Fonts", extensions: "ttf;otf;ttc" }]
      )
    }
    // A font file chosen in the system's dialog becomes the font.
    match poll_dialog(host) {
      Some(Chosen(tag, path)) => if tag == FONT_DIALOG { settings.font_file = path },
      _ => {},
    }
    if ask.changed || "${settings.font_family}|${settings.font_file}" != faces_were {
      theme = theme_of(settings)
      if "${settings.font_family}|${settings.font_file}" != faces_were {
        fonts = load_fonts(host, families, settings)
      }
      fonts.size = settings.font_size
    }
    let now_json = settings_to_json(settings)
    if now_json != saved && !is_mouse_down(0) {
      let _ = save_settings(settings_file, settings)
      saved = now_json
    }
    select = None
    active = bar.shown
    match bar.closing {
      Some(n) => sessions[n].request_close(),
      None => {},
    }
    // Tabs dragged into a new order: the list put in it, the shown tab still the same one.
    if !in_order(bar.order) {
      var moved: []Session = []
      for old in bar.order { moved.push(sessions[old]) }
      sessions = moved
      for i in 0..<bar.order.len() {
        if bar.order[i] == active {
          active = i
        }
      }
    }
    if bar.add {
      match open_session([], directory(sessions[active]), next_id) {
        Some(s) => {
          sessions.push(s)
          active = sessions.len() - 1
          select = Some(active)
        },
        None => {},
      }
      next_id += 1
    }
    // Edit's items greyed out while they would do nothing in the tab shown.
    if menus {
      for (tag, a) in EDIT_ITEMS { set_enabled(tag, sessions[active].can(a)) }
    }
    let now = tab_title(sessions[active], home)
    if now != title {
      title = now
      set_window_title(host, title)
    }
    let clear = clear_colour(theme)
    end_frame(host, clear.0, clear.1, clear.2)
  }
  for s in sessions { close_session(s) }
  destroy_host(host)
}

/// The window: the tab bar, and the tab shown below it, drawn and given the keys — unless a
/// tab shortcut took them this frame. Answers what was done to the bar (`ui.tab_bar`).
let draw_window = (
  sessions: mut []Session,
  active: i64,
  select: Maybe<i64>,
  fonts: Fonts,
  theme: Theme,
  line_spacing: f32,
  home: string,
  command: TabCommand,
  menus: bool
) -> TabBar => {
  let viewport = get_main_viewport()
  set_next_window_pos(viewport.work_pos())
  set_next_window_size(viewport.work_size())
  push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, Vec2 { x: PADDING, y: PADDING })
  let flags = WINDOW_FLAGS_NO_DECORATION | WINDOW_FLAGS_NO_NAV_INPUTS |
    WINDOW_FLAGS_NO_BACKGROUND | WINDOW_FLAGS_NO_SAVED_SETTINGS | WINDOW_FLAGS_NO_SCROLLBAR |
    WINDOW_FLAGS_NO_SCROLL_WITH_MOUSE | WINDOW_FLAGS_NO_BRING_TO_FRONT_ON_FOCUS
  let _ = begin("terminal", flags)
  pop_style_var()

  let labels = [k in 0..<sessions.len() | TabLabel {
    name: "${if sessions[k].unseen { "• " } else { "" }}${tab_title(sessions[k], home)}",
    id: sessions[k].id,
  }]
  let bar = tab_bar(labels, active, select)
  let shown = bar.shown

  // The shown tab fills the rest of the window, in a child that scrolls on its own.
  push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, Vec2 { x: PADDING, y: PADDING / 2.0 })
  let _ = begin_child(
    "grid",
    Vec2 { x: 0.0, y: 0.0 },
    CHILD_FLAGS_ALWAYS_USE_WINDOW_PADDING,
    WINDOW_FLAGS_NO_NAV_INPUTS | WINDOW_FLAGS_NO_BACKGROUND
  )
  pop_style_var()
  match fonts.regular {
    Some(f) => push_font_float(f, fonts.size),
    None => {},
  }
  // A cell is one advance wide, measured over a long run: ImGui rounds a measured width up
  // to a whole pixel, which over one character overstates the advance by up to a pixel and
  // put the cursor cells to the right of the text it follows.
  let cell = Vec2 {
    x: calc_text_size(MEASURE).x / f32(MEASURE.len()),
    y: f32((get_font_size() * line_spacing).round()),
  }
  let look = Look {
    cell: cell,
    text_dy: f32(((cell.y - get_font_size()) / 2.0).floor()),
    // One display pixel, in points: what a drawn bold is offset by.
    pixel: 1.0 / get_io().display_framebuffer_scale().x.max(1.0),
    fonts: fonts,
    theme: theme,
  }
  let keys_taken = match command {
    NoCommand => false,
    _ => true,
  }
  let focused = is_window_focused(FOCUSED_FLAGS_ROOT_AND_CHILD_WINDOWS) && !keys_taken
  draw_session(sessions[shown], look, focused, menus)
  match fonts.regular {
    Some(_) => pop_font(),
    None => {},
  }
  end_child()
  end()
  bar
}

/// Whether `order` is 0, 1, 2, … — the tabs as they were.
let in_order = pure (order: []i64) -> bool => {
  for i in 0..<order.len() { if order[i] != i { return false } }
  true
}

/// The tag the font file dialog's answer comes back under.
const FONT_DIALOG: i32 = 1

/// Points between the window's edge and the grid.
const PADDING: f32 = 10.0

/// The run of characters a cell's width is measured over.
const MEASURE: string = "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"

/// Reads per frame at most — a megabyte — so that a program writing without end (`yes`)
/// cannot stop the window drawing.
const READS_PER_FRAME: i64 = 16

/// The faces the settings choose (a chosen file's, else the family's — the first family when
/// it is not installed), at the settings' size; ImGui's own face (monospaced) alone when no family is found.
let load_fonts = (host: Host, families: []FontFamily, s: Settings) -> Fonts => {
  let none = Fonts {
    regular: None,
    bold: None,
    italic: None,
    bold_italic: None,
    size: s.font_size
  }
  let Some(family) = family_for(s, families) else { return none }
  match face(host, family.regular, s.font_size) {
    Some(regular) => Fonts {
      regular: Some(regular),
      bold: face(host, family.bold, s.font_size),
      italic: face(host, family.italic, s.font_size),
      bold_italic: face(host, family.bold_italic, s.font_size),
      size: s.font_size,
    },
    None => none,
  }
}

/// A face from `path` (`None` for `""`, or a file that cannot be read). ImGui keeps one per
/// file, and a size is chosen as it is pushed, so the size here is only its first.
let face = (host: Host, path: string, size: f32) -> Maybe<Font> =>
  if path == "" { None } else { font_file(host, path, size) }
