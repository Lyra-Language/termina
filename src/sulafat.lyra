// sulafat — a terminal: the user's shell on a pseudo-terminal, its output drawn in a window
// and the keyboard sent back to it.
//
//   build/sulafat              the login shell ($SHELL, else /bin/sh), in the home directory
//   build/sulafat CMD [ARG…]   that program instead, in this directory (as `xterm -e`)
//
// A classic terminal, in colour, in tabs, whose command line is an editor of its own while
// zsh is at a prompt (its integration says when — shell/shell.lyra; the keys are in
// ui/command_line.lyra). Each tab is a session (session/session.lyra); a tab closes when
// its program ends, and the window with its last. ⌘V (Ctrl+Shift+V off macOS) pastes; the
// wheel scrolls back.
//
// Tabs, on a Mac: ⌘T opens one (in the shown tab's directory), ⌘W closes the shown one,
// ⌘1–⌘8 show that one and ⌘9 the last, ⌘⇧[ and ⌘⇧] the one before and after. Elsewhere
// Ctrl+Shift+T and Ctrl+Shift+W, Alt+1–9, Ctrl+PageUp and Ctrl+PageDown.

import std.env.{ lookup }
import bindings.imgui.{
  create_host,
  begin_frame,
  end_frame,
  destroy_host,
  set_window_title,
  font_file,
  push_font_float,
  pop_font,
  begin,
  end,
  begin_child,
  end_child,
  begin_tab_bar,
  end_tab_bar,
  begin_tab_item_closable,
  end_tab_item,
  tab_item_button,
  get_main_viewport,
  set_next_window_pos,
  set_next_window_size,
  get_io,
  push_style_var_vec2,
  pop_style_var,
  calc_text_size,
  get_font_size,
  is_window_focused,
  Vec2,
  Host,
  Font,
  WINDOW_FLAGS_NO_DECORATION,
  WINDOW_FLAGS_NO_NAV_INPUTS,
  WINDOW_FLAGS_NO_BACKGROUND,
  WINDOW_FLAGS_NO_SAVED_SETTINGS,
  WINDOW_FLAGS_NO_SCROLLBAR,
  WINDOW_FLAGS_NO_SCROLL_WITH_MOUSE,
  STYLE_VAR_WINDOW_PADDING,
  CONFIG_FLAGS_NAV_ENABLE_KEYBOARD,
  FOCUSED_FLAGS_ROOT_AND_CHILD_WINDOWS,
  CHILD_FLAGS_ALWAYS_USE_WINDOW_PADDING,
  TAB_BAR_FLAGS_FITTING_POLICY_SHRINK,
  TAB_ITEM_FLAGS_SET_SELECTED,
  TAB_ITEM_FLAGS_TRAILING,
  TAB_ITEM_FLAGS_NO_TOOLTIP,
}
import session.{
  open_session,
  close_session,
  draw_session,
  tab_title,
  directory,
  Session,
  Look,
}
import bindings.menubar.{ poll_menu }
import ui.{
  tab_command,
  menu_command,
  install_menus,
  dark_theme,
  Fonts,
  Theme,
  TabCommand,
  NoCommand,
  NewTab,
  CloseTab,
  ShowTab
}

let main = () -> void => {
  let Some(host) = create_host("Sulafat", 960, 600, 0) else { return }
  // The keyboard is the shell's: ImGui's own navigation would take the arrows and Tab.
  let io = get_io()
  io.set_config_flags(io.config_flags() & ~CONFIG_FLAGS_NAV_ENABLE_KEYBOARD)
  // On a Mac, Sulafat's own menu bar in place of SDL's, whose Window ▸ Close takes ⌘W and
  // would close the window, and so quit, rather than the tab.
  let menus = install_menus()
  let fonts = load_fonts(host)
  let theme = dark_theme()
  let home = lookup("HOME") ?? ""
  // A program given on the command line runs in the first tab instead of the shell,
  // without the shell's integration, where Sulafat was started; tabs opened after it run
  // the shell.
  let given = program_args().slice(1, program_args().len())
  var next_id = 0
  var sessions: []Session = []
  match open_session(given, if given.len() > 0 { lookup("PWD") } else { None }, next_id) {
    Some(s) => sessions.push(s),
    None => {},
  }
  next_id += 1
  var active = 0
  // A tab to show, chosen by a key or opened, for the tab bar to select this frame.
  var select: Maybe<i64> = Some(0)
  var title = ""
  while sessions.len() > 0 && begin_frame(host) {
    // Every tab is read every frame, shown or not, so that a program writing in a hidden
    // one never waits on a full terminal.
    for k in 0..<sessions.len() { sessions[k].step(k == active) }
    // A tab whose program has ended closes.
    var k = sessions.len() - 1
    while k >= 0 {
      if !sessions[k].alive {
        close_session(sessions[k])
        sessions = [...sessions.slice(0, k), ...sessions.slice(k + 1, sessions.len())]
        if active > k || active >= sessions.len() { active = (active - 1).max(0) }
        select = Some(active)
      }
      k -= 1
    }
    if sessions.len() == 0 { break }

    var command = tab_command(active, sessions.len(), menus)
    while let Some(tag) = poll_menu() {
      match menu_command(tag, active, sessions.len()) {
        NoCommand => {},
        c => { command = c },
      }
    }
    match command {
      NewTab => {
        match open_session([], directory(sessions[active]), next_id) {
          Some(s) => {
            sessions.push(s)
            active = sessions.len() - 1
            select = Some(active)
          },
          None => {},
        }
        next_id += 1
      },
      CloseTab => sessions[active].request_close(),
      ShowTab(n) => {
        active = n
        select = Some(n)
      },
      NoCommand => {},
    }

    let (
      shown,
      closing,
      add
    ) = draw_window(sessions, active, select, fonts, theme, home, command)
    select = None
    if shown != active {
      active = shown
    }
    match closing {
      Some(n) => sessions[n].request_close(),
      None => {},
    }
    if add {
      match open_session([], directory(sessions[active]), next_id) {
        Some(s) => {
          sessions.push(s)
          active = sessions.len() - 1
          select = Some(active)
        },
        None => {},
      }
      next_id += 1
    }
    let now = tab_title(sessions[active], home)
    if now != title {
      title = now
      set_window_title(host, title)
    }
    end_frame(host, BACKGROUND.0, BACKGROUND.1, BACKGROUND.2)
  }
  for s in sessions { close_session(s) }
  destroy_host(host)
}

/// The window: the tab bar, and the tab shown below it, drawn and given the keys — unless a
/// tab shortcut took them this frame. Answers the tab now shown (a click may have chosen
/// another), one whose close button was pressed, and whether `+` was.
let draw_window = (
  sessions: mut []Session,
  active: i64,
  select: Maybe<i64>,
  fonts: Fonts,
  theme: Theme,
  home: string,
  command: TabCommand
) -> (i64, Maybe<i64>, bool) => {
  let viewport = get_main_viewport()
  set_next_window_pos(viewport.work_pos())
  set_next_window_size(viewport.work_size())
  push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, Vec2 { x: PADDING, y: PADDING / 2.0 })
  let flags = WINDOW_FLAGS_NO_DECORATION | WINDOW_FLAGS_NO_NAV_INPUTS |
    WINDOW_FLAGS_NO_BACKGROUND | WINDOW_FLAGS_NO_SAVED_SETTINGS | WINDOW_FLAGS_NO_SCROLLBAR |
    WINDOW_FLAGS_NO_SCROLL_WITH_MOUSE
  let _ = begin("terminal", flags)
  pop_style_var()

  var shown = active
  var closing: Maybe<i64> = None
  var add = false
  if begin_tab_bar("tabs", TAB_BAR_FLAGS_FITTING_POLICY_SHRINK) {
    for k in 0..<sessions.len() {
      var open = true
      let chosen = match select {
        Some(n) => if n == k { TAB_ITEM_FLAGS_SET_SELECTED } else { 0 },
        None => 0,
      }
      // The label after `###` is the tab's identity, which a changing title must not move.
      let mark = if sessions[k].unseen { "• " } else { "" }
      let label = "${mark}${tab_title(sessions[k], home)}###tab${sessions[k].id}"
      if begin_tab_item_closable(label, open, chosen) {
        shown = k
        end_tab_item()
      }
      if !open { closing = Some(k) }
    }
    if tab_item_button(
      "+",
      TAB_ITEM_FLAGS_TRAILING | TAB_ITEM_FLAGS_NO_TOOLTIP
    ) { add = true }
    end_tab_bar()
  }
  // A tab chosen by a key this frame is shown now, whatever the bar has yet caught up with.
  match select {
    Some(n) => { shown = n },
    None => {},
  }
  shown = shown.clamp(0, sessions.len() - 1)

  // The shown tab fills the rest of the window, in a child that scrolls on its own.
  push_style_var_vec2(STYLE_VAR_WINDOW_PADDING, Vec2 { x: PADDING, y: PADDING / 2.0 })
  let _ = begin_child(
    "grid",
    Vec2 { x: 0.0, y: 0.0 },
    CHILD_FLAGS_ALWAYS_USE_WINDOW_PADDING,
    WINDOW_FLAGS_NO_NAV_INPUTS | WINDOW_FLAGS_NO_BACKGROUND
  )
  pop_style_var()
  match fonts.regular {
    Some(f) => push_font_float(f, FONT_SIZE),
    None => {},
  }
  // A cell is one advance wide, measured over a long run: ImGui rounds a measured width up
  // to a whole pixel, which over one character overstates the advance by up to a pixel and
  // put the cursor cells to the right of the text it follows.
  let cell = Vec2 {
    x: calc_text_size(MEASURE).x / f32(MEASURE.len()),
    y: f32((get_font_size() * LINE_SPACING).round()),
  }
  let look = Look {
    cell: cell,
    text_dy: f32(((cell.y - get_font_size()) / 2.0).floor()),
    // One display pixel, in points: what a drawn bold is offset by.
    pixel: 1.0 / get_io().display_framebuffer_scale().x.max(1.0),
    fonts: fonts,
    theme: theme,
  }
  let keys_taken = match command {
    NoCommand => false,
    _ => true,
  }
  let focused = is_window_focused(FOCUSED_FLAGS_ROOT_AND_CHILD_WINDOWS) && !keys_taken
  draw_session(sessions[shown], look, focused)
  match fonts.regular {
    Some(_) => pop_font(),
    None => {},
  }
  end_child()
  end()
  (shown, closing, add)
}

/// The window's own background is the theme's (`ui/theme.lyra`'s `#181A1E`), cleared to
/// before anything is drawn.
const BACKGROUND: (f32, f32, f32) = (0.094, 0.102, 0.118)

/// Points between the window's edge and the grid.
const PADDING: f32 = 10.0

/// The text's size in points, and the line's height as a multiple of it.
const FONT_SIZE: f32 = 14.0
const LINE_SPACING: f32 = 1.2

/// The run of characters a cell's width is measured over.
const MEASURE: string = "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"

/// Reads per frame at most — a megabyte — so that a program writing without end (`yes`)
/// cannot stop the window drawing.
const READS_PER_FRAME: i64 = 16

/// The first monospaced family found among the system's — its regular face, and the bold,
/// italic and bold italic ones it has — or ImGui's own face (which is monospaced) alone.
let load_fonts = (host: Host) -> Fonts => {
  for family in FAMILIES {
    match font_file(host, family.0, FONT_SIZE) {
      Some(regular) => return Fonts {
        regular: Some(regular),
        bold: face(host, family.1),
        italic: face(host, family.2),
        bold_italic: face(host, family.3),
        size: FONT_SIZE,
      },
      None => {},
    }
  }
  Fonts { regular: None, bold: None, italic: None, bold_italic: None, size: FONT_SIZE }
}

/// Monospaced families: regular, bold, italic and bold italic files (`""` for a face the
/// family has no file of). macOS's SF Mono is one variable font, so its bold is drawn.
const FAMILIES: [](string, string, string, string) = [
  ("/System/Library/Fonts/SFNSMono.ttf", "", "/System/Library/Fonts/SFNSMonoItalic.ttf", ""),
  ("/System/Library/Fonts/Menlo.ttc", "", "", ""),
  (
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Oblique.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-BoldOblique.ttf",
  ),
  (
    "/usr/share/fonts/TTF/DejaVuSansMono.ttf",
    "/usr/share/fonts/TTF/DejaVuSansMono-Bold.ttf",
    "/usr/share/fonts/TTF/DejaVuSansMono-Oblique.ttf",
    "/usr/share/fonts/TTF/DejaVuSansMono-BoldOblique.ttf",
  ),
  (
    "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono.ttf",
    "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono-Bold.ttf",
    "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono-Oblique.ttf",
    "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono-BoldOblique.ttf",
  ),
]

let face = (host: Host, path: string) -> Maybe<Font> =>
  if path == "" { None } else { font_file(host, path, FONT_SIZE) }
