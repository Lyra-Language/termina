module menus
//! Termina's menus, described once (`../menus_view.lui`) and shown one of two ways: in the
//! Mac's own menu bar, replacing SDL's — whose Window ▸ Close took ⌘W and closed the window,
//! and so the app, rather than the tab — or, off macOS, as ImGui's main menu bar along the
//! window's top. Either way a choice is a [MenuChoice], carried out by `../termina.lyra`.
//!
//! **On a Mac the tree is installed once** ([install_native]): its shape never changes there
//! (the tabs are listed only in the menu Termina draws), and each frame sets the installed
//! items' greying from the tree as it is now ([sync_native]). The first menu is the
//! application menu, whose Quit macOS makes, and the Window menu is macOS's standard one.
//! A key equivalent reaches SDL too, so `ui.tab_command` leaves the menus' keys alone there.
//!
//! **Off macOS the keys stay keys**: a shortcut is read where it acts (`ui.tab_command`, the
//! command line, the session), and an item only shows it. ImGui's main menu bar takes its
//! height off the viewport's work area, which the terminal's window fills, so the tabs move
//! down below it.

import bindings.imgui.{
  get_style,
  push_style_var_vec2,
  pop_style_var,
  Vec2,
  Host,
  STYLE_VAR_FRAME_PADDING,
  COL_TEXT,
  begin_title_bar,
  title_bar_title,
  title_bar_end,
  title_bar_button,
  title_bar_button_width,
  open_popup,
  begin_popup,
  end_popup,
  set_next_window_pos,
  get_window_draw_list,
  get_item_rect_min,
  get_item_rect_max,
  get_color_u32,
  get_font_size,
}
import bindings.imgui.ui.{
  Node,
  Menu,
  MenuItem,
  Separator,
  MainMenuBar,
  Component,
  Fragment,
  MenuItemAttrs,
  render,
  menu_items,
}
import bindings.menubar
import menus_view.{ MenuChoice, Tabs, PreviousTab, NextTab }
import term.{
  TabCommand,
  NoCommand,
  NewTab,
  ShowTab,
}

/// The menus installed in the Mac's menu bar; the choice each tag stands for, in tag order.
/// `None` where there is no native bar — off macOS, or before SDL has an application.
pub let install_native = (menus: []Node<MenuChoice>) -> Maybe<[]MenuChoice> => {
  var choices: []MenuChoice = []
  for i, node in bar_menus(menus) {
    let Menu(m, entries) = node else { continue }
    if i == 0 { menubar.app_menu() } else { menubar.menu(m.label) }
    for entry in flat(entries) {
      match entry {
        MenuItem(it) => {
          let (key, held) = native_key(it)
          menubar.item(it.label, key, held, i32(choices.len()))
          choices.push(it.on_select)
        },
        Separator => menubar.separator(),
        _ => {},
      }
    }
  }
  menubar.window_menu()
  if !menubar.install("Termina") { return None }
  Some(choices)
}

/// The menus on the bar `nodes` describe, looking through the component and the bar
/// around them.
/// A menu's entries with the components and fragments that hold some opened in place: the
/// items, separators and submenus as the menu shows them.
let flat = pure (nodes: []Node<MenuChoice>) -> []Node<MenuChoice> => {
  var out: []Node<MenuChoice> = []
  for node in nodes {
    match node {
      Component(_, children) => { out = [...out, ...flat(children)] },
      Fragment(children) => { out = [...out, ...flat(children)] },
      _ => out.push(node),
    }
  }
  out
}

let bar_menus = pure (nodes: []Node<MenuChoice>) -> []Node<MenuChoice> => {
  var out: []Node<MenuChoice> = []
  for node in nodes {
    match node {
      Menu(_, _) => out.push(node),
      MainMenuBar(children) => { out = [...out, ...bar_menus(children)] },
      Component(_, children) => { out = [...out, ...bar_menus(children)] },
      Fragment(children) => { out = [...out, ...bar_menus(children)] },
      _ => {},
    }
  }
  out
}

/// The installed items' checkmarks and greying set from `menus` — the tree they were
/// installed from, as it is this frame.
pub let sync_native = (menus: []Node<MenuChoice>) -> void => {
  for tag, it in menu_items(menus) {
    menubar.set_checked(i32(tag), it.checked)
    menubar.set_enabled(i32(tag), it.enabled)
  }
}

/// The choices made in the Mac's bar since the last frame.
pub let native_choices = (installed: []MenuChoice) -> []MenuChoice => {
  var chosen: []MenuChoice = []
  while let Some(tag) = menubar.poll_menu() {
    if tag >= 0 && i64(tag) < installed.len() { chosen.push(installed[tag]) }
  }
  chosen
}

/// The menus as ImGui's main menu bar; the choices made this frame. `seen` is called after
/// each menu and item is drawn (a test finds them by it).
pub let draw_menu_bar = (
  menus: []Node<MenuChoice>,
  seen: (Node<MenuChoice>) -> void
) -> []MenuChoice => {
  // Taller than ImGui's own, the menus' names with room above and below: the bar's height
  // is its frame padding's, around the text, and the names are placed by it too — so it
  // stays pushed until the bar ends.
  let pad = get_style().frame_padding()
  push_style_var_vec2(
    STYLE_VAR_FRAME_PADDING,
    Vec2 { x: pad.x, y: pad.y + MENU_BAR_EXTRA }
  )
  let chosen = render(menus, seen)
  pop_style_var()
  chosen
}

/// The menus as a GNOME header bar along the window's top, where Termina draws the window's
/// title bar (`HOST_CUSTOM_TITLE_BAR`, off macOS), as Ubuntu's terminal has it: a `+`
/// button (a new tab) at its left, `title` in its middle, a ☰ button before the window's
/// buttons opening `menu` — its items — under itself; the choices made this frame. The
/// buttons are the bar's full height, as the window's are. `seen` is called with the menu's
/// nodes, `after_button` with each button's name once drawn (`New Tab`, `Menu`, and the
/// window's), for a test to find them by.
pub let draw_header_bar = (
  host: Host,
  title: string,
  menu: []Node<MenuChoice>,
  seen: (Node<MenuChoice>) -> void,
  after_button: (string) -> void
) -> []MenuChoice => {
  // Half again as tall as the bar Termina draws elsewhere (the font and its padding twice),
  // all of it padding, so the title stays centred; the buttons, which the host sizes from
  // the bar, grow with it.
  let pad = get_style().frame_padding()
  let font = get_font_size()
  let classic = font + 2.0 * (pad.y + MENU_BAR_EXTRA)
  push_style_var_vec2(
    STYLE_VAR_FRAME_PADDING,
    Vec2 { x: pad.x, y: (HEADER_SCALE * classic - font) / 2.0 }
  )
  if !begin_title_bar(host, after_button) {
    pop_style_var()
    return []
  }
  var chosen: []MenuChoice = []
  if title_bar_button(host, "New Tab", after_button) { chosen.push(Tabs(NewTab)) }
  draw_glyph(PlusGlyph)
  title_bar_title(host, title, title_bar_button_width(host))
  if title_bar_button(host, "Menu", after_button) { let _ = open_popup(HEADER_MENU) }
  draw_glyph(MenuGlyph)
  // The menu under its button, their right edges together. Begun inside the bar, where the
  // button opened it: a popup is found by the window it was opened in.
  let under = get_item_rect_max()
  set_next_window_pos(under, 0, Vec2 { x: 1.0, y: 0.0 })
  if begin_popup(HEADER_MENU) {
    chosen = [...chosen, ...render(menu, seen)]
    end_popup()
  }
  title_bar_end(host, after_button)
  pop_style_var()
  chosen
}

/// The header bar's menu's popup.
const HEADER_MENU: string = "##header menu"

/// The glyphs drawn on the header bar's buttons, which the interface's font has none of at
/// the bar's size.
data Glyph = PlusGlyph | MenuGlyph

/// `glyph` over the button just drawn (ImGui's last item): lines in the text's color, in
/// proportion to the bar.
let draw_glyph = (glyph: Glyph) -> void => {
  let lo = get_item_rect_min()
  let hi = get_item_rect_max()
  let mid = Vec2 {
    x: f32(((lo.x + hi.x) / 2.0).round()),
    y: f32(((lo.y + hi.y) / 2.0).round())
  }
  let bar = hi.y - lo.y
  let half = f32((bar * 0.2).round())
  let width = (bar / 24.0).max(1.5)
  let ink = get_color_u32(COL_TEXT)
  let list = get_window_draw_list()
  match glyph {
    PlusGlyph => {
      list.add_line(
        Vec2 { x: mid.x - half, y: mid.y },
        Vec2 { x: mid.x + half, y: mid.y },
        ink,
        width
      )
      list.add_line(
        Vec2 { x: mid.x, y: mid.y - half },
        Vec2 { x: mid.x, y: mid.y + half },
        ink,
        width
      )
    },
    MenuGlyph => {
      let step = f32((bar * 0.13).round())
      // Typed: an untyped float array's elements reach the backend as doubles beside an
      // f32 (lyra todo.md, "A float literal array's element times an f32").
      let rows: []f32 = [-1.0, 0.0, 1.0]
      for k in rows {
        let y = mid.y + k * step
        list.add_line(
          Vec2 { x: mid.x - half, y: y },
          Vec2 { x: mid.x + half, y: y },
          ink,
          width
        )
      }
    },
  }
}

/// How much taller the header bar is than the bar Termina draws where it has none.
const HEADER_SCALE: f32 = 1.5

/// Points added above and below the menus' names on the bar.
const MENU_BAR_EXTRA: f32 = 4.0

/// The tab command a choice stands for, with `active` shown of `count`; `NoCommand` for
/// one that is not the tabs'.
pub let tab_command_of = pure (
  choice: MenuChoice,
  active: i64,
  count: i64
) -> TabCommand =>
  match choice {
    Tabs(c) => c,
    PreviousTab => ShowTab((active - 1) %% count),
    NextTab => ShowTab((active + 1) %% count),
    _ => NoCommand,
  }

/// An item's key equivalent for the Mac, and the modifiers held with it.
let native_key = pure (it: MenuItemAttrs<MenuChoice>) -> (string, u32) =>
  match it.shortcut {
    Some(s) => (
      s.key,
      (if s.primary { menubar.COMMAND } else { 0 }) |
        (if s.shift { menubar.SHIFT } else { 0 }) |
        (if s.alt { menubar.OPTION } else { 0 })
    ),
    None => ("", 0),
  }
