module shell
//! Shell integration: what a shell is given at start so that it tells the terminal where its
//! prompts and commands are. With it, Sulafat knows when the shell is waiting for a command —
//! and the command line is Sulafat's editor — and when a program is running and the keys are
//! that program's.
//!
//! The shell reports through OSC 133 (FinalTerm's marks, as iTerm2, kitty and WezTerm use
//! them): `A` a prompt begins, `B` the prompt has been drawn and input begins, `C` a command
//! is running and its output begins, `D;status` it ended. OSC 7 reports the directory.
//!
//! **Tab completion is the shell's own.** Sulafat writes the command line to a request file
//! and sends a key bound to a widget here. zsh's loads it into zsh's buffer and runs zsh's
//! completion system with `compadd` captured; bash's runs what readline would — the
//! command's compspec (`complete -p`, bash-completion's loaded on demand), its `-F`
//! function with `COMP_*` set, its other options through `compgen` — so the user's
//! completion settings, plugins and directory all apply. Each reports each match (OSC
//! 7770) without inserting or listing any. Its messages are `b` (begin), `m;<prefix>;<insert>;<suffix>;<shown>;<description>`
//! (a match, each field percent-encoded) and `e` (end); `vt.Screen` collects them.
//!
//! **Keys typed ahead** — typed while a command ran, and not read by it — are still on the
//! terminal when zsh starts its next line, and zsh's own line editor would take them into
//! a buffer hidden under Sulafat's. A `zle-line-init` hook (wrapping the user's own) reads
//! them first and reports them raw, as OSC 7770 `t;<keys>` (percent-encoded); Sulafat
//! interprets them (`../ui/typeahead.lyra`).
//!
//! **zsh** is reached through `ZDOTDIR`: zsh reads `$ZDOTDIR/.zshenv` first, and Sulafat's
//! puts the user's `ZDOTDIR` back, reads their `.zshenv`, and adds two hooks — so their
//! `.zprofile`, `.zshrc` and `.zlogin` are read from their own directory as always.
//!
//! **bash** is started `bash --rcfile <Sulafat's> -i`: an rc file is read only by an
//! interactive shell that is not a login one, so Sulafat's reads what `bash -l` would —
//! `/etc/profile`, then the first of `~/.bash_profile`, `~/.bash_login` and `~/.profile`
//! (Ubuntu's reads `~/.bashrc`) — and then adds the marks: `D`, OSC 7 and `A` from the
//! front of `PROMPT_COMMAND`, `B` at the end of `PS1` from its back (after a theme's prompt
//! command has rebuilt it), `C` from `PS0`. Keys typed ahead are read at the end of
//! `PROMPT_COMMAND`, before readline starts, and reported as zsh's are, a moment before the
//! prompt rather than after it — the command line keeps them until the prompt comes. The
//! hooks need `PS0`, so a bash older than 4.4 (macOS's own is 3.2) is a classic terminal.
//! bash's completion function is given the word unquoted: bash-completion quotes it once
//! more for `compgen`, counting on two dequotings in a real completion (bash's and
//! readline's), and outside one there is only bash's. bash's matches have no descriptions.
//!
//! Other shells run without integration: a classic terminal, keys to the shell.

import std.env.{ lookup }
import std.io.{ write_file, create_dir_all, read_bytes }
import std.path

/// What a shell with Sulafat's integration is started with: its command line, its
/// environment, as `NAME=value` entries for `bindings.pty`'s `spawn`, and the file
/// completion requests are written to.
pub struct Integration {
  args: []string,
  env: []string,
  request: string,
}

/// The integration for `shell` (a path, as `$SHELL` holds it), its files written; `None` for
/// a shell it has none for, or when they could not be written. Each window has a request
/// file of its own, named by `id`.
pub let integration = (shell: string, id: string) -> Maybe<Integration> => {
  let name = shell.base()
  if name == "zsh" {
    let Some(dir) = integration_dir("zsh", ".zshenv", ZSHENV) else { return None }
    let request = dir.join("request-${id}")
    return Some(Integration {
      args: [shell, "-l"],
      env: [
        "ZDOTDIR=${dir}",
        "SULAFAT_ORIG_ZDOTDIR=${lookup("ZDOTDIR") ?? ""}",
        "SULAFAT_SHELL_INTEGRATION=1",
        "SULAFAT_COMPLETE_FILE=${request}",
      ],
      request: request,
    })
  }
  if name == "bash" {
    let Some(dir) = integration_dir("bash", "rc.bash", BASHRC) else { return None }
    let request = dir.join("request-${id}")
    return Some(Integration {
      args: [shell, "--rcfile", dir.join("rc.bash"), "-i"],
      env: ["SULAFAT_SHELL_INTEGRATION=1", "SULAFAT_COMPLETE_FILE=${request}"],
      request: request,
    })
  }
  None
}

/// Ask the shell for the completions of `text` with the caret at rune `cursor`: the request
/// written, and the key that runs the shell's widget on it, to be sent to the shell. `None`
/// when the file cannot be written.
pub let completion_request = (
  i: Integration,
  text: string,
  cursor: i64
) -> Maybe<string> =>
  if write_file(
    i.request,
    "${cursor}\n${text}"
  ) { Some(COMPLETE_KEY) } else { None }

/// The key zsh's completion widget is bound to: a private CSI no keyboard sends.
const COMPLETE_KEY: string = "\e[9898~"

/// What the shell is sent to run `command`. Through bracketed paste when the shell has it
/// on (zsh does at its prompt), so that a command of several lines reaches the shell's line
/// editor as one, its line breaks literal; then Return. The paste's own end marker cannot
/// be in it: ESC is dropped.
pub let submission = pure (command: string, bracketed: bool) -> string => {
  if command == "" { return "\r" }
  if bracketed { "\e[200~${command.replace("\e", "")}\e[201~\r" } else { "${command}\r" }
}

/// The shell's saved history, oldest first, for the command line's ↑: zsh's `$HISTFILE`, or
/// `.zsh_history` in `ZDOTDIR` or the home directory; bash's `$HISTFILE`, or
/// `~/.bash_history`. At most [HISTORY_LIMIT] entries, a command repeated in a row kept
/// once; empty for another shell or no file.
pub let load_history = (shell: string) -> []string => {
  let name = shell.base()
  if name == "zsh" {
    let home = lookup("ZDOTDIR") ?? lookup("HOME") ?? ""
    let file = lookup("HISTFILE") ?? home.join(".zsh_history")
    let Some(bytes) = read_bytes(file) else { return [] }
    return parse_zsh_history(bytes)
  }
  if name == "bash" {
    let file = lookup("HISTFILE") ?? (lookup("HOME") ?? "").join(".bash_history")
    let Some(bytes) = read_bytes(file) else { return [] }
    return parse_bash_history(bytes)
  }
  []
}

/// History entries kept at most.
pub const HISTORY_LIMIT: i64 = 2000

/// zsh's history file as entries. Each is a line, extended (`: <time>:<duration>;<command>`)
/// or plain; a command of several lines has each line but the last ending in `\`. zsh
/// writes it *metafied*: a byte zsh treats specially is written as 0x83 then the byte with
/// bit 5 flipped, which is undone before the bytes are read as UTF-8.
pub let parse_zsh_history = pure (bytes: []u8) -> []string => {
  var raw: []u8 = []
  var i = 0
  while i < bytes.len() {
    if bytes[i] == 0x83 && i + 1 < bytes.len() {
      raw.push(bytes[i + 1] ~ 32)
      i += 2
    } else {
      raw.push(bytes[i])
      i += 1
    }
  }
  var out: []string = []
  var pending = ""
  for line in raw.decode_utf8().split("\n") {
    if line.ends_with("\\") {
      pending = "${pending}${line.slice(0, line.len() - 1)}\n"
    } else {
      let whole = strip_extended("${pending}${line}")
      pending = ""
      if whole != "" && (out.len() == 0 || out[out.len() - 1] != whole) { out.push(whole) }
    }
  }
  if out.len() > HISTORY_LIMIT { out.slice(
    out.len() - HISTORY_LIMIT,
    out.len()
  ) } else { out }
}

/// bash's history file as entries: a line each, but the `#<seconds>` lines `HISTTIMEFORMAT`
/// writes before each, which are times, not commands.
pub let parse_bash_history = pure (bytes: []u8) -> []string => {
  var out: []string = []
  for line in bytes.decode_utf8().split("\n") {
    if line != "" && !is_time_stamp(line) && (out.len() == 0 || out[out.len() - 1] != line) { out.push(line) }
  }
  if out.len() > HISTORY_LIMIT { out.slice(
    out.len() - HISTORY_LIMIT,
    out.len()
  ) } else { out }
}

/// Whether a bash history line is a time, `#` and digits.
let is_time_stamp = pure (line: string) -> bool => {
  if line.len() < 2 || !line.starts_with("#") { return false }
  for r in line.slice(
    1,
    line.len()
  ).to_runes() { if !r.is_ascii_digit() { return false } }
  true
}

/// A history line without the extended format's `: <time>:<duration>;` in front.
let strip_extended = pure (line: string) -> string => {
  if !line.starts_with(": ") { return line }
  match line.index(";") {
    Some(k) => line.slice(k + 1, line.len()),
    None => line,
  }
}

/// The directory holding a shell's integration, its file `name` written there now as `text`
/// (each start, so that a newer Sulafat's replaces an older one's):
/// `$XDG_CACHE_HOME/sulafat/<shell>`, else `~/.cache/…`.
let integration_dir = (shell: string, name: string, text: string) -> Maybe<string> => {
  let cache = match lookup("XDG_CACHE_HOME") {
    Some(d) => if d == "" { "${lookup("HOME") ?? "/tmp"}/.cache" } else { d },
    None => "${lookup("HOME") ?? "/tmp"}/.cache",
  }
  let dir = cache.join("sulafat").join(shell)
  if !create_dir_all(dir) { return None }
  if !write_file(dir.join(name), text) { return None }
  Some(dir)
}

/// zsh's integration. The `B` mark goes at the end of `PS1` rather than in a `zle-line-init`
/// widget, because a widget runs before the prompt is drawn on some versions, and the mark
/// must sit where input begins. Its precmd hook moves itself last, so that a theme that
/// rebuilds `PS1` in its own hook (powerlevel10k, starship) has done so before the mark is
/// added — from the second prompt on; the first may lack the mark under such a theme, and
/// is then a classic prompt.
const ZSHENV: string = ##`# Sulafat's shell integration, loaded through ZDOTDIR, which is put back first.
# Written by Sulafat at each start; edits here are lost.
if [[ -n "$SULAFAT_ORIG_ZDOTDIR" ]]; then ZDOTDIR="$SULAFAT_ORIG_ZDOTDIR"; else builtin unset ZDOTDIR; fi
builtin unset SULAFAT_ORIG_ZDOTDIR
[[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]] && builtin source "${ZDOTDIR:-$HOME}/.zshenv"
if [[ -o interactive ]]; then
  builtin autoload -Uz add-zsh-hook
  typeset -g _sulafat_ran=
  _sulafat_precmd() {
    local s=$?
    [[ -n $_sulafat_ran ]] && builtin printf '\e]133;D;%s\a' $s
    _sulafat_ran=
    builtin printf '\e]7;file://%s%s\a' "${HOST}" "${PWD}"
    builtin printf '\e]133;A\a'
    if [[ ${precmd_functions[-1]} != _sulafat_precmd ]]; then
      precmd_functions=(${precmd_functions:#_sulafat_precmd} _sulafat_precmd)
    fi
    [[ $PS1 == *$'\e]133;B\a'* ]] || PS1="${PS1}%{"$'\e]133;B\a'"%}"
  }
  _sulafat_preexec() {
    _sulafat_ran=1
    builtin printf '\e]133;C\a'
  }
  add-zsh-hook precmd _sulafat_precmd
  add-zsh-hook preexec _sulafat_preexec

  # Tab completion for the command line Sulafat edits: the request file holds the caret's
  # offset, a newline and the text; each match is reported (OSC 7770) and none is added.
  _sulafat_enc() {
    local s=${1//\%/%25}
    s=${s//;/%3B}
    s=${s//$'\n'/%0A}
    s=${s//$'\t'/%09}
    s=${s//$'\e'/}
    s=${s//$'\a'/}
    REPLY=$s
  }
  _sulafat_capture() {
    compadd() {
      # A compadd that only asks (-O, -A, -D) is a completion function's own business.
      if [[ ${@[1,(i)(-|--)]} == *-(O|A|D)\ * ]]; then builtin compadd "$@"; return; fi
      local -a hits dscr
      local -A o
      zparseopts -A o -E P: S: p: s: i: I: W: d: J: V: X: x: r: R: F: E: M: o:: a k q Q f e n U l 1 2 C
      [[ -n ${o[-d]} ]] && dscr=( "${(@P)o[-d]}" )
      builtin compadd -A hits -D dscr "$@"
      (( $#hits )) || return 1
      local h i=0 ins shown suf desc dir pre
      for h in $hits; do
        (( i++ ))
        (( _sulafat_count >= 500 )) && return 0
        (( _sulafat_count++ ))
        if (( $+o[-Q] )) || [[ -n $QIPREFIX ]]; then ins=$h; shown=${(Q)h}; else ins=${(q)h}; shown=$h; fi
        ins="${o[-P]}${o[-p]}${ins}"
        suf=${o[-S]- }
        if (( $+o[-f] )); then
          dir=${o[-W]-${o[-p]}}
          [[ -d ${~dir}${(Q)h} ]] && suf=/
        fi
        # Inside quotes, close them after a match that is finished.
        [[ -n $QIPREFIX && $suf != / ]] && suf="${QIPREFIX[1]}${suf}"
        desc=${dscr[i]}
        if [[ $desc == *' -- '* ]]; then desc=${desc#* -- }; else desc=; fi
        _sulafat_enc "${QIPREFIX}${IPREFIX}"; pre=$REPLY
        _sulafat_enc "$ins"; ins=$REPLY
        _sulafat_enc "$suf"; suf=$REPLY
        _sulafat_enc "$shown"; shown=$REPLY
        _sulafat_enc "$desc"; desc=$REPLY
        builtin printf '\e]7770;m;%s;%s;%s;%s;%s\a' "$pre" "$ins" "$suf" "$shown" "$desc"
      done
      return 0
    }
    _main_complete
    builtin unfunction compadd
    compstate[insert]=''
    compstate[list]=''
  }
  _sulafat_complete() {
    if (( ! $+functions[_main_complete] )); then
      builtin autoload -Uz compinit && compinit -i -d "${SULAFAT_COMPLETE_FILE:h}/zcompdump"
    fi
    local f=$SULAFAT_COMPLETE_FILE data
    [[ -r $f ]] || return 0
    data=$(<$f)
    BUFFER=${data#*$'\n'}
    CURSOR=${data%%$'\n'*}
    typeset -gi _sulafat_count=0
    builtin printf '\e]7770;b\a'
    zle _sulafat_complete_word
    builtin printf '\e]7770;e\a'
    BUFFER=
    CURSOR=0
  }
  # Keys typed ahead: at the start of each line, before zsh's line editor reads them, read
  # whatever is waiting and report it (OSC 7770 t), controls and `%`/`;` as %XX.
  _sulafat_line_init() {
    (( $+widgets[_sulafat_orig_line_init] )) && zle _sulafat_orig_line_init -- "$@"
    (( PENDING )) || return 0
    local c h out=
    while builtin read -k 1 -s -t 0 c; do
      if [[ $c == [[:cntrl:]] || $c == '%' || $c == ';' ]]; then
        builtin printf -v h '%%%02X' "'$c"
        out+=$h
      else
        out+=$c
      fi
    done
    [[ -n $out ]] && builtin printf '\e]7770;t;%s\a' "$out"
    return 0
  }
  _sulafat_bind() {
    zle -C _sulafat_complete_word complete-word _sulafat_capture
    zle -N _sulafat_complete
    # The user's own zle-line-init, if their .zshrc made one, still runs — first.
    if (( $+widgets[zle-line-init] )) && [[ ${widgets[zle-line-init]} != *_sulafat_line_init* ]]; then
      zle -A zle-line-init _sulafat_orig_line_init
    fi
    zle -N zle-line-init _sulafat_line_init
    # Bound once the user's .zshrc has chosen emacs or vi keys, in every keymap.
    local m
    for m in emacs viins vicmd; do builtin bindkey -M $m '\e[9898~' _sulafat_complete; done
    add-zsh-hook -d precmd _sulafat_bind
  }
  add-zsh-hook precmd _sulafat_bind
fi
`##

/// bash's integration (see the module's notes). `PS0` cannot run a command in this shell — a
/// `$(…)` there runs in a subshell — so `C` is a substring of itself whose length is an
/// arithmetic expression: its whole length while no command has run since the prompt,
/// noting that one has as it is worked out, and nothing after.
/// Each hook gives back the `$?` it found, for the user's prompt commands after it.
const BASHRC: string = ##`# Sulafat's bash integration, read through --rcfile in place of ~/.bashrc.
# Written by Sulafat at each start; edits here are lost.
# What a login shell reads, as `bash -l` would: an --rcfile is read only by a shell that
# is interactive and not a login one, which is how Sulafat starts bash.
[ -r /etc/profile ] && . /etc/profile
if [ -r "$HOME/.bash_profile" ]; then . "$HOME/.bash_profile"
elif [ -r "$HOME/.bash_login" ]; then . "$HOME/.bash_login"
elif [ -r "$HOME/.profile" ]; then . "$HOME/.profile"
fi
# The hooks need PS0 (bash 4.4); an older bash is a classic terminal.
if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )); then
  _sulafat_ran=
  _sulafat_precmd() {
    local s=$?
    [[ -n $_sulafat_ran ]] && builtin printf '\e]133;D;%s\a' "$s"
    _sulafat_ran=
    builtin printf '\e]7;file://%s%s\a' "$HOSTNAME" "$PWD"
    builtin printf '\e]133;A\a'
    return $s
  }
  # Last: B at the end of PS1, which a prompt command before may have rebuilt; then keys
  # typed ahead, read before readline would take them (OSC 7770 t), controls and %/; as %XX.
  _sulafat_prompt() {
    local s=$? c h out=
    [[ $PS1 == *'133;B'* ]] || PS1="${PS1}"'\[\e]133;B\a\]'
    # `read -n` puts the terminal in non-canonical mode while it waits, so a line half typed
    # is read too; `-t 0` alone would see only whole lines.
    while IFS= builtin read -r -s -n 1 -d '' -t 0.001 c; do
      if [[ $c == [[:cntrl:]] || $c == '%' || $c == ';' ]]; then
        builtin printf -v h '%%%02X' "'$c"
        out+=$h
      else
        out+=$c
      fi
    done
    [[ -n $out ]] && builtin printf '\e]7770;t;%s\a' "$out"
    return $s
  }
  if [[ $(builtin declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a"* ]]; then
    PROMPT_COMMAND=(_sulafat_precmd "${PROMPT_COMMAND[@]}" _sulafat_prompt)
  else
    PROMPT_COMMAND=$'_sulafat_precmd\n'"${PROMPT_COMMAND}"$'\n_sulafat_prompt'
  fi
  # C once for what was entered, though a paste of several lines runs as several commands:
  # all of it the first time, which notes that a command ran, and none of it after.
  _sulafat_c=$'\e]133;C\a'
  PS0="${PS0}"'${_sulafat_c:0:$((_sulafat_ran ? 0 : (_sulafat_ran = 1, 99)))}'
  # Tab completion for the command line Sulafat edits: the request file holds the caret's
  # offset, a newline and the text; the word's matches are reported (OSC 7770) as zsh's are,
  # none inserted. What readline would run is run: the command's compspec (`complete -p`,
  # loaded on demand through bash-completion's -D loader), its -F function with COMP_* set,
  # its other options through compgen; commands for the first word; else file names.
  _sulafat_enc() {
    local s=${1//\%/%25}
    s=${s//;/%3B}
    s=${s//$'\n'/%0A}
    s=${s//$'\t'/%09}
    s=${s//$'\e'/}
    s=${s//$'\a'/}
    REPLY=$s
  }
  _sulafat_complete() {
    local f=$SULAFAT_COMPLETE_FILE data
    [[ -r $f ]] || return 0
    data=$(<"$f")
    local point=${data%%$'\n'*} line=${data#*$'\n'}
    local before=${line:0:point}
    # The command the caret is in (from `start`), its words as readline makes them — a
    # break character in COMP_WORDBREAKS (`=`, `:`) a word of its own — and the shell word
    # under the caret, which is what Sulafat replaces.
    local breaks=${COMP_WORDBREAKS-$' \t\n"\'><=;|&(:'}
    local -a words=()
    local w= word= q= esc= c i start=0 broke=
    for (( i = 0; i < ${#before}; i++ )); do
      c=${before:i:1}
      broke=
      if [[ -n $esc ]]; then w+=$c; word+=$c; esc=; continue; fi
      if [[ -n $q ]]; then
        w+=$c; word+=$c
        if [[ $c == "$q" ]]; then q=; elif [[ $c == '\' && $q == '"' ]]; then esc=1; fi
        continue
      fi
      case $c in
        '\') w+=$c; word+=$c; esc=1 ;;
        '"'|"'") q=$c; w+=$c; word+=$c ;;
        ' '|$'\t') [[ -n $w ]] && words+=("$w"); w=; word= ;;
        $'\n'|';'|'|'|'&'|'(') words=(); w=; word=; start=$(( i + 1 )) ;;
        *)
          if [[ $breaks == *"$c"* ]]; then
            [[ -n $w ]] && words+=("$w")
            words+=("$c"); w=; word+=$c; broke=1
          else
            w+=$c; word+=$c
          fi ;;
      esac
    done
    # Right after a break character readline's word is that character, and what is typed
    # goes after it: nothing of it is replaced.
    [[ -n $broke ]] || words+=("$w")
    local cword=$(( ${#words[@]} - 1 ))
    local prev= cmd=${words[0]} typed=$w
    (( cword > 0 )) && prev=${words[cword - 1]}
    # The word unquoted — without its opening quote, or its backslashes — for compgen, and
    # for the completion function: bash-completion quotes the word once more for compgen,
    # counting on two dequotings, bash's and readline's, of which outside a real completion
    # only bash's happens.
    local quote= bare=$typed
    if [[ $typed == [\"\']* ]]; then quote=${typed:0:1}; bare=${typed:1}; else bare=${typed//\\/}; fi
    local -a fwords=("${words[@]}")
    [[ -n $broke ]] || fwords[cword]=$bare
    local fline=${before:start}
    fline=${fline:0:${#fline}-${#typed}}$bare
    local -a hits=()
    local -A _sulafat_opts=()
    # compopt outside a real completion fails: this one notes the options for the report.
    compopt() {
      while (( $# )); do
        case $1 in
          -o) _sulafat_opts[$2]=1; shift ;;
          +o) unset "_sulafat_opts[$2]"; shift ;;
        esac
        shift
      done
      return 0
    }
    if (( cword == 0 )); then
      if [[ $bare == */* ]]; then
        _sulafat_opts[filenames]=1
        mapfile -t hits < <(compgen -f -- "$bare")
      else
        mapfile -t hits < <(compgen -c -- "$bare")
      fi
    else
      local spec loader
      spec=$(builtin complete -p -- "$cmd" 2>/dev/null)
      if [[ -z $spec && $(builtin complete -p -D 2>/dev/null) =~ -F\ ([^ ]+) ]]; then
        loader=${BASH_REMATCH[1]}
        local COMP_WORDS=("${fwords[@]}") COMP_CWORD=$cword COMP_LINE=$fline
        local COMP_POINT=${#fline} COMP_TYPE=9 COMP_KEY=9
        local -a COMPREPLY=()
        "$loader" "$cmd" "$bare" "$prev" >/dev/null 2>&1 </dev/null
        spec=$(builtin complete -p -- "$cmd" 2>/dev/null)
      fi
      if [[ -n $spec ]]; then
        local -a sw=() gen=()
        local fn= k
        eval "sw=(${spec#complete })"
        for (( k = 0; k < ${#sw[@]} - 1; k++ )); do
          case ${sw[k]} in
            -F) fn=${sw[k + 1]}; (( k++ )) ;;
            -o) _sulafat_opts[${sw[k + 1]}]=1; (( k++ )) ;;
            # A command's output: left out, as it may be slow or change something.
            -C) (( k++ )) ;;
            -A|-G|-W|-X|-P|-S) gen+=("${sw[k]}" "${sw[k + 1]}"); (( k++ )) ;;
            *) gen+=("${sw[k]}") ;;
          esac
        done
        (( ${#gen[@]} )) && mapfile -t hits < <(compgen "${gen[@]}" -- "$bare" 2>/dev/null)
        if [[ -n $fn ]]; then
          local COMP_WORDS=("${fwords[@]}") COMP_CWORD=$cword COMP_LINE=$fline
          local COMP_POINT=${#fline} COMP_TYPE=9 COMP_KEY=9
          local -a COMPREPLY=()
          "$fn" "$cmd" "$bare" "$prev" >/dev/null 2>&1 </dev/null
          hits+=("${COMPREPLY[@]}")
        fi
        if (( ${#hits[@]} == 0 )) && [[ -n ${_sulafat_opts[default]}${_sulafat_opts[bashdefault]} ]]; then
          _sulafat_opts[filenames]=1
          mapfile -t hits < <(compgen -f -- "$bare")
        fi
        if (( ${#hits[@]} == 0 )) && [[ -n ${_sulafat_opts[dirnames]} ]]; then
          _sulafat_opts[filenames]=1
          mapfile -t hits < <(compgen -d -- "$bare")
        fi
        if [[ -n ${_sulafat_opts[plusdirs]} ]]; then
          _sulafat_opts[filenames]=1
          mapfile -t -O ${#hits[@]} hits < <(compgen -d -- "$bare")
        fi
      else
        _sulafat_opts[filenames]=1
        mapfile -t hits < <(compgen -f -- "$bare")
      fi
    fi
    builtin unset -f compopt
    # Sorted and each once, as readline lists them (but -o nosort), at most 500.
    if [[ -z ${_sulafat_opts[nosort]} ]] && (( ${#hits[@]} )); then
      mapfile -t hits < <(builtin printf '%s\n' "${hits[@]}" | LC_ALL=C sort -u)
    fi
    # Sulafat's word is replaced: what of it comes before readline's (`--opt=` before a
    # value), the match, and after it a space — a `/` after a directory, nothing under
    # -o nospace, a closing quote first inside quotes.
    local pre=${word:0:${#word}-${#typed}}$quote
    local h ins shown suf path n=0
    builtin printf '\e]7770;b\a'
    for h in "${hits[@]}"; do
      [[ -z $h ]] && continue
      (( n++ >= 500 )) && break
      ins=$h; shown=$h; suf=' '
      if [[ -n ${_sulafat_opts[filenames]} ]]; then
        path=$h
        [[ $path == '~/'* ]] && path=$HOME/${path:2}
        if [[ $h == */ ]]; then suf=; elif [[ -d $path ]]; then suf=/; fi
        shown=${h%/}; shown=${shown##*/}
        [[ $h == */ || $suf == / ]] && shown+=/
        if [[ -z $quote && -z ${_sulafat_opts[noquote]} ]]; then
          if [[ $h == '~/'* ]]; then builtin printf -v ins '~/%q' "${h:2}"
          else builtin printf -v ins '%q' "$h"; fi
        fi
      fi
      [[ -n ${_sulafat_opts[nospace]} && $suf == ' ' ]] && suf=
      [[ -n $quote && $suf != / ]] && suf=$quote$suf
      _sulafat_enc "$pre"; local e_pre=$REPLY
      _sulafat_enc "$ins"; ins=$REPLY
      _sulafat_enc "$suf"; suf=$REPLY
      _sulafat_enc "$shown"; shown=$REPLY
      builtin printf '\e]7770;m;%s;%s;%s;%s;\a' "$e_pre" "$ins" "$suf" "$shown"
    done
    builtin printf '\e]7770;e\a'
    READLINE_LINE=
    READLINE_POINT=0
  }
  # In every keymap, whichever the user's files chose.
  for _sulafat_m in emacs vi-insert vi-command; do
    builtin bind -m "$_sulafat_m" -x '"\e[9898~": _sulafat_complete' 2>/dev/null
  done
  builtin unset _sulafat_m
fi
`##
