module shell
//! Shell integration: what a shell is given at start so that it tells the terminal where its
//! prompts and commands are. With it, Sulafat knows when the shell is waiting for a command —
//! and the command line is Sulafat's editor — and when a program is running and the keys are
//! that program's.
//!
//! The shell reports through OSC 133 (FinalTerm's marks, as iTerm2, kitty and WezTerm use
//! them): `A` a prompt begins, `B` the prompt has been drawn and input begins, `C` a command
//! is running and its output begins, `D;status` it ended. OSC 7 reports the directory.
//!
//! **Tab completion is zsh's own.** Sulafat writes the command line to a request file and
//! sends a key bound to a widget here, which loads it into zsh's buffer, runs zsh's
//! completion system with `compadd` captured — so the user's completion settings, plugins
//! and directory all apply — and reports each match (OSC 7770) without inserting or listing
//! any. Its messages are `b` (begin), `m;<prefix>;<insert>;<suffix>;<shown>;<description>`
//! (a match, each field percent-encoded) and `e` (end); `vt.Screen` collects them.
//!
//! **zsh** is reached through `ZDOTDIR`: zsh reads `$ZDOTDIR/.zshenv` first, and Sulafat's
//! puts the user's `ZDOTDIR` back, reads their `.zshenv`, and adds two hooks — so their
//! `.zprofile`, `.zshrc` and `.zlogin` are read from their own directory as always. Other
//! shells run without integration: a classic terminal, keys to the shell.

import std.env.{ lookup }
import std.io.{ write_file, create_dir_all, read_bytes }
import std.path

/// What a shell with Sulafat's integration is started with: its environment, as `NAME=value`
/// entries for `bindings.pty`'s `spawn`, and the file completion requests are written to.
pub struct Integration {
  env: []string,
  request: string,
}

/// The integration for `shell` (a path, as `$SHELL` holds it), its files written; `None` for
/// a shell it has none for, or when they could not be written. Each window has a request
/// file of its own, named by `id`.
pub let integration = (shell: string, id: string) -> Maybe<Integration> => {
  if shell.base() != "zsh" { return None }
  let Some(dir) = zsh_dir() else { return None }
  let request = dir.join("request-${id}")
  Some(Integration {
    env: [
      "ZDOTDIR=${dir}",
      "SULAFAT_ORIG_ZDOTDIR=${lookup("ZDOTDIR") ?? ""}",
      "SULAFAT_SHELL_INTEGRATION=1",
      "SULAFAT_COMPLETE_FILE=${request}",
    ],
    request: request,
  })
}

/// Ask the shell for the completions of `text` with the caret at rune `cursor`: the request
/// written, and the key that runs the shell's widget on it, to be sent to the shell. `None`
/// when the file cannot be written.
pub let completion_request = (
  i: Integration,
  text: string,
  cursor: i64
) -> Maybe<string> =>
  if write_file(i.request, "${cursor}\n${text}") { Some(COMPLETE_KEY) } else { None }

/// The key zsh's completion widget is bound to: a private CSI no keyboard sends.
const COMPLETE_KEY: string = "\e[9898~"

/// What the shell is sent to run `command`. Through bracketed paste when the shell has it
/// on (zsh does at its prompt), so that a command of several lines reaches the shell's line
/// editor as one, its line breaks literal; then Return. The paste's own end marker cannot
/// be in it: ESC is dropped.
pub let submission = (command: string, bracketed: bool) -> string => {
  if command == "" { return "\r" }
  if bracketed { "\e[200~${command.replace("\e", "")}\e[201~\r" } else { "${command}\r" }
}

/// The shell's saved history, oldest first, for the command line's ↑: zsh's `$HISTFILE`, or
/// `.zsh_history` in `ZDOTDIR` or the home directory. At most [HISTORY_LIMIT] entries, a
/// command repeated in a row kept once; empty for another shell or no file.
pub let load_history = (shell: string) -> []string => {
  if shell.base() != "zsh" { return [] }
  let home = lookup("ZDOTDIR") ?? lookup("HOME") ?? ""
  let file = lookup("HISTFILE") ?? home.join(".zsh_history")
  let Some(bytes) = read_bytes(file) else { return [] }
  parse_zsh_history(bytes)
}

/// History entries kept at most.
pub const HISTORY_LIMIT: i64 = 2000

/// zsh's history file as entries. Each is a line, extended (`: <time>:<duration>;<command>`)
/// or plain; a command of several lines has each line but the last ending in `\`. zsh
/// writes it *metafied*: a byte zsh treats specially is written as 0x83 then the byte with
/// bit 5 flipped, which is undone before the bytes are read as UTF-8.
pub let parse_zsh_history = pure (bytes: []u8) -> []string => {
  var raw: []u8 = []
  var i = 0
  while i < bytes.len() {
    if bytes[i] == 0x83 && i + 1 < bytes.len() {
      raw.push(bytes[i + 1] ~ 32)
      i += 2
    } else {
      raw.push(bytes[i])
      i += 1
    }
  }
  var out: []string = []
  var pending = ""
  for line in raw.decode_utf8().split("\n") {
    if line.ends_with("\\") {
      pending = "${pending}${line.slice(0, line.len() - 1)}\n"
    } else {
      let whole = strip_extended("${pending}${line}")
      pending = ""
      if whole != "" && (out.len() == 0 || out[out.len() - 1] != whole) { out.push(whole) }
    }
  }
  if out.len() > HISTORY_LIMIT { out.slice(
    out.len() - HISTORY_LIMIT,
    out.len()
  ) } else { out }
}

/// A history line without the extended format's `: <time>:<duration>;` in front.
let strip_extended = pure (line: string) -> string => {
  if !line.starts_with(": ") { return line }
  match line.index(";") {
    Some(k) => line.slice(k + 1, line.len()),
    None => line,
  }
}

/// The directory holding Sulafat's `.zshenv`, written there now (each start, so that a newer
/// Sulafat's replaces an older one's): `$XDG_CACHE_HOME/sulafat/zsh`, else `~/.cache/…`.
let zsh_dir = () -> Maybe<string> => {
  let cache = match lookup("XDG_CACHE_HOME") {
    Some(d) => if d == "" { "${lookup("HOME") ?? "/tmp"}/.cache" } else { d },
    None => "${lookup("HOME") ?? "/tmp"}/.cache",
  }
  let dir = cache.join("sulafat").join("zsh")
  if !create_dir_all(dir) { return None }
  if !write_file(dir.join(".zshenv"), ZSHENV) { return None }
  Some(dir)
}

/// zsh's integration. The `B` mark goes at the end of `PS1` rather than in a `zle-line-init`
/// widget, because a widget runs before the prompt is drawn on some versions, and the mark
/// must sit where input begins. Its precmd hook moves itself last, so that a theme that
/// rebuilds `PS1` in its own hook (powerlevel10k, starship) has done so before the mark is
/// added — from the second prompt on; the first may lack the mark under such a theme, and
/// is then a classic prompt.
const ZSHENV: string = ##`# Sulafat's shell integration, loaded through ZDOTDIR, which is put back first.
# Written by Sulafat at each start; edits here are lost.
if [[ -n "$SULAFAT_ORIG_ZDOTDIR" ]]; then ZDOTDIR="$SULAFAT_ORIG_ZDOTDIR"; else builtin unset ZDOTDIR; fi
builtin unset SULAFAT_ORIG_ZDOTDIR
[[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]] && builtin source "${ZDOTDIR:-$HOME}/.zshenv"
if [[ -o interactive ]]; then
  builtin autoload -Uz add-zsh-hook
  typeset -g _sulafat_ran=
  _sulafat_precmd() {
    local s=$?
    [[ -n $_sulafat_ran ]] && builtin printf '\e]133;D;%s\a' $s
    _sulafat_ran=
    builtin printf '\e]7;file://%s%s\a' "${HOST}" "${PWD}"
    builtin printf '\e]133;A\a'
    if [[ ${precmd_functions[-1]} != _sulafat_precmd ]]; then
      precmd_functions=(${precmd_functions:#_sulafat_precmd} _sulafat_precmd)
    fi
    [[ $PS1 == *$'\e]133;B\a'* ]] || PS1="${PS1}%{"$'\e]133;B\a'"%}"
  }
  _sulafat_preexec() {
    _sulafat_ran=1
    builtin printf '\e]133;C\a'
  }
  add-zsh-hook precmd _sulafat_precmd
  add-zsh-hook preexec _sulafat_preexec

  # Tab completion for the command line Sulafat edits: the request file holds the caret's
  # offset, a newline and the text; each match is reported (OSC 7770) and none is added.
  _sulafat_enc() {
    local s=${1//\%/%25}
    s=${s//;/%3B}
    s=${s//$'\n'/%0A}
    s=${s//$'\t'/%09}
    s=${s//$'\e'/}
    s=${s//$'\a'/}
    REPLY=$s
  }
  _sulafat_capture() {
    compadd() {
      # A compadd that only asks (-O, -A, -D) is a completion function's own business.
      if [[ ${@[1,(i)(-|--)]} == *-(O|A|D)\ * ]]; then builtin compadd "$@"; return; fi
      local -a hits dscr
      local -A o
      zparseopts -A o -E P: S: p: s: i: I: W: d: J: V: X: x: r: R: F: E: M: o:: a k q Q f e n U l 1 2 C
      [[ -n ${o[-d]} ]] && dscr=( "${(@P)o[-d]}" )
      builtin compadd -A hits -D dscr "$@"
      (( $#hits )) || return 1
      local h i=0 ins shown suf desc dir pre
      for h in $hits; do
        (( i++ ))
        (( _sulafat_count >= 500 )) && return 0
        (( _sulafat_count++ ))
        if (( $+o[-Q] )) || [[ -n $QIPREFIX ]]; then ins=$h; shown=${(Q)h}; else ins=${(q)h}; shown=$h; fi
        ins="${o[-P]}${o[-p]}${ins}"
        suf=${o[-S]- }
        if (( $+o[-f] )); then
          dir=${o[-W]-${o[-p]}}
          [[ -d ${~dir}${(Q)h} ]] && suf=/
        fi
        # Inside quotes, close them after a match that is finished.
        [[ -n $QIPREFIX && $suf != / ]] && suf="${QIPREFIX[1]}${suf}"
        desc=${dscr[i]}
        if [[ $desc == *' -- '* ]]; then desc=${desc#* -- }; else desc=; fi
        _sulafat_enc "${QIPREFIX}${IPREFIX}"; pre=$REPLY
        _sulafat_enc "$ins"; ins=$REPLY
        _sulafat_enc "$suf"; suf=$REPLY
        _sulafat_enc "$shown"; shown=$REPLY
        _sulafat_enc "$desc"; desc=$REPLY
        builtin printf '\e]7770;m;%s;%s;%s;%s;%s\a' "$pre" "$ins" "$suf" "$shown" "$desc"
      done
      return 0
    }
    _main_complete
    builtin unfunction compadd
    compstate[insert]=''
    compstate[list]=''
  }
  _sulafat_complete() {
    if (( ! $+functions[_main_complete] )); then
      builtin autoload -Uz compinit && compinit -i -d "${SULAFAT_COMPLETE_FILE:h}/zcompdump"
    fi
    local f=$SULAFAT_COMPLETE_FILE data
    [[ -r $f ]] || return 0
    data=$(<$f)
    BUFFER=${data#*$'\n'}
    CURSOR=${data%%$'\n'*}
    typeset -gi _sulafat_count=0
    builtin printf '\e]7770;b\a'
    zle _sulafat_complete_word
    builtin printf '\e]7770;e\a'
    BUFFER=
    CURSOR=0
  }
  _sulafat_bind() {
    zle -C _sulafat_complete_word complete-word _sulafat_capture
    zle -N _sulafat_complete
    # Bound once the user's .zshrc has chosen emacs or vi keys, in every keymap.
    local m
    for m in emacs viins vicmd; do builtin bindkey -M $m '\e[9898~' _sulafat_complete; done
    add-zsh-hook -d precmd _sulafat_bind
  }
  add-zsh-hook precmd _sulafat_bind
fi
`##
