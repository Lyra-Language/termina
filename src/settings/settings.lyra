module settings
//! What the user has chosen — the font, its size, the line spacing, the colors — kept in
//! `$XDG_CONFIG_HOME/termina/settings.json` (else `~/.config/…`) and read at start. The
//! settings window (`../ui/settings_window.lyra`) changes it; the theme and the faces are
//! made from it (`../ui/theme.lyra`'s [theme_of], `../termina.lyra`).
//!
//! **A file is read leniently**: a setting missing, of the wrong kind or out of range keeps
//! its default, so a file written by an older or newer Termina, or edited by hand, still
//! starts — with what of it makes sense.
//!
//! A color is `0xRRGGBB` here, as people write them; `#rrggbb` in the file.

import std.env.{ lookup }
import std.io.{ read_file, write_file, create_dir_all, read_dir }
import std.json.{
  parse_json,
  JsonValue,
  JsonMember,
  JsonObject,
  JsonString,
  JsonNumber,
  JsonBool,
  JsonArray
}
import std.path

/// Everything the settings window sets.
pub struct Settings {
  /// The font family's name, as [font_families] lists them.
  font_family: string,
  /// A font file chosen instead of a family (`""` for none): its one face, bold drawn.
  font_file: string,
  /// The text's size in points, and a line's height as a multiple of it.
  font_size: f32,
  line_spacing: f32,
  /// The theme the colors came from, by name — `"Custom"` once one is changed.
  theme_name: string,
  colors: Colors,
  /// The themes the user saved, in the order saved.
  themes: []SavedTheme,
  /// The saved theme the colors were changed from by hand, while the theme is `Custom` (`""`
  /// for none): what Save overwrites ([edit_colors], [can_save]).
  edited_from: string = "",
  bold_is_bright: bool,
  /// What is behind a see-through window — one whose background is not opaque — blurred by,
  /// in points (0 for none; macOS only).
  background_blur: f32 = 0.0,
  /// What is behind the input sections — the command line's box, each block's prompt and
  /// command — and the output sections blurred by, each where its colour is not opaque: the
  /// desktop through a see-through window, and the transcript scrolled under the box (0 for
  /// none; macOS only). Not 0 to begin with: unblurred, the transcript's text runs through the
  /// prompt's.
  input_blur: f32 = 16.0,
  output_blur: f32 = 16.0,
  /// How thick the rule under the tab bar is, in points (0 for none); its color
  /// `Colors.tab_rule`.
  tab_rule_width: f32 = 1.0,
  /// Whether the window opens where it was last closed, at its size, maximized if it was; and
  /// where that was (`None` before it was ever closed so).
  remember_window: bool = true,
  window: Maybe<WindowPlace> = None,
}

/// Where the window was: its top-left corner on the screens (in the system's coordinates; none
/// where the system does not say, as Wayland does not), its size in points — the size it had
/// before it was maximized, while it is — and whether it was maximized.
pub struct WindowPlace {
  x: f32 = 0.0,
  y: f32 = 0.0,
  placed: bool = false,
  width: f32,
  height: f32,
  maximized: bool = false,
}

/// A theme the user saved: its name, none of Termina's own, and its colors.
pub struct SavedTheme {
  name: string,
  colors: Colors,
}

/// A theme's colors, each `0xRRGGBB` with how transparent it is in the top byte — 0, as every
/// theme's own are, opaque. Only the backgrounds may be other than opaque — the window's and
/// the sections' (`may_be_clear`, `backgrounds_alone_clear`); a window background that is
/// not makes the window see-through. The file writes such a colour `#rrggbbaa` (`hex_of`).
pub struct Colors {
  fg: u32,
  bg: u32,
  cursor: u32,
  selection: u32,
  /// The sections' backgrounds: the input's — the command line's box, and each block's
  /// prompt and command — and each block's output's.
  input: u32,
  output: u32,
  /// The input section's text — the prompt and command, where a program gave them no
  /// color of their own.
  input_text: u32,
  /// The tabs' backgrounds: a tab's, under the pointer, and the one shown. Their labels are
  /// in the text's color.
  tab: u32,
  tab_hovered: u32,
  tab_selected: u32,
  /// The rule under the tab bar, across the window (its thickness `Settings.tab_rule_width`).
  tab_rule: u32,
  /// The command line's own: its text, and its completion menu's background and chosen row.
  editor_text: u32,
  menu: u32,
  menu_chosen: u32,
  /// The 16 ANSI colors: black, red, green, yellow, blue, magenta, cyan, white, then
  /// their bright versions.
  ansi: []u32,
  /// What fills the backgrounds beyond their colors — the window's, the input sections', the
  /// output sections' — at their colors' opacity ([Backing], `backing.lyra`).
  bg_fill: Backing = PlainBacking,
  input_fill: Backing = PlainBacking,
  output_fill: Backing = PlainBacking,
}

/// The settings before any are chosen.
pub let defaults = pure () -> Settings => Settings {
  font_family: "SF Mono",
  font_file: "",
  font_size: 14.0,
  line_spacing: 1.2,
  theme_name: "Termina Dark",
  colors: theme_colors("Termina Dark"),
  themes: [],
  bold_is_bright: false,
}

/// The sizes and spacings the window offers.
pub const FONT_SIZE_RANGE: (f32, f32) = (9.0, 32.0)
pub const LINE_SPACING_RANGE: (f32, f32) = (1.0, 2.0)
/// How thick the rule under the tab bar may be, in points.
pub const RULE_WIDTH_RANGE: (f32, f32) = (0.0, 6.0)
/// The blurs, behind a see-through window and behind its sections, in points.
pub const BLUR_RANGE: (f32, f32) = (0.0, 64.0)

// ── Themes ───────────────────────────────────────────────────────────────────

/// The themes offered, by name, in the window's order.
pub const THEME_NAMES: []string = [
  "Termina Dark",
  "Termina Light",
  "Solarized Dark",
  "Solarized Light",
  "Dracula",
  "Nord",
  "Gruvbox Dark",
  "Gruvbox Light",
]

/// A theme's colors by name; Termina Dark's for a name not known.
pub let theme_colors = pure (name: string) -> Colors => {
  if name == "Termina Light" {
    return colors_of(
      0x2B2D33,
      0xFAF8F5,
      0x2B2D33,
      0xB4D5FE,
      sections_of(0xFAF8F5),
      [
        0x3B3F4A, 0xC4363F, 0x4E8A2E, 0x9C6D00, 0x2F6FCB, 0x9A4DB7, 0x2B8794, 0xD8D4CE,
        0x6B7280, 0xE0484F, 0x5FA53A, 0xB88300, 0x4285F4, 0xB45FD1, 0x36A3B1, 0xFFFFFF,
      ]
    )
  }
  if name == "Solarized Dark" || name == "Solarized Light" {
    let dark = name == "Solarized Dark"
    return colors_of(
      if dark { 0x839496 } else { 0x657B83 },
      if dark { 0x002B36 } else { 0xFDF6E3 },
      if dark { 0x93A1A1 } else { 0x586E75 },
      if dark { 0x073642 } else { 0xEEE8D5 },
      // Solarized's own highlight shades: base02 and base2.
      if dark { (0x073642, 0x03303C) } else { (0xEEE8D5, 0xF6EFDC) },
      [
        0x073642, 0xDC322F, 0x859900, 0xB58900, 0x268BD2, 0xD33682, 0x2AA198, 0xEEE8D5,
        0x002B36, 0xCB4B16, 0x586E75, 0x657B83, 0x839496, 0x6C71C4, 0x93A1A1, 0xFDF6E3,
      ]
    )
  }
  if name == "Dracula" {
    return colors_of(
      0xF8F8F2,
      0x282A36,
      0xF8F8F2,
      0x44475A,
      sections_of(0x282A36),
      [
        0x21222C, 0xFF5555, 0x50FA7B, 0xF1FA8C, 0xBD93F9, 0xFF79C6, 0x8BE9FD, 0xF8F8F2,
        0x6272A4, 0xFF6E6E, 0x69FF94, 0xFFFFA5, 0xD6ACFF, 0xFF92DF, 0xA4FFFF, 0xFFFFFF,
      ]
    )
  }
  if name == "Gruvbox Dark" || name == "Gruvbox Light" {
    let dark = name == "Gruvbox Dark"
    return colors_of(
      if dark { 0xEBDBB2 } else { 0x3C3836 },
      if dark { 0x282828 } else { 0xFBF1C7 },
      if dark { 0xEBDBB2 } else { 0x3C3836 },
      if dark { 0x504945 } else { 0xD5C4A1 },
      // Gruvbox's own: bg1 for the input, the soft background for the output.
      if dark { (0x3C3836, 0x32302F) } else { (0xEBDBB2, 0xF2E5BC) },
      if dark {
        [
          0x282828, 0xCC241D, 0x98971A, 0xD79921, 0x458588, 0xB16286, 0x689D6A, 0xA89984,
          0x928374, 0xFB4934, 0xB8BB26, 0xFABD2F, 0x83A598, 0xD3869B, 0x8EC07C, 0xEBDBB2,
        ]
      } else {
        [
          0xFBF1C7, 0xCC241D, 0x98971A, 0xD79921, 0x458588, 0xB16286, 0x689D6A, 0x7C6F64,
          0x928374, 0x9D0006, 0x79740E, 0xB57614, 0x076678, 0x8F3F71, 0x427B58, 0x3C3836,
        ]
      }
    )
  }
  if name == "Nord" {
    return colors_of(
      0xD8DEE9,
      0x2E3440,
      0xD8DEE9,
      0x434C5E,
      // Nord's own: nord1, and half-way to it.
      (0x3B4252, 0x343B49),
      [
        0x3B4252, 0xBF616A, 0xA3BE8C, 0xEBCB8B, 0x81A1C1, 0xB48EAD, 0x88C0D0, 0xE5E9F0,
        0x4C566A, 0xBF616A, 0xA3BE8C, 0xEBCB8B, 0x81A1C1, 0xB48EAD, 0x8FBCBB, 0xECEFF4,
      ]
    )
  }
  // Termina Dark: the window's #181A1E behind #E6E1DC, an ANSI set in the spirit of One Dark.
  colors_of(
    0xE6E1DC,
    0x181A1E,
    0xE6E1DC,
    0x3A6EA5,
    sections_of(0x181A1E),
    [
      0x3B3F4A, 0xE06C75, 0x98C379, 0xE5C07B, 0x61AFEF, 0xC678DD, 0x56B6C2, 0xABB2BF,
      0x5C6370, 0xF08A93, 0xB5E08F, 0xF2D49B, 0x84C3F5, 0xD79BE8, 0x7FCBD5, 0xF5F2EE,
    ]
  )
}

/// A theme from its own colors — text, background, cursor, selection, the sections' input
/// and output, the ANSI sixteen — and the rest made from them: tabs from the input
/// section's shade towards the text (the selected one the selection's), the command line's
/// text the theme's, its completion menu a shade off the background and its chosen row
/// towards the selection.
let colors_of = pure (
  fg: u32,
  bg: u32,
  cursor: u32,
  selection: u32,
  sections: (u32, u32),
  ansi: []u32
) -> Colors => Colors {
  fg: fg,
  bg: bg,
  cursor: cursor,
  selection: selection,
  input: sections.0,
  output: sections.1,
  input_text: fg,
  tab: sections.0,
  tab_hovered: mix(sections.0, fg, 0.12),
  tab_selected: mix(bg, selection, 0.7),
  // The text faint over the background.
  tab_rule: mix(bg, fg, 0.19),
  editor_text: fg,
  menu: mix(bg, fg, 0.07),
  menu_chosen: mix(bg, selection, 0.5),
  ansi: ansi,
}

/// Whether `name` may be a saved theme's: not empty, not one of Termina's own, not
/// `Custom` — a saved theme of that name is replaced.
pub let can_save_as = pure (name: string) -> bool =>
  name.trim() != "" && name.trim() != "Custom" && !THEME_NAMES.contains(name.trim())

/// The colors changed by hand: the theme made the user's own (`Custom`), and where it was one
/// of their saved ones, that one kept as what Save overwrites ([can_save]) — through every
/// change after, until another theme is chosen or saved.
pub let edit_colors = (s: mut Settings) -> void => {
  if saved_colors(s.themes, s.theme_name) != None {
    s.edited_from = s.theme_name
  } else if s.theme_name != "Custom" {
    s.edited_from = ""
  }
  s.theme_name = "Custom"
}

/// Whether Save has a theme to overwrite: the colors changed from one of the user's saved
/// themes, still there.
pub let can_save = pure (s: Settings) -> bool =>
  s.theme_name == "Custom" && saved_colors(s.themes, s.edited_from) != None

/// The current colors saved as theme `name` (one of that name replaced), and made the
/// current theme. Nothing for a name [can_save_as] refuses.
pub let save_theme = (s: mut Settings, name: string) -> void => {
  if !can_save_as(name) { return }
  let n = name.trim()
  let saved = SavedTheme { name: n, colors: s.colors }
  var replaced = false
  for k in 0..<s.themes.len() {
    if s.themes[k].name == n {
      s.themes[k] = saved
      replaced = true
    }
  }
  if !replaced { s.themes.push(saved) }
  s.theme_name = n
  s.edited_from = ""
}

/// Saved theme `name` gone; the colors stay, a theme of their own now (`Custom`) if it was
/// the current one.
pub let delete_theme = (s: mut Settings, name: string) -> void => {
  s.themes = [t in s.themes | t.name != name | t]
  if s.theme_name == name { s.theme_name = "Custom" }
  if s.edited_from == name { s.edited_from = "" }
}

/// Saved theme `name`'s colors, if there is one.
pub let saved_colors = pure (themes: []SavedTheme, name: string) -> Maybe<Colors> => {
  for t in themes { if t.name == name { return Some(t.colors) } }
  None
}

/// The color a [Colors] field holds, by the field's name (`"fg"`, `"tab_hovered"`, …; not
/// `ansi`): what the settings' color editors are named by. 0 for any other name.
pub let color_named = pure (c: Colors, field: string) -> u32 => match field {
  "fg" => c.fg,
  "bg" => c.bg,
  "cursor" => c.cursor,
  "selection" => c.selection,
  "input" => c.input,
  "output" => c.output,
  "input_text" => c.input_text,
  "tab" => c.tab,
  "tab_hovered" => c.tab_hovered,
  "tab_selected" => c.tab_selected,
  "tab_rule" => c.tab_rule,
  "editor_text" => c.editor_text,
  "menu" => c.menu,
  "menu_chosen" => c.menu_chosen,
  _ => 0,
}

/// `c` with the field named `field` (as [color_named] names them) set to `given` — opaque but
/// for the background, the one colour that may be translucent; `c` itself for any other name.
pub let with_color = pure (c: Colors, field: string, given: u32) -> Colors => {
  let rgb = if may_be_clear(field) { given } else { given & 0xFFFFFF }
  match field {
    "fg" => Colors { c | fg: rgb },
    "bg" => Colors { c | bg: rgb },
    "cursor" => Colors { c | cursor: rgb },
    "selection" => Colors { c | selection: rgb },
    "input" => Colors { c | input: rgb },
    "output" => Colors { c | output: rgb },
    "input_text" => Colors { c | input_text: rgb },
    "tab" => Colors { c | tab: rgb },
    "tab_hovered" => Colors { c | tab_hovered: rgb },
    "tab_selected" => Colors { c | tab_selected: rgb },
    "tab_rule" => Colors { c | tab_rule: rgb },
    "editor_text" => Colors { c | editor_text: rgb },
    "menu" => Colors { c | menu: rgb },
    "menu_chosen" => Colors { c | menu_chosen: rgb },
    _ => c,
  }
}

/// `c` with ANSI color `k` set to `rgb`, in an array of its own: `c`'s is shared with every
/// copy of these colors, a saved theme's among them.
pub let with_ansi = pure (c: Colors, k: i64, rgb: u32) -> Colors => {
  var ansi = [...c.ansi]
  if k >= 0 && k < ansi.len() { ansi[k] = rgb & 0xFFFFFF }
  Colors { c | ansi: ansi }
}

/// Whether no theme among `themes` is called `name`.
let is_free_name = pure (themes: []SavedTheme, name: string) -> bool =>
  saved_colors(themes, name) == None

/// The sections' backgrounds a theme of background `bg` has, input and output: a dark one
/// lightened, 6% towards white and 3%; a light one darkened, 5% towards black and 2.5%.
pub let sections_of = pure (bg: u32) -> (u32, u32) => {
  let r = f32((bg >> 16) & 0xFF)
  let g = f32((bg >> 8) & 0xFF)
  let b = f32(bg & 0xFF)
  let dark = 0.299 * r + 0.587 * g + 0.114 * b < 128.0
  if dark { (mix(bg, 0xFFFFFF, 0.06), mix(bg, 0xFFFFFF, 0.03)) }
  else { (mix(bg, 0x000000, 0.05), mix(bg, 0x000000, 0.025)) }
}

/// `a` taken a fraction `t` of the way to `b`, channel by channel (`0xRRGGBB` each).
let mix = pure (a: u32, b: u32, t: f32) -> u32 => {
  var out: u32 = 0
  for shift in [16, 8, 0] {
    let x = f32((a >> u32(shift)) & 0xFF)
    let y = f32((b >> u32(shift)) & 0xFF)
    out = out | (u32((x + (y - x) * t).round()) << u32(shift))
  }
  out
}

// ── The file ─────────────────────────────────────────────────────────────────

/// Where the settings are kept: `$XDG_CONFIG_HOME/termina/settings.json`, else
/// `~/.config/termina/settings.json`.
pub let settings_path = () -> string => config_dir().join("termina").join("settings.json")

/// The settings kept at `path`, or the defaults when there are none to read. With none at
/// `path`, the settings the terminal kept before it was renamed (`~/.config/sulafat/`) are
/// read instead — saved at `path` the next time anything changes.
pub let load_settings = (path: string) -> Settings => {
  match read_file(path) {
    Some(text) => settings_from_json(text),
    None => match read_file(config_dir().join(OLD_NAME).join("settings.json")) {
      Some(text) => settings_from_json(text),
      None => defaults(),
    },
  }
}

/// The directory settings go under: `$XDG_CONFIG_HOME`, else `~/.config`.
let config_dir = () -> string => match lookup("XDG_CONFIG_HOME") {
  Some(d) => if d == "" { "${lookup("HOME") ?? "/tmp"}/.config" } else { d },
  None => "${lookup("HOME") ?? "/tmp"}/.config",
}

/// The terminal's name before it was Termina, where its settings may still be.
const OLD_NAME: string = "sulafat"

/// An object's colors in the file: `colors`, else `colours`, as the file was written before
/// 10/20 — a user's colors and saved themes are kept, and the next save writes `colors`.
let colors_in = pure (v: JsonValue) -> JsonValue => match v.field("colors") {
  Some(c) => c,
  None => v.field(OLD_COLORS_KEY) ?? JsonObject([]),
}

const OLD_COLORS_KEY: string = "colours"

/// Keep `s` at `path`, making its directory; whether it was written.
pub let save_settings = (path: string, s: Settings) -> bool => {
  match path.parent() {
    Some(dir) => if !create_dir_all(dir) { return false },
    None => {},
  }
  write_file(path, "${settings_to_json(s)}\n")
}

/// `s` as the file holds it.
pub let settings_to_json = pure (s: Settings) -> string => JsonObject([
  member("font_family", JsonString(s.font_family)),
  member("font_file", JsonString(s.font_file)),
  member("font_size", JsonNumber(f64(s.font_size))),
  member("line_spacing", JsonNumber(f64(s.line_spacing))),
  member("theme", JsonString(s.theme_name)),
  ...(if s.edited_from == "" { [] } else { [member("edited_from", JsonString(s.edited_from))] }),
  member("bold_is_bright", JsonBool(s.bold_is_bright)),
  member("colors", colors_to_json(s.colors)),
  member("themes", JsonArray([t in s.themes | JsonObject([
    member("name", JsonString(t.name)),
    member("colors", colors_to_json(t.colors)),
  ])])),
  member("background_blur", JsonNumber(f64(s.background_blur))),
  member("input_blur", JsonNumber(f64(s.input_blur))),
  member("output_blur", JsonNumber(f64(s.output_blur))),
  member("tab_rule_width", JsonNumber(f64(s.tab_rule_width))),
  member("remember_window", JsonBool(s.remember_window)),
  ...(match s.window {
    Some(w) => [member("window", JsonObject([
      ...(if w.placed { [member("x", JsonNumber(f64(w.x))), member("y", JsonNumber(f64(w.y)))] } else { [] }),
      member("width", JsonNumber(f64(w.width))),
      member("height", JsonNumber(f64(w.height))),
      member("maximized", JsonBool(w.maximized)),
    ]))],
    None => [],
  }),
]).to_json_pretty()

/// Settings from the file's text: each setting that is there and makes sense, the default
/// for each that is not.
pub let settings_from_json = pure (text: string) -> Settings => {
  let d = defaults()
  let doc = match parse_json(text) {
    Ok(v) => v,
    Err(_) => return d,
  }
  // The saved themes, each with a name and its colors over the default theme's.
  var themes: []SavedTheme = []
  for t in (doc.field("themes") ?? JsonArray([])).elements() {
    let name = text_field(t, "name") ?? ""
    if name != "" && is_free_name(themes, name) {
      themes.push(SavedTheme {
        name: name,
        colors: colors_from_json(colors_in(t), d.colors),
      })
    }
  }
  let theme = text_field(doc, "theme") ?? d.theme_name
  let rule_width = f32(number_field(doc, "tab_rule_width") ?? f64(d.tab_rule_width))
  // The theme's colors first — a saved one's or one of Termina's — then any written out
  // over them.
  let base = if theme == "Custom" { d.colors } else { saved_colors(
    themes,
    theme
  ) ?? theme_colors(theme) }
  Settings {
    font_family: text_field(doc, "font_family") ?? d.font_family,
    font_file: text_field(doc, "font_file") ?? d.font_file,
    font_size: f32(number_field(doc, "font_size") ?? f64(d.font_size)).clamp(FONT_SIZE_RANGE.0, FONT_SIZE_RANGE.1),
    line_spacing: f32(number_field(doc, "line_spacing") ?? f64(d.line_spacing)).clamp(
      LINE_SPACING_RANGE.0,
      LINE_SPACING_RANGE.1
    ),
    theme_name: theme,
    // Kept only while the colors are Custom and the theme they came from is still saved.
    edited_from: match text_field(doc, "edited_from") {
      Some(name) =>
        if theme == "Custom" && saved_colors(themes, name) != None { name } else { "" },
      None => "",
    },
    colors: colors_from_json(colors_in(doc), base),
    themes: themes,
    bold_is_bright: (doc.field("bold_is_bright") ?? JsonBool(d.bold_is_bright)).as_bool() ?? d.bold_is_bright,
    background_blur: f32(number_field(doc, "background_blur") ?? 0.0).clamp(BLUR_RANGE.0, BLUR_RANGE.1),
    input_blur: f32(number_field(doc, "input_blur") ?? f64(d.input_blur)).clamp(BLUR_RANGE.0, BLUR_RANGE.1),
    output_blur: f32(number_field(doc, "output_blur") ?? f64(d.output_blur)).clamp(BLUR_RANGE.0, BLUR_RANGE.1),
    tab_rule_width: rule_width.clamp(RULE_WIDTH_RANGE.0, RULE_WIDTH_RANGE.1),
    remember_window: (doc.field("remember_window") ?? JsonBool(d.remember_window)).as_bool() ?? d.remember_window,
    window: window_from_json(doc.field("window")),
  }
}

/// The window's place from the file: a size it must have, a place and maximized where
/// written; `None` for no size, or one no window could be.
let window_from_json = pure (w: Maybe<JsonValue>) -> Maybe<WindowPlace> => {
  let Some(v) = w else { return None }
  let Some(width) = number_field(v, "width") else { return None }
  let Some(height) = number_field(v, "height") else { return None }
  if width < 100.0 || height < 100.0 || width > 20000.0 || height > 20000.0 { return None }
  let x = number_field(v, "x")
  let y = number_field(v, "y")
  Some(WindowPlace {
    x: f32(x ?? 0.0),
    y: f32(y ?? 0.0),
    placed: x.is_some() && y.is_some(),
    width: f32(width),
    height: f32(height),
    maximized: (v.field("maximized") ?? JsonBool(false)).as_bool() ?? false,
  })
}

/// A theme's colors as the file holds them, `#rrggbb` each.
let colors_to_json = pure (c: Colors) -> JsonValue => JsonObject([
  member("foreground", JsonString(hex_of(c.fg))),
  member("background", JsonString(hex_of(c.bg))),
  member("cursor", JsonString(hex_of(c.cursor))),
  member("selection", JsonString(hex_of(c.selection))),
  member("input", JsonString(hex_of(c.input))),
  member("output", JsonString(hex_of(c.output))),
  member("input_text", JsonString(hex_of(c.input_text))),
  member("tab", JsonString(hex_of(c.tab))),
  member("tab_hovered", JsonString(hex_of(c.tab_hovered))),
  member("tab_selected", JsonString(hex_of(c.tab_selected))),
  member("tab_rule", JsonString(hex_of(c.tab_rule))),
  member("command_text", JsonString(hex_of(c.editor_text))),
  member("menu", JsonString(hex_of(c.menu))),
  member("menu_chosen", JsonString(hex_of(c.menu_chosen))),
  member("ansi", JsonArray([x in c.ansi | JsonString(hex_of(x))])),
  ...[
    f in [
      ("background_fill", c.bg_fill),
      ("input_fill", c.input_fill),
      ("output_fill", c.output_fill)
    ] |
      backing_to_json(f.1).is_some() |
      member(f.0, backing_to_json(f.1) ?? JsonBool(false))
  ],
])

/// Colors from the file's object `c`: each written there that makes sense, `base`'s for
/// the rest — the ANSI sixteen only when all sixteen are.
let colors_from_json = pure (c: JsonValue, base: Colors) -> Colors => {
  var ansi = base.ansi
  let written = (c.field("ansi") ?? JsonArray([])).elements()
  if written.len() == 16 {
    var whole = true
    var read: []u32 = []
    for v in written {
      match color_of(v.as_text() ?? "") {
        Some(rgb) => read.push(rgb),
        None => { whole = false },
      }
    }
    if whole { ansi = read }
  }
  backgrounds_alone_clear(Colors {
    fg: color_field(c, "foreground") ?? base.fg,
    bg: color_field(c, "background") ?? base.bg,
    cursor: color_field(c, "cursor") ?? base.cursor,
    selection: color_field(c, "selection") ?? base.selection,
    input: color_field(c, "input") ?? base.input,
    output: color_field(c, "output") ?? base.output,
    input_text: color_field(c, "input_text") ?? base.input_text,
    tab: color_field(c, "tab") ?? base.tab,
    tab_hovered: color_field(c, "tab_hovered") ?? base.tab_hovered,
    tab_selected: color_field(c, "tab_selected") ?? base.tab_selected,
    tab_rule: color_field(c, "tab_rule") ?? base.tab_rule,
    editor_text: color_field(c, "command_text") ?? base.editor_text,
    menu: color_field(c, "menu") ?? base.menu,
    menu_chosen: color_field(c, "menu_chosen") ?? base.menu_chosen,
    ansi: ansi,
    bg_fill: if c.field("background_fill").is_some() { backing_from_json(c.field("background_fill")) } else { base.bg_fill },
    input_fill: if c.field("input_fill").is_some() { backing_from_json(c.field("input_fill")) } else { base.input_fill },
    output_fill: if c.field("output_fill").is_some() { backing_from_json(c.field("output_fill")) } else { base.output_fill },
  })
}

/// How much what is behind the background `field` names is blurred, in points: the window's
/// (`bg`), the input sections' or the output sections' ([may_be_clear]); 0 for any other.
pub let blur_named = pure (s: Settings, field: string) -> f32 => match field {
  "bg" => s.background_blur,
  "input" => s.input_blur,
  "output" => s.output_blur,
  _ => 0.0,
}

/// `s` with the blur behind the background `field` names set to `radius`, whole points.
pub let with_blur = (s: mut Settings, field: string, radius: f32) -> void => {
  let r = f32(radius.round()).clamp(BLUR_RANGE.0, BLUR_RANGE.1)
  match field {
    "bg" => { s.background_blur = r },
    "input" => { s.input_blur = r },
    "output" => { s.output_blur = r },
    _ => {},
  }
}

/// Whether the colour `field` names may be translucent: the backgrounds — the window's, which
/// makes the window see-through, and the sections' (input and output), drawn over it. Text,
/// the tabs and the menus are opaque.
pub let may_be_clear = pure (field: string) -> bool =>
  field == "bg" || field == "input" || field == "output"

/// `c` with every colour but the backgrounds ([may_be_clear]) made opaque; a file's other
/// `#rrggbbaa` is read opaque.
let backgrounds_alone_clear = pure (c: Colors) -> Colors => Colors {
  c |
  fg: c.fg & 0xFFFFFF,
  cursor: c.cursor & 0xFFFFFF,
  selection: c.selection & 0xFFFFFF,
  input_text: c.input_text & 0xFFFFFF,
  tab: c.tab & 0xFFFFFF,
  tab_hovered: c.tab_hovered & 0xFFFFFF,
  tab_selected: c.tab_selected & 0xFFFFFF,
  tab_rule: c.tab_rule & 0xFFFFFF,
  editor_text: c.editor_text & 0xFFFFFF,
  menu: c.menu & 0xFFFFFF,
  menu_chosen: c.menu_chosen & 0xFFFFFF,
  ansi: [x in c.ansi | x & 0xFFFFFF],
}

/// A colour as `#rrggbb`, or `#rrggbbaa` where it is not opaque.
pub let hex_of = pure (rgb: u32) -> string => {
  let clear = (rgb >> 24) & 0xFF
  if clear == 0 { "#${(rgb & 0xFFFFFF).to_hex(6)}" } else { "#${(rgb & 0xFFFFFF).to_hex(6)}${(255 - clear).to_hex(2)}" }
}

/// `#rrggbb` or `#rrggbbaa` (the `#` optional) as a colour, its alpha kept as how transparent
/// it is in the top byte; `None` for anything else.
pub let color_of = pure (text: string) -> Maybe<u32> => {
  let digits = if text.starts_with("#") { text.slice(1, text.len()) } else { text }
  if digits.len() == 8 {
    let Some(rgb) = color_of(digits.slice(0, 6)) else { return None }
    let Some(alpha) = color_of("0000${digits.slice(6, 8)}") else { return None }
    return Some(((255 - alpha) << 24) | rgb)
  }
  if digits.len() != 6 { return None }
  var v: u32 = 0
  for r in digits.to_runes() {
    let c = i64(r)
    let d = if c >= 0x30 && c <= 0x39 { c - 0x30 }
    else if c >= 0x61 && c <= 0x66 { c - 0x61 + 10 }
    else if c >= 0x41 && c <= 0x46 { c - 0x41 + 10 }
    else { return None }
    v = v * 16 + u32(d)
  }
  Some(v)
}

let member = pure (key: string, value: JsonValue) -> JsonMember =>
  JsonMember { key: key, value: value }

let text_field = pure (doc: JsonValue, key: string) -> Maybe<string> =>
  match doc.field(key) {
    Some(v) => v.as_text(),
    None => None,
  }

let number_field = pure (doc: JsonValue, key: string) -> Maybe<f64> =>
  match doc.field(key) {
    Some(v) => v.as_number(),
    None => None,
  }

let color_field = pure (doc: JsonValue, key: string) -> Maybe<u32> =>
  match text_field(doc, key) {
    Some(t) => color_of(t),
    None => None,
  }

// ── Fonts ────────────────────────────────────────────────────────────────────

/// A font family: its name, and its regular, bold, italic and bold italic files (`""` for a
/// face it has no file of — bold is then drawn, italic left upright).
pub struct FontFamily {
  name: string,
  regular: string,
  bold: string,
  italic: string,
  bold_italic: string,
}

/// The name `f`'s regular face is loaded under for the Family list, which shows each family in
/// itself: its own, apart from the one the grid loads the whole family under, which would
/// otherwise be taken as loaded with no bold or italic.
pub let preview_name = pure (f: FontFamily) -> string => "preview ${f.regular}"

/// The monospaced families on this machine: the ones Termina knows by name (SF Mono,
/// Menlo, DejaVu Sans Mono) that are installed, then any others found in the font
/// directories whose files say they are monospaced (`Mono`, `Code`, `Courier`, `Consol` in
/// the name), sorted. The first is what Termina starts with.
pub let font_families = () -> []FontFamily => {
  var out: []FontFamily = []
  var known_files: []string = []
  for f in KNOWN {
    if exists(f.regular) { out.push(f) }
    known_files = [...known_files, f.regular, f.bold, f.italic, f.bold_italic]
  }
  // Every other font file, but those a family above already has.
  var files: []string = []
  for dir in font_dirs() {
    for path in font_files(dir, 2) {
      var known = false
      for k in known_files { if k == path { known = true } }
      if !known { files.push(path) }
    }
  }
  for f in families_of(files) {
    var seen = false
    for o in out { if o.name == f.name { seen = true } }
    if !seen { out.push(f) }
  }
  out
}

/// The families in `files` (paths of `.ttf`, `.otf` and `.ttc` files) that look monospaced,
/// their faces grouped by name: `JetBrainsMono-Bold.ttf` is JetBrains Mono's bold. A family
/// without a regular face is left out. Sorted by name after the first file of each.
pub let families_of = pure (files: []string) -> []FontFamily => {
  var names: []string = []
  var out: []FontFamily = []
  for path in files {
    let stem = path.stem()
    if looks_monospaced(stem) {
      let (family, face) = split_face(stem)
      let name = spaced(family)
      var k = -1
      for i in 0..<names.len() { if names[i] == name { k = i } }
      if k < 0 {
        names.push(name)
        out.push(FontFamily {
          name: name,
          regular: "",
          bold: "",
          italic: "",
          bold_italic: ""
        })
        k = out.len() - 1
      }
      if face == "regular" { out[k].regular = path }
      else if face == "bold" { out[k].bold = path }
      else if face == "italic" { out[k].italic = path }
      else if face == "bold italic" { out[k].bold_italic = path }
    }
  }
  var kept: []FontFamily = []
  for f in out { if f.regular != "" { kept.push(f) } }
  kept.sorted_by((a, b) => a.name.compare(b.name))
}

/// The faces the settings choose: the chosen file's alone when there is one, else the family
/// named (the first of `families` when it is not installed).
pub let family_for = pure (s: Settings, families: []FontFamily) -> Maybe<FontFamily> => {
  if s.font_file != "" { return Some(file_family(s.font_file)) }
  family_named(families, s.font_family)
}

/// A family of one file: named for it, its one face the regular.
pub let file_family = pure (path: string) -> FontFamily => FontFamily {
  name: spaced(split_face(path.stem()).0),
  regular: path,
  bold: "",
  italic: "",
  bold_italic: "",
}

/// The family `name` among `families`, or the first when it is not there.
pub let family_named = pure (
  families: []FontFamily,
  name: string
) -> Maybe<FontFamily> => {
  for f in families { if f.name == name { return Some(f) } }
  if families.len() > 0 { Some(families[0]) } else { None }
}

/// The fonts drawn from for the glyphs a family lacks — CJK, then symbols: of each group in
/// [FALLBACKS] the first installed. Merged into every face, in this order
/// (`../termina.lyra`).
pub let fallback_fonts = () -> []string => {
  var out: []string = []
  for group in FALLBACKS {
    if let Some(found) = first_existing(group) { out.push(found) }
  }
  out
}

/// The fallback for Chinese, Japanese and Korean, if the machine has one — the first of
/// [fallback_fonts] when it is there at all.
pub let cjk_fallback = () -> Maybe<string> => first_existing(FALLBACKS[0])

/// The first of `paths` that exists.
let first_existing = (paths: []string) -> Maybe<string> => {
  for path in paths { if exists(path) { return Some(path) } }
  None
}

/// The fallback fonts, a group each, where macOS and the Linux distributions keep them.
/// Arial Unicode covers Chinese, Japanese and Korean in one file of 23 MB (Hangul alone
/// is 55 MB in Apple SD Gothic Neo); Noto Sans CJK likewise on Linux.
const FALLBACKS: [][]string = [
  [
    "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
    "/System/Library/Fonts/Hiragino Sans GB.ttc",
    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/google-noto-cjk/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/google-noto-sans-cjk-vf-fonts/NotoSansCJK-VF.ttc",
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
  ],
  ["/System/Library/Fonts/Apple Symbols.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"],
]

/// The families Termina knows by name and where each platform keeps them.
const KNOWN: []FontFamily = [
  FontFamily {
    name: "SF Mono",
    regular: "/System/Library/Fonts/SFNSMono.ttf",
    bold: "",
    italic: "/System/Library/Fonts/SFNSMonoItalic.ttf",
    bold_italic: "",
  },
  FontFamily { name: "Menlo", regular: "/System/Library/Fonts/Menlo.ttc", bold: "", italic: "", bold_italic: "" },
  FontFamily {
    name: "DejaVu Sans Mono",
    regular: "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
    bold: "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
    italic: "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Oblique.ttf",
    bold_italic: "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-BoldOblique.ttf",
  },
]

/// The directories fonts are installed in, on macOS and Linux, the user's own included.
let font_dirs = () -> []string => {
  let home = lookup("HOME") ?? ""
  [
    "/System/Library/Fonts",
    "/System/Library/Fonts/Supplemental",
    "/Library/Fonts",
    home.join("Library/Fonts"),
    "/usr/share/fonts",
    "/usr/local/share/fonts",
    home.join(".local/share/fonts"),
    home.join(".fonts"),
  ]
}

/// The font files in `dir` and its subdirectories, `depth` levels down.
let font_files = (dir: string, depth: i64) -> []string => {
  let Some(names) = read_dir(dir) else { return [] }
  var out: []string = []
  for n in names {
    let path = dir.join(n)
    let ext = (n.extension() ?? "").to_ascii_lower()
    if ext == "ttf" || ext == "otf" || ext == "ttc" { out.push(path) }
    else if depth > 0 && !n.contains(".") { out = [
      ...out,
      ...font_files(path, depth - 1)
    ] }
  }
  out
}

/// Whether a file is at `path` — asked of its directory, since reading a font to find out
/// would read all of it.
let exists = (path: string) -> bool => {
  let Some(dir) = path.parent() else { return false }
  let Some(names) = read_dir(dir) else { return false }
  let name = path.base()
  for n in names { if n == name { return true } }
  false
}

/// Whether a file's stem names a monospaced font: `Mono`, `Code`, `Courier` or `Consol` in it,
/// as capitalised — `Unicode` does not count.
let looks_monospaced = pure (stem: string) -> bool =>
  stem.contains("Mono") ||
  stem.contains("mono") ||
  stem.contains("Code") ||
  stem.contains("Courier") ||
  stem.contains("Consol")

/// A file's stem as its family and face: `JetBrainsMono-BoldItalic` is `JetBrainsMono` and
/// `bold italic`; a stem with no face suffix is the regular face.
let split_face = pure (stem: string) -> (string, string) => {
  // After a dash, a space (`Courier New Bold`), or nothing (`SFNSMonoItalic`).
  let suffixes = [
    ("-BoldItalic", "bold italic"),
    ("-BoldOblique", "bold italic"),
    (" Bold Italic", "bold italic"),
    (" Bold Oblique", "bold italic"),
    ("BoldItalic", "bold italic"),
    ("-Bold", "bold"),
    (" Bold", "bold"),
    ("-Italic", "italic"),
    ("-Oblique", "italic"),
    (" Italic", "italic"),
    (" Oblique", "italic"),
    ("Italic", "italic"),
    ("-Regular", "regular"),
    (" Regular", "regular"),
  ]
  for (suffix, face) in suffixes {
    if stem.ends_with(suffix) { return (stem.slice(0, stem.len() - suffix.len()), face) }
  }
  // A face whose name is not one of these — Light, Medium, Thin — is not offered.
  for word in [
    "-Light",
    "-Medium",
    "-Thin",
    "-ExtraBold",
    "-SemiBold",
    "-Black",
    "-ExtraLight"
  ] {
    if stem.contains(word) { return (stem, "other") }
  }
  (stem, "regular")
}

/// `JetBrainsMono` as `JetBrains Mono`: a space before the words font names are made of
/// (`Mono`, `Code`, `Sans`, …) when run into the word before, and for `-` and `_`. Not
/// before every capital — that would make `JetBrains` two words.
let spaced = pure (name: string) -> string => {
  var out = name.replace("-", " ").replace("_", " ")
  for word in ["Mono", "Code", "Sans", "Serif", "Pro", "Nerd", "Font"] {
    var i = 1
    while i < out.len() {
      let rest = out.slice(i, out.len())
      if rest.starts_with(word) && out.slice(i - 1, i) != " " {
        out = "${out.slice(0, i)} ${rest}"
        i += word.len() + 1
      } else {
        i += 1
      }
    }
  }
  out
}
