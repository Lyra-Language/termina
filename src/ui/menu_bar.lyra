module ui
//! The menu bar off macOS, drawn by Termina along the window's top: the Mac's menus —
//! Termina (Settings…, Quit), Shell (the tabs), Edit, View (the font's size) and Window —
//! with the same items. A
//! choice answers the tag the Mac's bar sends for it (`tabs.lyra`'s `MENU_*`), so one piece
//! of `../termina.lyra` carries out both; Quit, Minimize and Maximize are the host's and
//! done here. ImGui's main menu bar takes its height off the viewport's work area, which
//! the terminal's window fills, so the tabs move down below it.
//!
//! **The keys stay keys**: off macOS a shortcut is read where it acts (`tab_command`, the
//! command line, the session), and an item only shows it. Ctrl alone is the shell's, so
//! the terminal's own are Ctrl+Shift, as GNOME Terminal and Konsole have them — but Undo,
//! which is Ctrl+Z in the command line (Ctrl+Shift+Z being Redo).

import bindings.imgui.{
  Host,
  begin_main_menu_bar,
  end_main_menu_bar,
  push_style_var_vec2,
  pop_style_var,
  get_style,
  Vec2,
  STYLE_VAR_FRAME_PADDING,
  begin_menu,
  end_menu,
  menu_item,
  separator as menu_separator,
  request_quit,
  minimize,
  toggle_maximized,
  is_maximized,
}

/// Draw the menu bar, the tabs `tabs` in the Window menu with `active` checked, and Edit's
/// items enabled as `enabled` says, in [EDIT_ITEMS]' order. The tag of the item chosen this
/// frame, if any. `after_item` is called after each menu and item is drawn, with its label,
/// for a test to find it by.
pub let menu_bar = (
  host: Host,
  tabs: []TabLabel,
  active: i64,
  enabled: []bool,
  after_item: (string) -> void
) -> Maybe<i32> => {
  var chosen: Maybe<i32> = None
  // Taller than ImGui's own, the menus' names with room above and below: the bar's height
  // is its frame padding's, around the text, and the names are placed by it too — so it
  // stays pushed until the bar ends.
  let pad = get_style().frame_padding()
  push_style_var_vec2(
    STYLE_VAR_FRAME_PADDING,
    Vec2 { x: pad.x, y: pad.y + MENU_BAR_EXTRA }
  )
  if !begin_main_menu_bar() {
    pop_style_var()
    return None
  }
  if open_menu("Termina", after_item) {
    if menu_choice(
      "Settings…",
      "Ctrl+,",
      true,
      after_item
    ) { chosen = Some(MENU_SETTINGS) }
    menu_separator()
    if menu_choice("Quit", "", true, after_item) { request_quit(host) }
    end_menu()
  }
  if open_menu("Shell", after_item) {
    if menu_choice(
      "New Tab",
      "Ctrl+Shift+T",
      true,
      after_item
    ) { chosen = Some(MENU_NEW_TAB) }
    menu_separator()
    let many = tabs.len() > 1
    if menu_choice("Show Previous Tab", "Ctrl+PgUp", many, after_item) {
      chosen = Some(MENU_PREVIOUS_TAB)
    }
    if menu_choice(
      "Show Next Tab",
      "Ctrl+PgDn",
      many,
      after_item
    ) { chosen = Some(MENU_NEXT_TAB) }
    menu_separator()
    if menu_choice(
      "Close Tab",
      "Ctrl+Shift+W",
      true,
      after_item
    ) { chosen = Some(MENU_CLOSE_TAB) }
    end_menu()
  }
  if open_menu("Edit", after_item) {
    for k in 0..<EDIT_ITEMS.len() {
      // A rule between Undo and Redo and the clipboard's, as the Mac's menu has it.
      if k == 2 { menu_separator() }
      let (tag, _) = EDIT_ITEMS[k]
      let on = k < enabled.len() && enabled[k]
      if menu_choice(
        EDIT_LABELS[k].0,
        EDIT_LABELS[k].1,
        on,
        after_item
      ) { chosen = Some(tag) }
    }
    end_menu()
  }
  if open_menu("View", after_item) {
    if menu_choice("Default Font Size", "Ctrl+Shift+0", true, after_item) {
      chosen = Some(MENU_DEFAULT_SIZE)
    }
    if menu_choice(
      "Bigger",
      "Ctrl+Shift+=",
      true,
      after_item
    ) { chosen = Some(MENU_BIGGER) }
    if menu_choice(
      "Smaller",
      "Ctrl+Shift+-",
      true,
      after_item
    ) { chosen = Some(MENU_SMALLER) }
    end_menu()
  }
  if open_menu("Window", after_item) {
    if menu_choice("Minimize", "", true, after_item) { minimize(host) }
    let zoom = if is_maximized(host) { "Restore" } else { "Maximize" }
    if menu_choice(zoom, "", true, after_item) { toggle_maximized(host) }
    menu_separator()
    // The tabs, the shown one checked, as the Mac's Window menu lists windows.
    for k in 0..<tabs.len() {
      let shortcut = if k < 9 { Some("Alt+${k + 1}") } else { None }
      if menu_item("${tabs[k].name}###menutab${tabs[k].id}", shortcut, k == active) {
        chosen = Some(MENU_TAB + i32(k))
      }
      after_item(tabs[k].name)
    }
    end_menu()
  }
  end_main_menu_bar()
  pop_style_var()
  chosen
}

/// Points added above and below the menus' names on the bar.
const MENU_BAR_EXTRA: f32 = 4.0

/// Window ▸ a tab: the first's tag, the rest after it ([menu_command] reads them).
pub const MENU_TAB: i32 = 100

/// Edit's items as this bar shows them, in [EDIT_ITEMS]' order: each name and its keys.
const EDIT_LABELS: [](string, string) = [
  ("Undo", "Ctrl+Z"),
  ("Redo", "Ctrl+Shift+Z"),
  ("Cut", "Ctrl+Shift+X"),
  ("Copy", "Ctrl+Shift+C"),
  ("Paste", "Ctrl+Shift+V"),
  ("Select All", "Ctrl+Shift+A"),
]

/// A menu on the bar, named to `after_item`; whether it is open.
let open_menu = (label: string, after_item: (string) -> void) -> bool => {
  let open = begin_menu(label)
  after_item(label)
  open
}

/// An item, its keys shown beside it (none for `""`), greyed unless `enabled`, named to
/// `after_item`; whether it was chosen.
let menu_choice = (
  label: string,
  keys: string,
  enabled: bool,
  after_item: (string) -> void
) -> bool => {
  let shortcut = if keys == "" { None } else { Some(keys) }
  let picked = menu_item(label, shortcut, false, enabled)
  after_item(label)
  picked
}
