module ui
//! The modifier keys held, as the keyboard has them. **ImGui swaps Ctrl and ⌘ on macOS**
//! (`ConfigMacOSXBehaviors`, since 1.90.7): its `KeyCtrl` is "the shortcut key", ⌘ on a Mac,
//! so that its own widgets' Ctrl+C is ⌘C there. A terminal needs the keys themselves —
//! Ctrl+A is zsh's line start and ⌘A is select-all — so every key decision in Termina asks
//! [held], which undoes the swap when ImGui made it.

import bindings.imgui.{ get_io }

/// The modifiers held: the physical Control key, ⌘ (the Windows or Super key elsewhere),
/// Option or Alt, and Shift.
pub struct Held {
  control: bool,
  command: bool,
  alt: bool,
  shift: bool,
}

/// The modifiers held this frame, as pressed.
pub let held = () -> Held => {
  let io = get_io()
  let swapped = io.config_mac_osx_behaviors()
  Held {
    control: if swapped { io.key_super() } else { io.key_ctrl() },
    command: if swapped { io.key_ctrl() } else { io.key_super() },
    alt: io.key_alt(),
    shift: io.key_shift(),
  }
}
