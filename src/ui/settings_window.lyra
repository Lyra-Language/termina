module ui
//! The settings: the font — its family, size and line spacing — and the colours —
//! a theme to start from, then the text, background, cursor, selection, the sections'
//! (input and output), the tabs', the command line's and the 16 ANSI colours one by one,
//! and bold as bright. Changes take at once; `../termina.lyra` keeps
//! them (`../settings/settings.lyra`). Drawn in a Settings tab of the tab bar, opened by
//! Termina ▸ Settings… (⌘,, or Ctrl+, off macOS).

import bindings.imgui.{
  begin_combo,
  end_combo,
  selectable,
  slider_float,
  color_edit3,
  checkbox,
  button,
  separator_text,
  same_line,
  text as label,
  push_id_int,
  pop_id,
  input_text_with_hint,
  begin_disabled,
  end_disabled,
  separator as themes_rule,
  set_next_item_width,
  Vec2,
  push_item_width,
  pop_item_width,
  COLOR_EDIT_FLAGS_NO_INPUTS,
  COLOR_EDIT_FLAGS_NO_LABEL,
}
import settings.{
  Settings,
  FontFamily,
  defaults,
  file_family,
  theme_colours,
  can_save_as,
  save_theme,
  delete_theme,
  saved_colours,
  THEME_NAMES,
  FONT_SIZE_RANGE,
  LINE_SPACING_RANGE,
}

/// What the settings ask of the program this frame.
pub struct SettingsAsk {
  /// Something changed.
  changed: bool,
  /// Other Font File… was pressed: the system's file dialog is the program's to show.
  choose_file: bool,
}

/// Draw the settings into the window drawing now — the Settings tab's area — editing `s`, the
/// font families on offer being `families`; `theme_name` is what is typed to save the
/// colours as a theme, kept between frames.
pub let settings_panel = (
  s: mut Settings,
  families: []FontFamily,
  theme_name: mut string
) -> SettingsAsk => {
  var choose_file = false
  var changed = false
  // Fields as wide as their contents need, not the tab's width.
  push_item_width(SETTINGS_FIELD_WIDTH)
  separator_text("Font")
  // A chosen file shows as its own name; picking a family goes back to families.
  let shown = if s.font_file != "" { file_family(s.font_file).name } else { s.font_family }
  if begin_combo("Family", shown) {
    for f in families {
      if selectable(f.name, s.font_file == "" && f.name == s.font_family) {
        s.font_family = f.name
        s.font_file = ""
        changed = true
      }
    }
    end_combo()
  }
  if button("Other Font File…") { choose_file = true }
  if slider_float(
    "Size",
    s.font_size,
    FONT_SIZE_RANGE.0,
    FONT_SIZE_RANGE.1,
    "%.0f pt"
  ) {
    // Whole points: a fractional size blurs every glyph.
    s.font_size = f32(s.font_size.round())
    changed = true
  }
  if slider_float(
    "Line spacing",
    s.line_spacing,
    LINE_SPACING_RANGE.0,
    LINE_SPACING_RANGE.1,
    "%.2f"
  ) {
    changed = true
  }

  separator_text("Colours")
  if begin_combo("Theme", s.theme_name) {
    for name in THEME_NAMES {
      if selectable(name, name == s.theme_name) {
        s.theme_name = name
        s.colours = theme_colours(name)
        changed = true
      }
    }
    // The user's own, after Termina's.
    if s.themes.len() > 0 { themes_rule() }
    for t in s.themes {
      if selectable("${t.name}##saved", t.name == s.theme_name) {
        s.theme_name = t.name
        s.colours = t.colours
        changed = true
      }
    }
    end_combo()
  }
  // The colours as they are, saved under a name of the user's — one of theirs replaced,
  // Termina's own not; and a saved theme deleted.
  set_next_item_width(180.0)
  let _ = input_text_with_hint("##themename", "Theme name", theme_name)
  same_line()
  begin_disabled(!can_save_as(theme_name))
  if button("Save Theme As…") {
    save_theme(s, theme_name)
    theme_name = ""
    changed = true
  }
  end_disabled()
  match saved_colours(s.themes, s.theme_name) {
    Some(_) => {
      same_line()
      if button("Delete") {
        delete_theme(s, s.theme_name)
        changed = true
      }
    },
    None => {},
  }
  // A colour changed by hand makes the theme the user's own.
  var edited = false
  if colour_field("Text", s.colours.fg) { edited = true }
  if colour_field("Background", s.colours.bg) { edited = true }
  if colour_field("Cursor", s.colours.cursor) { edited = true }
  if colour_field("Selection", s.colours.selection) { edited = true }
  label("Sections")
  if colour_field("Input##section", s.colours.input) { edited = true }
  if colour_field("Output##section", s.colours.output) { edited = true }
  if colour_field("Input text", s.colours.input_text) { edited = true }
  label("Tabs")
  if colour_field("Tab", s.colours.tab) { edited = true }
  if colour_field("Under the pointer", s.colours.tab_hovered) { edited = true }
  if colour_field("Shown", s.colours.tab_selected) { edited = true }
  label("Command line")
  if colour_field("Text##command", s.colours.editor_text) { edited = true }
  if colour_field("Completion menu", s.colours.menu) { edited = true }
  if colour_field("Chosen completion", s.colours.menu_chosen) { edited = true }
  label("ANSI colours")
  for k in 0..<16 {
    if k % 8 != 0 { same_line() }
    push_id_int(i32(k))
    if colour_swatch(s.colours.ansi, k) { edited = true }
    pop_id()
  }
  if edited {
    s.theme_name = "Custom"
    changed = true
  }
  if checkbox("Draw bold text in bright colours", s.bold_is_bright) { changed = true }

  separator_text("")
  if button("Reset to Defaults") {
    s = defaults()
    changed = true
  }
  pop_item_width()
  SettingsAsk { changed: changed, choose_file: choose_file }
}

/// How wide the settings' fields are, in points.
const SETTINGS_FIELD_WIDTH: f32 = 320.0

/// A colour's swatch and picker, labelled; whether it was changed.
let colour_field = (label: string, rgb: mut u32) -> bool => {
  var c = channels(rgb)
  if color_edit3(label, c, COLOR_EDIT_FLAGS_NO_INPUTS) {
    rgb = packed(c)
    return true
  }
  false
}

/// ANSI colour `k`'s swatch, unlabelled; whether it was changed.
let colour_swatch = (ansi: mut []u32, k: i64) -> bool => {
  var c = channels(ansi[k])
  if color_edit3("##ansi", c, COLOR_EDIT_FLAGS_NO_INPUTS | COLOR_EDIT_FLAGS_NO_LABEL) {
    ansi[k] = packed(c)
    return true
  }
  false
}

/// `0xRRGGBB` as the three channels a colour picker edits, 0 to 1.
pub let channels = pure (rgb: u32) -> [3]f32 => #[
  f32((rgb >> 16) & 0xFF) / 255.0,
  f32((rgb >> 8) & 0xFF) / 255.0,
  f32(rgb & 0xFF) / 255.0,
]

/// Three channels, 0 to 1, as `0xRRGGBB`.
pub let packed = pure (c: [3]f32) -> u32 => {
  let r = u32((c[0].clamp(0.0, 1.0) * 255.0).round())
  let g = u32((c[1].clamp(0.0, 1.0) * 255.0).round())
  let b = u32((c[2].clamp(0.0, 1.0) * 255.0).round())
  (r << 16) | (g << 8) | b
}
