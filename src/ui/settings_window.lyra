module ui
//! The settings: the font — its family, size and line spacing — and the colors —
//! a theme to start from, then the text, background, cursor, selection, the sections'
//! (input and output), the tabs', the command line's and the 16 ANSI colors one by one,
//! and bold as bright. Changes take at once; `../termina.lyra` keeps
//! them (`../settings/settings.lyra`). Drawn in a Settings tab of the tab bar, opened by
//! Termina ▸ Settings… (⌘,, or Ctrl+, off macOS).
//!
//! The tab is markup, `../settings_view.lui`; its events are carried out here.

import bindings.imgui.{ push_item_width, pop_item_width }
import bindings.imgui.ui.{ render }
import settings.{
  Settings,
  FontFamily,
  defaults,
  theme_colors,
  save_theme,
  delete_theme,
  saved_colors,
  with_color,
  with_ansi,
}
import settings_view.{
  settings_view,
  SettingsEvent,
  UseFamily,
  ChooseFontFile,
  SetFontSize,
  SetLineSpacing,
  SetColor,
  SetAnsi,
  UseTheme,
  UseSavedTheme,
  NameTheme,
  SaveThemeAs,
  DeleteSavedTheme,
  ToggleBoldBright,
  ResetSettings,
}

/// What the settings ask of the program this frame.
pub struct SettingsAsk {
  /// Something changed.
  changed: bool,
  /// Other Font File… was pressed: the system's file dialog is the program's to show.
  choose_file: bool,
}

/// Draw the settings into the window drawing now — the Settings tab's area — editing `s`, the
/// font families on offer being `families`; `theme_name` is what is typed to save the
/// colors as a theme, kept between frames.
pub let settings_panel = (
  s: mut Settings,
  families: []FontFamily,
  theme_name: mut string
) -> SettingsAsk => {
  // Fields as wide as their contents need, not the tab's width.
  push_item_width(SETTINGS_FIELD_WIDTH)
  let events = render([settings_view(s, families, theme_name)], (_) => {})
  pop_item_width()
  var changed = false
  var choose_file = false
  for event in events {
    let ask = carry_out(s, theme_name, event)
    changed = changed || ask.changed
    choose_file = choose_file || ask.choose_file
  }
  SettingsAsk { changed: changed, choose_file: choose_file }
}

/// One of the tab's events carried out on `s` (and `theme_name`, what is typed to save a
/// theme as); what it asks of the program.
pub let carry_out = (
  s: mut Settings,
  theme_name: mut string,
  event: SettingsEvent
) -> SettingsAsk => {
  match event {
    // Picking a family goes back to families from a chosen file.
    UseFamily(name) => {
      s.font_family = name
      s.font_file = ""
    },
    ChooseFontFile => { return SettingsAsk { changed: false, choose_file: true } },
    // Whole points: a fractional size blurs every glyph.
    SetFontSize(size) => { s.font_size = f32(size.round()) },
    SetLineSpacing(spacing) => { s.line_spacing = spacing },
    // A color changed by hand makes the theme the user's own.
    SetColor(field, rgb) => {
      s.colors = with_color(s.colors, field, rgb)
      s.theme_name = "Custom"
    },
    SetAnsi(k, rgb) => {
      s.colors = with_ansi(s.colors, k, rgb)
      s.theme_name = "Custom"
    },
    UseTheme(name) => {
      s.theme_name = name
      s.colors = theme_colors(name)
    },
    UseSavedTheme(name) => {
      let Some(saved) = saved_colors(s.themes, name) else { return UNCHANGED }
      s.theme_name = name
      s.colors = saved
    },
    NameTheme(text) => {
      theme_name = text
      return UNCHANGED
    },
    // The colors as they are, under a name of the user's — one of theirs replaced,
    // Termina's own not.
    SaveThemeAs => {
      save_theme(s, theme_name)
      theme_name = ""
    },
    DeleteSavedTheme => delete_theme(s, s.theme_name),
    ToggleBoldBright => { s.bold_is_bright = !s.bold_is_bright },
    ResetSettings => { s = defaults() },
  }
  SettingsAsk { changed: true, choose_file: false }
}

/// Nothing asked.
const UNCHANGED = SettingsAsk { changed: false, choose_file: false }

/// How wide the settings' fields are, in points.
const SETTINGS_FIELD_WIDTH: f32 = 320.0
