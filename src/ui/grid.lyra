module ui
//! A screen line drawn: its backgrounds, its text in runs of one style, and the lines an
//! underline or a strike adds. A run is as long as the style stays the same, so a line of
//! plain text is one `add_text`, as it was before colour. **A wide rune is drawn alone**,
//! across its two cells: a run's glyphs are spaced a cell apart, which a wide glyph is not.
//! So is a rune with combining marks, drawn as it and its marks, so that a mark's own
//! advance (the font's, not the grid's) cannot move what follows.
//!
//! **Bold** is the bold face when there is one (Linux's DejaVu has a file for it), else
//! the text drawn twice a pixel apart: macOS's SF Mono is one variable font, and ImGui
//! takes one instance of it. **Italic** is the italic face (SF Mono and DejaVu both ship
//! one), or upright without it.

import bindings.imgui.{ push_font_float, pop_font, calc_text_size, Vec2, DrawList, Font }
import vt.{
  Cell,
  BOLD,
  ITALIC,
  UNDERLINE,
  DOUBLE_UNDERLINE,
  CURLY_UNDERLINE,
  STRIKE,
  SPACER,
  width_of,
  marks_of
}

/// The faces a grid is drawn in; `None` for one not found (the host's default face stands
/// in for a missing regular one).
pub struct Fonts {
  regular: Maybe<Font>,
  bold: Maybe<Font>,
  italic: Maybe<Font>,
  bold_italic: Maybe<Font>,
  size: f32,
}

/// Where a line goes: the screen position of its first cell, a cell's size, how far down
/// the cell its text sits, and the pixel a fake bold is offset by.
pub struct LineAt {
  origin: Vec2,
  cell: Vec2,
  text_dy: f32,
  pixel: f32,
}

/// Draw the first `upto` cells of `cells` (all of them when `upto` is past the end), their
/// combining marks the screen's `combining`.
pub let draw_line = (
  list: DrawList,
  theme: Theme,
  fonts: Fonts,
  at: LineAt,
  cells: []Cell,
  combining: []string,
  upto: i64
) -> void => {
  let n = upto.min(cells.len())
  if n <= 0 { return }
  draw_backgrounds(list, theme, at, cells, n)
  // Text, a run of one colour and face at a time. Trailing blanks are not drawn.
  var end = n
  while end > 0 && cells[end - 1].ch == ' ' && cells[end - 1].attrs & (UNDERLINE_ANY | STRIKE) == 0 {
    end -= 1
  }
  var start = 0
  while start < end {
    let (fg, _) = theme.colours(cells[start])
    let attrs = cells[start].attrs
    if cells[start].ch == SPACER {
      // The second cell of a wide rune (or one left alone by an erase): nothing to draw.
      start += 1
    } else if width_of(cells[start].ch) == 2 {
      draw_run(list, fonts, at, cells, combining, start, (start + 2).min(n), fg, attrs)
      start += 2
    } else if marks_of(cells[start]) != 0 {
      draw_run(list, fonts, at, cells, combining, start, start + 1, fg, attrs)
      start += 1
    } else {
      var stop = start + 1
      while stop < end && one_cell(cells[stop]) && same_run(
        theme,
        cells[stop],
        fg,
        attrs
      ) { stop += 1 }
      draw_run(list, fonts, at, cells, combining, start, stop, fg, attrs)
      start = stop
    }
  }
}

/// Whether a cell holds a rune one cell wide and unmarked — one a run may take.
let one_cell = pure (c: Cell) -> bool =>
  c.ch != SPACER && width_of(c.ch) == 1 && marks_of(c) == 0

/// Every underline's bit.
const UNDERLINE_ANY: u32 = UNDERLINE | DOUBLE_UNDERLINE | CURLY_UNDERLINE

/// The attributes that change how text is drawn, rather than its colour.
const DRAWN: u32 = BOLD | ITALIC | UNDERLINE_ANY | STRIKE

let same_run = pure (theme: Theme, c: Cell, fg: u32, attrs: u32) -> bool => {
  let (cfg, _) = theme.colours(c)
  cfg == fg && c.attrs & DRAWN == attrs & DRAWN
}

// Runs of one background colour as rectangles; the theme's own is the window's, and is not
// drawn.
let draw_backgrounds = (
  list: DrawList,
  theme: Theme,
  at: LineAt,
  cells: []Cell,
  n: i64
) -> void => {
  var start = 0
  while start < n {
    let (_, bg) = theme.colours(cells[start])
    var stop = start + 1
    while stop < n && theme.colours(cells[stop]).1 == bg { stop += 1 }
    match bg {
      Some(colour) => {
        let x0 = at.origin.x + f32(start) * at.cell.x
        let x1 = at.origin.x + f32(stop) * at.cell.x
        list.add_rect_filled(
          Vec2 { x: x0, y: at.origin.y },
          Vec2 { x: x1, y: at.origin.y + at.cell.y },
          colour
        )
      },
      None => {},
    }
    start = stop
  }
}

let draw_run = (
  list: DrawList,
  fonts: Fonts,
  at: LineAt,
  cells: []Cell,
  combining: []string,
  start: i64,
  stop: i64,
  fg: u32,
  attrs: u32
) -> void => {
  var bytes: []u8 = []
  for k in start..<stop {
    if cells[k].ch != SPACER {
      push_rune(bytes, i64(cells[k].ch))
      let marks = marks_of(cells[k])
      if marks != 0 { for b in combining[marks].encode_utf8() { bytes.push(b) } }
    }
  }
  let text = bytes.decode_utf8()
  let x0 = at.origin.x + f32(start) * at.cell.x
  let x1 = at.origin.x + f32(stop) * at.cell.x
  let (face, drawn_bold) = face_for(fonts, attrs & BOLD != 0, attrs & ITALIC != 0)
  match face {
    Some(f) => push_font_float(f, fonts.size),
    None => {},
  }
  // A wide glyph (from a fallback font, often) is narrower than its two cells: centred.
  let wide = stop - start == 2 && width_of(cells[start].ch) == 2
  let spare = if wide { (x1 - x0 - calc_text_size(text).x).max(0.0) } else { 0.0 }
  let pos = Vec2 { x: x0 + f32((spare / 2.0).floor()), y: at.origin.y + at.text_dy }
  list.add_text(pos, fg, text)
  if drawn_bold { list.add_text(Vec2 { x: pos.x + at.pixel, y: pos.y }, fg, text) }
  match face {
    Some(_) => pop_font(),
    None => {},
  }
  // Decorations, from the text's baseline (a size below its top, near enough for a
  // monospaced face) and its middle.
  let baseline = at.origin.y + at.text_dy + fonts.size * 0.92
  let thick = (fonts.size / 14.0).max(1.0)
  if attrs & UNDERLINE != 0 { list.add_line_h(x0, x1, baseline + thick, fg, thick) }
  if attrs & DOUBLE_UNDERLINE != 0 {
    list.add_line_h(x0, x1, baseline + thick * 0.5, fg, thick)
    list.add_line_h(x0, x1, baseline + thick * 2.5, fg, thick)
  }
  if attrs & CURLY_UNDERLINE != 0 { curl(
    list,
    x0,
    x1,
    baseline + thick * 1.5,
    thick * 1.5,
    fg,
    thick
  ) }
  if attrs & STRIKE != 0 { list.add_line_h(
    x0,
    x1,
    at.origin.y + at.text_dy + fonts.size * 0.55,
    fg,
    thick
  ) }
}

// The face a run is drawn in (`None`: the regular one, already pushed) and whether its bold
// must be drawn: bold italic falls back to the italic face drawn bold, then to bold.
let face_for = pure (fonts: Fonts, bold: bool, italic: bool) -> (Maybe<Font>, bool) => {
  if bold && italic {
    match fonts.bold_italic {
      Some(f) => return (Some(f), false),
      None => {},
    }
    match fonts.italic {
      Some(f) => return (Some(f), true),
      None => {},
    }
  }
  if bold {
    return match fonts.bold {
      Some(f) => (Some(f), false),
      None => (None, true),
    }
  }
  if italic { return (fonts.italic, false) }
  (None, false)
}

// A wave from x0 to x1 about `y`, `amp` high: a half-period of a quadratic bezier each way
// across `amp * 4` points.
let curl = (
  list: DrawList,
  x0: f32,
  x1: f32,
  y: f32,
  amp: f32,
  colour: u32,
  thick: f32
) -> void => {
  let step = amp * 4.0
  var x = x0
  var up = true
  while x < x1 {
    let nx = (x + step).min(x1)
    let peak = if up { y - amp } else { y + amp }
    list.add_bezier_quadratic(
      Vec2 { x: x, y: y },
      Vec2 { x: (x + nx) / 2.0, y: peak },
      Vec2 { x: nx, y: y },
      colour,
      thick
    )
    x = nx
    up = !up
  }
}
