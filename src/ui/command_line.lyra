module ui
//! The command line: the [Editor] drawn where the shell's prompt ends, and the keyboard and
//! mouse turned into its edits. Shown only while the shell is at a prompt (its integration
//! said so — `../shell/shell.lyra`); otherwise the keys are the running program's.
//!
//! **Keys, on a Mac** — ←/→ a rune, ⌥←/→ a word, ⌘←/→ the line's start and end, ↑/↓ a row
//! (from the first or last row: the history), ⌘↑/↓ the text's start and end; ⇧ with any of
//! them selects. ⌫, ⌥⌫ a word, ⌘⌫ to the line's start; ⌦ and ⌥⌦ forward. ⌘A, ⌘C, ⌘X, ⌘V,
//! ⌘Z, ⇧⌘Z. Return runs the command; ⇧Return (or ⌥Return) starts a new line. The shell's
//! own Ctrl keys still work: Ctrl+A/E the line's ends, Ctrl+K and Ctrl+U delete to them,
//! Ctrl+W a word back, Ctrl+C clears, Ctrl+D on an empty line ends the shell, Ctrl+L clears
//! the screen. **Elsewhere** Ctrl takes ⌥'s place for words, and Ctrl+Shift ⌘'s.
//!
//! **Tab** asks the shell for the completions of the word at the caret (zsh's own, through
//! its integration — `../shell/shell.lyra`). One is put in at once; of several, the start
//! they share is, and a menu opens under the word: ↑/↓ or Tab/⇧Tab choose, Return or a
//! click puts the chosen one in, Escape closes it. **Typing narrows it** to the matches
//! that start with the word as it now stands, and ⌫ widens it again — from the list zsh
//! gave, without asking again; it closes when nothing is left to offer or the caret leaves
//! the word's end.
//!
//! **Mouse** — a click puts the caret; a drag, or a shift-click, selects; a double-click
//! selects the word under the pointer and a drag after it extends by whole words; a
//! triple-click selects the line.

import bindings.sdl3.{ platform }
import bindings.imgui.{
  typed_text,
  is_key_pressed,
  is_mouse_clicked,
  is_mouse_down,
  get_mouse_clicked_count,
  get_mouse_pos,
  is_window_hovered,
  set_mouse_cursor,
  get_clipboard_text,
  set_clipboard_text,
  request_text_input,
  Vec2,
  DrawList,
  MOUSE_CURSOR_TEXT_INPUT,
  KEY_A,
  KEY_C,
  KEY_D,
  KEY_E,
  KEY_K,
  KEY_L,
  KEY_U,
  KEY_V,
  KEY_W,
  KEY_X,
  KEY_Z,
  KEY_LEFT_ARROW,
  KEY_RIGHT_ARROW,
  KEY_UP_ARROW,
  KEY_DOWN_ARROW,
  KEY_HOME,
  KEY_END,
  KEY_DELETE,
  KEY_BACKSPACE,
  KEY_ENTER,
  KEY_KEYPAD_ENTER,
  KEY_ESCAPE,
  KEY_TAB,
}
import editor.{
  editor,
  Editor,
  Wrap,
  position,
  row_count,
  index_at,
  rune_at,
  shell_word_at,
  text_of
}
import vt.{ Completion }

/// The command line's state between frames: the editor, the history being walked, and a
/// drag under way.
pub struct CommandLine {
  edit: Editor,
  history: []string,
  /// The history entry shown, or `history.len()` when none is (the user's own text).
  browsing: i64,
  /// The user's own text, kept while ↑ walks the history so that ↓ past the newest entry
  /// brings it back.
  draft: string,
  dragging: bool,
  /// The word a double-click selected, while the drag after it extends by words.
  word_drag: Maybe<(i64, i64)>,
  /// The text and caret completions were asked for, while the shell works on them: an
  /// answer for anything else (the user went on typing) is dropped.
  pending: Maybe<(string, i64)>,
  /// The completions zsh offered, while their menu is open, and the column their word
  /// begins at: what typing narrows the menu from, and widens it back to.
  offered: []Completion,
  menu_word: i64,
  /// The completions the menu shows (empty: closed) — those of `offered` that start with
  /// the word as typed — the one chosen, and the first shown.
  menu: []Completion,
  chosen: i64,
  menu_top: i64,
  /// Whether ⌘Z, ⌘X, ⌘C, ⌘V and ⌘A belong to a menu bar's Edit menu, and come as
  /// [edit_action]s rather than keys: AppKit hands a menu's key equivalent to SDL too, and
  /// read both ways every paste would happen twice.
  menu_keys: bool,
  /// Keys typed ahead and not yet used, as lines (`typeahead.lyra`): each ended line a
  /// command to run at a prompt, in turn, and what follows the last Return for the editor.
  ahead: string,
}

/// Completions a menu shows at once; more scroll.
const MENU_ROWS: i64 = 8

/// The widest a completion and its description are shown, in cells; longer is cut.
const MENU_SHOWN: i64 = 40
const MENU_DESCRIPTION: i64 = 60

/// What the command line asks of the terminal this frame.
pub data Outcome =
  Nothing
  /// Run this command.
  | Submit string
  /// Send these bytes to the shell as typed (Ctrl+D, Ctrl+L).
  | Send string
  /// Ask the shell for the completions of this text, the caret at this rune (Tab).
  | Complete(string, i64)

/// An empty command line over `history` (oldest first).
pub let command_line = pure (history: []string) -> CommandLine => CommandLine {
  edit: editor(),
  history: history,
  browsing: history.len(),
  draft: "",
  dragging: false,
  word_drag: None,
  pending: None,
  offered: [],
  menu_word: 0,
  menu: [],
  chosen: 0,
  menu_top: 0,
  ahead: "",
  menu_keys: false,
}

/// What the Edit menu does — and ⌘Z, ⇧⌘Z, ⌘X, ⌘C, ⌘V, ⌘A without one.
pub data EditAction = Undo | Redo | Cut | Copy | Paste | SelectAll

/// How the command line looks.
pub struct Style {
  text: u32,
  caret: u32,
  selection: u32,
  /// The completion menu: its background, the chosen row's, and descriptions' text.
  menu: u32,
  menu_chosen: u32,
  faint: u32,
}

/// Where the command line is: the screen position of column 0 of its first row, a cell's
/// size, and the layout.
pub struct Place {
  origin: Vec2,
  cell: Vec2,
  /// How far down its cell a line's text is drawn.
  text_dy: f32,
  wrap: Wrap,
  /// The completion menu opens upward, its foot `lift` points above the text (over the
  /// prompt's row and the box's padding, when the command line is a box at the window's
  /// foot), rather than below it.
  menu_above: bool = false,
  lift: f32 = 0.0,
}

impl CommandLine {
  /// How many rows the command line takes laid out by `wrap`.
  pub let rows = pure (self, wrap: Wrap) -> i64 => row_count(self.edit.text, wrap)

  /// How many rows the completion menu takes below them (0 when it is closed).
  pub let menu_rows = pure (self) -> i64 =>
    if self.menu.len() == 0 { 0 } else { self.menu.len().min(MENU_ROWS) }

  /// The shell's completions arrived. Those for a line since edited are dropped; one is put
  /// in; of several, the start they share is put in and the menu opens.
  pub let completed = (self: mut, offered: []Completion) -> void => {
    let Some((text, cursor)) = self.pending else { return }
    self.pending = None
    if text != self.edit.content() || cursor != self.edit.cursor { return }
    // The same completion can come from two completion functions (zsh's `echo` is a
    // builtin and a command): offered once.
    var unique: []Completion = []
    for c in offered {
      var seen = false
      for u in unique { if u.prefix == c.prefix && u.insert == c.insert && u.suffix == c.suffix { seen = true } }
      if !seen { unique.push(c) }
    }
    if unique.len() == 0 { return }
    if unique.len() == 1 { return self.apply(unique[0]) }
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    let word = text_of(self.edit.text.slice(start, end))
    let shared = common_start([c in unique | "${c.prefix}${c.insert}"])
    if shared.len() > word.len() && shared.starts_with(word) { self.edit.replace(
      start,
      end,
      shared
    ) }
    let (word_start, _) = shell_word_at(self.edit.text, self.edit.cursor)
    self.offered = unique
    self.menu_word = word_start
    self.chosen = 0
    self.menu_top = 0
    self.narrow()
  }

  // The menu as the word now stands: the offered completions it is the start of, the one
  // chosen kept chosen while it is among them. Closed when the caret has left the end of
  // the word the completions were for, when none is left, or when the one left is the word
  // already, complete.
  let narrow = (self: mut) -> void => {
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    if start != self.menu_word || self.edit.cursor != end || self.edit.has_selection() {
      return self.close_menu()
    }
    let typed = text_of(self.edit.text.slice(start, self.edit.cursor))
    var kept: []Completion = []
    for c in self.offered { if key_of(c).starts_with(typed) { kept.push(c) } }
    if kept.len() == 0 || (kept.len() == 1 && key_of(kept[0]) == typed) { return self.close_menu() }
    let was = if self.chosen < self.menu.len() { key_of(self.menu[self.chosen]) } else { "" }
    self.chosen = 0
    for k in 0..<kept.len() { if key_of(kept[k]) == was { self.chosen = k } }
    self.menu = kept
    // Scrolled no further than a shorter list allows, with the choice in view.
    let last_top = (kept.len() - MENU_ROWS).max(0)
    self.menu_top = self.menu_top
      .min(last_top)
      .min(self.chosen)
      .max(self.chosen - MENU_ROWS + 1)
      .max(0)
  }

  // Put completion `c` in place of the word at the caret, and close the menu.
  let apply = (self: mut, c: Completion) -> void => {
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    self.edit.replace(start, end, "${c.prefix}${c.insert}${c.suffix}")
    self.close_menu()
  }

  let close_menu = (self: mut) -> void => {
    self.offered = []
    self.menu = []
    self.chosen = 0
    self.menu_top = 0
  }

  // Move the menu's choice by `by`, round its ends, scrolling to keep it shown.
  let choose = (self: mut, by: i64) -> void => {
    let n = self.menu.len()
    self.chosen = (self.chosen + by) %% n
    if self.chosen < self.menu_top { self.menu_top = self.chosen }
    if self.chosen >= self.menu_top + MENU_ROWS { self.menu_top = self.chosen - MENU_ROWS + 1 }
  }

  // Where the menu is: its top left on the screen (below the command line's last row, or
  // above it by `lift`), its column (the word's, moved left to fit), and its width in cells.
  let menu_layout = pure (self, at: Place) -> (Vec2, i64, i64) => {
    let wrap = at.wrap
    var shown_w = 0
    var desc_w = 0
    for c in self.menu {
      shown_w = shown_w.max(c.shown.len().min(MENU_SHOWN))
      desc_w = desc_w.max(c.description.len().min(MENU_DESCRIPTION))
    }
    let gap = if desc_w > 0 { desc_w + 2 } else { 0 }
    let width = (shown_w + 2 + gap).min(wrap.cols)
    let (start, _) = shell_word_at(self.edit.text, self.edit.cursor)
    let (_, col) = position(self.edit.text, wrap, start)
    let left = col.min(wrap.cols - width).max(0)
    let under = cell_pos(at, row_count(self.edit.text, wrap), left)
    let top = if at.menu_above {
      Vec2 { x: under.x, y: at.origin.y - at.lift - f32(self.menu_rows()) * at.cell.y }
    } else { under }
    (top, left, width)
  }

  /// Undo, cut, paste and the rest: the same whether chosen from the Edit menu or pressed.
  /// An edit narrows (or closes) an open completion menu, as typing does.
  pub let edit_action = (self: mut, a: EditAction) -> void => {
    let before = self.edit.content()
    match a {
      Undo => {
        let _ = self.edit.undo()
      },
      Redo => {
        let _ = self.edit.redo()
      },
      Cut => if self.edit.has_selection() { set_clipboard_text(self.edit.cut()) },
      Copy =>
        if self.edit.has_selection() { set_clipboard_text(self.edit.selected_text()) },
      Paste => self.edit.paste(get_clipboard_text()),
      SelectAll => self.edit.select_all(),
    }
    if self.menu.len() > 0 {
      if self.edit.content() != before { self.narrow() } else { self.close_menu() }
    }
  }

  /// Whether `a` would do anything now: what the Edit menu greys out when not.
  pub let can = pure (self, a: EditAction) -> bool => match a {
    Undo => self.edit.undo_stack.len() > 0,
    Redo => self.edit.redo_stack.len() > 0,
    Cut => self.edit.has_selection(),
    Copy => self.edit.has_selection(),
    Paste => true,
    SelectAll => !self.edit.is_empty(),
  }

  /// Keys typed ahead, as the shell found them waiting at a new line: kept until a prompt
  /// takes them ([take_typed_ahead]).
  pub let typed_ahead = (self: mut, keys: string) -> void => {
    self.ahead = "${self.ahead}${typed_lines(keys)}"
  }

  /// At a prompt, what typing ahead left for it: the first command ended by a Return, to be
  /// run — what a terminal would have done — or, with none, the text typed after the last
  /// Return, put into the editor at the caret.
  pub let take_typed_ahead = (self: mut) -> Maybe<string> => {
    if self.ahead == "" { return None }
    match self.ahead.index("\n") {
      Some(k) => {
        let command = self.ahead.slice(0, k)
        self.ahead = self.ahead.slice(k + 1, self.ahead.len())
        Some(command)
      },
      None => {
        self.edit.paste(self.ahead)
        self.ahead = ""
        None
      },
    }
  }

  /// Run a command: remember it, and start an empty line.
  pub let submitted = (self: mut, command: string) -> void => {
    self.close_menu()
    self.pending = None
    if command.trim() != "" && (self.history.len() == 0 || self.history[self.history.len() - 1] != command) {
      self.history.push(command)
    }
    self.edit = editor()
    self.browsing = self.history.len()
    self.draft = ""
    self.dragging = false
    self.word_drag = None
  }

  /// This frame's mouse and keys (when `focused`), then the command line drawn into `list`.
  pub let update = (
    self: mut,
    at: Place,
    list: DrawList,
    style: Style,
    focused: bool
  ) -> Outcome => {
    self.mouse(at)
    var outcome = Nothing
    if focused {
      outcome = self.keys(at.wrap)
      let (row, col) = position(self.edit.text, at.wrap, self.edit.cursor)
      request_text_input(cell_pos(at, row, col), at.cell.y)
    }
    self.draw(at, list, style, focused)
    outcome
  }

  // ── Mouse ────────────────────────────────────────────────────────────────

  let mouse = (self: mut, at: Place) -> void => {
    let m = get_mouse_pos()
    // ImGui's pointer is at -FLT_MAX when it is nowhere (outside the window, or no mouse
    // yet), which no cell arithmetic survives — floor traps on it.
    if m.x < -1.0e30 || m.y < -1.0e30 {
      if !is_mouse_down(0) { self.dragging = false }
      return
    }
    let row = ((m.y - at.origin.y) / at.cell.y).floor()
    let fx = (m.x - at.origin.x) / at.cell.x
    if self.menu.len() > 0 {
      let (menu_top, menu_col, width) = self.menu_layout(at)
      let k = ((m.y - menu_top.y) / at.cell.y).floor()
      let inside = k >= 0 &&
        k < self.menu_rows() &&
        fx >= f32(menu_col) &&
        fx < f32(menu_col + width)
      if inside {
        if is_mouse_clicked(0) { return self.apply(self.menu[self.menu_top + k]) }
        return
      }
      if is_mouse_clicked(0) { self.close_menu() }
    }
    let over = is_window_hovered() && row >= 0
    if over { set_mouse_cursor(MOUSE_CURSOR_TEXT_INPUT) }
    // A caret goes to the nearer edge of a cell; a word is the rune in the cell.
    let caret = index_at(self.edit.text, at.wrap, row, (fx + 0.5).floor())
    let under = rune_at(self.edit.text, at.wrap, row, fx.floor())
    if over && is_mouse_clicked(0) {
      let clicks = get_mouse_clicked_count(0)
      if clicks == 2 {
        self.edit.select_word(under)
        self.word_drag = Some(self.edit.selection())
        self.dragging = true
      } else if clicks >= 3 {
        self.edit.select_line(caret)
        self.word_drag = None
        self.dragging = false
      } else {
        self.edit.click(caret, held().shift)
        self.word_drag = None
        self.dragging = true
      }
    } else if self.dragging && is_mouse_down(0) {
      match self.word_drag {
        Some((a, b)) => self.edit.select_words(a, b, under),
        None => self.edit.click(caret, true),
      }
    } else if !is_mouse_down(0) {
      self.dragging = false
    }
  }

  // ── Keys ─────────────────────────────────────────────────────────────────

  let keys = (self: mut, wrap: Wrap) -> Outcome => {
    // The keys as pressed, ImGui's macOS swap of Ctrl and ⌘ undone (`modifiers.lyra`).
    let mods = held()
    let mac = platform() == "macOS"
    let shift = mods.shift
    let ctrl = mods.control
    // The editor's shortcuts (copy, paste, undo): ⌘ on a Mac, Ctrl+Shift elsewhere.
    let command = if mac { mods.command } else { ctrl && shift }
    // A word at a time: ⌥ on a Mac, Ctrl elsewhere.
    let by_word = if mac { mods.alt } else { ctrl }
    if self.menu.len() > 0 {
      if is_key_pressed(KEY_DOWN_ARROW) || (is_key_pressed(KEY_TAB) && !shift) { self.choose(1); return Nothing }
      if is_key_pressed(KEY_UP_ARROW) || (is_key_pressed(KEY_TAB) && shift) { self.choose(-1); return Nothing }
      if is_key_pressed(KEY_ENTER) || is_key_pressed(KEY_KEYPAD_ENTER) {
        self.apply(self.menu[self.chosen])
        return Nothing
      }
      if is_key_pressed(KEY_ESCAPE) {
        self.close_menu()
        return Nothing
      }
      // Anything else is itself: an edit narrows the menu (or widens it), and a move alone
      // — the caret leaving the word — closes it.
      let text_before = self.edit.content()
      let cursor_before = self.edit.cursor
      let outcome = self.edit_keys(wrap, mac, shift, ctrl, command, by_word)
      if self.edit.content() != text_before { self.narrow() }
      else if self.edit.cursor != cursor_before { self.close_menu() }
      return outcome
    }
    if is_key_pressed(KEY_TAB) && !ctrl && !command {
      self.pending = Some((self.edit.content(), self.edit.cursor))
      return Complete(self.edit.content(), self.edit.cursor)
    }
    self.edit_keys(wrap, mac, shift, ctrl, command, by_word)
  }

  let edit_keys = (
    self: mut,
    wrap: Wrap,
    mac: bool,
    shift: bool,
    ctrl: bool,
    command: bool,
    by_word: bool
  ) -> Outcome => {
    let mods = held()
    if !ctrl && !(mac && command) {
      let typed = typed_text()
      if typed != "" { self.type_text(typed) }
    }
    if is_key_pressed(KEY_ENTER) || is_key_pressed(KEY_KEYPAD_ENTER) {
      if shift || mods.alt { self.edit.newline() }
      else { return Submit(self.edit.content()) }
    }
    if command {
      // The Edit menu's own when there is one; read here they would act twice.
      if !self.menu_keys {
        if is_key_pressed(KEY_A) { self.edit_action(SelectAll) }
        if is_key_pressed(KEY_C) { self.edit_action(Copy) }
        if is_key_pressed(KEY_X) { self.edit_action(Cut) }
        if is_key_pressed(KEY_V) { self.edit_action(Paste) }
        if is_key_pressed(KEY_Z) { self.edit_action(if shift { Redo } else { Undo }) }
      }
    } else if ctrl {
      // The shell's line-editing keys, as zsh's emacs mode has them.
      if is_key_pressed(KEY_A) { self.edit.line_start(shift) }
      if is_key_pressed(KEY_E) { self.edit.line_end(shift) }
      if is_key_pressed(KEY_K) { self.edit.delete_to_line_end() }
      if is_key_pressed(KEY_U) { self.edit.delete_to_line_start() }
      if is_key_pressed(KEY_W) { self.edit.delete_word_back() }
      if is_key_pressed(KEY_C) { self.edit.clear() }
      if is_key_pressed(KEY_L) { return Send("\x0c") }
      if is_key_pressed(KEY_D) {
        if self.edit.is_empty() { return Send("\x04") }
        self.edit.delete_forward()
      }
      if !mac && is_key_pressed(KEY_Z) { let _ = self.edit.undo() }
    }
    let line_mod = mac && mods.command
    if is_key_pressed(KEY_LEFT_ARROW) {
      if line_mod { self.edit.line_start(shift) }
      else if by_word { self.edit.word_left(shift) }
      else { self.edit.left(shift) }
    }
    if is_key_pressed(KEY_RIGHT_ARROW) {
      if line_mod { self.edit.line_end(shift) }
      else if by_word { self.edit.word_right(shift) }
      else { self.edit.right(shift) }
    }
    if is_key_pressed(KEY_UP_ARROW) {
      if line_mod { self.edit.text_start(shift) }
      else if !self.edit.vertical(wrap, -1, shift) && !shift { self.older() }
    }
    if is_key_pressed(KEY_DOWN_ARROW) {
      if line_mod { self.edit.text_end(shift) }
      else if !self.edit.vertical(wrap, 1, shift) && !shift { self.newer() }
    }
    if is_key_pressed(KEY_HOME) { self.edit.line_start(shift) }
    if is_key_pressed(KEY_END) { self.edit.line_end(shift) }
    if is_key_pressed(KEY_BACKSPACE) {
      if line_mod { self.edit.delete_to_line_start() }
      else if by_word { self.edit.delete_word_back() }
      else { self.edit.backspace() }
    }
    if is_key_pressed(KEY_DELETE) {
      if by_word { self.edit.delete_word_forward() } else { self.edit.delete_forward() }
    }
    if is_key_pressed(KEY_ESCAPE) { self.edit.click(self.edit.cursor, false) }
    Nothing
  }

  let type_text = (self: mut, s: string) -> void => self.edit.type_text(s)

  // ↑ from the first row: the entry before the one shown, the user's own text kept.
  let older = (self: mut) -> void => {
    if self.browsing == 0 { return }
    if self.browsing == self.history.len() { self.draft = self.edit.content() }
    self.browsing -= 1
    self.edit.set_content(self.history[self.browsing])
  }

  // ↓ from the last row: the entry after, then the user's own text again.
  let newer = (self: mut) -> void => {
    if self.browsing >= self.history.len() { return }
    self.browsing += 1
    self.edit.set_content(
      if self.browsing == self.history.len() { self.draft } else { self.history[self.browsing] }
    )
  }

  // ── Drawing ──────────────────────────────────────────────────────────────

  let draw = (self, at: Place, list: DrawList, style: Style, focused: bool) -> void => {
    let text = self.edit.text
    let (a, b) = self.edit.selection()
    var row = 0
    var col = at.wrap.first
    var run: []u8 = []
    var run_col = col
    for k in 0..<=text.len() {
      let ends_row = k == text.len() || text[k] == '\n'
      if k >= a && k < b {
        // A selected line break shows as a sliver, so the selection visibly spans it.
        let w = if ends_row { at.cell.x * 0.5 } else { at.cell.x }
        let p = cell_pos(at, row, col)
        list.add_rect_filled(p, Vec2 { x: p.x + w, y: p.y + at.cell.y }, style.selection)
      }
      if ends_row || col + 1 >= at.wrap.cols {
        if !ends_row { push_rune(run, i64(text[k])) }
        flush(list, at, row, run_col, run, style.text)
        run = []
        row += 1
        col = 0
        run_col = 0
      } else {
        push_rune(run, i64(text[k]))
        col += 1
      }
    }
    if focused {
      let (r, c) = position(text, at.wrap, self.edit.cursor)
      let p = cell_pos(at, r, c)
      list.add_rect_filled(p, Vec2 { x: p.x + 2.0, y: p.y + at.cell.y }, style.caret)
    }
    if self.menu.len() > 0 { self.draw_menu(at, list, style) }
  }

  // The completion menu: a row each, the chosen one marked, descriptions fainter.
  let draw_menu = (self, at: Place, list: DrawList, style: Style) -> void => {
    let (top, _, width) = self.menu_layout(at)
    let shown_rows = self.menu_rows()
    let pad = at.cell.x * 0.5
    list.add_rect_filled(
      Vec2 { x: top.x - pad, y: top.y },
      Vec2 { x: top.x + f32(width) * at.cell.x + pad, y: top.y + f32(shown_rows) * at.cell.y },
      style.menu,
      4.0
    )
    var shown_w = 0
    for c in self.menu { shown_w = shown_w.max(c.shown.len().min(MENU_SHOWN)) }
    for k in 0..<shown_rows {
      let c = self.menu[self.menu_top + k]
      let y = top.y + f32(k) * at.cell.y
      if self.menu_top + k == self.chosen {
        list.add_rect_filled(
          Vec2 { x: top.x - pad, y: y },
          Vec2 { x: top.x + f32(width) * at.cell.x + pad, y: y + at.cell.y },
          style.menu_chosen,
          4.0
        )
      }
      let shown = if c.shown.len() > MENU_SHOWN { c.shown.slice(
        0,
        MENU_SHOWN
      ) } else { c.shown }
      list.add_text(Vec2 { x: top.x + at.cell.x, y: y + at.text_dy }, style.text, shown)
      if c.description != "" {
        let room = width - shown_w - 4
        if room > 0 {
          let d = if c.description.len() > room { c.description.slice(
            0,
            room
          ) } else { c.description }
          list.add_text(
            Vec2 { x: top.x + f32(shown_w + 3) * at.cell.x, y: y + at.text_dy },
            style.faint,
            d
          )
        }
      }
    }
  }
}

let cell_pos = pure (at: Place, row: i64, col: i64) -> Vec2 => Vec2 {
  x: at.origin.x + f32(col) * at.cell.x,
  y: at.origin.y + f32(row) * at.cell.y,
}

let flush = (
  list: DrawList,
  at: Place,
  row: i64,
  col: i64,
  run: []u8,
  color: u32
) -> void => {
  if run.len() == 0 { return }
  let p = cell_pos(at, row, col)
  list.add_text(Vec2 { x: p.x, y: p.y + at.text_dy }, color, run.decode_utf8())
}

/// The UTF-8 encoding of code point `c`, pushed onto `bytes`.
pub let push_rune = (bytes: mut []u8, c: i64) -> void => {
  if c < 0x80 { bytes.push(u8(c)) }
  else if c < 0x800 {
    bytes.push(u8(0xC0 | (c >> 6)))
    bytes.push(u8(0x80 | (c & 0x3F)))
  } else if c < 0x10000 {
    bytes.push(u8(0xE0 | (c >> 12)))
    bytes.push(u8(0x80 | ((c >> 6) & 0x3F)))
    bytes.push(u8(0x80 | (c & 0x3F)))
  } else {
    bytes.push(u8(0xF0 | (c >> 18)))
    bytes.push(u8(0x80 | ((c >> 12) & 0x3F)))
    bytes.push(u8(0x80 | ((c >> 6) & 0x3F)))
    bytes.push(u8(0x80 | (c & 0x3F)))
  }
}

/// What a completion makes of its word, before its suffix: what typing is compared with.
let key_of = pure (c: Completion) -> string => "${c.prefix}${c.insert}"

/// The longest start every one of `words` shares.
let common_start = pure (words: []string) -> string => {
  if words.len() == 0 { return "" }
  var shared = words[0].to_runes()
  for w in words {
    let r = w.to_runes()
    var n = 0
    while n < shared.len() && n < r.len() && shared[n] == r[n] { n += 1 }
    shared = shared.slice(0, n)
  }
  text_of(shared)
}
