module ui
//! The tabs' bar and shortcuts: the bar drawn and what was done to it, and which shortcut,
//! if any, was pressed this frame. The tabs themselves are `../sulafat.lyra`'s.
//!
//! **Tabs are dragged into a new order by ImGui**, which keeps its own display order and
//! does not tell it. [tab_bar] reads it back — each tab's place on the bar, after it is
//! drawn — and answers it as [TabBar.order], for the caller to put its tabs in, so that the
//! order shown, ⌘1–9's and ⌘⇧[ ⌘⇧]'s stay one.
//!
//! **On a Mac with Sulafat's menu bar, ⌘T, ⌘W, ⌘⇧[ and ⌘⇧] are its menu items'**, and
//! come as menu choices: AppKit hands a key equivalent to the menu as well as to SDL, so
//! reading them here too would open two tabs, or close two. ⌘1–⌘9 have no items and stay
//! keys.

import bindings.sdl3.{ platform }
import bindings.menubar.{
  menu,
  app_menu,
  item,
  separator,
  window_menu,
  install,
  COMMAND,
  SHIFT
}
import bindings.imgui.{
  begin_tab_bar,
  end_tab_bar,
  begin_tab_item_closable,
  end_tab_item,
  tab_item_button,
  get_item_rect_min,
  get_item_rect_max,
  Vec2,
  TAB_BAR_FLAGS_FITTING_POLICY_SHRINK,
  TAB_BAR_FLAGS_REORDERABLE,
  TAB_ITEM_FLAGS_SET_SELECTED,
  TAB_ITEM_FLAGS_TRAILING,
  TAB_ITEM_FLAGS_NO_TOOLTIP,
  is_key_pressed,
  KEY_T,
  KEY_COMMA,
  KEY_W,
  KEY_1,
  KEY_LEFT_BRACKET,
  KEY_RIGHT_BRACKET,
  KEY_PAGE_UP,
  KEY_PAGE_DOWN,
}

/// A tab on the bar: what it is called, and its identity, which no other tab of the window
/// has and a changing name must not move.
pub struct TabLabel {
  name: string,
  id: i64,
}

/// What the tab bar answers for a frame, every index into the tabs as they were given.
pub struct TabBar {
  /// The tab shown: a click may have chosen another.
  shown: i64,
  /// A tab whose close button was pressed.
  closing: Maybe<i64>,
  /// Whether `+` was pressed.
  add: bool,
  /// The tabs in the order the bar now shows them — the order given, unless one was dragged.
  order: []i64,
  /// Each tab's middle on the screen.
  centres: []Vec2,
}

/// Draw the tab bar for `tabs`, `active` shown and `select` (a tab chosen by a key, or just
/// opened) made the shown one; its tabs dragged into another order as the user likes.
pub let tab_bar = (tabs: []TabLabel, active: i64, select: Maybe<i64>) -> TabBar => {
  var shown = active
  var closing: Maybe<i64> = None
  var add = false
  var lefts: []f32 = []
  var centres: []Vec2 = []
  if begin_tab_bar(
    "tabs",
    TAB_BAR_FLAGS_FITTING_POLICY_SHRINK | TAB_BAR_FLAGS_REORDERABLE
  ) {
    for k in 0..<tabs.len() {
      var open = true
      let chosen = match select {
        Some(n) => if n == k { TAB_ITEM_FLAGS_SET_SELECTED } else { 0 },
        None => 0,
      }
      // The label after `###` is the tab's identity.
      if begin_tab_item_closable("${tabs[k].name}###tab${tabs[k].id}", open, chosen) {
        shown = k
        end_tab_item()
      }
      // Where the bar put this tab: what its order is read from.
      let lo = get_item_rect_min()
      let hi = get_item_rect_max()
      lefts.push(lo.x)
      centres.push(Vec2 { x: (lo.x + hi.x) / 2.0, y: (lo.y + hi.y) / 2.0 })
      if !open { closing = Some(k) }
    }
    if tab_item_button(
      "+",
      TAB_ITEM_FLAGS_TRAILING | TAB_ITEM_FLAGS_NO_TOOLTIP
    ) { add = true }
    end_tab_bar()
  }
  // A tab chosen by a key this frame is shown now, whatever the bar has yet caught up with.
  match select {
    Some(n) => { shown = n },
    None => {},
  }
  TabBar {
    shown: shown.clamp(0, (tabs.len() - 1).max(0)),
    closing: closing,
    add: add,
    order: order_by(lefts),
    centres: centres,
  }
}

/// The indices of `lefts` from the leftmost to the rightmost — an insertion sort, stable,
/// for a bar's handful of tabs.
pub let order_by = pure (lefts: []f32) -> []i64 => {
  var order: []i64 = [k in 0..<lefts.len() | k]
  for i in 1..<order.len() {
    var j = i
    while j > 0 && lefts[order[j - 1]] > lefts[order[j]] {
      let t = order[j]
      order[j] = order[j - 1]
      order[j - 1] = t
      j -= 1
    }
  }
  order
}

/// A tab shortcut pressed this frame.
pub data TabCommand =
  NoCommand
  | NewTab
  | CloseTab
  /// Show the tab at this index.
  | ShowTab i64
  /// Open the settings window (⌘, from the menu bar; Ctrl+, without one).
  | OpenSettings

/// The tab shortcut pressed this frame, if any, with `active` shown of `count`: ⌘T, ⌘W,
/// ⌘1–⌘9, ⌘⇧[ and ⌘⇧] on a Mac; Ctrl+Shift+T and W, Alt+1–9 and Ctrl+PageUp/PageDown
/// elsewhere, where Ctrl alone is the shell's.
pub let tab_command = (active: i64, count: i64, menus: bool) -> TabCommand => {
  let mods = held()
  let mac = platform() == "macOS"
  let chord = if mac { mods.command && !mods.control } else { mods.control && mods.shift }
  // The menu bar's own, when there is one (a Mac's).
  let by_menu = mac && menus
  if chord && !by_menu && is_key_pressed(KEY_T) { return NewTab }
  if chord && !by_menu && is_key_pressed(KEY_W) { return CloseTab }
  // Settings: the menu's ⌘, on a Mac, Ctrl+, elsewhere (no shell binds it).
  if !mac && mods.control && !mods.shift && is_key_pressed(KEY_COMMA) { return OpenSettings }
  let numbered = if mac { mods.command && !mods.shift } else { mods.alt && !mods.control }
  if numbered {
    for n in 0..<9 {
      // 1–8 that tab; 9 the last, as browsers have it.
      if is_key_pressed(KEY_1 + i32(n)) {
        return ShowTab(if n == 8 { count - 1 } else { n.min(count - 1) })
      }
    }
  }
  let before = if mac { chord &&
      mods.shift &&
      is_key_pressed(KEY_LEFT_BRACKET) } else { mods.control &&
      !mods.shift &&
      is_key_pressed(KEY_PAGE_UP) }
  let after = if mac { chord &&
      mods.shift &&
      is_key_pressed(KEY_RIGHT_BRACKET) } else { mods.control &&
      !mods.shift &&
      is_key_pressed(KEY_PAGE_DOWN) }
  if before && !by_menu { return ShowTab((active - 1) %% count) }
  if after && !by_menu { return ShowTab((active + 1) %% count) }
  NoCommand
}

/// The menu bar's items for the tabs, by tag ([menu_command] reads them).
pub const MENU_NEW_TAB: i32 = 1
pub const MENU_CLOSE_TAB: i32 = 2
pub const MENU_PREVIOUS_TAB: i32 = 3
pub const MENU_NEXT_TAB: i32 = 4
pub const MENU_SETTINGS: i32 = 5

/// The tab command a menu item stands for, with `active` shown of `count`.
pub let menu_command = pure (tag: i32, active: i64, count: i64) -> TabCommand =>
  if tag == MENU_NEW_TAB { NewTab }
  else if tag == MENU_CLOSE_TAB { CloseTab }
  else if tag == MENU_PREVIOUS_TAB { ShowTab((active - 1) %% count) }
  else if tag == MENU_NEXT_TAB { ShowTab((active + 1) %% count) }
  else if tag == MENU_SETTINGS { OpenSettings }
  else { NoCommand }

/// The menu bar, on a Mac: Shell's tab items — New Tab ⌘T, Close Tab ⌘W, Show Previous and
/// Next Tab ⌘⇧[ and ⌘⇧] — Edit's (Undo, Redo, Cut, Copy, Paste, Select All, read by
/// [edit_action_of]), and the standard Window menu. Whether there is one (`false`
/// elsewhere, where the tab keys are read as keys).
pub let install_menus = () -> bool => {
  app_menu()
  item("Settings…", ",", COMMAND, MENU_SETTINGS)
  menu("Shell")
  item("New Tab", "t", COMMAND, MENU_NEW_TAB)
  separator()
  // ⌘⇧[ and ⌘⇧] as AppKit spells them: the shifted characters, as Terminal has it.
  item("Show Previous Tab", "{", COMMAND, MENU_PREVIOUS_TAB)
  item("Show Next Tab", "}", COMMAND, MENU_NEXT_TAB)
  separator()
  item("Close Tab", "w", COMMAND, MENU_CLOSE_TAB)
  menu("Edit")
  item("Undo", "z", COMMAND, MENU_UNDO)
  item("Redo", "z", COMMAND | SHIFT, MENU_REDO)
  separator()
  item("Cut", "x", COMMAND, MENU_CUT)
  item("Copy", "c", COMMAND, MENU_COPY)
  item("Paste", "v", COMMAND, MENU_PASTE)
  item("Select All", "a", COMMAND, MENU_SELECT_ALL)
  window_menu()
  install("Sulafat")
}

/// The Edit menu's items, by tag.
pub const MENU_UNDO: i32 = 10
pub const MENU_REDO: i32 = 11
pub const MENU_CUT: i32 = 12
pub const MENU_COPY: i32 = 13
pub const MENU_PASTE: i32 = 14
pub const MENU_SELECT_ALL: i32 = 15

/// The Edit menu's items and what each does, in the menu's order — for greying out those
/// that would do nothing.
pub const EDIT_ITEMS: [](i32, EditAction) = [
  (MENU_UNDO, Undo),
  (MENU_REDO, Redo),
  (MENU_CUT, Cut),
  (MENU_COPY, Copy),
  (MENU_PASTE, Paste),
  (MENU_SELECT_ALL, SelectAll),
]

/// What an Edit menu item does, by its tag; `None` for another menu's.
pub let edit_action_of = pure (tag: i32) -> Maybe<EditAction> => {
  for (t, a) in EDIT_ITEMS { if t == tag { return Some(a) } }
  None
}
