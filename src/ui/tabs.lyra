module ui
//! The tabs' bar and shortcuts: the bar drawn and what was done to it, and which shortcut,
//! if any, was pressed this frame. The tabs themselves are `../termina.lyra`'s.
//!
//! **Tabs are dragged into a new order by ImGui**, which keeps its own display order and
//! does not tell it. [tab_bar] reads it back — each tab's place on the bar, after it is
//! drawn — and answers it as [TabBar.order], for the caller to put its tabs in, so that the
//! order shown, ⌘1–9's and ⌘⇧[ ⌘⇧]'s stay one.
//!
//! **On a Mac with Termina's menu bar, ⌘T, ⌘W, ⌘⇧[ and ⌘⇧] are its menu items'**, and
//! come as menu choices: AppKit hands a key equivalent to the menu as well as to SDL, so
//! reading them here too would open two tabs, or close two. ⌘1–⌘9 have no items and stay
//! keys.

import bindings.sdl3.{ platform }
import bindings.imgui.{
  begin_tab_bar,
  end_tab_bar,
  begin_tab_item_closable,
  end_tab_item,
  tab_item_button,
  get_item_rect_min,
  get_item_rect_max,
  push_style_var_vec2,
  pop_style_var,
  push_style_color,
  pop_style_color,
  COL_TEXT,
  COL_TAB,
  COL_TAB_HOVERED,
  COL_TAB_SELECTED,
  COL_TAB_SELECTED_OVERLINE,
  COL_TAB_DIMMED,
  COL_TAB_DIMMED_SELECTED,
  COL_TAB_DIMMED_SELECTED_OVERLINE,
  Vec2,
  STYLE_VAR_FRAME_PADDING,
  STYLE_VAR_ITEM_INNER_SPACING,
  STYLE_VAR_ITEM_SPACING,
  TAB_BAR_FLAGS_FITTING_POLICY_SHRINK,
  TAB_BAR_FLAGS_REORDERABLE,
  TAB_ITEM_FLAGS_SET_SELECTED,
  TAB_ITEM_FLAGS_TRAILING,
  TAB_ITEM_FLAGS_NO_TOOLTIP,
  is_key_pressed,
  KEY_T,
  KEY_COMMA,
  KEY_W,
  KEY_1,
  KEY_LEFT_BRACKET,
  KEY_RIGHT_BRACKET,
  KEY_PAGE_UP,
  KEY_PAGE_DOWN,
  KEY_EQUAL,
  KEY_MINUS,
  KEY_0,
  KEY_KEYPAD_ADD,
  KEY_KEYPAD_SUBTRACT,
}

/// A tab on the bar: what it is called, and its identity, which no other tab of the window
/// has and a changing name must not move.
pub struct TabLabel {
  name: string,
  id: i64,
}

/// What the tab bar answers for a frame, every index into the tabs as they were given.
pub struct TabBar {
  /// The tab shown: a click may have chosen another.
  shown: i64,
  /// A tab whose close button was pressed.
  closing: Maybe<i64>,
  /// Whether `+` was pressed.
  add: bool,
  /// The tabs in the order the bar now shows them — the order given, unless one was dragged.
  order: []i64,
  /// Each tab's middle on the screen.
  centres: []Vec2,
  /// Whether the Settings tab is the one shown, and whether its close button was pressed.
  settings_shown: bool,
  settings_closed: bool,
}

/// Draw the tab bar for `tabs`, `active` shown and `select` (a tab chosen by a key, or just
/// opened) made the shown one, in `theme`'s tab colours; its tabs dragged into another
/// order as the user likes. With `settings`, a Settings tab at the bar's right end — made
/// the shown one by `select_settings`.
pub let tab_bar = (
  tabs: []TabLabel,
  active: i64,
  select: Maybe<i64>,
  theme: Theme,
  settings: bool,
  select_settings: bool
) -> TabBar => {
  var shown = active
  var closing: Maybe<i64> = None
  var add = false
  var lefts: []f32 = []
  var centres: []Vec2 = []
  var settings_shown = false
  var settings_closed = false
  // Roomier than ImGui's own: the inside of a tab, the gap between tabs and between a
  // tab's name and its close button, and the space under the bar.
  // The theme's tabs, the same while the window is not focused, labelled in its text's
  // colour, the shown one's overline its selection's.
  push_style_color(COL_TAB, theme.tab)
  push_style_color(COL_TAB_DIMMED, theme.tab)
  push_style_color(COL_TAB_HOVERED, theme.tab_hovered)
  push_style_color(COL_TAB_SELECTED, theme.tab_selected)
  push_style_color(COL_TAB_DIMMED_SELECTED, theme.tab_selected)
  push_style_color(COL_TAB_SELECTED_OVERLINE, theme.cursor)
  push_style_color(COL_TAB_DIMMED_SELECTED_OVERLINE, theme.tab_selected)
  push_style_color(COL_TEXT, theme.fg)
  push_style_var_vec2(STYLE_VAR_FRAME_PADDING, TAB_PADDING)
  push_style_var_vec2(STYLE_VAR_ITEM_INNER_SPACING, TAB_SPACING)
  push_style_var_vec2(STYLE_VAR_ITEM_SPACING, TAB_SPACING)
  if begin_tab_bar(
    "tabs",
    TAB_BAR_FLAGS_FITTING_POLICY_SHRINK | TAB_BAR_FLAGS_REORDERABLE
  ) {
    for k in 0..<tabs.len() {
      var open = true
      let chosen = match select {
        Some(n) => if n == k { TAB_ITEM_FLAGS_SET_SELECTED } else { 0 },
        None => 0,
      }
      // The label after `###` is the tab's identity.
      if begin_tab_item_closable("${tabs[k].name}###tab${tabs[k].id}", open, chosen) {
        shown = k
        end_tab_item()
      }
      // Where the bar put this tab: what its order is read from.
      let lo = get_item_rect_min()
      let hi = get_item_rect_max()
      lefts.push(lo.x)
      centres.push(Vec2 { x: (lo.x + hi.x) / 2.0, y: (lo.y + hi.y) / 2.0 })
      if !open { closing = Some(k) }
    }
    // The Settings tab, at the right end with `+`, out of the tabs' order.
    if settings {
      var open = true
      let chosen = if select_settings { TAB_ITEM_FLAGS_SET_SELECTED } else { 0 }
      if begin_tab_item_closable(
        "Settings###settings",
        open,
        TAB_ITEM_FLAGS_TRAILING | chosen
      ) {
        settings_shown = true
        end_tab_item()
      }
      if !open { settings_closed = true }
    }
    if tab_item_button(
      "+",
      TAB_ITEM_FLAGS_TRAILING | TAB_ITEM_FLAGS_NO_TOOLTIP
    ) { add = true }
    end_tab_bar()
  }
  pop_style_var(3)
  pop_style_color(8)
  // A tab chosen by a key this frame is shown now, whatever the bar has yet caught up with.
  match select {
    Some(n) => { shown = n },
    None => {},
  }
  TabBar {
    shown: shown.clamp(0, (tabs.len() - 1).max(0)),
    closing: closing,
    add: add,
    order: order_by(lefts),
    centres: centres,
    settings_shown: settings_shown,
    settings_closed: settings_closed,
  }
}

/// The indices of `lefts` from the leftmost to the rightmost — an insertion sort, stable,
/// for a bar's handful of tabs.
pub let order_by = pure (lefts: []f32) -> []i64 => {
  var order: []i64 = [k in 0..<lefts.len() | k]
  for i in 1..<order.len() {
    var j = i
    while j > 0 && lefts[order[j - 1]] > lefts[order[j]] {
      let t = order[j]
      order[j] = order[j - 1]
      order[j - 1] = t
      j -= 1
    }
  }
  order
}

/// Points between a tab's edge and its name, across and up and down.
const TAB_PADDING: Vec2 = Vec2 { x: 14.0, y: 7.0 }

/// Points between tabs, between a name and its close button, and under the bar.
const TAB_SPACING: Vec2 = Vec2 { x: 6.0, y: 8.0 }

/// A window's shortcut pressed (or menu item chosen) this frame.
pub data TabCommand =
  NoCommand
  | NewTab
  | CloseTab
  /// Show the tab at this index.
  | ShowTab i64
  /// Open the settings window (⌘, from the menu bar; Ctrl+, without one).
  | OpenSettings
  /// The font a point bigger or smaller, or back to the default size (View's items).
  | FontBigger
  | FontSmaller
  | FontDefault

/// The window's shortcut pressed this frame, if any, with `active` shown of `count`: ⌘T,
/// ⌘W, ⌘1–⌘9, ⌘⇧[ and ⌘⇧], ⌘= ⌘- ⌘0 on a Mac; Ctrl+Shift+T and W, Alt+1–9,
/// Ctrl+PageUp/PageDown and Ctrl+Shift+= - 0 elsewhere, where Ctrl alone is the shell's
/// (Ctrl+- is readline's undo).
pub let tab_command = (active: i64, count: i64, menus: bool) -> TabCommand => {
  let mods = held()
  let mac = platform() == "macOS"
  let chord = if mac { mods.command && !mods.control } else { mods.control && mods.shift }
  // The menu bar's own, when there is one (a Mac's).
  let by_menu = mac && menus
  if chord && !by_menu && is_key_pressed(KEY_T) { return NewTab }
  if chord && !by_menu && is_key_pressed(KEY_W) { return CloseTab }
  // Settings: the menu's ⌘, on a Mac, Ctrl+, elsewhere (no shell binds it).
  if !mac && mods.control && !mods.shift && is_key_pressed(KEY_COMMA) { return OpenSettings }
  // The font's size: View's items on a Mac with the bar, keys otherwise.
  if chord && !by_menu {
    if is_key_pressed(KEY_EQUAL) || is_key_pressed(KEY_KEYPAD_ADD) { return FontBigger }
    if is_key_pressed(KEY_MINUS) || is_key_pressed(KEY_KEYPAD_SUBTRACT) { return FontSmaller }
    if is_key_pressed(KEY_0) { return FontDefault }
  }
  let numbered = if mac { mods.command && !mods.shift } else { mods.alt && !mods.control }
  if numbered {
    for n in 0..<9 {
      // 1–8 that tab; 9 the last, as browsers have it.
      if is_key_pressed(KEY_1 + i32(n)) {
        return ShowTab(if n == 8 { count - 1 } else { n.min(count - 1) })
      }
    }
  }
  let before = if mac { chord &&
      mods.shift &&
      is_key_pressed(KEY_LEFT_BRACKET) } else { mods.control &&
      !mods.shift &&
      is_key_pressed(KEY_PAGE_UP) }
  let after = if mac { chord &&
      mods.shift &&
      is_key_pressed(KEY_RIGHT_BRACKET) } else { mods.control &&
      !mods.shift &&
      is_key_pressed(KEY_PAGE_DOWN) }
  if before && !by_menu { return ShowTab((active - 1) %% count) }
  if after && !by_menu { return ShowTab((active + 1) %% count) }
  NoCommand
}
