module ui
//! Keys typed ahead, as the shell found them waiting at a new line (`../shell/shell.lyra`):
//! raw bytes, as a terminal sends keys, turned into what they typed. Text is text; Return
//! ends a line (the terminal has already made it `\n`); Backspace, Ctrl+U and Ctrl+W edit
//! the line being typed as a shell's line editor would; anything else — an arrow, a
//! function key, another control — is dropped, since where it would have moved the caret
//! to is not knowable now.

import vt.{ parser, Print, Execute }
import editor.{ text_of }

/// What `keys` typed: lines, each ended by a Return, joined by `\n` — the last one unended
/// when no Return followed it.
pub let typed_lines = (keys: string) -> string => {
  // DEL is what Backspace sends, and the parser drops it in text: made BS first.
  let bytes = [b in keys.encode_utf8() | if b == 0x7F { u8(0x08) } else { b }]
  var p = parser()
  var typed: [][]rune = [[]]
  for action in p.feed(bytes) {
    let n = typed.len() - 1
    match action {
      Print(text) => {
        for r in text { typed[n].push(r) }
      },
      Execute(c) => {
        if c == 10 || c == 13 { typed.push([]) }
        else if c == 8 && typed[n].len() > 0 { typed[n] = typed[n].slice(
          0,
          typed[n].len() - 1
        ) }
        else if c == 0x15 { typed[n] = [] }
        else if c == 0x17 { typed[n] = without_last_word(typed[n]) }
      },
      _ => {},
    }
  }
  [l in typed | text_of(l)].join("\n")
}

/// `line` with its last word, and the spaces after it, taken off — Ctrl+W.
let without_last_word = (line: []rune) -> []rune => {
  var n = line.len()
  while n > 0 && line[n - 1] == ' ' { n -= 1 }
  while n > 0 && line[n - 1] != ' ' { n -= 1 }
  line.slice(0, n)
}
