module session
//! One tab: a program on a pseudo-terminal (the user's shell, usually), what it has drawn,
//! where its shell is, and its command line — read every frame whether it is shown or not,
//! drawn and given the keys when it is the tab shown (`../sulafat.lyra` keeps the tabs).

import std.env.{ lookup }
import std.io.{ remove_file }
import bindings.pty.{ spawn, close, Pty }
import bindings.sdl3.{ platform }
import bindings.imgui.{
  DrawList,
  DRAW_FLAGS_ROUND_CORNERS_TOP,
  is_mouse_released,
  get_io,
  set_clipboard_text,
  is_mouse_clicked,
  is_mouse_down,
  get_mouse_clicked_count,
  get_mouse_pos,
  is_window_hovered,
  KEY_C,
  get_content_region_avail,
  get_cursor_screen_pos,
  get_window_draw_list,
  request_text_input,
  typed_text,
  is_key_pressed,
  get_clipboard_text,
  dummy,
  get_scroll_y,
  get_scroll_max_y,
  set_scroll_y,
  Vec2,
  KEY_A,
  KEY_V,
  KEY_TAB,
  KEY_LEFT_ARROW,
  KEY_RIGHT_ARROW,
  KEY_UP_ARROW,
  KEY_DOWN_ARROW,
  KEY_PAGE_UP,
  KEY_PAGE_DOWN,
  KEY_HOME,
  KEY_END,
  KEY_INSERT,
  KEY_DELETE,
  KEY_BACKSPACE,
  KEY_SPACE,
  KEY_ENTER,
  KEY_ESCAPE,
}
import vt.{
  parser,
  screen,
  Parser,
  Screen,
  InputStart,
  Spot,
  selected_on,
  selection_text,
  word_span,
}
import shell.{ integration, load_history, submission, completion_request, Integration }
import ui.{
  EditAction,
  Paste,
  held,
  Complete,
  command_line,
  CommandLine,
  Place,
  Style,
  Submit,
  Send,
  draw_line,
  report_of,
  Theme,
  Fonts,
  LineAt,
}
import editor.{ Wrap, text_of }

/// A tab's program and everything Sulafat keeps for it.
pub struct Session {
  pty: Pty,
  parse: Parser,
  shown: Screen,
  mode: Mode,
  line: CommandLine,
  integrated: Maybe<Integration>,
  /// What the tab is called without a title from its program: the program, by name.
  program: string,
  /// The command running since Return, or `""` at a prompt: the tab's name meanwhile.
  running: string,
  /// Whether output arrived this frame, and since the tab was last shown.
  got_output: bool,
  unseen: bool,
  /// Still running; `false` once its program has ended or the user closed the tab, and it
  /// is to close.
  alive: bool,
  /// A number no other tab of this window has, for the tab bar's identity.
  id: i64,
  /// A selection on the grid, from `sel_a` to `sel_b` (`vt.selection`); none while the two
  /// are the same place. While a drag goes on, `sel_unit` says what it extends by — 1
  /// cells, 2 words (after a double-click), 3 lines (after a triple-click) — and
  /// `sel_origin` is the word or line the click chose.
  sel_a: Spot,
  sel_b: Spot,
  sel_dragging: bool,
  sel_unit: i64,
  sel_origin: (Spot, Spot),
  /// The mouse as last reported to a program that asked: the cell (so motion is reported a
  /// cell at a time), wheel travel not yet a whole notch, and whether the window had the
  /// keyboard (for focus reports).
  mouse_cell: (i64, i64),
  wheel_left: f32,
  had_focus: bool,
  /// Where the prompt a command was just sent from began (its `B` mark), until the next
  /// mark of another kind: a `B` there again is that prompt redrawn — bash's readline
  /// redraws its line on a paste of several lines — not a new one.
  sent_from: Maybe<(i64, i64)>,
  /// Where the last prompt began (its `A` mark): an absolute line and a column. The box
  /// shows the prompt from there — a prompt of several lines whole.
  prompt_from: (i64, i64),
  /// The commands run, as blocks of the transcript (oldest first, at most [BLOCKS]), and the
  /// one running.
  blocks: []Block,
  running_block: Maybe<Block>,
}

/// A command's place in the transcript, as the shell's marks drew it, in absolute lines:
/// its input — the prompt and the command, from the prompt's first line to where the output
/// begins — and its output, to where it ended (`end`, -1 while it runs); its exit status
/// (-1 unknown) and when it started and ended, in nanoseconds.
pub struct Block {
  prompt: i64,
  output: i64,
  end: i64,
  status: i64,
  started: i64,
  ended: i64,
}

/// Start a tab: `program` (the login shell with Sulafat's integration when empty) in `dir`
/// (the home directory when `None`). `None` when it cannot be started.
pub let open_session = (
  program: []string,
  dir: Maybe<string>,
  id: i64
) -> Maybe<Session> => {
  let shell = lookup("SHELL") ?? "/bin/sh"
  let own = program.len() > 0
  // The request file is this tab's: named by the time it started, to the nanosecond.
  let integrated = if own { None } else { integration(shell, "${wall_clock_nanos()}") }
  let args = if own { program } else {
    match integrated {
      Some(i) => i.args,
      None => [shell, "-l"],
    }
  }
  let integration_env = match integrated {
    Some(i) => i.env,
    None => [],
  }
  let env = [
    "TERM=xterm-256color",
    "COLORTERM=truecolor",
    "TERM_PROGRAM=Sulafat",
    ...integration_env,
  ]
  let start_in = match dir {
    Some(d) => Some(d),
    None => lookup("HOME"),
  }
  let Some(pty) = spawn(args, 80, 24, start_in, env) else { return None }
  Some(Session {
    pty: pty,
    parse: parser(),
    shown: screen(80, 24),
    mode: Raw,
    line: command_line(if own { [] } else { load_history(shell) }),
    integrated: integrated,
    program: base_name(args[0]),
    running: "",
    got_output: false,
    unseen: false,
    alive: true,
    id: id,
    sel_a: Spot { line: 0, col: 0 },
    sel_b: Spot { line: 0, col: 0 },
    sel_dragging: false,
    sel_unit: 1,
    sel_origin: (Spot { line: 0, col: 0 }, Spot { line: 0, col: 0 }),
    mouse_cell: (-1, -1),
    wheel_left: 0.0,
    had_focus: false,
    sent_from: None,
    prompt_from: (-1, 0),
    blocks: [],
    running_block: None,
  })
}

/// End a tab: its program hung up on, its request file removed.
pub let close_session = (s: Session) -> void => {
  close(s.pty)
  match s.integrated {
    Some(i) => {
      let _ = remove_file(i.request)
    },
    None => {},
  }
}

/// The tab's name: the title its program set, else the command running, else its
/// directory's last part (`~` for home), else the program.
pub let tab_title = pure (s: Session, home: string) -> string => {
  if s.shown.title != "" { return s.shown.title }
  if s.running != "" { return first_line(s.running) }
  let cwd = s.shown.cwd
  if cwd == "" { return s.program }
  if cwd == home { return "~" }
  let name = base_name(cwd)
  if name == "" { "/" } else { name }
}

/// The directory a tab beside this one starts in: where its shell last said it was.
pub let directory = pure (s: Session) -> Maybe<string> =>
  if s.shown.cwd == "" { None } else { Some(s.shown.cwd) }

impl Session {
  /// Carry out an Edit menu item (or its key, without a menu bar): on the command line at a
  /// prompt — Copy there taking the grid's selection when the command line has none; while a
  /// program runs, Paste is the program's (a bracketed paste when it asked for one), Copy
  /// the grid's selection, and Select All the whole screen and its scrollback.
  pub let edit_action = (self: mut, a: EditAction) -> void => {
    let at_prompt = match self.mode {
      AtPrompt(_, _) => true,
      Raw => false,
    }
    match a {
      Copy => {
        if at_prompt && self.line.can(Copy) { self.line.edit_action(Copy) }
        else if self.has_selection() { set_clipboard_text(self.selected_text()) }
      },
      SelectAll => {
        if at_prompt { self.line.edit_action(SelectAll) } else { self.select_everything() }
      },
      Paste => {
        if at_prompt { self.line.edit_action(Paste) }
        else {
          let _ = self.pty.write(pasted(get_clipboard_text(), self.shown.bracketed_paste))
        }
      },
      _ => if at_prompt { self.line.edit_action(a) },
    }
  }

  /// Whether Edit menu item `a` would do anything now.
  pub let can = pure (self, a: EditAction) -> bool => {
    let at_prompt = match self.mode {
      AtPrompt(_, _) => true,
      Raw => false,
    }
    match a {
      Copy => (at_prompt && self.line.can(Copy)) || self.has_selection(),
      SelectAll => if at_prompt { self.line.can(SelectAll) } else { true },
      Paste => true,
      _ => at_prompt && self.line.can(a),
    }
  }

  /// Whether the grid has a selection.
  pub let has_selection = pure (self) -> bool =>
    self.sel_a.line != self.sel_b.line || self.sel_a.col != self.sel_b.col

  /// The grid's selected text.
  pub let selected_text = pure (self) -> string =>
    selection_text(self.shown, self.sel_a, self.sel_b)

  /// Select the whole screen and its scrollback.
  pub let select_everything = (self: mut) -> void => {
    let last = self.shown.scrollback_len() + self.shown.rows - 1
    self.sel_a = Spot { line: self.shown.absolute(0), col: 0 }
    self.sel_b = Spot { line: self.shown.absolute(last), col: self.shown.cols }
  }

  /// Close the tab (⌘W, its close button): it goes at the end of this frame, its program
  /// hung up on.
  pub let request_close = (self: mut) -> void => { self.alive = false }

  /// Run `command` at the prompt: sent to the shell as a paste and a Return, kept in the
  /// history, and the prompt it was sent from noted ([Session.sent_from]).
  let send_command = (self: mut, command: string) -> void => {
    let _ = self.pty.write(submission(command, self.shown.bracketed_paste))
    self.line.submitted(command)
    self.running = command
    match self.mode {
      AtPrompt(at, col) => { self.sent_from = Some((at, col)) },
      Raw => {},
    }
    self.mode = Raw
  }

  /// This frame's reading: what the program wrote, carried out; where its shell now is; the
  /// shell's completions and keys typed ahead handed to the command line; a typed-ahead
  /// command run at a prompt. `shown` says whether the tab is the one in view.
  pub let step = (self: mut, shown: bool) -> void => {
    let (alive, got) = drain(self.pty, self.parse, self.shown)
    // Reading only ever ends a tab: one closed by the user stays closed though its program
    // has not ended yet.
    if !alive { self.alive = false }
    self.got_output = got
    if got && !shown { self.unseen = true }
    if shown { self.unseen = false }
    // The last mark says where the shell is: input begins there, or something else has.
    for m in self.shown.take_marks() {
      match m {
        InputStart(at, col) => {
          let redrawn = match self.sent_from {
            Some((a, c)) => a == at && c == col,
            None => false,
          }
          if !redrawn {
            self.mode = AtPrompt(at, col)
            self.running = ""
          }
        },
        // A prompt begins; drawn again with its line (bash's readline, on a paste), it does
        // not end what a command sent from it is waiting for.
        PromptStart(at, col) => {
          self.prompt_from = (at, col)
          self.mode = Raw
        },
        // A command runs: its block opens, from the prompt it was entered at.
        OutputStart(line) => {
          self.mode = Raw
          self.sent_from = None
          if self.prompt_from.0 >= 0 {
            self.running_block = Some(Block {
              prompt: self.prompt_from.0,
              output: line.max(self.prompt_from.0),
              end: -1,
              status: -1,
              started: wall_clock_nanos(),
              ended: 0,
            })
          }
        },
        // It ended: its block is done.
        CommandEnd(status, line) => {
          self.mode = Raw
          self.sent_from = None
          match self.running_block {
            Some(b) => {
              self.blocks.push(Block {
                b | end: line.max(b.output),
                status: status,
                ended: wall_clock_nanos()
              })
              if self.blocks.len() > BLOCKS { self.blocks = self.blocks.slice(
                self.blocks.len() - BLOCKS,
                self.blocks.len()
              ) }
            },
            None => {},
          }
          self.running_block = None
        },
        // The screen erased: blocks on it are gone; one above whose output reached it, cut.
        Cleared(line) => {
          self.mode = Raw
          self.sent_from = None
          self.blocks = [b in self.blocks | b.output < line | Block { b | end: b.end.min(line) }]
          match self.running_block {
            Some(b) => if b.output >= line { self.running_block = None },
            None => {},
          }
        },
      }
    }
    // The program's questions answered (what terminal, where the cursor is, which colours).
    for reply in self.shown.take_replies() {
      let _ = self.pty.write(reply)
    }
    for offered in self.shown.take_completions() { self.line.completed(offered) }
    // Keys typed ahead while a command ran: at the prompt they wait for, a line ended by
    // Return runs, as in any terminal, and the rest goes into the editor.
    for keys in self.shown.take_typed_ahead() { self.line.typed_ahead(keys) }
    match self.mode {
      AtPrompt(_, _) => match self.line.take_typed_ahead() {
        Some(command) => self.send_command(command),
        None => {},
      },
      Raw => {},
    }
  }
}

/// How the grid is drawn: a cell's size, how far down its cell text sits, a display pixel
/// (what a drawn bold is offset by), the faces and the theme.
pub struct Look {
  cell: Vec2,
  text_dy: f32,
  pixel: f32,
  fonts: Fonts,
  theme: Theme,
}

/// Draw a tab into the current window — its grid filling it, the scrollback above, and the
/// cursor, or at a prompt the command line's editor where input begins — and, when
/// `focused`, give it the keys: the editor's at a prompt, the program's otherwise.
/// `menus` says whether a menu bar's Edit menu has ⌘Z, ⌘X, ⌘C, ⌘V and ⌘A, which then come as
/// [Session.edit_action]s rather than keys.
pub let draw_session = (
  s: mut Session,
  look: Look,
  focused: bool,
  menus: bool
) -> void => {
  s.line.menu_keys = menus
  // What a program asking (vim) is told the colours are: the theme's.
  s.shown.fg_report = report_of(look.theme.fg)
  s.shown.bg_report = report_of(look.theme.bg)
  let cell = look.cell
  let text_dy = look.text_dy
  let pixel = look.pixel
  let fonts = look.fonts
  let theme = look.theme
  // The grid is as many whole cells as the window holds.
  let avail = get_content_region_avail()
  let cols = (avail.x / cell.x).floor().max(2)
  let rows = (avail.y / cell.y).floor().max(1)
  if cols != s.shown.cols || rows != s.shown.rows {
    s.shown.resize(cols, rows)
    let _ = s.pty.resize(cols, rows)
  }

  // At a prompt still on the screen or in the scrollback: its line, and the column its
  // input begins at — the end of the prompt.
  let prompt = match s.mode {
    AtPrompt(at, col) => match s.shown.line_at(at) {
      Some(i) => Some((i, col.min(cols - 1))),
      None => None,
    },
    Raw => None,
  }
  let input_line = match prompt {
    Some((i, _)) => i,
    None => -1,
  }
  // At a prompt the command line is a box pinned to the window's foot, as Warp has it: the
  // prompt's row, then the command's rows from the first column, inset from the box's sides
  // and so a little narrower than the grid.
  let inset_cols = (2.0 * BOX_INSET / cell.x).ceil()
  let wrap = Wrap { first: 0, cols: (cols - inset_cols).max(1) }
  // The prompt's first line and the column it begins at: its `A` mark's, when that is the
  // input's line or a few above it; else the input's line from its start.
  let (first, first_col) = match prompt {
    Some((i, _)) => match s.shown.line_at(s.prompt_from.0) {
      Some(a) => if a <= i && i - a < PROMPT_ROWS { (a, s.prompt_from.1.min(cols)) } else { (i, 0) },
      None => (i, 0),
    },
    None => (-1, 0),
  }
  let prompt_rows = if input_line >= 0 { input_line - first + 1 } else { 0 }
  // While a command sent from the box runs, the box stays, greyed, showing it — the keys
  // are the program's — but not when a full-screen program has the window.
  let integrated = match s.integrated {
    Some(_) => true,
    None => false,
  }
  let running_box = input_line < 0 && s.running != "" && !s.shown.alt && integrated
  let box_rows = if input_line >= 0 { prompt_rows + s.line.rows(wrap) }
  else if running_box { 1 }
  else { 0 }
  let box_height = if box_rows > 0 {
    f32(box_rows) * cell.y + 2.0 * BOX_PADDING + BOX_GAP
  } else { 0.0 }

  // Following the output: the view was at the bottom before this frame's scroll.
  let at_bottom = get_scroll_y() >= get_scroll_max_y() - 1.0
  let origin = get_cursor_screen_pos()
  // The first line drawn: on the alternate screen a full-screen program has the window, and
  // the scrollback above its screen is not shown.
  let base = if s.shown.alt { s.shown.scrollback_len() } else { 0 }
  // The lines there are: the scrollback and the screen's rows — on the main screen only
  // those in use, so that the blank rows below a running command's output do not pad the
  // page out past the view (with the box and the cards' room), scrolling what it wrote,
  // a password prompt, say, out of sight. A full-screen program has every row.
  let screen_rows = if s.shown.alt { s.shown.rows } else { s.shown.used_rows() }
  let line_count = s.shown.scrollback_len() + screen_rows
  // The grid's lines: all of them, or at a prompt those above its first line — the prompt is
  // in the box, and below it is only the shell's empty input — and that line too when the
  // prompt began partway along it, after output that did not end its line.
  let grid_lines = if input_line < 0 { line_count } else if first_col > 0 { first + 1 } else { first }
  // Where each line goes: a line's height a row, and the room the blocks put between them.
  let layout = if s.shown.alt { Rows {
    origin_y: origin.y,
    base: base,
    cell_y: cell.y,
    at: [],
    through: []
  } }
  else { block_rows_layout(s, origin.y, base, cell.y, grid_lines) }
  // The page: the grid's lines, and room under them for the box and a margin above it, so
  // that the last line rests that far above the box when the view is at the bottom.
  let above_box = if box_height > 0.0 { BLOCK_MARGIN } else { 0.0 }
  let page = layout.y_of(grid_lines) - origin.y + above_box + box_height
  let top = layout.line_at_y(origin.y + get_scroll_y(), grid_lines)
  let bottom = (top + rows + 1).min(grid_lines)
  // The box's top on the screen: the view's foot, wherever it is scrolled to.
  let view_bottom = origin.y + get_scroll_y() + avail.y
  let box_top = view_bottom - box_height
  let list = get_window_draw_list()
  // The commands' blocks under the text: the input's band, the rule above each.
  let grid = Grid {
    origin: origin,
    cell: cell,
    cols: cols,
    base: base,
    top: top,
    bottom: bottom,
    rows: layout,
  }
  if !s.shown.alt {
    for b in s.blocks { draw_block_under(s, list, theme, grid, b, false) }
    match s.running_block {
      Some(b) => draw_block_under(
        s,
        list,
        theme,
        grid,
        Block { b | end: grid_lines + s.shown.absolute(0) },
        true
      ),
      None => {},
    }
  }
  // The rows in view that are a block's input — its prompt and command — drawn with the
  // input's text colour.
  let input_theme = theme.for_input()
  var input_rows: []bool = [false; (bottom - top).max(0)]
  if !s.shown.alt {
    let oldest = s.shown.absolute(0)
    var spans: [](i64, i64) = [b in s.blocks | (b.prompt, b.output)]
    match s.running_block {
      Some(b) => spans.push((b.prompt, b.output)),
      None => {},
    }
    for (p, o) in spans {
      for i in (p - oldest).max(top)..<(o - oldest).min(bottom) { input_rows[i - top] = true }
    }
  }
  for i in top..<bottom {
    let upto = if input_line >= 0 && i == first && first_col > 0 { first_col } else { s.shown.cols }
    let at = LineAt {
      origin: Vec2 { x: origin.x, y: layout.y_of(i) },
      cell: cell,
      text_dy: text_dy,
      pixel: pixel,
    }
    let row_theme = if input_rows[i - top] { input_theme } else { theme }
    draw_line(list, row_theme, fonts, at, s.shown.line(i), s.shown.combining, upto)
  }
  // And over it: how each ended, and how long it took.
  if !s.shown.alt {
    for b in s.blocks { draw_block_over(s, list, theme, grid, b, text_dy) }
  }
  let cursor = Vec2 {
    x: origin.x + f32(s.shown.x) * cell.x,
    y: layout.y_of(s.shown.scrollback_len() + s.shown.y),
  }
  // The grid's selection, over the text.
  if s.has_selection() {
    for i in top..<bottom {
      let (a, b) = selected_on(s.sel_a, s.sel_b, s.shown.absolute(i), cols)
      if b > a {
        let y = layout.y_of(i)
        list.add_rect_filled(
          Vec2 { x: origin.x + f32(a) * cell.x, y: y },
          Vec2 { x: origin.x + f32(b) * cell.x, y: y + cell.y },
          theme.selection
        )
      }
    }
  }
  // The mouse selects on the grid — above the command line at a prompt (which has its own
  // mouse), and with Shift held when a program has asked for the mouse; otherwise the
  // program is told of it. A program on the alternate screen that has not asked is sent
  // the wheel as arrow keys, so that less and man scroll.
  let raw = input_line < 0
  if raw && s.shown.mouse_mode != 0 && !held().shift {
    report_mouse(s, origin, cell, base)
  } else {
    // The box's own clicks are the command line's; the grid takes those above it.
    grid_mouse(
      s,
      origin,
      cell,
      layout,
      grid_lines,
      if raw && !running_box { 1.0e30 } else { box_top }
    )
    if raw && s.shown.alt && s.shown.alternate_scroll && s.shown.mouse_mode == 0 && is_window_hovered() {
      let notches = wheel_notches(s, get_io().mouse_wheel())
      if notches != 0 {
        let _ = s.pty.write(wheel_keys(notches, s.shown.cursor_keys))
      }
    }
  }
  // Focus reports (`?1004`): the window gaining or losing the keyboard.
  if s.shown.focus_events && focused != s.had_focus {
    let _ = s.pty.write(if focused { "\e[I" } else { "\e[O" })
  }
  s.had_focus = focused
  dummy(Vec2 { x: f32(cols) * cell.x, y: page })

  var follow = s.got_output && at_bottom
  match prompt {
    Some((i, prompt_end)) => {
      let before = "${s.line.edit.cursor}:${s.line.edit.anchor}:${s.line.edit.content()}"
      draw_box(list, theme, origin.x, cols, cell, box_top, view_bottom)
      // The prompt's rows, each line's cells from where the prompt began on it to the input
      // column on the last.
      for r in 0..<prompt_rows {
        let l = first + r
        let cells = s.shown.line(l)
        let from = if r == 0 { first_col } else { 0 }
        let to = (if l == i { prompt_end } else { cols }).min(cells.len())
        if to > from {
          let row_at = LineAt {
            origin: Vec2 { x: origin.x + BOX_INSET, y: box_top + BOX_PADDING + f32(r) * cell.y },
            cell: cell,
            text_dy: text_dy,
            pixel: pixel,
          }
          draw_line(
            list,
            input_theme,
            fonts,
            row_at,
            cells.slice(from, to),
            s.shown.combining,
            to - from
          )
        }
      }
      draw_right_prompt(s, list, input_theme, fonts, i, prompt_end, LineAt {
        origin: Vec2 {
          x: origin.x + BOX_INSET,
          y: box_top + BOX_PADDING + f32(prompt_rows - 1) * cell.y,
        },
        cell: cell,
        text_dy: text_dy,
        pixel: pixel,
      }, wrap.cols, (if i == first { prompt_end - first_col } else { prompt_end }))
      let place = Place {
        origin: Vec2 {
          x: origin.x + BOX_INSET,
          y: box_top + BOX_PADDING + f32(prompt_rows) * cell.y + BOX_GAP,
        },
        cell: cell,
        text_dy: text_dy,
        wrap: wrap,
        menu_above: true,
        // The menu rests just above the box.
        lift: f32(prompt_rows) * cell.y + BOX_PADDING + BOX_GAP + BOX_MENU_GAP,
      }
      let style = Style {
        text: theme.editor_text,
        caret: theme.cursor,
        selection: theme.selection,
        menu: theme.menu,
        menu_chosen: theme.menu_chosen,
        faint: theme.palette[8],
        // The syntax in the theme's own ANSI colours: green, cyan, yellow, magenta, blue.
        command: theme.palette[2],
        option: theme.palette[6],
        quoted: theme.palette[3],
        variable: theme.palette[5],
        operator: theme.palette[4],
      }
      match s.line.update(place, list, style, focused) {
        Submit(command) => {
          s.send_command(command)
          follow = true
        },
        Send(bytes) => {
          let _ = s.pty.write(bytes)
        },
        Complete(text, cursor) => {
          match s.integrated {
            Some(i) => match completion_request(i, text, cursor) {
              Some(key) => {
                let _ = s.pty.write(key)
              },
              None => {},
            },
            None => {},
          }
        },
        _ => {},
      }
      let after = "${s.line.edit.cursor}:${s.line.edit.anchor}:${s.line.edit.content()}"
      if before != after { follow = true }
    },
    None => {
      if running_box {
        // The command running, greyed, its first line, as wide as the box.
        draw_box(list, theme, origin.x, cols, cell, box_top, view_bottom)
        let lines = s.running.split("\n")
        let head = if lines.len() > 1 { "${lines[0]} ⏎ …" } else { lines[0] }
        let runes = head.to_runes()
        let fits = if runes.len() > wrap.cols { text_of(runes.slice(
          0,
          wrap.cols
        )) } else { head }
        list.add_text(
          Vec2 { x: origin.x + BOX_INSET, y: box_top + BOX_PADDING + text_dy },
          theme.palette[8],
          fits
        )
      }
      if s.shown.cursor_visible {
        // The shape the program set (DECSCUSR): a block, an underline or a bar.
        let shape = s.shown.cursor_shape
        let (lo, hi) = if shape == 3 || shape == 4 {
          (
            Vec2 { x: cursor.x, y: cursor.y + cell.y - 2.0 },
            Vec2 { x: cursor.x + cell.x, y: cursor.y + cell.y }
          )
        } else if shape == 5 || shape == 6 {
          (cursor, Vec2 { x: cursor.x + 2.0, y: cursor.y + cell.y })
        } else {
          (cursor, Vec2 { x: cursor.x + cell.x, y: cursor.y + cell.y })
        }
        list.add_rect_filled(lo, hi, (theme.cursor & 0x00FFFFFF) | 0xB0000000)
      }
      if focused {
        // Copy without a menu bar (Ctrl+Shift+C off macOS): the grid's selection.
        let mods = held()
        if !menus && mods.control && mods.shift && is_key_pressed(KEY_C) && s.has_selection() {
          set_clipboard_text(s.selected_text())
        }
        request_text_input(cursor, cell.y)
        if send_keys(
          s.pty,
          menus,
          s.shown.bracketed_paste,
          s.shown.cursor_keys
        ) { follow = true }
      }
    },
  }
  if follow { set_scroll_y(page) }
}

/// Where the shell is, as far as Sulafat can tell.
data Mode =
  /// A program is running, the shell is drawing its prompt, or it has no integration: the
  /// keys go to it as typed.
  Raw
  /// At a prompt whose input begins at this absolute line and column: the command line
  /// there is Sulafat's editor.
  | AtPrompt(i64, i64)

/// The mouse on the grid: a click sets where a selection starts (and drops one), a drag
/// selects, a double-click selects a word and a triple-click a line, a drag after either
/// extending by words or lines. Only lines before `grid_rows` (an index of everything's
/// lines) take it, and only above `below` on the screen (the command line's box).
let grid_mouse = (
  s: mut Session,
  origin: Vec2,
  cell: Vec2,
  layout: Rows,
  grid_rows: i64,
  below: f32
) -> void => {
  let m = get_mouse_pos()
  // -FLT_MAX when the pointer is nowhere; no cell arithmetic survives it.
  if m.x < -1.0e30 || m.y < -1.0e30 {
    if !is_mouse_down(0) { s.sel_dragging = false }
    return
  }
  let i = layout.line_at_y(m.y, grid_rows).clamp(0, (grid_rows - 1).max(0))
  let line = s.shown.absolute(i)
  let fx = (m.x - origin.x) / cell.x
  let edge = (fx + 0.5).floor().clamp(0, s.shown.cols)
  let under = fx.floor().clamp(0, s.shown.cols - 1)
  let inside = is_window_hovered() &&
    m.y >= origin.y &&
    m.y < below &&
    m.y < layout.y_of(grid_rows)
  if inside && is_mouse_clicked(0) {
    s.sel_unit = i64(get_mouse_clicked_count(0)).clamp(1, 3)
    s.sel_origin = unit_span(s.shown, s.sel_unit, line, under, edge)
    s.sel_a = s.sel_origin.0
    s.sel_b = s.sel_origin.1
    s.sel_dragging = true
  } else if s.sel_dragging && is_mouse_down(0) {
    // Extended to the pointer — by whole words or lines after a double or triple click.
    let (here_a, here_b) = unit_span(s.shown, s.sel_unit, line, under, edge)
    let (o_a, o_b) = s.sel_origin
    let before = here_a.line < o_a.line || (here_a.line == o_a.line && here_a.col < o_a.col)
    if before {
      s.sel_a = o_b
      s.sel_b = here_a
    } else {
      s.sel_a = o_a
      s.sel_b = here_b
    }
  } else if !is_mouse_down(0) {
    s.sel_dragging = false
  }
}

/// The mouse told to a program that asked (`?1000`, `?1002`, `?1003`): presses and releases
/// of each button, motion a cell at a time — with a button held for 1002, always for 1003 —
/// and the wheel, with Shift, Alt and Ctrl, in SGR's encoding or X10's.
let report_mouse = (s: mut Session, origin: Vec2, cell: Vec2, base: i64) -> void => {
  let m = get_mouse_pos()
  if m.x < -1.0e30 || m.y < -1.0e30 || !is_window_hovered() { return }
  let col = ((m.x - origin.x) / cell.x).floor().clamp(0, s.shown.cols - 1)
  let row = (base + ((m.y - origin.y) / cell.y).floor() - s.shown.scrollback_len()).clamp(
    0,
    s.shown.rows - 1
  )
  let mods = held()
  let extra = (if mods.shift { 4 } else { 0 }) + (if mods.alt { 8 } else { 0 }) + (if mods.control { 16 } else { 0 })
  let sgr = s.shown.mouse_sgr
  var out: []u8 = []
  // ImGui's buttons are left, right, middle; a terminal's 0 left, 1 middle, 2 right.
  let codes = [0, 2, 1]
  var held_button = -1
  for k in 0..<3 {
    let b = codes[k]
    if is_mouse_clicked(i32(k)) { out = [
      ...out,
      ...mouse_report(b + extra, col, row, true, sgr)
    ] }
    if is_mouse_released(i32(k)) { out = [
      ...out,
      ...mouse_report(b + extra, col, row, false, sgr)
    ] }
    if is_mouse_down(i32(k)) && held_button < 0 { held_button = b }
  }
  // Motion, when the pointer reaches another cell.
  let moved = s.mouse_cell.0 != col || s.mouse_cell.1 != row
  if moved && s.mouse_cell.0 >= 0 {
    if held_button >= 0 && s.shown.mouse_mode >= 1002 {
      out = [...out, ...mouse_report(held_button + 32 + extra, col, row, true, sgr)]
    } else if held_button < 0 && s.shown.mouse_mode == 1003 {
      out = [...out, ...mouse_report(3 + 32 + extra, col, row, true, sgr)]
    }
  }
  s.mouse_cell = (col, row)
  // The wheel: 64 up, 65 down, a report a notch.
  let notches = wheel_notches(s, get_io().mouse_wheel())
  let wheel = if notches > 0 { 64 } else { 65 }
  for _ in 0..<notches.abs() { out = [
    ...out,
    ...mouse_report(wheel + extra, col, row, true, sgr)
  ] }
  if out.len() > 0 {
    let _ = s.pty.write_bytes(out)
  }
}

/// Whole wheel notches from this frame's travel and what was left from before, the rest
/// kept: up positive. A trackpad's travel comes in fractions.
let wheel_notches = (s: mut Session, travel: f32) -> i64 => {
  s.wheel_left += travel
  let whole = if s.wheel_left >= 0.0 { s.wheel_left.floor() } else { s.wheel_left.ceil() }
  s.wheel_left -= f32(whole)
  whole
}

/// A mouse report: button code `b` (with its modifier and motion bits), at the 0-based cell
/// `col`, `row`; a press or motion, or a release. SGR's form (`\e[<b;x;yM`, `m` for a
/// release, any size) or X10's (`\e[M` and three bytes, 32 more than the button and the
/// 1-based place — so no place past 223, and a release is button 3).
pub let mouse_report = pure (
  b: i64,
  col: i64,
  row: i64,
  press: bool,
  sgr: bool
) -> []u8 => {
  if sgr { return "\e[<${b};${col + 1};${row + 1}${if press { "M" } else { "m" }}".encode_utf8() }
  let code = if press { b } else { (b & ~3) | 3 }
  [
    0x1B,
    0x5B,
    0x4D,
    u8(32 + code),
    u8(32 + (col + 1).min(223)),
    u8(32 + (row + 1).min(223))
  ]
}

/// `notches` of the wheel as arrow keys — three lines a notch, up when positive — for a
/// program on the alternate screen that has not asked for the mouse.
pub let wheel_keys = pure (notches: i64, cursor_keys: bool) -> string => {
  let key = if cursor_keys { if notches > 0 { "\eOA" } else { "\eOB" } } else { if notches > 0 { "\e[A" } else { "\e[B" } }
  [n in 0..<(notches.abs() * 3) | key].join("")
}

/// What a click selects on line `line` (absolute): with `unit` 1 the place `edge` (a column
/// boundary), with 2 the word around cell `under`, with 3 the whole line.
let unit_span = pure (
  shown: Screen,
  unit: i64,
  line: i64,
  under: i64,
  edge: i64
) -> (Spot, Spot) => {
  let (
    a,
    b
  ) = if unit == 2 { word_span(
    shown,
    line,
    under
  ) } else if unit == 3 { (0, shown.cols) } else { (edge, edge) }
  let from = Spot { line: line, col: a }
  let to = Spot { line: line, col: b }
  (from, to)
}

/// Where the grid is drawn this frame: its first cell on the screen, a cell's size, its
/// width, the first line of everything drawn (`base`) and the lines in view, `top` to
/// `bottom`, as indices for [Screen.line].
struct Grid {
  origin: Vec2,
  cell: Vec2,
  cols: i64,
  base: i64,
  top: i64,
  bottom: i64,
  rows: Rows,
}

/// Where the grid's lines go on the screen: a line's height each, and gaps the blocks put
/// above lines — `at`, the line (index) each gap is above, in order, and `through`, all the
/// room above lines up to and including that one. A line's top is [y_of]; what comes before
/// its gaps, [y_above].
pub struct Rows {
  origin_y: f32,
  base: i64,
  cell_y: f32,
  at: []i64,
  through: []f32,
}

impl Rows {
  /// Line `i`'s top: below every gap above it.
  pub let y_of = pure (self, i: i64) -> f32 =>
    self.origin_y + f32(i - self.base) * self.cell_y + self.room_through(i)

  /// Where the gaps above line `i` begin: the foot of the line before.
  pub let y_above = pure (self, i: i64) -> f32 =>
    self.origin_y + f32(i - self.base) * self.cell_y + self.room_through(i - 1)

  /// The line at screen height `y` — the last whose top is above it — from `base` to `last`.
  pub let line_at_y = pure (self, y: f32, last: i64) -> i64 => {
    var lo = self.base
    var hi = last.max(self.base)
    while lo < hi {
      let mid = (lo + hi + 1) / 2
      if self.y_of(mid) <= y { lo = mid } else { hi = mid - 1 }
    }
    lo
  }

  /// The room of every gap above lines up to and including line `i`.
  let room_through = pure (self, i: i64) -> f32 => {
    var lo = 0
    var hi = self.at.len()
    while lo < hi {
      let mid = (lo + hi) / 2
      if self.at[mid] <= i { lo = mid + 1 } else { hi = mid }
    }
    if lo == 0 { 0.0 } else { self.through[lo - 1] }
  }
}

/// The grid's rows with the blocks' room: above each block its margin and the input's
/// padding, between its input and output the padding of each, below its output padding —
/// for the lines from `base` to `grid_lines` (indices).
pub let block_rows_layout = pure (
  s: Session,
  origin_y: f32,
  base: i64,
  cell_y: f32,
  grid_lines: i64
) -> Rows => {
  var gaps: [](i64, f32) = []
  let first = s.shown.absolute(0)
  // The running block with the finished ones, in an array of its own: `s.blocks` itself is
  // the session's, and an array a variable is set to is that array, not a copy — a push
  // here added a block to the session every frame.
  let all = match s.running_block {
    Some(b) => [...s.blocks, b],
    None => s.blocks,
  }
  for b in all {
    let p = b.prompt - first
    let o = b.output - first
    if o >= base && o <= grid_lines {
      if p >= base { gaps.push((p, BLOCK_MARGIN + BLOCK_PAD)) }
      gaps.push((o, 2.0 * BLOCK_PAD))
      if b.end >= 0 && b.end - first <= grid_lines { gaps.push((
        b.end - first,
        BLOCK_PAD
      )) }
    }
  }
  // In order of line, the gaps above one line together.
  var at: []i64 = []
  var through: []f32 = []
  var sum: f32 = 0.0
  for (line, room) in sorted_gaps(gaps) {
    sum += room
    if at.len() > 0 && at[at.len() - 1] == line { through[through.len() - 1] = sum } else {
      at.push(line)
      through.push(sum)
    }
  }
  Rows { origin_y: origin_y, base: base, cell_y: cell_y, at: at, through: through }
}

/// `gaps` in order of their lines — nearly so already, the blocks being in order: an
/// insertion sort, stable.
let sorted_gaps = pure (gaps: [](i64, f32)) -> [](i64, f32) => {
  // A copy to sort: `gaps` is the caller's array.
  var out = [...gaps]
  for i in 1..<out.len() {
    var j = i
    while j > 0 && out[j - 1].0 > out[j].0 {
      let t = out[j]
      out[j] = out[j - 1]
      out[j - 1] = t
      j -= 1
    }
  }
  out
}

/// Under a block's text, as a card: its input on the box's tint, rounded at the top, its
/// output on a fainter one below, each with its padding; a red bar down the left of a
/// failed one. `running`: it has no end yet, and its card reaches the grid's foot (`b.end`).
let draw_block_under = (
  s: Session,
  list: DrawList,
  theme: Theme,
  g: Grid,
  b: Block,
  running: bool
) -> void => {
  let first = s.shown.absolute(0)
  // A prompt gone from the scrollback: the card from the first line kept.
  let kept = b.prompt - first >= g.base
  let p = (b.prompt - first).max(g.base)
  let o = b.output - first
  let e = b.end - first
  if e < g.top || p > g.bottom { return }
  let r = g.rows
  let top = if kept { r.y_of(p) - BLOCK_PAD } else { r.y_of(p) }
  let input_foot = r.y_above(o) + BLOCK_PAD
  let foot = if running { r.y_of(e) } else { r.y_above(e) + BLOCK_PAD }
  let x0 = g.origin.x - BOX_MARGIN
  let x1 = g.origin.x + f32(g.cols) * g.cell.x + BOX_MARGIN
  if foot > input_foot + 0.5 {
    list.add_rect_filled(
      Vec2 { x: x0, y: top },
      Vec2 { x: x1, y: foot },
      theme.output,
      BLOCK_ROUNDING
    )
    list.add_rect_filled(
      Vec2 { x: x0, y: top },
      Vec2 { x: x1, y: input_foot },
      theme.input,
      BLOCK_ROUNDING,
      DRAW_FLAGS_ROUND_CORNERS_TOP
    )
  } else {
    list.add_rect_filled(
      Vec2 { x: x0, y: top },
      Vec2 { x: x1, y: input_foot },
      theme.input,
      BLOCK_ROUNDING
    )
  }
  if b.status > 0 {
    list.add_rect_filled(
      Vec2 { x: x0 + 3.0, y: top + 4.0 },
      Vec2 { x: x0 + 3.0 + FAILED_BAR, y: foot.max(input_foot) - 4.0 },
      theme.palette[1],
      FAILED_BAR / 2.0
    )
  }
}

/// Over a finished block's first row, at its right end: how long it took, faint, and when
/// it failed its status, red — where the row's own text leaves room.
let draw_block_over = (
  s: Session,
  list: DrawList,
  theme: Theme,
  g: Grid,
  b: Block,
  text_dy: f32
) -> void => {
  let Some(i) = s.shown.line_at(b.prompt) else { return }
  if i < g.top || i >= g.bottom { return }
  let took = duration_text(b.ended - b.started)
  let note = if b.status > 0 { "exit ${b.status}  ${took}" } else { took }
  let width = note.to_runes().len()
  let cells = s.shown.line(i)
  var used = cells.len()
  while used > 0 && cells[used - 1].ch == ' ' { used -= 1 }
  if used + 2 + width > g.cols { return }
  let x = g.origin.x + f32(g.cols - width) * g.cell.x
  let y = g.rows.y_of(i) + text_dy
  if b.status > 0 {
    let status = "exit ${b.status}"
    list.add_text(Vec2 { x: x, y: y }, theme.palette[1], status)
    list.add_text(
      Vec2 { x: x + f32(status.to_runes().len() + 2) * g.cell.x, y: y },
      theme.palette[8],
      took
    )
  } else {
    list.add_text(Vec2 { x: x, y: y }, theme.palette[8], took)
  }
}

/// A duration in nanoseconds as a block shows it: `0.42s`, `4.2s`, `1m 05s`.
let duration_text = pure (nanos: i64) -> string => {
  let ms = (nanos / 1000000).max(0)
  if ms < 10000 {
    let hundredths = ms / 10
    let whole = hundredths / 100
    let frac = hundredths % 100
    return "${whole}.${if frac < 10 { "0" } else { "" }}${frac}s"
  }
  if ms < 60000 { return "${ms / 1000}.${(ms / 100) % 10}s" }
  let secs = ms / 1000
  "${secs / 60}m ${if secs % 60 < 10 { "0" } else { "" }}${secs % 60}s"
}

/// The bar down a failed block's left edge, in points.
const FAILED_BAR: f32 = 3.0

/// A block's card: the room between cards, the padding inside each around its input and
/// its output, and its corners' rounding. Its colours are the theme's sections'.
const BLOCK_MARGIN: f32 = 10.0
const BLOCK_PAD: f32 = 6.0
const BLOCK_ROUNDING: f32 = 8.0

/// The box's frame from `box_top` to the view's foot, around a grid `cols` wide from `x`:
/// opaque, so the scrolled-back grid never shows through it, tinted, a rule along its top.
let draw_box = (
  list: DrawList,
  theme: Theme,
  x: f32,
  cols: i64,
  cell: Vec2,
  box_top: f32,
  view_bottom: f32
) -> void => {
  let x0 = x - BOX_MARGIN
  let x1 = x + f32(cols) * cell.x + BOX_MARGIN
  list.add_rect_filled(
    Vec2 { x: x0, y: box_top },
    Vec2 { x: x1, y: view_bottom + BOX_MARGIN },
    theme.bg
  )
  list.add_rect_filled(
    Vec2 { x: x0, y: box_top },
    Vec2 { x: x1, y: view_bottom + BOX_MARGIN },
    theme.input,
    BOX_ROUNDING
  )
  list.add_line_h(x0, x1, box_top, theme.rule, 1.0)
}

/// A right prompt (zsh's `RPROMPT`) in the box: what the shell drew on input line `i` after
/// input column `prompt_end` — the shell's input itself is empty, the command line being
/// Sulafat's — right-aligned in the row `at` begins, `cols` wide; left out where it would
/// meet the prompt, `prompt_cols` wide on that row.
let draw_right_prompt = (
  s: Session,
  list: DrawList,
  theme: Theme,
  fonts: Fonts,
  i: i64,
  prompt_end: i64,
  at: LineAt,
  cols: i64,
  prompt_cols: i64
) -> void => {
  let cells = s.shown.line(i)
  var from = prompt_end
  while from < cells.len() && cells[from].ch == ' ' { from += 1 }
  var to = cells.len()
  while to > from && cells[to - 1].ch == ' ' { to -= 1 }
  let width = to - from
  if width <= 0 || cols - width <= prompt_cols { return }
  let right_at = LineAt {
    origin: Vec2 { x: at.origin.x + f32(cols - width) * at.cell.x, y: at.origin.y },
    cell: at.cell,
    text_dy: at.text_dy,
    pixel: at.pixel,
  }
  draw_line(list, theme, fonts, right_at, cells.slice(from, to), s.shown.combining, width)
}

/// The most blocks a tab keeps; older ones go, as their lines will from the scrollback.
const BLOCKS: i64 = 2000

/// The most rows of a prompt the box shows; a prompt's `A` mark further above its input is
/// taken for a stray, and the box shows the input's line alone.
const PROMPT_ROWS: i64 = 4

/// The command line's box: how far it reaches past the grid on each side, how far its text
/// is set in from the grid's sides, the space inside it above and below its rows, between
/// the prompt's row and the command's, and between it and a completion menu above it, and
/// its corners' rounding. Its colours are the theme's: the input section's, and its rule.
const BOX_MARGIN: f32 = 12.0
const BOX_INSET: f32 = 2.0
const BOX_PADDING: f32 = 12.0
const BOX_GAP: f32 = 4.0
const BOX_MENU_GAP: f32 = 4.0
const BOX_ROUNDING: f32 = 8.0

/// Reads per frame at most — a megabyte — so that a program writing without end (`yes`)
/// cannot stop the window drawing.
const READS_PER_FRAME: i64 = 16

/// What the shell has written since the last frame, carried out on `shown`. Answers whether
/// the shell is still there, and whether anything arrived.
let drain = (pty: Pty, parse: mut Parser, shown: mut Screen) -> (bool, bool) => {
  var got = false
  for _ in 0..<READS_PER_FRAME {
    match pty.read() {
      None => return (false, got),
      Some(bytes) => {
        if bytes.len() == 0 { return (true, got) }
        shown.apply(parse.feed(bytes))
        got = true
      },
    }
  }
  (true, got)
}

/// This frame's keys and typed text, sent to the shell as a terminal sends them. Whether
/// anything was sent. With `menus`, ⌘V is the Edit menu's Paste and is not read here;
/// `bracketed` and `cursor_keys` are the program's modes for pastes and arrows.
let send_keys = (pty: Pty, menus: bool, bracketed: bool, cursor_keys: bool) -> bool => {
  // The keys as pressed: ImGui swaps Ctrl and ⌘ on macOS, and `held` undoes it.
  let keys = held()
  let mac = platform() == "macOS"
  let ctrl = keys.control
  // A shortcut of the terminal's own: ⌘ on a Mac, Ctrl+Shift elsewhere.
  let command = if mac { keys.command } else { ctrl && keys.shift }
  var out = ""
  if command {
    if !menus && is_key_pressed(KEY_V) { out = pasted(get_clipboard_text(), bracketed) }
  } else if ctrl {
    // Ctrl+A … Ctrl+Z are the control characters 1 … 26; Ctrl+Space is NUL.
    for k in 0..<26 {
      if is_key_pressed(KEY_A + i32(k)) { out = "${out}${rune(k + 1)}" }
    }
    if is_key_pressed(KEY_SPACE) { let _ = pty.write_bytes([0]) }
  } else if !mac && keys.alt {
    // Alt as Meta, off a Mac: Escape and then the key, as shells and Emacs read it — Alt+B
    // a word back, Alt+F forward. (On a Mac Option types its own characters, as Terminal
    // does unless told otherwise.)
    let typed = typed_text()
    if typed != "" { out = meta(typed) }
    else {
      for k in 0..<26 {
        if is_key_pressed(KEY_A + i32(k)) {
          let letter = rune(i64(if keys.shift { 'A' } else { 'a' }) + k)
          out = "${out}\e${letter}"
        }
      }
    }
    if is_key_pressed(KEY_BACKSPACE) { out = "${out}\e\x7f" }
  } else {
    out = typed_text()
  }
  let arrow = if cursor_keys { "\eO" } else { "\e[" }
  let named = [
    (KEY_ENTER, "\r"),
    (KEY_BACKSPACE, "\x7f"),
    (KEY_TAB, if keys.shift { "\e[Z" } else { "\t" }),
    (KEY_ESCAPE, "\e"),
    // Application cursor keys (`?1`), which full-screen programs turn on, are `\eO…`.
    (KEY_UP_ARROW, "${arrow}A"),
    (KEY_DOWN_ARROW, "${arrow}B"),
    (KEY_RIGHT_ARROW, "${arrow}C"),
    (KEY_LEFT_ARROW, "${arrow}D"),
    (KEY_HOME, "${arrow}H"),
    (KEY_END, "${arrow}F"),
    (KEY_INSERT, "\e[2~"),
    (KEY_DELETE, "\e[3~"),
    (KEY_PAGE_UP, "\e[5~"),
    (KEY_PAGE_DOWN, "\e[6~"),
  ]
  // Alt+Backspace was sent above, as Meta's.
  let meta_held = !mac && keys.alt && !ctrl && !command
  if !command {
    for (key, bytes) in named {
      if is_key_pressed(key) && !(meta_held && key == KEY_BACKSPACE) { out = "${out}${bytes}" }
    }
  }
  if out == "" { return false }
  let _ = pty.write(out)
  true
}

/// `text` typed with Alt as Meta: each rune after an Escape.
pub let meta = pure (text: string) -> string => [r in text | "\e${r}"].join("")

/// `text` as a program is sent it for a paste: between bracketed paste's markers when the
/// program turned the mode on (so it can tell a paste from typing — an editor does not
/// auto-indent it, a shell does not run its lines), its own end marker taken out.
pub let pasted = pure (text: string, bracketed: bool) -> string =>
  if bracketed { "\e[200~${text.replace("\e[201~", "")}\e[201~" } else { text }

/// The last part of a path.
let base_name = pure (path: string) -> string => {
  var k = path.len()
  while k > 0 && path.slice(k - 1, k) == "/" { k -= 1 }
  let parts = path.slice(0, k).split("/")
  parts[parts.len() - 1]
}

/// A command's first line, for a tab's name.
let first_line = pure (command: string) -> string => command.split("\n")[0]
