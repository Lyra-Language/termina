module term
//! The colors a cell's style is drawn in. The screen records what a program asked for —
//! palette entry 1, the default background (`../vt/style.lyra`) — and the theme says what
//! that looks like: its own foreground and background, the 16 ANSI colors, and xterm's
//! 256-color palette built from them.
//!
//! Colors here are `0xAABBGGRR` — as Dear ImGui's `IM_COL32` packed them, when Termina drew
//! with it — and `face` reads them as `ui`'s. A theme is made from
//! the user's settings ([theme_of]); `../settings/settings.lyra` holds the themes offered.

import settings.{ Settings, defaults }
import vt.{
  Cell,
  DEFAULT,
  DIM,
  INVERSE,
  HIDDEN,
  BOLD,
  indexed,
  palette_index,
  rgb_of,
}

/// A theme: its own text and background colors, and a 256-entry palette.
pub struct Theme {
  fg: u32,
  bg: u32,
  /// The cursor's color, and the selection's (drawn over the text, so translucent).
  cursor: u32,
  selection: u32,
  /// The sections' backgrounds: the input's (the box, a block's prompt and command) and a
  /// block's output's; and the rule along the box's top, the text's color faintly.
  input: u32,
  output: u32,
  /// The input section's text, where a program gave it no color ([Theme.for_input]).
  input_text: u32,
  rule: u32,
  /// The tabs' backgrounds — a tab, the one under the pointer, the one shown — and the
  /// command line's text, completion menu and chosen completion.
  tab: u32,
  tab_hovered: u32,
  tab_selected: u32,
  editor_text: u32,
  menu: u32,
  menu_chosen: u32,
  palette: []u32,
  /// Draw bold text in colors 0–7 as their bright versions (8–15), as older programs that
  /// used bold *for* brightness expect. Off: bold is a heavier face, the color as asked.
  bold_is_bright: bool,
}

/// The theme the settings describe.
pub let theme_of = pure (s: Settings) -> Theme => Theme {
  fg: abgr(s.colors.fg),
  bg: abgr(s.colors.bg),
  cursor: abgr(s.colors.cursor),
  selection: (abgr(s.colors.selection) & 0x00FFFFFF) | 0x99000000,
  input: abgr(s.colors.input),
  output: abgr(s.colors.output),
  input_text: abgr(s.colors.input_text),
  rule: (abgr(s.colors.fg) & 0x00FFFFFF) | 0x30000000,
  tab: abgr(s.colors.tab),
  tab_hovered: abgr(s.colors.tab_hovered),
  tab_selected: abgr(s.colors.tab_selected),
  editor_text: abgr(s.colors.editor_text),
  menu: abgr(s.colors.menu),
  menu_chosen: abgr(s.colors.menu_chosen),
  palette: palette_256(s.colors.ansi),
  bold_is_bright: s.bold_is_bright,
}

/// Termina's own theme, before any settings: Termina Dark.
pub let dark_theme = pure () -> Theme => theme_of(defaults())

impl Theme {
  /// The theme an input section's text is drawn in: its default text the input's color.
  pub let for_input = pure (self) -> Theme => Theme { self | fg: self.input_text }

  /// The colors `cell` is drawn in: its text, and its background — `None` for the theme's
  /// own, which the window is already. Inverse swaps the two (the theme's own included), a
  /// hidden cell's text is its background, and dim text is half-way to the background.
  pub let colors = pure (self, cell: Cell) -> (u32, Maybe<u32>) => {
    // Bold as bright, when the theme has it: one of the first eight colors, brightened.
    let asked = match palette_index(cell.fg) {
      Some(i) => if self.bold_is_bright && cell.attrs & BOLD != 0 && i < 8 { indexed(i + 8) } else { cell.fg },
      None => cell.fg,
    }
    var fg = self.color(asked, self.fg)
    var bg = if cell.bg == DEFAULT { None } else { Some(self.color(cell.bg, self.bg)) }
    if cell.attrs & INVERSE != 0 {
      let was = fg
      fg = bg ?? self.bg
      bg = Some(was)
    }
    if cell.attrs & DIM != 0 { fg = blend(fg, bg ?? self.bg) }
    if cell.attrs & HIDDEN != 0 { fg = bg ?? self.bg }
    (fg, bg)
  }

  /// A recorded color drawn: `fallback` for the default.
  pub let color = pure (self, c: u32, fallback: u32) -> u32 => {
    match palette_index(c) {
      Some(i) => return self.palette[i],
      None => {},
    }
    match rgb_of(c) {
      Some((r, g, b)) => 0xFF000000 | (u32(b) << 16) | (u32(g) << 8) | u32(r),
      None => fallback,
    }
  }
}

/// A theme's color as a program asking for it (OSC 10, 11) is told it: `rrrr/gggg/bbbb`, each
/// channel's byte twice, as X11's 16-bit form.
pub let report_of = pure (c: u32) -> string => {
  let r = (c & 0xFF).to_hex(2)
  let g = ((c >> 8) & 0xFF).to_hex(2)
  let b = ((c >> 16) & 0xFF).to_hex(2)
  "${r}${r}/${g}${g}/${b}${b}"
}

/// The theme's background as the window is cleared to it: red, green, blue, 0 to 1.
pub let clear_color = pure (t: Theme) -> (f32, f32, f32) => (
  f32(t.bg & 0xFF) / 255.0,
  f32((t.bg >> 8) & 0xFF) / 255.0,
  f32((t.bg >> 16) & 0xFF) / 255.0,
)

/// A settings colour as a theme's `0xAABBGGRR`: `0xRRGGBB`, its top byte how transparent it is
/// (`settings.Colors`) — 0, as every theme's colours are, opaque.
pub let abgr = pure (rgb: u32) -> u32 =>
  ((255 - ((rgb >> 24) & 0xFF)) << 24) | ((rgb & 0xFF) << 16) | (rgb & 0xFF00) | ((rgb >> 16) & 0xFF)

/// xterm's 256 colors: the 16 given, then a 6×6×6 cube (levels 0, 95, 135, 175, 215, 255),
/// then 24 greys from 8 to 238.
let palette_256 = pure (ansi: []u32) -> []u32 => {
  var out: []u32 = [c in ansi | abgr(c)]
  let levels = [0, 95, 135, 175, 215, 255]
  for i in 0..<216 {
    let r = levels[i / 36]
    let g = levels[(i / 6) % 6]
    let b = levels[i % 6]
    out.push(abgr(u32(r * 65536 + g * 256 + b)))
  }
  for i in 0..<24 {
    let v = 8 + i * 10
    out.push(abgr(u32(v * 65536 + v * 256 + v)))
  }
  out
}

/// Half-way between two theme colors, opaque.
let blend = pure (a: u32, b: u32) -> u32 => {
  let r = ((a & 0xFF) + (b & 0xFF)) / 2
  let g = (((a >> 8) & 0xFF) + ((b >> 8) & 0xFF)) / 2
  let bl = (((a >> 16) & 0xFF) + ((b >> 16) & 0xFF)) / 2
  0xFF000000 | (bl << 16) | (g << 8) | r
}
