module term
//! The command line: the [Editor] drawn where the shell's prompt ends, and the keyboard and
//! mouse turned into its edits. Shown only while the shell is at a prompt (its integration
//! said so — `../shell/shell.lyra`); otherwise the keys are the running program's.
//!
//! **Keys, on a Mac** — ←/→ a rune, ⌥←/→ a word, ⌘←/→ the line's start and end, ↑/↓ a row
//! (from the first or last row: the history), ⌘↑/↓ the text's start and end; ⇧ with any of
//! them selects. ⌫, ⌥⌫ a word, ⌘⌫ to the line's start; ⌦ and ⌥⌦ forward. ⌘A, ⌘C, ⌘X, ⌘V,
//! ⌘Z, ⇧⌘Z. Return runs the command; ⇧Return (or ⌥Return) starts a new line. The shell's
//! own Ctrl keys still work: Ctrl+A/E the line's ends, Ctrl+K and Ctrl+U delete to them,
//! Ctrl+W a word back, Ctrl+C clears, Ctrl+D on an empty line ends the shell, Ctrl+L clears
//! the screen. **Elsewhere** Ctrl takes ⌥'s place for words, and Ctrl+Shift ⌘'s.
//!
//! **Tab** asks the shell for the completions of the word at the caret (zsh's own, through
//! its integration — `../shell/shell.lyra`). One is put in at once; of several, the start
//! they share is, and a menu opens under the word: ↑/↓ or Tab/⇧Tab choose, Return or a
//! click puts the chosen one in, Escape closes it. **Typing narrows it** to the matches
//! that start with the word as it now stands, and ⌫ widens it again — from the list zsh
//! gave, without asking again; it closes when nothing is left to offer or the caret leaves
//! the word's end.
//!
//! **Mouse** — a click puts the caret; a drag, or a shift-click, selects; a double-click
//! selects the word under the pointer and a drag after it extends by whole words; a
//! triple-click selects the line.

import bindings.sdl3.{ platform }
import ui.draw.{ Point }
import ui.backend.{
  Key,
  Modifiers,
  Character,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  ArrowDown,
  Home,
  End,
  Delete,
  Backspace,
  Enter,
  Escape,
  Tab,
}
import editor.{
  editor,
  Editor,
  Wrap,
  position,
  row_count,
  index_at,
  rune_at,
  shell_word_at,
  text_of
}
import vt.{ Completion }

/// The command line's state between frames: the editor, the history being walked, and a
/// drag under way.
pub struct CommandLine {
  edit: Editor,
  history: []string,
  /// The history entry shown, or `history.len()` when none is (the user's own text).
  browsing: i64,
  /// The user's own text, kept while ↑ walks the history so that ↓ past the newest entry
  /// brings it back.
  draft: string,
  dragging: bool,
  /// The word a double-click selected, while the drag after it extends by words.
  word_drag: Maybe<(i64, i64)>,
  /// The text and caret completions were asked for, while the shell works on them: an
  /// answer for anything else (the user went on typing) is dropped. `refreshing`: the ask
  /// was typing's, with the menu open, and the answer is the menu's new contents.
  pending: Maybe<(string, i64)>,
  refreshing: bool,
  /// The completions zsh offered, while their menu is open, and the column their word
  /// begins at: what typing narrows the menu from, and widens it back to.
  offered: []Completion,
  menu_word: i64,
  /// The completions the menu shows (empty: closed) — those of `offered` that start with
  /// the word as typed — the one chosen, and the first shown.
  menu: []Completion,
  chosen: i64,
  menu_top: i64,
  /// Whether ⌘Z, ⌘X, ⌘C, ⌘V and ⌘A belong to a menu bar's Edit menu, and come as
  /// [edit_action]s rather than keys: AppKit hands a menu's key equivalent to SDL too, and
  /// read both ways every paste would happen twice.
  menu_keys: bool,
  /// Keys typed ahead and not yet used, as lines (`typeahead.lyra`): each ended line a
  /// command to run at a prompt, in turn, and what follows the last Return for the editor.
  ahead: string,
  /// The suffix a completion just put in — its `/` or space — with the line and caret it
  /// left, while they are unchanged: what the next key typed may take back ([type_text]).
  suffix_left: Maybe<(string, i64, string)>,
  /// History search (Ctrl+R) under way: what the editor held before it, put back if it is
  /// cancelled. Meanwhile the editor's text is the query and the menu its matches.
  searching: Maybe<string>,
}

/// Completions a menu shows at once; more scroll.
pub const MENU_ROWS: i64 = 8

/// The room inside the menu above its first row and below its last, in points.
pub const MENU_PAD: f32 = 6.0

/// The widest a completion and its description are shown, in cells; longer is cut.
pub const MENU_SHOWN: i64 = 40
pub const MENU_DESCRIPTION: i64 = 60

/// What the command line asks of the terminal for an input.
pub data Outcome =
  Nothing
  /// Run this command.
  | Submit string
  /// Send these bytes to the shell as typed (Ctrl+D, Ctrl+L).
  | Send string
  /// Ask the shell for the completions of this text, the caret at this rune (Tab).
  | Complete(string, i64)
  /// Put this text on the clipboard (a copy or cut by key).
  | Clip string
  /// Paste the clipboard: the front end reads it and hands it to [CommandLine.edit_action].
  | PasteWanted

/// An input for the command line ([CommandLine.input]): a key pressed with the modifiers held,
/// or text typed with them — a frame's text before its keys.
pub data LineInput = LineKey(Key, Modifiers) | LineText(string, Modifiers)

/// An empty command line over `history` (oldest first).
pub let command_line = pure (history: []string) -> CommandLine => CommandLine {
  edit: editor(),
  history: history,
  browsing: history.len(),
  draft: "",
  dragging: false,
  word_drag: None,
  pending: None,
  refreshing: false,
  offered: [],
  menu_word: 0,
  menu: [],
  chosen: 0,
  menu_top: 0,
  ahead: "",
  menu_keys: false,
  suffix_left: None,
  searching: None,
}

/// What the Edit menu does — and ⌘Z, ⇧⌘Z, ⌘X, ⌘C, ⌘V, ⌘A without one.
pub data EditAction = Undo | Redo | Cut | Copy | Paste | SelectAll

/// Where the command line is: the position of column 0 of its first row (in the front end's
/// coordinates), a cell's size, and the layout.
pub struct Place {
  origin: Point,
  /// A cell's width (`x`) and height (`y`).
  cell: Point,
  /// How far down its cell a line's text is drawn.
  text_dy: f32,
  wrap: Wrap,
  /// The completion menu opens upward, its foot `lift` points above the text (over the
  /// prompt's row and the box's padding, when the command line is a box at the window's
  /// foot), rather than below it.
  menu_above: bool = false,
  lift: f32 = 0.0,
}

impl CommandLine {
  /// How many rows the command line takes laid out by `wrap`.
  pub let rows = pure (self, wrap: Wrap) -> i64 => row_count(self.edit.text, wrap)

  /// How many rows the completion menu takes below them (0 when it is closed) — or the
  /// history search's matches, one row saying there are none when there are none.
  pub let menu_rows = pure (self) -> i64 =>
    if self.menu.len() == 0 { if self.searching != None { 1 } else { 0 } } else { self.menu.len().min(MENU_ROWS) }

  /// Whether a history search (Ctrl+R) is under way.
  pub let is_searching = pure (self) -> bool => self.searching != None

  /// The shell's completions arrived. Those for a line since edited are dropped; one is put
  /// in; of several, the start they share is put in and the menu opens. Asked again as
  /// typing narrowed the menu, they are its contents as the shell gave them — its matching
  /// (a case-insensitive or substring `matcher-list`) honoured — and nothing is put in.
  pub let completed = (self: mut, offered: []Completion) -> void => {
    let Some((text, cursor)) = self.pending else { return }
    self.pending = None
    let refresh = self.refreshing
    self.refreshing = false
    if text != self.edit.content() || cursor != self.edit.cursor { return }
    // The same completion can come from two completion functions (zsh's `echo` is a
    // builtin and a command): offered once.
    var unique: []Completion = []
    for c in offered {
      var seen = false
      for u in unique { if u.prefix == c.prefix && u.insert == c.insert && u.suffix == c.suffix { seen = true } }
      if !seen { unique.push(c) }
    }
    if refresh { return self.refreshed(unique) }
    if unique.len() == 0 { return }
    if unique.len() == 1 { return self.apply(unique[0]) }
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    let word = text_of(self.edit.text.slice(start, end))
    let shared = common_start([c in unique | "${c.prefix}${c.insert}"])
    if shared.len() > word.len() && shared.starts_with(word) { self.edit.replace(
      start,
      end,
      shared
    ) }
    let (word_start, _) = shell_word_at(self.edit.text, self.edit.cursor)
    self.offered = unique
    self.menu_word = word_start
    self.chosen = 0
    self.menu_top = 0
    self.narrow()
  }

  // The menu as the word now stands, until the shell answers again: the offered completions
  // it is the start of, case aside, the one chosen kept chosen while it is among them.
  // Closed when the caret has left the end of the word the completions were for, or when
  // the one left is the word already, complete; kept as it was when none starts so, since
  // the shell's own matching may yet find some.
  let narrow = (self: mut) -> void => {
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    if start != self.menu_word || self.edit.cursor != end || self.edit.has_selection() {
      return self.close_menu()
    }
    let typed = text_of(self.edit.text.slice(start, self.edit.cursor))
    var kept: []Completion = []
    for c in self.offered { if key_of(c)
        .to_ascii_lower()
        .starts_with(typed.to_ascii_lower()) { kept.push(c) } }
    if kept.len() == 1 && key_of(kept[0]) == typed { return self.close_menu() }
    if kept.len() == 0 { return }
    self.show(kept)
  }

  // The shell's answer for the word as typed now: the menu's contents as given, or closed
  // when there are none — or when the menu closed meanwhile, the answer is not wanted.
  let refreshed = (self: mut, offered: []Completion) -> void => {
    if self.offered.len() == 0 { return }
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    if start != self.menu_word || self.edit.cursor != end { return self.close_menu() }
    if offered.len() == 0 { return self.close_menu() }
    let typed = text_of(self.edit.text.slice(start, end))
    if offered.len() == 1 && key_of(offered[0]) == typed { return self.close_menu() }
    self.offered = offered
    self.show(offered)
  }

  // `kept` as the menu, the one chosen kept chosen while it is among them.
  let show = (self: mut, kept: []Completion) -> void => {
    let was = if self.chosen < self.menu.len() { key_of(self.menu[self.chosen]) } else { "" }
    self.chosen = 0
    for k in 0..<kept.len() { if key_of(kept[k]) == was { self.chosen = k } }
    self.menu = kept
    // Scrolled no further than a shorter list allows, with the choice in view.
    let last_top = (kept.len() - MENU_ROWS).max(0)
    self.menu_top = self.menu_top
      .min(last_top)
      .min(self.chosen)
      .max(self.chosen - MENU_ROWS + 1)
      .max(0)
  }

  // Put completion `c` in place of the word at the caret, and close the menu; its suffix
  // noted, for the next key to take back.
  let apply = (self: mut, c: Completion) -> void => {
    let (start, end) = shell_word_at(self.edit.text, self.edit.cursor)
    self.edit.replace(start, end, "${c.prefix}${c.insert}${c.suffix}")
    self.close_menu()
    self.suffix_left = if c.suffix.ends_with("/") || c.suffix.ends_with(" ") {
      Some((self.edit.content(), self.edit.cursor, c.suffix))
    } else { None }
  }

  let close_menu = (self: mut) -> void => {
    self.refreshing = false
    self.offered = []
    self.menu = []
    self.chosen = 0
    self.menu_top = 0
  }

  // Move the menu's choice by `by`, round its ends, scrolling to keep it shown.
  let choose = (self: mut, by: i64) -> void => {
    let n = self.menu.len()
    self.chosen = (self.chosen + by) %% n
    if self.chosen < self.menu_top { self.menu_top = self.chosen }
    if self.chosen >= self.menu_top + MENU_ROWS { self.menu_top = self.chosen - MENU_ROWS + 1 }
  }

  // Where the menu is: its top left on the screen (below the command line's last row, or
  // above it by `lift`), its column (the word's, moved left to fit), and its width in cells.
  pub let menu_layout = pure (self, at: Place) -> (Point, i64, i64) => {
    let wrap = at.wrap
    var shown_w = 0
    var desc_w = 0
    for c in self.menu {
      shown_w = shown_w.max(c.shown.len().min(MENU_SHOWN))
      desc_w = desc_w.max(c.description.len().min(MENU_DESCRIPTION))
    }
    let gap = if desc_w > 0 { desc_w + 2 } else { 0 }
    let searching = self.searching != None
    // The history search's list is the box's width, from its first column.
    let width = if searching { wrap.cols } else { (shown_w + 2 + gap).min(wrap.cols) }
    let (start, _) = shell_word_at(self.edit.text, self.edit.cursor)
    let (_, col) = position(self.edit.text, wrap, start)
    let left = if searching { 0 } else { col.min(wrap.cols - width).max(0) }
    let under = cell_pos(at, row_count(self.edit.text, wrap), left)
    // Its rows begin inside its padding: above the text by `lift` and the padding below its
    // last row, or below the text by the padding above its first.
    let top = if at.menu_above {
      Point {
        x: under.x,
        y: at.origin.y - at.lift - MENU_PAD - f32(self.menu_rows()) * at.cell.y,
      }
    } else { Point { x: under.x, y: under.y + MENU_PAD } }
    (top, left, width)
  }

  /// Undo, cut, paste and the rest: the same whether chosen from the Edit menu or pressed.
  /// An edit narrows (or closes) an open completion menu, as typing does. `clipboard` is
  /// what a paste puts in; what a cut or copy takes is answered, for the front end to put on
  /// the clipboard (`None` for nothing).
  pub let edit_action = (
    self: mut,
    a: EditAction,
    clipboard: string = ""
  ) -> Maybe<string> => {
    let before = self.edit.content()
    var taken: Maybe<string> = None
    match a {
      Undo => {
        let _ = self.edit.undo()
      },
      Redo => {
        let _ = self.edit.redo()
      },
      Cut => if self.edit.has_selection() { taken = Some(self.edit.cut()) },
      Copy => if self.edit.has_selection() { taken = Some(self.edit.selected_text()) },
      Paste => self.edit.paste(clipboard),
      SelectAll => self.edit.select_all(),
    }
    if self.menu.len() > 0 {
      if self.edit.content() != before { self.narrow() } else { self.close_menu() }
    }
    taken
  }

  /// Whether `a` would do anything now: what the Edit menu greys out when not.
  pub let can = pure (self, a: EditAction) -> bool => match a {
    Undo => self.edit.undo_stack.len() > 0,
    Redo => self.edit.redo_stack.len() > 0,
    Cut => self.edit.has_selection(),
    Copy => self.edit.has_selection(),
    Paste => true,
    SelectAll => !self.edit.is_empty(),
  }

  /// Keys typed ahead, as the shell found them waiting at a new line: kept until a prompt
  /// takes them ([take_typed_ahead]).
  pub let typed_ahead = (self: mut, keys: string) -> void => {
    self.ahead = "${self.ahead}${typed_lines(keys)}"
  }

  /// At a prompt, what typing ahead left for it: the first command ended by a Return, to be
  /// run — what a terminal would have done — or, with none, the text typed after the last
  /// Return, put into the editor at the caret.
  pub let take_typed_ahead = (self: mut) -> Maybe<string> => {
    if self.ahead == "" { return None }
    match self.ahead.index("\n") {
      Some(k) => {
        let command = self.ahead.slice(0, k)
        self.ahead = self.ahead.slice(k + 1, self.ahead.len())
        Some(command)
      },
      None => {
        self.edit.paste(self.ahead)
        self.ahead = ""
        None
      },
    }
  }

  /// Run a command: remember it, and start an empty line.
  pub let submitted = (self: mut, command: string) -> void => {
    self.searching = None
    self.close_menu()
    self.pending = None
    if command.trim() != "" && (self.history.len() == 0 || self.history[self.history.len() - 1] != command) {
      self.history.push(command)
    }
    self.edit = editor()
    self.browsing = self.history.len()
    self.draft = ""
    self.dragging = false
    self.word_drag = None
  }

  // ── Mouse ────────────────────────────────────────────────────────────────

  /// A press of the primary button at `p` (the front end's coordinates, as `at`'s), the clicks
  /// in a row it makes, Shift held or not, and whether the pointer is over the command line's
  /// window: an open menu's row chosen, or the menu closed by a press elsewhere; on the text, a
  /// caret put (Shift: the selection extended), a word selected (two clicks, a drag after
  /// extending by words) or the line (three). Whether the text or the menu took it.
  pub let press = (
    self: mut,
    at: Place,
    p: Point,
    clicks: i64,
    shift: bool,
    over: bool
  ) -> bool => {
    let row = ((p.y - at.origin.y) / at.cell.y).floor()
    let fx = (p.x - at.origin.x) / at.cell.x
    if self.menu.len() > 0 {
      let (menu_top, menu_col, width) = self.menu_layout(at)
      let k = ((p.y - menu_top.y) / at.cell.y).floor()
      let inside = k >= 0 &&
        k < self.menu_rows() &&
        fx >= f32(menu_col) &&
        fx < f32(menu_col + width)
      if inside {
        if self.searching != None { self.end_search(Some(self.menu_top + k)) } else {
          self.apply(self.menu[self.menu_top + k])
        }
        return true
      }
      if self.searching != None { self.end_search(None) } else { self.close_menu() }
    }
    if !over || row < 0 { return false }
    // A caret goes to the nearer edge of a rune; a word is the rune in the cell.
    let caret = index_at(self.edit.text, at.wrap, row, fx)
    let under = rune_at(self.edit.text, at.wrap, row, fx.floor())
    if clicks == 2 {
      self.edit.select_word(under)
      self.word_drag = Some(self.edit.selection())
      self.dragging = true
    } else if clicks >= 3 {
      self.edit.select_line(caret)
      self.word_drag = None
      self.dragging = false
    } else {
      self.edit.click(caret, shift)
      self.word_drag = None
      self.dragging = true
    }
    true
  }

  /// The pointer at `p` with the primary button held: a drag begun on the text extends the
  /// selection to it — by words after a double click.
  pub let drag = (self: mut, at: Place, p: Point) -> void => {
    if !self.dragging { return }
    let row = ((p.y - at.origin.y) / at.cell.y).floor()
    let fx = (p.x - at.origin.x) / at.cell.x
    let caret = index_at(self.edit.text, at.wrap, row, fx)
    let under = rune_at(self.edit.text, at.wrap, row, fx.floor())
    match self.word_drag {
      Some((a, b)) => self.edit.select_words(a, b, under),
      None => self.edit.click(caret, true),
    }
  }

  /// The primary button let go: a drag ends.
  pub let release = (self: mut) -> void => { self.dragging = false }

  // ── Keys ─────────────────────────────────────────────────────────────────

  /// One key or typed text, as the front end hands them over (a frame's text before its keys,
  /// as typing comes first): what the command line asks of the terminal for it. A key's
  /// `Character` is its unshifted character; `mods` are the keys as pressed, Ctrl and ⌘ never
  /// swapped.
  pub let input = (self: mut, wrap: Wrap, i: LineInput) -> Outcome => {
    let mods = match i {
      LineKey(_, m) => m,
      LineText(_, m) => m,
    }
    let mac = platform() == "macOS"
    let shift = mods.shift
    let ctrl = mods.control
    // The editor's shortcuts (copy, paste, undo): ⌘ on a Mac, Ctrl+Shift elsewhere.
    let command = if mac { mods.command } else { ctrl && shift }
    // A word at a time: ⌥ on a Mac, Ctrl elsewhere.
    let by_word = if mac { mods.alt } else { ctrl }
    if self.searching != None { return self.search_keys(
      wrap,
      i,
      mac,
      shift,
      ctrl,
      command,
      by_word
    ) }
    if ctrl && !shift && pressed(i, Character('r')) {
      self.start_search()
      return Nothing
    }
    if self.menu.len() > 0 {
      if pressed(
        i,
        ArrowDown
      ) || (pressed(i, Tab) && !shift) { self.choose(1); return Nothing }
      if pressed(
        i,
        ArrowUp
      ) || (pressed(i, Tab) && shift) { self.choose(-1); return Nothing }
      if pressed(i, Enter) {
        self.apply(self.menu[self.chosen])
        return Nothing
      }
      if pressed(i, Escape) {
        self.close_menu()
        return Nothing
      }
      // Anything else is itself: an edit narrows the menu (or widens it), and a move alone
      // — the caret leaving the word — closes it.
      let text_before = self.edit.content()
      let cursor_before = self.edit.cursor
      let outcome = self.edit_keys(wrap, i, mac, shift, ctrl, command, by_word)
      if self.edit.content() != text_before {
        self.narrow()
        // And the shell asked again, for its own matching of the word as it now is.
        let asked = match outcome {
          Nothing => self.menu.len() > 0,
          _ => false,
        }
        if asked {
          self.pending = Some((self.edit.content(), self.edit.cursor))
          self.refreshing = true
          return Complete(self.edit.content(), self.edit.cursor)
        }
      } else if self.edit.cursor != cursor_before { self.close_menu() }
      return outcome
    }
    if pressed(i, Tab) && !ctrl && !command {
      self.pending = Some((self.edit.content(), self.edit.cursor))
      return Complete(self.edit.content(), self.edit.cursor)
    }
    self.edit_keys(wrap, i, mac, shift, ctrl, command, by_word)
  }

  let edit_keys = (
    self: mut,
    wrap: Wrap,
    i: LineInput,
    mac: bool,
    shift: bool,
    ctrl: bool,
    command: bool,
    by_word: bool
  ) -> Outcome => {
    let mods = match i {
      LineKey(_, m) => m,
      LineText(_, m) => m,
    }
    if let LineText(typed, _) = i {
      if !ctrl && !(mac && command) && typed != "" { self.type_text(typed) }
      return Nothing
    }
    if pressed(i, Enter) {
      if shift || mods.alt { self.edit.newline() }
      else { return Submit(self.edit.content()) }
    }
    if command {
      // The Edit menu's own when there is one; read here they would act twice.
      if !self.menu_keys {
        if pressed(i, Character('a')) { let _ = self.edit_action(SelectAll) }
        if pressed(i, Character('c')) { return clipped(self.edit_action(Copy)) }
        if pressed(i, Character('x')) { return clipped(self.edit_action(Cut)) }
        if pressed(i, Character('v')) { return PasteWanted }
        if pressed(
          i,
          Character('z')
        ) { let _ = self.edit_action(if shift { Redo } else { Undo }) }
      }
    } else if ctrl {
      // The shell's line-editing keys, as zsh's emacs mode has them.
      if pressed(i, Character('a')) { self.edit.line_start(shift) }
      if pressed(i, Character('e')) { self.edit.line_end(shift) }
      if pressed(i, Character('k')) { self.edit.delete_to_line_end() }
      if pressed(i, Character('u')) { self.edit.delete_to_line_start() }
      if pressed(i, Character('w')) { self.edit.delete_word_back() }
      if pressed(i, Character('c')) { self.edit.clear() }
      if pressed(i, Character('l')) { return Send("\x0c") }
      if pressed(i, Character('d')) {
        if self.edit.is_empty() { return Send("\x04") }
        self.edit.delete_forward()
      }
      if !mac && pressed(i, Character('z')) { let _ = self.edit.undo() }
    }
    let line_mod = mac && mods.command
    if pressed(i, ArrowLeft) {
      if line_mod { self.edit.line_start(shift) }
      else if by_word { self.edit.word_left(shift) }
      else { self.edit.left(shift) }
    }
    if pressed(i, ArrowRight) {
      if line_mod { self.edit.line_end(shift) }
      else if by_word { self.edit.word_right(shift) }
      else { self.edit.right(shift) }
    }
    if pressed(i, ArrowUp) {
      if line_mod { self.edit.text_start(shift) }
      else if !self.edit.vertical(wrap, -1, shift) && !shift { self.older() }
    }
    if pressed(i, ArrowDown) {
      if line_mod { self.edit.text_end(shift) }
      else if !self.edit.vertical(wrap, 1, shift) && !shift { self.newer() }
    }
    if pressed(i, Home) { self.edit.line_start(shift) }
    if pressed(i, End) { self.edit.line_end(shift) }
    if pressed(i, Backspace) {
      if line_mod { self.edit.delete_to_line_start() }
      else if by_word { self.edit.delete_word_back() }
      else { self.edit.backspace() }
    }
    if pressed(i, Delete) {
      if by_word { self.edit.delete_word_forward() } else { self.edit.delete_forward() }
    }
    if pressed(i, Escape) { self.edit.click(self.edit.cursor, false) }
    Nothing
  }

  // Typing — and, right after a completion, its suffix taken back when what is typed would
  // double it or end the word anyway, as zsh does (`AUTO_REMOVE_SLASH`): a `/` before a `/`,
  // a blank or `; | & )`, a space before a blank or `; | & )`.
  let type_text = (self: mut, s: string) -> void => {
    match self.suffix_left {
      Some((text, cursor, suffix)) => {
        if text == self.edit.content() &&
          cursor == self.edit.cursor &&
          s != "" &&
          suffix_gives_way(
            suffix,
            s.slice(0, 1)
          ) { self.edit.backspace() }
      },
      None => {},
    }
    self.suffix_left = None
    self.edit.type_text(s)
  }

  // ── History search ───────────────────────────────────────────────────────

  // Ctrl+R: the history's matches for what the editor holds, the newest chosen.
  let start_search = (self: mut) -> void => {
    self.close_menu()
    self.searching = Some(self.edit.content())
    self.search()
  }

  // The menu as the history's commands the query is in — case aside — each once, the newest
  // last (nearest the box) and chosen.
  let search = (self: mut) -> void => {
    let query = self.edit.content().to_ascii_lower()
    var newest_first: []Completion = []
    var seen: []string = []
    var k = self.history.len() - 1
    while k >= 0 {
      let entry = self.history[k]
      if !seen.contains(entry) && entry.to_ascii_lower().contains(query) {
        seen.push(entry)
        newest_first.push(Completion {
          prefix: "",
          insert: entry,
          suffix: "",
          shown: entry.replace("\n", " ⏎ "),
          description: "",
        })
      }
      k -= 1
    }
    self.menu = [i in 0..<newest_first.len() | newest_first[newest_first.len() - 1 - i]]
    self.chosen = (self.menu.len() - 1).max(0)
    self.menu_top = (self.menu.len() - MENU_ROWS).max(0)
  }

  // The search ended: match `chosen` put in the editor, or (`None`) the text from before.
  let end_search = (self: mut, chosen: Maybe<i64>) -> void => {
    let before = self.searching ?? ""
    self.searching = None
    let text = match chosen {
      Some(k) => if k < self.menu.len() { self.menu[k].insert } else { before },
      None => before,
    }
    self.close_menu()
    self.edit.set_content(text)
  }

  // A key during the search: ↑ or Ctrl+R an older match, ↓ or Ctrl+S a newer, Return or Tab
  // the chosen one into the editor, Escape or Ctrl+G back to what was there; anything else
  // edits the query.
  let search_keys = (
    self: mut,
    wrap: Wrap,
    i: LineInput,
    mac: bool,
    shift: bool,
    ctrl: bool,
    command: bool,
    by_word: bool
  ) -> Outcome => {
    let has = self.menu.len() > 0
    if pressed(i, ArrowUp) || (ctrl && pressed(i, Character('r'))) {
      if has { self.choose(-1) }
      return Nothing
    }
    if pressed(i, ArrowDown) || (ctrl && pressed(i, Character('s'))) {
      if has { self.choose(1) }
      return Nothing
    }
    if pressed(i, Enter) || pressed(i, Tab) {
      self.end_search(if has { Some(self.chosen) } else { None })
      return Nothing
    }
    if pressed(i, Escape) || (ctrl && pressed(i, Character('g'))) {
      self.end_search(None)
      return Nothing
    }
    let before = self.edit.content()
    let outcome = self.edit_keys(wrap, i, mac, shift, ctrl, command, by_word)
    if self.edit.content() != before { self.search() }
    match outcome {
      Submit(_) => Nothing,
      other => other,
    }
  }

  // ↑ from the first row: the entry before the one shown, the user's own text kept.
  let older = (self: mut) -> void => {
    if self.browsing == 0 { return }
    if self.browsing == self.history.len() { self.draft = self.edit.content() }
    self.browsing -= 1
    self.edit.set_content(self.history[self.browsing])
  }

  // ↓ from the last row: the entry after, then the user's own text again.
  let newer = (self: mut) -> void => {
    if self.browsing >= self.history.len() { return }
    self.browsing += 1
    self.edit.set_content(
      if self.browsing == self.history.len() { self.draft } else { self.history[self.browsing] }
    )
  }
}

/// Whether `i` is a press of `k`.
let pressed = pure (i: LineInput, k: Key) -> bool => match i {
  LineKey(key, _) => key == k,
  LineText(_, _) => false,
}

/// A copy or cut's outcome: the text for the clipboard, or nothing when nothing was taken.
let clipped = pure (taken: Maybe<string>) -> Outcome => match taken {
  Some(text) => Clip(text),
  None => Nothing,
}

/// Where column `col` of row `row` is.
pub let cell_pos = pure (at: Place, row: i64, col: i64) -> Point => Point {
  x: at.origin.x + f32(col) * at.cell.x,
  y: at.origin.y + f32(row) * at.cell.y,
}

/// The UTF-8 encoding of code point `c`, pushed onto `bytes`.
pub let push_rune = (bytes: mut []u8, c: i64) -> void => {
  if c < 0x80 { bytes.push(u8(c)) }
  else if c < 0x800 {
    bytes.push(u8(0xC0 | (c >> 6)))
    bytes.push(u8(0x80 | (c & 0x3F)))
  } else if c < 0x10000 {
    bytes.push(u8(0xE0 | (c >> 12)))
    bytes.push(u8(0x80 | ((c >> 6) & 0x3F)))
    bytes.push(u8(0x80 | (c & 0x3F)))
  } else {
    bytes.push(u8(0xF0 | (c >> 18)))
    bytes.push(u8(0x80 | ((c >> 12) & 0x3F)))
    bytes.push(u8(0x80 | ((c >> 6) & 0x3F)))
    bytes.push(u8(0x80 | (c & 0x3F)))
  }
}

/// Whether a completion's auto-added `suffix` gives way to `next`, the character typed after
/// it: a `/` to another, and either to a blank or a character that ends a word.
let suffix_gives_way = pure (suffix: string, next: string) -> bool => {
  let ends_word = next == " " ||
    next == "\t" ||
    next == ";" ||
    next == "|" ||
    next == "&" ||
    next == ")"
  if suffix.ends_with("/") { next == "/" || ends_word } else { ends_word }
}

/// What a completion makes of its word, before its suffix: what typing is compared with.
let key_of = pure (c: Completion) -> string => "${c.prefix}${c.insert}"

/// The longest start every one of `words` shares.
let common_start = pure (words: []string) -> string => {
  if words.len() == 0 { return "" }
  var shared = words[0].to_runes()
  for w in words {
    let r = w.to_runes()
    var n = 0
    while n < shared.len() && n < r.len() && shared[n] == r[n] { n += 1 }
    shared = shared.slice(0, n)
  }
  text_of(shared)
}
