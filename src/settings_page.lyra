/// What the settings can be asked to do; the Settings tab carries it out.
pub data SettingsEvent =
  UseFamily(string)
  | ChooseFontFile
  /// The font's size or the line spacing, as the slider is dragged.
  | SetFontSize(f32)
  | SetLineSpacing(f32)
  /// A color, by its field's name (`fg`, `tab_hovered`, …), as it is picked.
  | SetColor(string, u32)
  /// ANSI color `k`, 0 to 15.
  | SetAnsi(i64, u32)
  | UseTheme(string)
  | UseSavedTheme(string)
  | NameTheme(string)
  | SaveThemeAs
  | DeleteSavedTheme
  | ToggleBoldBright
  /// Whether the window opens where it was last closed.
  | ToggleRememberWindow
  /// What is behind a see-through window blurred by, as the slider is dragged.
  | SetBlur(f32)
  /// What scrolls under a translucent command line box blurred by, likewise.
  | SetBoxBlur(f32)
  | ResetSettings
  /// A swatch's picker opened, by its color's field (`ansi 3` for an ANSI color), or closed.
  | OpenSwatch(string)
  | CloseSwatch
  /// An option that is no change: the font file's own name, or the theme as it is.
  | KeepSetting

/// The Family list: a chosen file's own name first, set off by a rule, then the families.
let family_options = pure (s: Settings, families: []FontFamily) -> []string => [
  ...(if s.font_file != "" { [file_family(s.font_file).name] } else { [] }),
  ...[f in families | f.name],
]

/// Where the list shows the font in use: the file's own name, else its family.
let family_shown = pure (s: Settings, families: []FontFamily) -> i64 => {
  if s.font_file != "" { return 0 }
  for k, f in families { if f.name == s.font_family { return k } }
  -1
}

/// The family at `k` of the list, the file's own name (first) being no change.
let family_picked = pure (s: Settings, families: []FontFamily, k: i64) -> SettingsEvent => {
  let first = if s.font_file != "" { 1 } else { 0 }
  if k < first || k - first >= families.len() { KeepSetting } else { UseFamily(families[k - first].name) }
}

/// The Theme list: Termina's themes, then the user's after a rule — and a theme that is
/// neither (`Custom`) first, set off by a rule of its own.
let theme_options = pure (s: Settings) -> []string => [
  ...(if theme_listed(s) { [] } else { [s.theme_name] }),
  ...THEME_NAMES,
  ...[t in s.themes | t.name],
]

/// Whether the theme in use is one of the list's.
let theme_listed = pure (s: Settings) -> bool =>
  THEME_NAMES.contains(s.theme_name) || is_saved(s)

/// Where the list shows the theme in use.
let theme_shown = pure (s: Settings) -> i64 => {
  let options = theme_options(s)
  for k, name in options { if name == s.theme_name { return k } }
  -1
}

/// The rules of the Theme list: after an unlisted theme, and before the user's themes.
let theme_rules = pure (s: Settings) -> []i64 => {
  let first = if theme_listed(s) { 0 } else { 1 }
  [
    ...(if first == 1 { [1] } else { [] }),
    ...(if s.themes.len() > 0 { [first + THEME_NAMES.len()] } else { [] }),
  ]
}

/// The theme at `k` of the list.
let theme_picked = pure (s: Settings, k: i64) -> SettingsEvent => {
  let first = if theme_listed(s) { 0 } else { 1 }
  let at = k - first
  if at < 0 { KeepSetting } else if at < THEME_NAMES.len() { UseTheme(THEME_NAMES[at]) } else if at - THEME_NAMES.len() < s.themes.len() {
    UseSavedTheme(s.themes[at - THEME_NAMES.len()].name)
  } else { KeepSetting }
}

/// Whether the theme in use is one the user saved.
let is_saved = pure (s: Settings) -> bool => saved_colors(s.themes, s.theme_name) != None

/// A swatch's colour as the settings keep it: `0xRRGGBB`, how transparent in the top byte.
let rgb_of_color = pure (c: Color) -> u32 =>
  ((255 - u32(c.a)) << 24) | (u32(c.r) << 16) | (u32(c.g) << 8) | u32(c.b)

/// A colour as the settings keep it — how transparent it is in the top byte — as a swatch's.
let swatch_color = pure (v: u32) -> Color => Color {
  r: u8((v >> 16) & 0xFF),
  g: u8((v >> 8) & 0xFF),
  b: u8(v & 0xFF),
  a: u8(255 - ((v >> 24) & 0xFF)),
}

/// The size, in whole points; the spacing to two places.
let points = pure (size: f32) -> string => "${i64(size.round())} pt"
let spacing_text = pure (x: f32) -> string => {
  let hundredths = i64((x * 100.0).round())
  "${hundredths / 100}.${if hundredths % 100 < 10 { "0" } else { "" }}${hundredths % 100}"
}

/// The colors the settings edit, by label and field (`settings.color_named`), in their
/// groups: the grid's own, the sections', the tabs', the command line's.
struct ColorGroup {
  heading: string,
  colors: [](string, string),
}

const COLOR_GROUPS = [
  ColorGroup { heading: "Terminal", colors: [("Text", "fg"), ("Background", "bg"), ("Cursor", "cursor"), ("Selection", "selection")] },
  ColorGroup { heading: "Sections", colors: [("Input", "input"), ("Output", "output"), ("Input text", "input_text")] },
  ColorGroup { heading: "Tabs", colors: [("Tab", "tab"), ("Under the pointer", "tab_hovered"), ("Shown", "tab_selected")] },
  ColorGroup { heading: "Command line", colors: [("Text", "editor_text"), ("Completion menu", "menu"), ("Chosen completion", "menu_chosen")] },
]

