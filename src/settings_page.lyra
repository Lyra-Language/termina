/// From settings_page.lui, line 345.
pub let color_field = pure (s: Settings, label: string, field: string, open: string) -> Node<SettingsEvent> =>
  component_of("color_field", color_field_sheet, [
    row([ // settings_page.lui:351
      swatch(swatch_color(color_named(s.colors, field)), open == field, OpenSwatch(field), (c: Color) -> SettingsEvent => SetColor(field, rgb_of_color(c)), CloseSwatch, !(!may_be_clear(field)), [ // settings_page.lui:352
        ...(if may_be_clear(field) { // settings_page.lui:361
          [
            row([ // settings_page.lui:362
              text("Blur"), // settings_page.lui:363
              expanded(slider(SliderSpec { value: blur_named(s, field), min: BLUR_RANGE.0, max: BLUR_RANGE.1, step: 1.0, on_change: (v: f32) -> SettingsEvent => SetBlur(field, v) })), // settings_page.lui:364
              text("${points(blur_named(s, field))}"), // settings_page.lui:367
            ]).with_class("blur").keyed("blur"),
          ]
        } else {
          []
        }),
        ...(if field == "tab_rule" { // settings_page.lui:371
          [
            row([ // settings_page.lui:372
              text("Thickness"), // settings_page.lui:373
              expanded(slider(SliderSpec { value: s.tab_rule_width, min: RULE_WIDTH_RANGE.0, max: RULE_WIDTH_RANGE.1, step: 1.0, on_change: (value: f32) -> SettingsEvent => SetTabRuleWidth(value) })), // settings_page.lui:374
              text("${points(s.tab_rule_width)}"), // settings_page.lui:377
            ]).with_class("blur").keyed("thickness"),
          ]
        } else {
          []
        }),
      ]),
      text("${label}"), // settings_page.lui:381
    ]).with_class("swatch-row").keyed(field),
  ])

/// From settings_page.lui, line 386.
pub let ansi_field = pure (s: Settings, k: i64, open: string) -> Node<SettingsEvent> =>
  component("ansi_field", Sheet {}, [
    swatch(swatch_color(s.colors.ansi[k]), open == "ansi ${k}", OpenSwatch("ansi ${k}"), (c: Color) -> SettingsEvent => SetAnsi(k, rgb_of_color(c)), CloseSwatch, false), // settings_page.lui:387
  ])

