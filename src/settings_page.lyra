    Rule { selector: ".section", style: Style { gap: Some(12.0) } }, // settings_page.lui:218
    Rule { selector: "Text.heading", style: Style { font_size: Some(15.0), color: Some(t.colors.muted) } }, // settings_page.lui:219
    Rule { selector: ".form", style: Style { grid_columns: Some([auto_track(), fr(1.0)]), column_gap: Some(16.0), row_gap: Some(12.0), align_items: Some(AlignCenter) } }, // settings_page.lui:220
    Rule { selector: ".field", style: Style { gap: Some(8.0) } }, // settings_page.lui:221
    Rule { selector: "Slider", style: Style { width: Some(240.0) } }, // settings_page.lui:222
    Rule { selector: "TextInput", style: Style { width: Some(220.0) } }, // settings_page.lui:223
    Rule { selector: ".groups", style: Style { gap: Some(32.0), row_gap: Some(20.0) } }, // settings_page.lui:224
    Rule { selector: ".group", style: Style { gap: Some(10.0) } }, // settings_page.lui:225
    Rule { selector: ".swatch-row", style: Style { gap: Some(8.0) } }, // settings_page.lui:226
    Rule { selector: ".ansi", style: Style { gap: Some(6.0) } }, // settings_page.lui:227
    Rule { selector: "Text.note", style: Style { color: Some(t.colors.muted), font_size: Some(12.0) } }, // settings_page.lui:228
    Rule { selector: ".fill-rule", style: Style { background: Some(t.colors.border) } }, // settings_page.lui:229
  ],
}

