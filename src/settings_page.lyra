/// From settings_page.lui, line 348.
pub let color_field = pure (s: ref Settings, label: string, field: string, open: string) -> Node<SettingsEvent> =>
  component_of("color_field", color_field_sheet, [
    row([ // settings_page.lui:354
      swatch(swatch_color(color_named(s.colors, field)), open == field, OpenSwatch(field), (c: Color) -> SettingsEvent => SetColor(field, rgb_of_color(c)), CloseSwatch, !(!may_be_clear(field)), [ // settings_page.lui:355
        ...(if may_be_clear(field) { // settings_page.lui:364
          [
            row([ // settings_page.lui:365
              text("Blur"), // settings_page.lui:366
              expanded(slider(SliderSpec { value: blur_named(s, field), min: BLUR_RANGE.0, max: BLUR_RANGE.1, step: 1.0, on_change: (v: f32) -> SettingsEvent => SetBlur(field, v) })), // settings_page.lui:367
              text("${points(blur_named(s, field))}"), // settings_page.lui:370
            ]).with_class("blur").keyed("blur"),
          ]
        } else {
          []
        }),
        ...(if field == "tab_rule" { // settings_page.lui:374
          [
            row([ // settings_page.lui:375
              text("Thickness"), // settings_page.lui:376
              expanded(slider(SliderSpec { value: s.tab_rule_width, min: RULE_WIDTH_RANGE.0, max: RULE_WIDTH_RANGE.1, step: 1.0, on_change: SetTabRuleWidth })), // settings_page.lui:377
              text("${points(s.tab_rule_width)}"), // settings_page.lui:380
            ]).with_class("blur").keyed("thickness"),
          ]
        } else {
          []
        }),
      ]),
      text("${label}"), // settings_page.lui:384
    ]).with_class("swatch-row").keyed(field),
  ])

