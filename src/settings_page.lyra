        ]).with_class("stop").keyed("stop ${k}")],
      ...(if g.stops.len() < GRADIENT_STOPS.1 { // settings_page.lui:459
        [
          row([ // settings_page.lui:460
            button("Add Stop", AddStop(field)), // settings_page.lui:461
          ]),
        ]
