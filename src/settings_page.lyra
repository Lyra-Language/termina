            text("Angle"), // settings_page.lui:435
            slider(SliderSpec { value: g.angle, min: 0.0, max: 360.0, step: 1.0, on_change: (v: f32) -> SettingsEvent => SetGradientAngle(field, v) }), // settings_page.lui:436
            text("${degrees(g.angle)}"), // settings_page.lui:437
          ]
        } else {
          []
        }),
      ]).with_class("stop"),
      ...[k in 0..<g.stops.len() | row([ // settings_page.lui:440
          swatch(swatch_color(g.stops[k].color), open == stop_key(field, k), OpenSwatch(stop_key(field, k)), (c: Color) -> SettingsEvent => SetStopColor(field, k, rgb_of_color(c)), CloseSwatch), // settings_page.lui:442
          slider(SliderSpec { value: g.stops[k].at, min: 0.0, max: 1.0, step: 0.01, on_change: (v: f32) -> SettingsEvent => SetStopAt(field, k, v) }), // settings_page.lui:449
          text("${percent(g.stops[k].at)}"), // settings_page.lui:450
          ...(if g.stops.len() > GRADIENT_STOPS.0 { // settings_page.lui:451
            [
              button("Remove", RemoveStop(field, k)), // settings_page.lui:452
            ]
          } else {
            []
          }),
        ]).with_class("stop").keyed("stop ${k}")],
      ...(if g.stops.len() < GRADIENT_STOPS.1 { // settings_page.lui:456
        [
          row([ // settings_page.lui:457
            button("Add Stop", AddStop(field)), // settings_page.lui:458
          ]),
        ]
      } else {
        []
      }),
    ]).with_class("gradient"),
  ])

let settings_page_sheet = pure (t: Theme) -> Sheet => Sheet { // settings_page.lui:213
  rules: [
    Rule { selector: ".page", style: Style { padding: Some(insets(10.0)) } }, // settings_page.lui:214
    Rule { selector: ".panel", style: Style { gap: Some(22.0), padding: Some(insets(24.0)), overflow_y: Some(OverflowAuto) } }, // settings_page.lui:215
    Rule { selector: ".section", style: Style { gap: Some(12.0) } }, // settings_page.lui:216
    Rule { selector: "Text.heading", style: Style { font_size: Some(15.0), color: Some(t.colors.muted) } }, // settings_page.lui:217
    Rule { selector: ".form", style: Style { grid_columns: Some([auto_track(), fr(1.0)]), column_gap: Some(16.0), row_gap: Some(12.0), align_items: Some(AlignCenter) } }, // settings_page.lui:218
    Rule { selector: ".field", style: Style { gap: Some(8.0) } }, // settings_page.lui:219
    Rule { selector: "Slider", style: Style { width: Some(240.0) } }, // settings_page.lui:220
    Rule { selector: "TextInput", style: Style { width: Some(220.0) } }, // settings_page.lui:221
    Rule { selector: ".groups", style: Style { gap: Some(32.0), row_gap: Some(20.0) } }, // settings_page.lui:222
    Rule { selector: ".group", style: Style { gap: Some(10.0) } }, // settings_page.lui:223
    Rule { selector: ".swatch-row", style: Style { gap: Some(8.0) } }, // settings_page.lui:224
    Rule { selector: ".ansi", style: Style { gap: Some(6.0) } }, // settings_page.lui:225
    Rule { selector: "Text.note", style: Style { color: Some(t.colors.muted), font_size: Some(12.0) } }, // settings_page.lui:226
    Rule { selector: ".fill-rule", style: Style { background: Some(t.colors.border) } }, // settings_page.lui:227
  ],
}

