/// From settings_page.lui, line 274.
pub let color_field = pure (s: Settings, label: string, field: string, open: string) -> Node<SettingsEvent> =>
  component("color_field", Sheet {}, [
    row([ // settings_page.lui:275
      swatch(swatch_color(color_named(s.colors, field)), open == field, OpenSwatch(field), (c: Color) -> SettingsEvent => SetColor(field, rgb_of_color(c)), CloseSwatch, !(!may_be_clear(field))), // settings_page.lui:276
      text("${label}"), // settings_page.lui:284
    ]).with_class("swatch-row").keyed(field),
  ])

/// From settings_page.lui, line 289.
pub let ansi_field = pure (s: Settings, k: i64, open: string) -> Node<SettingsEvent> =>
  component("ansi_field", Sheet {}, [
    swatch(swatch_color(s.colors.ansi[k]), open == "ansi ${k}", OpenSwatch("ansi ${k}"), (c: Color) -> SettingsEvent => SetAnsi(k, rgb_of_color(c)), CloseSwatch, false).keyed("ansi ${k}"), // settings_page.lui:290
  ])

