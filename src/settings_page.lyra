/// What the settings can be asked to do; the Settings tab carries it out.
pub data SettingsEvent =
  /// A background's fill, by its color's field: its kind (0 the color, 1 a gradient, 2 an
  /// image); a gradient's shape (0 linear, 1 radial, 2 a circle), angle, and a stop's color,
  /// place, removal or one added; an image file asked for, and how it fits (0 tiled, 1
  /// stretched, 2 stretched and cropped).
  SetFill(string, i64)
  | SetGradientShape(string, i64)
  | SetGradientAngle(string, f32)
  | SetStopColor(string, i64, u32)
  | SetStopAt(string, i64, f32)
  | AddStop(string)
  | RemoveStop(string, i64)
  | ChooseFillImage(string)
  | SetImageFit(string, i64)
  | UseFamily(string)
  | ChooseFontFile
  /// The font's size or the line spacing, as the slider is dragged.
  | SetFontSize(f32)
  | SetLineSpacing(f32)
  /// A color, by its field's name (`fg`, `tab_hovered`, …), as it is picked.
  | SetColor(string, u32)
  /// ANSI color `k`, 0 to 15.
  | SetAnsi(i64, u32)
  | UseTheme(string)
  | UseSavedTheme(string)
  | NameTheme(string)
  | SaveThemeAs
  /// The colors over the saved theme they were changed from (`Settings.edited_from`).
  | SaveTheme
  | DeleteSavedTheme
  | ToggleBoldBright
  /// Whether the window opens where it was last closed.
  | ToggleRememberWindow
  /// What is behind a background — the window's (`bg`), the input's, the output's — blurred
  /// by, by its color's field, as its picker's slider is dragged.
  | SetBlur(string, f32)
  /// How thick the rule under the tab bar is, as its picker's slider is dragged.
  | SetTabRuleWidth(f32)
  | ResetSettings
  /// A swatch's picker opened, by its color's field (`ansi 3` for an ANSI color), or closed.
  | OpenSwatch(string)
  | CloseSwatch
  /// An option that is no change: the font file's own name, or the theme as it is.
  | KeepSetting

/// The Family list: a chosen file's own name first, set off by a rule, then the families.
let family_options = pure (s: Settings, families: []FontFamily) -> []string => [
  ...(if s.font_file != "" { [file_family(s.font_file).name] } else { [] }),
  ...[f in families | f.name],
]

/// Each option's font: a family in itself, the chosen file's name in the select's own.
let family_fonts = pure (s: Settings, families: []FontFamily) -> []string => [
  ...(if s.font_file != "" { [""] } else { [] }),
  ...[f in families | preview_name(f)],
]

/// Where the list shows the font in use: the file's own name, else its family.
let family_shown = pure (s: Settings, families: []FontFamily) -> i64 => {
  if s.font_file != "" { return 0 }
  for k, f in families { if f.name == s.font_family { return k } }
  -1
}

/// The family at `k` of the list, the file's own name (first) being no change.
let family_picked = pure (s: Settings, families: []FontFamily, k: i64) -> SettingsEvent => {
  let first = if s.font_file != "" { 1 } else { 0 }
  if k < first || k - first >= families.len() { KeepSetting } else { UseFamily(families[k - first].name) }
}

/// The Theme list: Termina's themes, then the user's after a rule — the one being edited
/// marked `*` until Save ([edited_name]) — and a theme that is neither (`Custom`) first, set
/// off by a rule of its own.
let theme_options = pure (s: Settings) -> []string => [
  ...(if theme_listed(s) { [] } else { [s.theme_name] }),
  ...THEME_NAMES,
  ...[t in s.themes | if t.name == edited_name(s) { "${t.name}*" } else { t.name }],
]

/// The saved theme whose colors are being edited, which Save overwrites; `""` for none.
let edited_name = pure (s: Settings) -> string => if can_save(s) { s.edited_from } else { "" }

/// Whether the theme in use is one of the list's — a saved one being edited among them.
let theme_listed = pure (s: Settings) -> bool =>
  THEME_NAMES.contains(s.theme_name) || is_saved(s) || edited_name(s) != ""

/// Where the list shows the theme in use: a saved one being edited at its own place, marked.
let theme_shown = pure (s: Settings) -> i64 => {
  let shown = if edited_name(s) != "" { "${edited_name(s)}*" } else { s.theme_name }
  for k, name in theme_options(s) { if name == shown { return k } }
  -1
}

/// The rules of the Theme list: after an unlisted theme, and before the user's themes.
let theme_rules = pure (s: Settings) -> []i64 => {
  let first = if theme_listed(s) { 0 } else { 1 }
  [
    ...(if first == 1 { [1] } else { [] }),
    ...(if s.themes.len() > 0 { [first + THEME_NAMES.len()] } else { [] }),
  ]
}

/// The theme at `k` of the list.
let theme_picked = pure (s: Settings, k: i64) -> SettingsEvent => {
  let first = if theme_listed(s) { 0 } else { 1 }
  let at = k - first
  if at < 0 { KeepSetting } else if at < THEME_NAMES.len() { UseTheme(THEME_NAMES[at]) } else if at - THEME_NAMES.len() < s.themes.len() {
    UseSavedTheme(s.themes[at - THEME_NAMES.len()].name)
  } else { KeepSetting }
}

/// Whether the theme in use is one the user saved.
let is_saved = pure (s: Settings) -> bool => saved_colors(s.themes, s.theme_name) != None

/// A swatch's colour as the settings keep it: `0xRRGGBB`, how transparent in the top byte.
let rgb_of_color = pure (c: Color) -> u32 =>
  ((255 - u32(c.a)) << 24) | (u32(c.r) << 16) | (u32(c.g) << 8) | u32(c.b)

/// A colour as the settings keep it — how transparent it is in the top byte — as a swatch's.
let swatch_color = pure (v: u32) -> Color => Color {
  r: u8((v >> 16) & 0xFF),
  g: u8((v >> 8) & 0xFF),
  b: u8(v & 0xFF),
  a: u8(255 - ((v >> 24) & 0xFF)),
}

/// The size, in whole points; the spacing to two places.
let points = pure (size: f32) -> string => "${i64(size.round())} pt"

/// The fills' kinds, a gradient's shapes and an image's fits, as their lists show them.
const FILL_KINDS: []string = ["Color", "Gradient", "Image"]
const GRADIENT_SHAPES: []string = ["Linear", "Radial", "Circle"]
const IMAGE_FITS: []string = ["Tile", "Stretch", "Stretch and crop"]

/// Where an image's fit is in [IMAGE_FITS].
let fit_index = pure (i: BackingImage) -> i64 => match fit_name(i.fit) {
  "tile" => 0,
  "stretch" => 1,
  _ => 2,
}

/// An image's file name, or that none is chosen yet.
let image_label = pure (i: BackingImage) -> string =>
  if i.path == "" { "No image chosen" } else { i.path.base() }

/// The swatch key of a gradient's stop `k`, for the background `field` names.
let stop_key = pure (field: string, k: i64) -> string => "stop ${field} ${k}"

/// An angle in whole degrees, and a place along a gradient in whole percent.
let degrees = pure (a: f32) -> string => "${i64(a.round())}°"
let percent = pure (x: f32) -> string => "${i64((x * 100.0).round())}%"
let spacing_text = pure (x: f32) -> string => {
  let hundredths = i64((x * 100.0).round())
  "${hundredths / 100}.${if hundredths % 100 < 10 { "0" } else { "" }}${hundredths % 100}"
}

/// The colors the settings edit, by label and field (`settings.color_named`), in their
/// groups: the grid's own, the sections', the tabs', the command line's.
struct ColorGroup {
  heading: string,
  colors: [](string, string),
}

const COLOR_GROUPS = [
  ColorGroup { heading: "Terminal", colors: [("Text", "fg"), ("Background", "bg"), ("Cursor", "cursor"), ("Selection", "selection")] },
  ColorGroup { heading: "Sections", colors: [("Input", "input"), ("Output", "output"), ("Input text", "input_text")] },
  ColorGroup { heading: "Tabs", colors: [("Tab", "tab"), ("Under the pointer", "tab_hovered"), ("Shown", "tab_selected"), ("Underline", "tab_rule")] },
  ColorGroup { heading: "Command line", colors: [("Text", "editor_text"), ("Completion menu", "menu"), ("Chosen completion", "menu_chosen")] },
]

