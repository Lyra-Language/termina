          swatch(swatch_color(g.stops[k].color), open == stop_key(field, k), OpenSwatch(stop_key(field, k)), (c: Color) -> SettingsEvent => SetStopColor(field, k, rgb_of_color(c)), CloseSwatch), // settings_page.lui:445
          slider(SliderSpec { value: g.stops[k].at, min: 0.0, max: 1.0, step: 0.01, on_change: (v: f32) -> SettingsEvent => SetStopAt(field, k, v) }), // settings_page.lui:452
          text("${percent(g.stops[k].at)}"), // settings_page.lui:453
          ...(if g.stops.len() > GRADIENT_STOPS.0 { // settings_page.lui:454
