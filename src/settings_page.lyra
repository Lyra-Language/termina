pub let ansi_field = pure (s: ref Settings, k: i64, open: string) -> Node<SettingsEvent> =>
  component("ansi_field", Sheet {}, [
    swatch(swatch_color(s.colors.ansi[k]), open == "ansi ${k}", OpenSwatch("ansi ${k}"), (c: Color) -> SettingsEvent => SetAnsi(k, rgb_of_color(c)), CloseSwatch, false), // settings_page.lui:390
  ])

