<!--
  Termina's menus, as markup: `../lyra/build/lui src/menus_view.lui` writes menus_view.lyra
  beside it. One tree, shown two ways (`menus/menus.lyra`): installed in the Mac's own menu
  bar, or drawn along the window's top as ImGui's main menu bar elsewhere.
-->

<script>
  import bindings.imgui.ui.{ Shortcut }
  import ui.{
    TabLabel,
    TabCommand,
    NewTab,
    CloseTab,
    ShowTab,
    OpenSettings,
    FontBigger,
    FontSmaller,
    FontDefault,
    EditAction,
    Undo,
    Redo,
    Cut,
    Copy,
    Paste,
    SelectAll,
  }

  /// What a menu item does. The Mac's bar sends the item it was installed with, so an item's
  /// choice is the same whichever tab is shown: Show Previous Tab, not the tab it was.
  pub data MenuChoice =
    /// New Tab, Close Tab, a tab of the Window menu, Settings…, the font's size.
    Tabs(TabCommand)
    | PreviousTab
    | NextTab
    /// Edit's items, on the tab shown.
    | Edit(EditAction)
    /// Quit, Minimize, Maximize: the window's, where Termina draws the bar.
    | QuitApp
    | MinimizeWindow
    | ToggleMaximized

  /// Edit's items in the menu's order: what `can` lists to leave one enabled.
  pub const EDIT_ACTIONS: []EditAction = [Undo, Redo, Cut, Copy, Paste, SelectAll]

  /// A key with the primary modifier — ⌘ on a Mac, Ctrl elsewhere — and Shift if `shift`.
  let key = pure (k: string, shift: bool) -> Maybe<Shortcut> => Some(Shortcut { key: k, shift: shift })

  /// The terminal's own key: ⌘ and `k` on a Mac, Ctrl+Shift and it elsewhere — Ctrl alone is
  /// the shell's, so GNOME Terminal and Konsole add Shift.
  let own = pure (mac: bool, k: string) -> Maybe<Shortcut> => key(k, !mac)

  /// Window ▸ the tab at `k`: Alt and its number, the first nine.
  let tab_key = pure (k: i64) -> Maybe<Shortcut> =>
    if k < 9 { Some(Shortcut { key: "${k + 1}", alt: true, primary: false }) } else { None }
</script>

<!-- The menus, for the tabs `tabs` with `active` shown, Edit's actions that would do
     something `can`, on a Mac or not (its keys, and whether Termina draws Quit and the
     Window menu — the Mac's own being macOS's), the window maximized or not. -->
<component name="menus_view" props="tabs: []TabLabel, active: i64, can: []EditAction, mac: bool, maximized: bool" event="MenuChoice">
  <MainMenuBar>
    <Menu label="Termina">
      <MenuItem shortcut={key(",", false)} on_select={Tabs(OpenSettings)}>Settings…</MenuItem>
      <if test={!mac}>
        <Separator/>
        <MenuItem on_select={QuitApp}>Quit</MenuItem>
      </if>
    </Menu>
    <Menu label="Shell">
      <MenuItem shortcut={own(mac, "t")} on_select={Tabs(NewTab)}>New Tab</MenuItem>
      <Separator/>
      <!-- ⌘⇧[ and ⌘⇧] as AppKit spells them, the shifted characters, as Terminal has it;
           Ctrl+PgUp and Ctrl+PgDn elsewhere. -->
      <MenuItem shortcut={if mac { key("{", false) } else { key("PgUp", false) }} enabled={tabs.len() > 1} on_select={PreviousTab}>Show Previous Tab</MenuItem>
      <MenuItem shortcut={if mac { key("}", false) } else { key("PgDn", false) }} enabled={tabs.len() > 1} on_select={NextTab}>Show Next Tab</MenuItem>
      <Separator/>
      <MenuItem shortcut={own(mac, "w")} on_select={Tabs(CloseTab)}>Close Tab</MenuItem>
    </Menu>
    <Menu label="Edit">
      <!-- Undo is Ctrl+Z at the command line, Redo Ctrl+Shift+Z: the editor's keys. -->
      <MenuItem shortcut={key("z", false)} enabled={can.contains(Undo)} on_select={Edit(Undo)}>Undo</MenuItem>
      <MenuItem shortcut={key("z", true)} enabled={can.contains(Redo)} on_select={Edit(Redo)}>Redo</MenuItem>
      <Separator/>
      <MenuItem shortcut={own(mac, "x")} enabled={can.contains(Cut)} on_select={Edit(Cut)}>Cut</MenuItem>
      <MenuItem shortcut={own(mac, "c")} enabled={can.contains(Copy)} on_select={Edit(Copy)}>Copy</MenuItem>
      <MenuItem shortcut={own(mac, "v")} enabled={can.contains(Paste)} on_select={Edit(Paste)}>Paste</MenuItem>
      <MenuItem shortcut={own(mac, "a")} enabled={can.contains(SelectAll)} on_select={Edit(SelectAll)}>Select All</MenuItem>
    </Menu>
    <Menu label="View">
      <!-- The font's size; Ctrl+- alone is readline's undo. -->
      <MenuItem shortcut={own(mac, "0")} on_select={Tabs(FontDefault)}>Default Font Size</MenuItem>
      <MenuItem shortcut={own(mac, "=")} on_select={Tabs(FontBigger)}>Bigger</MenuItem>
      <MenuItem shortcut={own(mac, "-")} on_select={Tabs(FontSmaller)}>Smaller</MenuItem>
    </Menu>
    <if test={!mac}>
      <Menu label="Window">
        <MenuItem on_select={MinimizeWindow}>Minimize</MenuItem>
        <MenuItem id="Maximize" on_select={ToggleMaximized}>{if maximized { "Restore" } else { "Maximize" }}</MenuItem>
        <Separator/>
        <!-- The tabs, the shown one checked, as the Mac's Window menu lists windows. -->
        <for each={k in 0..<tabs.len()}>
          <MenuItem id={tabs[k].name} shortcut={tab_key(k)} checked={k == active} on_select={Tabs(ShowTab(k))}>{tabs[k].name}###menutab{tabs[k].id}</MenuItem>
        </for>
      </Menu>
    </if>
  </MainMenuBar>
</component>
