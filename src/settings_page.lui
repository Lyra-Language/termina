<!--
  Termina's settings on lyra's `ui`, as markup: `../lyra/build/lui src/settings_page.lui`
  writes settings_page.lyra beside it. The Settings tab draws it (`face/app.lyra`) and carries
  out its events (`face/settings.lyra`).
-->

<script target="ui">
  import ui.draw.{ Color }
  import std.path
  import settings.{
    Settings,
    FontFamily,
    file_family,
    preview_name,
    can_save_as,
    can_save,
    saved_colors,
    color_named,
    blur_named,
    BackingGradient,
    BackingImage,
    backing_named,
    backing_kind,
    gradient_named,
    image_named,
    gradient_between,
    gradient_shape,
    fit_name,
    GRADIENT_STOPS,
    may_be_clear,
    THEME_NAMES,
    FONT_SIZE_RANGE,
    LINE_SPACING_RANGE,
    BLUR_RANGE,
    RULE_WIDTH_RANGE,
  }

  /// What the settings can be asked to do; the Settings tab carries it out.
  pub data SettingsEvent =
    /// A background's fill, by its color's field: its kind (0 the color, 1 a gradient, 2 an
    /// image); a gradient's shape (0 linear, 1 radial, 2 a circle), angle, and a stop's color,
    /// place, removal or one added; an image file asked for, and how it fits (0 tiled, 1
    /// stretched, 2 stretched and cropped).
    SetFill(string, i64)
    | SetGradientShape(string, i64)
    | SetGradientAngle(string, f32)
    | SetStopColor(string, i64, u32)
    | SetStopAt(string, i64, f32)
    | AddStop(string)
    | RemoveStop(string, i64)
    | ChooseFillImage(string)
    | SetImageFit(string, i64)
    | UseFamily(string)
    | ChooseFontFile
    /// The font's size or the line spacing, as the slider is dragged.
    | SetFontSize(f32)
    | SetLineSpacing(f32)
    /// A color, by its field's name (`fg`, `tab_hovered`, …), as it is picked.
    | SetColor(string, u32)
    /// ANSI color `k`, 0 to 15.
    | SetAnsi(i64, u32)
    | UseTheme(string)
    | UseSavedTheme(string)
    | NameTheme(string)
    | SaveThemeAs
    /// The colors over the saved theme they were changed from (`Settings.edited_from`).
    | SaveTheme
    | DeleteSavedTheme
    | ToggleBoldBright
    /// Whether the window opens where it was last closed.
    | ToggleRememberWindow
    /// What is behind a background — the window's (`bg`), the input's, the output's — blurred
    /// by, by its color's field, as its picker's slider is dragged.
    | SetBlur(string, f32)
    /// How thick the rule under the tab bar is, as its picker's slider is dragged.
    | SetTabRuleWidth(f32)
    | ResetSettings
    /// A swatch's picker opened, by its color's field (`ansi 3` for an ANSI color), or closed.
    | OpenSwatch(string)
    | CloseSwatch
    /// An option that is no change: the font file's own name, or the theme as it is.
    | KeepSetting

  /// The Family list: a chosen file's own name first, set off by a rule, then the families.
  let family_options = pure (s: Settings, families: []FontFamily) -> []string => [
    ...(if s.font_file != "" { [file_family(s.font_file).name] } else { [] }),
    ...[f in families | f.name],
  ]

  /// Each option's font: a family in itself, the chosen file's name in the select's own.
  let family_fonts = pure (s: Settings, families: []FontFamily) -> []string => [
    ...(if s.font_file != "" { [""] } else { [] }),
    ...[f in families | preview_name(f)],
  ]

  /// Where the list shows the font in use: the file's own name, else its family.
  let family_shown = pure (s: Settings, families: []FontFamily) -> i64 => {
    if s.font_file != "" { return 0 }
    for k, f in families { if f.name == s.font_family { return k } }
    -1
  }

  /// The family at `k` of the list, the file's own name (first) being no change.
  let family_picked = pure (s: Settings, families: []FontFamily, k: i64) -> SettingsEvent => {
    let first = if s.font_file != "" { 1 } else { 0 }
    if k < first || k - first >= families.len() { KeepSetting } else { UseFamily(families[k - first].name) }
  }

  /// The Theme list: Termina's themes, then the user's after a rule — and a theme that is
  /// neither (`Custom`) first, set off by a rule of its own.
  let theme_options = pure (s: Settings) -> []string => [
    ...(if theme_listed(s) { [] } else { [s.theme_name] }),
    ...THEME_NAMES,
    ...[t in s.themes | t.name],
  ]

  /// Whether the theme in use is one of the list's.
  let theme_listed = pure (s: Settings) -> bool =>
    THEME_NAMES.contains(s.theme_name) || is_saved(s)

  /// Where the list shows the theme in use.
  let theme_shown = pure (s: Settings) -> i64 => {
    let options = theme_options(s)
    for k, name in options { if name == s.theme_name { return k } }
    -1
  }

  /// The rules of the Theme list: after an unlisted theme, and before the user's themes.
  let theme_rules = pure (s: Settings) -> []i64 => {
    let first = if theme_listed(s) { 0 } else { 1 }
    [
      ...(if first == 1 { [1] } else { [] }),
      ...(if s.themes.len() > 0 { [first + THEME_NAMES.len()] } else { [] }),
    ]
  }

  /// The theme at `k` of the list.
  let theme_picked = pure (s: Settings, k: i64) -> SettingsEvent => {
    let first = if theme_listed(s) { 0 } else { 1 }
    let at = k - first
    if at < 0 { KeepSetting } else if at < THEME_NAMES.len() { UseTheme(THEME_NAMES[at]) } else if at - THEME_NAMES.len() < s.themes.len() {
      UseSavedTheme(s.themes[at - THEME_NAMES.len()].name)
    } else { KeepSetting }
  }

  /// Whether the theme in use is one the user saved.
  let is_saved = pure (s: Settings) -> bool => saved_colors(s.themes, s.theme_name) != None

  /// A swatch's colour as the settings keep it: `0xRRGGBB`, how transparent in the top byte.
  let rgb_of_color = pure (c: Color) -> u32 =>
    ((255 - u32(c.a)) << 24) | (u32(c.r) << 16) | (u32(c.g) << 8) | u32(c.b)

  /// A colour as the settings keep it — how transparent it is in the top byte — as a swatch's.
  let swatch_color = pure (v: u32) -> Color => Color {
    r: u8((v >> 16) & 0xFF),
    g: u8((v >> 8) & 0xFF),
    b: u8(v & 0xFF),
    a: u8(255 - ((v >> 24) & 0xFF)),
  }

  /// The size, in whole points; the spacing to two places.
  let points = pure (size: f32) -> string => "${i64(size.round())} pt"

  /// The fills' kinds, a gradient's shapes and an image's fits, as their lists show them.
  const FILL_KINDS: []string = ["Color", "Gradient", "Image"]
  const GRADIENT_SHAPES: []string = ["Linear", "Radial", "Circle"]
  const IMAGE_FITS: []string = ["Tile", "Stretch", "Stretch and crop"]

  /// Where an image's fit is in [IMAGE_FITS].
  let fit_index = pure (i: BackingImage) -> i64 => match fit_name(i.fit) {
    "tile" => 0,
    "stretch" => 1,
    _ => 2,
  }

  /// An image's file name, or that none is chosen yet.
  let image_label = pure (i: BackingImage) -> string =>
    if i.path == "" { "No image chosen" } else { i.path.base() }

  /// The swatch key of a gradient's stop `k`, for the background `field` names.
  let stop_key = pure (field: string, k: i64) -> string => "stop ${field} ${k}"

  /// An angle in whole degrees, and a place along a gradient in whole percent.
  let degrees = pure (a: f32) -> string => "${i64(a.round())}°"
  let percent = pure (x: f32) -> string => "${i64((x * 100.0).round())}%"
  let spacing_text = pure (x: f32) -> string => {
    let hundredths = i64((x * 100.0).round())
    "${hundredths / 100}.${if hundredths % 100 < 10 { "0" } else { "" }}${hundredths % 100}"
  }

  /// The colors the settings edit, by label and field (`settings.color_named`), in their
  /// groups: the grid's own, the sections', the tabs', the command line's.
  struct ColorGroup {
    heading: string,
    colors: [](string, string),
  }

  const COLOR_GROUPS = [
    ColorGroup { heading: "Terminal", colors: [("Text", "fg"), ("Background", "bg"), ("Cursor", "cursor"), ("Selection", "selection")] },
    ColorGroup { heading: "Sections", colors: [("Input", "input"), ("Output", "output"), ("Input text", "input_text")] },
    ColorGroup { heading: "Tabs", colors: [("Tab", "tab"), ("Under the pointer", "tab_hovered"), ("Shown", "tab_selected"), ("Underline", "tab_rule")] },
    ColorGroup { heading: "Command line", colors: [("Text", "editor_text"), ("Completion menu", "menu"), ("Chosen completion", "menu_chosen")] },
  ]
</script>

<!-- The whole of the Settings tab, for the settings as they are, the families on offer, the
     name typed to save a theme as, and the swatch whose picker is open (`""` for none). -->
<component name="settings_page" props={{ s: Settings, families: []FontFamily, typed: string, open: string }} event={SettingsEvent}>
  <style>
    .page { padding: 10 }
    .panel { gap: 22; padding: 24; overflow-y: auto }
    .section { gap: 12 }
    Text.heading { font-size: 15; color: $colors.muted }
    .form { grid-template-columns: auto 1fr; column-gap: 16; row-gap: 12; align-items: center }
    .field { gap: 8 }
    Slider { width: 240 }
    TextInput { width: 220 }
    .groups { gap: 32; row-gap: 20 }
    .group { gap: 10 }
    .swatch-row { gap: 8 }
    .ansi { gap: 6 }
    Text.note { color: $colors.muted; font-size: 12 }
  </style>

  <!-- The controls on a panel of the Output section's colour, the window's background a band
       round it: a background clear enough to see the desktop through is hard to read on. -->
  <Column class="page" cross="stretch">
    <Expanded>
      <Column class="panel" cross="stretch">
        <Column class="section">
          <Text class="heading">Font</Text>
          <Grid class="form">
            <Text>Family</Text>
            <Row class="field">
              <Select
                options={family_options(s, families)}
                option_families={family_fonts(s, families)}
                selected={family_shown(s, families)}
                separators={if s.font_file != "" { [1] } else { [] }}
                on_change={(k: i64) -> SettingsEvent => family_picked(s, families, k)}
              />
              <Button on_click={ChooseFontFile} key="other font">Other Font File…</Button>
            </Row>
            <Text>Size</Text>
            <Row class="field">
              <Slider value={s.font_size} min={FONT_SIZE_RANGE.0} max={FONT_SIZE_RANGE.1} step="1" on_change={SetFontSize} key="size"/>
              <Text>{points(s.font_size)}</Text>
            </Row>
            <Text>Line spacing</Text>
            <Row class="field">
              <Slider value={s.line_spacing} min={LINE_SPACING_RANGE.0} max={LINE_SPACING_RANGE.1} step="0.05" on_change={SetLineSpacing} key="spacing"/>
              <Text>{spacing_text(s.line_spacing)}</Text>
            </Row>
          </Grid>
        </Column>

        <Column class="section">
          <Text class="heading">Colors</Text>
          <Grid class="form">
            <Text>Theme</Text>
            <Row class="field">
              <Select
                options={theme_options(s)}
                selected={theme_shown(s)}
                separators={theme_rules(s)}
                on_change={(k: i64) -> SettingsEvent => theme_picked(s, k)}
              />
            </Row>
            <Text>Theme name</Text>
            <Row class="field">
              <TextInput value={typed} placeholder="Theme name" on_edit={NameTheme} key="theme name"/>
              <!-- A saved theme being edited: overwritten as it is now. -->
              <if test={can_save(s)}>
                <Button on_click={SaveTheme} key="save">Save</Button>
              </if>
              <Button on_click={SaveThemeAs} disabled={!can_save_as(typed)} key="save theme">Save Theme As…</Button>
              <if test={is_saved(s)}>
                <Button on_click={DeleteSavedTheme} key="delete theme">Delete</Button>
              </if>
            </Row>
          </Grid>

          <!-- The colors in their groups, side by side as the window's width allows, wrapping to a
               new line when it does not: each its heading over its swatches, labelled on their
               right. -->
          <Flex class="groups" wrap="wrap">
            <for each={g in COLOR_GROUPS}>
              <Column class="group">
                <Text class="heading">{g.heading}</Text>
                <for each={c in g.colors}>
                  <color_field s={s} label={c.0} field={c.1} open={open}/>
                </for>
              </Column>
            </for>
            <Column class="group">
              <Text class="heading">ANSI colors</Text>
              <Row class="ansi">
                <for each={k in 0..<8}>
                  <ansi_field s={s} k={k} open={open}/>
                </for>
              </Row>
              <Row class="ansi">
                <for each={k in 8..<16}>
                  <ansi_field s={s} k={k} open={open}/>
                </for>
              </Row>
              <Checkbox checked={s.bold_is_bright} on_toggle={ToggleBoldBright}>Draw bold text in bright colors</Checkbox>
            </Column>
          </Flex>
        </Column>

        <!-- Each background's fill beyond its color: a gradient or an image, at its color's
             opacity. -->
        <Column class="section">
          <Text class="heading">Backgrounds</Text>
          <for each={b in [("Window", "bg"), ("Input", "input"), ("Output", "output")]}>
            <fill_editor s={s} label={b.0} field={b.1} open={open}/>
          </for>
          <Text class="note">A gradient or an image fills a background over its color, at its color's opacity, and is blurred behind as the color would be. Images may be PNG, JPEG or SVG.</Text>
        </Column>

        <Column class="section">
          <Text class="heading">Window</Text>
          <Checkbox checked={s.remember_window} on_toggle={ToggleRememberWindow}>Open the window where it was last closed, at its size</Checkbox>
          <Text class="note">The window shows what is behind it while the Background's opacity is below full, and the Input and Output sections may be translucent over it, each blurring what is behind it as its color's picker says (macOS).</Text>
        </Column>

        <Row>
          <Button on_click={ResetSettings} key="reset">Reset to Defaults</Button>
        </Row>
      </Column>
    </Expanded>
  </Column>
</component>

<!-- A color's swatch, its label to its right. -->
<component name="color_field" props={{ s: Settings, label: string, field: string, open: string }} event={SettingsEvent}>
  <!-- Here, not in the page's sheet, which reaches only this component's root, not into the
       picker it opens. -->
  <style>
    .blur { gap: 12 }
  </style>
  <Row class="swatch-row" key={field}>
    <Swatch
      color={swatch_color(color_named(s.colors, field))}
      open={open == field}
      on_open={OpenSwatch(field)}
      on_change={(c: Color) -> SettingsEvent => SetColor(field, rgb_of_color(c))}
      on_dismiss={CloseSwatch}
      opaque={!may_be_clear(field)}
    >
      <!-- A background's picker: how much what is behind it is blurred, under the opacity. -->
      <if test={may_be_clear(field)}>
        <Row class="blur" key="blur">
          <Text>Blur</Text>
          <Expanded>
            <Slider value={blur_named(s, field)} min={BLUR_RANGE.0} max={BLUR_RANGE.1} step="1" on_change={(v: f32) -> SettingsEvent => SetBlur(field, v)}/>
          </Expanded>
          <Text>{points(blur_named(s, field))}</Text>
        </Row>
      </if>
      <!-- The tab bar's underline's picker: how thick it is. -->
      <if test={field == "tab_rule"}>
        <Row class="blur" key="thickness">
          <Text>Thickness</Text>
          <Expanded>
            <Slider value={s.tab_rule_width} min={RULE_WIDTH_RANGE.0} max={RULE_WIDTH_RANGE.1} step="1" on_change={SetTabRuleWidth}/>
          </Expanded>
          <Text>{points(s.tab_rule_width)}</Text>
        </Row>
      </if>
    </Swatch>
    <Text>{label}</Text>
  </Row>
</component>

<!-- ANSI color `k`'s swatch, unlabelled. -->
<component name="ansi_field" props={{ s: Settings, k: i64, open: string }} event={SettingsEvent}>
  <Swatch
    color={swatch_color(s.colors.ansi[k])}
    open={open == "ansi ${k}"}
    on_open={OpenSwatch("ansi ${k}")}
    on_change={(c: Color) -> SettingsEvent => SetAnsi(k, rgb_of_color(c))}
    on_dismiss={CloseSwatch}
    opaque
    key="ansi {k}"
  />
</component>

<!-- A background's fill: the color alone, a gradient, or an image file and how it fits. -->
<component name="fill_editor" props={{ s: Settings, label: string, field: string, open: string }} event={SettingsEvent}>
  <style>
    .fill { gap: 10 }
    .fill-row { gap: 12 }
    .fill-label { width: 70 }
  </style>
  <Column class="fill" key={field}>
    <Row class="fill-row">
      <Text class="fill-label">{label}</Text>
      <Select options={FILL_KINDS} selected={backing_kind(backing_named(s.colors, field))} on_change={(k: i64) -> SettingsEvent => SetFill(field, k)}/>
    </Row>
    <if test={gradient_named(s.colors, field).is_some()}>
      <gradient_editor g={gradient_named(s.colors, field) ?? gradient_between(0, 0)} field={field} open={open}/>
    </if>
    <if test={image_named(s.colors, field).is_some()}>
      <Row class="fill-row">
        <Button on_click={ChooseFillImage(field)}>Choose Image…</Button>
        <Text>{image_label(image_named(s.colors, field) ?? BackingImage { path: "" })}</Text>
        <Select options={IMAGE_FITS} selected={fit_index(image_named(s.colors, field) ?? BackingImage { path: "" })} on_change={(k: i64) -> SettingsEvent => SetImageFit(field, k)}/>
      </Row>
    </if>
  </Column>
</component>

<!-- A gradient's shape and angle, and its stops: each its color, with its opacity, and its
     place along it, removable while there are more than the fewest. -->
<component name="gradient_editor" props={{ g: BackingGradient, field: string, open: string }} event={SettingsEvent}>
  <style>
    .gradient { gap: 8 }
    .stop { gap: 12 }
    Slider { width: 200 }
  </style>
  <Column class="gradient">
    <Row class="stop">
      <Select options={GRADIENT_SHAPES} selected={gradient_shape(g)} on_change={(k: i64) -> SettingsEvent => SetGradientShape(field, k)}/>
      <if test={!g.radial}>
        <Text>Angle</Text>
        <Slider value={g.angle} min="0" max="360" step="1" on_change={(v: f32) -> SettingsEvent => SetGradientAngle(field, v)}/>
        <Text>{degrees(g.angle)}</Text>
      </if>
    </Row>
    <for each={k in 0..<g.stops.len()}>
      <Row class="stop" key="stop {k}">
        <Swatch
          color={swatch_color(g.stops[k].color)}
          open={open == stop_key(field, k)}
          on_open={OpenSwatch(stop_key(field, k))}
          on_change={(c: Color) -> SettingsEvent => SetStopColor(field, k, rgb_of_color(c))}
          on_dismiss={CloseSwatch}
        />
        <Slider value={g.stops[k].at} min="0" max="1" step="0.01" on_change={(v: f32) -> SettingsEvent => SetStopAt(field, k, v)}/>
        <Text>{percent(g.stops[k].at)}</Text>
        <if test={g.stops.len() > GRADIENT_STOPS.0}>
          <Button on_click={RemoveStop(field, k)}>Remove</Button>
        </if>
      </Row>
    </for>
    <if test={g.stops.len() < GRADIENT_STOPS.1}>
      <Row>
        <Button on_click={AddStop(field)}>Add Stop</Button>
      </Row>
    </if>
  </Column>
</component>
