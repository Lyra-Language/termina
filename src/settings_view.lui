<!--
  Termina's settings, as markup: `../lyra/build/lui src/settings_view.lui` writes
  settings_view.lyra beside it. The Settings tab draws it (`ui.settings_panel`) and carries
  out its events.
-->

<script>
  import settings.{
    Settings,
    FontFamily,
    file_family,
    can_save_as,
    saved_colors,
    color_named,
    THEME_NAMES,
    FONT_SIZE_RANGE,
    LINE_SPACING_RANGE,
  }

  /// What the settings can be asked to do; the Settings tab carries it out.
  pub data SettingsEvent =
    UseFamily(string)
    | ChooseFontFile
    /// The font's size or the line spacing, as the slider is dragged.
    | SetFontSize(f32)
    | SetLineSpacing(f32)
    /// A color, by its field's name (`fg`, `tab_hovered`, …), as it is picked.
    | SetColor(string, u32)
    /// ANSI color `k`, 0 to 15.
    | SetAnsi(i64, u32)
    | UseTheme(string)
    | UseSavedTheme(string)
    | NameTheme(string)
    | SaveThemeAs
    | DeleteSavedTheme
    | ToggleBoldBright
    | ResetSettings

  /// The font the Family list shows: a chosen file's own name, else the family's.
  let family_shown = pure (s: Settings) -> string =>
    if s.font_file != "" { file_family(s.font_file).name } else { s.font_family }

  /// The colors the settings edit, by label and field (`settings.color_named`), in their
  /// groups: the grid's own, the sections', the tabs', the command line's.
  const COLORS = [("Text", "fg"), ("Background", "bg"), ("Cursor", "cursor"), ("Selection", "selection")]
  const SECTION_COLORS = [("Input", "input"), ("Output", "output"), ("Input text", "input_text")]
  const TAB_COLORS = [("Tab", "tab"), ("Under the pointer", "tab_hovered"), ("Shown", "tab_selected")]
  const COMMAND_LINE_COLORS = [("Text", "editor_text"), ("Completion menu", "menu"), ("Chosen completion", "menu_chosen")]

  /// Whether the theme in use is one the user saved.
  let is_saved = pure (s: Settings) -> bool => saved_colors(s.themes, s.theme_name) != None
</script>

<!-- The whole of the Settings tab, for the settings as they are and the name typed to
     save a theme as. -->
<component name="settings_view" props={{s: Settings, families: []FontFamily, typed: string}} event={SettingsEvent}>
  <style>
    Text.group { color: #9aa0a6 }
  </style>
  <SeparatorText>Font</SeparatorText>
  <Form>
    <Field label="Family">
      <Combo label="##family" id="combo Family" preview={family_shown(s)}>
        <for each={f in families}>
          <Selectable selected={s.font_file == "" && f.name == s.font_family} on_select={UseFamily(f.name)}>{f.name}</Selectable>
        </for>
      </Combo>
      <Button id="button Other Font File" on_click={ChooseFontFile}>Other Font File…</Button>
    </Field>
    <Field label="Size">
      <Slider label="##size" id="slider Size" value={s.font_size} min={FONT_SIZE_RANGE.0} max={FONT_SIZE_RANGE.1} format="%.0f pt" on_change={SetFontSize}/>
    </Field>
    <Field label="Line spacing">
      <Slider label="##spacing" id="slider Line spacing" value={s.line_spacing} min={LINE_SPACING_RANGE.0} max={LINE_SPACING_RANGE.1} format="%.2f" on_change={SetLineSpacing}/>
    </Field>
  </Form>

  <SeparatorText>Colors</SeparatorText>
  <Form>
    <Field label="Theme">
      <Combo label="##theme" id="combo Theme" preview={s.theme_name}>
        <for each={name in THEME_NAMES}>
          <Selectable selected={name == s.theme_name} on_select={UseTheme(name)}>{name}</Selectable>
        </for>
        <if test={s.themes.len() > 0}>
          <Separator/>
        </if>
        <for each={t in s.themes}>
          <Selectable id="saved {t.name}" selected={t.name == s.theme_name} on_select={UseSavedTheme(t.name)}>{t.name}</Selectable>
        </for>
      </Combo>
    </Field>
    <Field label="Theme name">
      <InputText label="##themename" id="field Theme name" hint="Theme name" value={typed} on_change={NameTheme} style="width: 14em"/>
      <Button id="button Save Theme As" enabled={can_save_as(typed)} on_click={SaveThemeAs}>Save Theme As…</Button>
      <if test={is_saved(s)}>
        <Button id="button Delete Theme" on_click={DeleteSavedTheme}>Delete</Button>
      </if>
    </Field>
    <for each={c in COLORS}>
      <Field label={c.0}><color s={s} field={c.1}/></Field>
    </for>
    <Text class="group">Sections</Text>
    <for each={c in SECTION_COLORS}>
      <Field label={c.0}><color s={s} field={c.1}/></Field>
    </for>
    <Text class="group">Tabs</Text>
    <for each={c in TAB_COLORS}>
      <Field label={c.0}><color s={s} field={c.1}/></Field>
    </for>
    <Text class="group">Command line</Text>
    <for each={c in COMMAND_LINE_COLORS}>
      <Field label={c.0}><color s={s} field={c.1}/></Field>
    </for>
  </Form>
  <Text class="group">ANSI colors</Text>
  <Row>
    <for each={k in 0..<8}>
      <ansi s={s} k={k}/>
    </for>
  </Row>
  <Row>
    <for each={k in 8..<16}>
      <ansi s={s} k={k}/>
    </for>
  </Row>
  <Checkbox id="checkbox Bold is bright" checked={s.bold_is_bright} on_toggle={ToggleBoldBright}>Draw bold text in bright colors</Checkbox>

  <Separator/>
  <Button id="button Reset" on_click={ResetSettings}>Reset to Defaults</Button>
</component>

<!-- A color's swatch, the field of the settings' colors it edits named. -->
<component name="color" props={{s: Settings, field: string}} event={SettingsEvent}>
  <ColorEdit label="##{field}" id="color {field}" value={color_named(s.colors, field)} inputs={false} on_change={(v: u32) -> SettingsEvent => SetColor(field, v)}/>
</component>

<!-- ANSI color `k`'s swatch, unlabelled. -->
<component name="ansi" props={{s: Settings, k: i64}} event={SettingsEvent}>
  <ColorEdit label="##ansi{k}" id="color ansi {k}" value={s.colors.ansi[k]} inputs={false} on_change={(v: u32) -> SettingsEvent => SetAnsi(k, v)}/>
</component>
