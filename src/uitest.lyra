  meta
}
import vt.{ Cell, Completion, DEFAULT, INVERSE, DIM, HIDDEN, BOLD, indexed, rgb }

let main = () -> u8 => {
  let Some(host) = create_headless_host(800, 400, 0) else {
    println("uitest: no headless host")
    return 1
  }
  var failed = 0
  failed += check_typing_and_words(host)
  failed += check_keys(host)
  failed += check_history(host)
  failed += check_theme()
  failed += check_completion(host)
  failed += check_mac_modifiers(host)
  failed += check_typed_ahead()
  failed += check_tab_keys(host)
  failed += check_sessions()
  failed += check_edit_actions(host)
  failed += check_tab_drag(host)
  failed += check_mouse_reports()
  failed += check_meta_and_bright()
  failed += check_settings(host)
  failed += check_fallback_fonts(host)
  failed += check_menu_bar(host)
  destroy_host(host)
  if failed == 0 {
    println("uitest: all passed")
    0
  } else {
    println("uitest: ${failed} failed")
    1
  }
}

/// The command line as the checks lay it out: after a five-column prompt, forty columns
/// wide, ten by twenty points a cell, from (100, 100).
const PLACE: Place = Place {
  origin: Vec2 { x: 100.0, y: 100.0 },
  cell: Vec2 { x: 10.0, y: 20.0 },
  text_dy: 2.0,
  wrap: Wrap { first: 5, cols: 40 },
}

let check_typing_and_words = (host: Host) -> i64 => {
  var line = command_line([])
  var failed = 0
  type_text(host, line, "echo hello-world  next")
  failed += check("typed", line.edit.content(), "echo hello-world  next")

  // Double-clicking a word selects it, wherever in the word the pointer is.
  double_click(host, line, 0, 5 + 7)
  failed += check("double-click inside a word", line.edit.selected_text(), "hello")
  double_click(host, line, 0, 5 + 11)
  failed += check("double-click the next word", line.edit.selected_text(), "world")
  double_click(host, line, 0, 5 + 10)
  failed += check("double-click punctuation", line.edit.selected_text(), "-")
  double_click(host, line, 0, 5 + 30)
  failed += check("double-click past the end", line.edit.selected_text(), "next")

  // A single click after it puts the caret and drops the selection.
  click(host, line, 0, 5 + 2)
  failed += check("click", "${line.edit.cursor}:${line.edit.has_selection()}", "2:false")

  // A drag after a double-click extends by whole words.
  double_click_and_drag(host, line, 5 + 12, 5 + 1)
  failed += check("double-click and drag", line.edit.selected_text(), "echo hello-world")

  // A plain drag selects rune by rune.
  drag(host, line, 0, 5 + 5, 5 + 8)
  failed += check("drag", line.edit.selected_text(), "hel")

  // Three clicks select the line.
  triple_click(host, line, 0, 5 + 3)
  failed += check("triple-click", line.edit.selected_text(), "echo hello-world  next")

  // Typing replaces the selection.
  type_text(host, line, "ls")
  failed += check("type over a selection", line.edit.content(), "ls")
  failed
}

let check_keys = (host: Host) -> i64 => {
  var line = command_line([])
  var failed = 0
  type_text(host, line, "git status")
  press(host, line, [MOD_SHIFT], KEY_LEFT_ARROW)
  press(host, line, [MOD_SHIFT], KEY_LEFT_ARROW)
  failed += check("shift-left selects", line.edit.selected_text(), "us")
  press(host, line, [], KEY_BACKSPACE)
  failed += check("backspace the selection", line.edit.content(), "git stat")
  let word = if platform() == "macOS" { MOD_ALT } else { MOD_CTRL }
  press(host, line, [word], KEY_BACKSPACE)
  failed += check("delete a word back", line.edit.content(), "git ")
  let command = if platform() == "macOS" { [MOD_SUPER] } else { [MOD_CTRL, MOD_SHIFT] }
  // Undo is ⌘Z, and off macOS Ctrl+Z: Ctrl+Shift+Z is Redo there.
  let undo = if platform() == "macOS" { [MOD_SUPER] } else { [MOD_CTRL] }
  press(host, line, undo, KEY_Z)
  failed += check("undo", line.edit.content(), "git stat")
  press(host, line, command, KEY_A)
  failed += check("select all", line.edit.selected_text(), "git stat")
  press(host, line, [], KEY_HOME)
  type_text(host, line, "x")
  failed += check("home, then type", line.edit.content(), "xgit stat")
  press(host, line, [], KEY_END)
  press(host, line, [MOD_SHIFT], KEY_ENTER)
  type_text(host, line, "two")
  failed += check("shift-return: a new line", line.edit.content(), "xgit stat\ntwo")
  let outcome = press(host, line, [], KEY_ENTER)
  failed += check("return runs it", describe(outcome), "submit xgit stat\ntwo")
  failed
}

let check_history = (host: Host) -> i64 => {
  var line = command_line(["make", "make test"])
  var failed = 0
  type_text(host, line, "dra")
  press(host, line, [], KEY_UP_ARROW)
  failed += check("up: the newest entry", line.edit.content(), "make test")
  press(host, line, [], KEY_UP_ARROW)
  press(host, line, [], KEY_UP_ARROW)
  failed += check("up past the oldest stays", line.edit.content(), "make")
  press(host, line, [], KEY_DOWN_ARROW)
  press(host, line, [], KEY_DOWN_ARROW)
  failed += check("down: back to the draft", line.edit.content(), "dra")
  line.submitted("echo new")
  press(host, line, [], KEY_UP_ARROW)
  failed += check("a run command joins the history", line.edit.content(), "echo new")

  // Ctrl+R: the history's commands with the query in them, case aside, each once, the
  // newest last and chosen; ↑ an older one; Return puts it in. Nothing matching shows a
  // row saying so; Escape puts back what was there.
  var search = command_line(["make", "git status", "make test", "ls", "make test"])
  type_text(host, search, "draft")
  press(host, search, [MOD_CTRL], KEY_R)
  // What was typed is the query: nothing has "draft" in it.
  failed += check(
    "what was typed is the query",
    "${search.is_searching()}|${shown(search)}",
    "true|"
  )
  press(host, search, [MOD_CTRL], KEY_A)
  press(host, search, [MOD_CTRL], KEY_K)
  failed += check("all of it, each once", shown(search), "make git status ls make test")
  failed += check("the newest chosen", chosen(search), "make test")
  type_text(host, search, "MA")
  failed += check("the query narrows it", shown(search), "make make test")
  press(host, search, [], KEY_UP_ARROW)
  press(host, search, [], KEY_ENTER)
  failed += check(
    "return puts it in",
    "${search.edit.content()}|${search.is_searching()}",
    "make|false"
  )
  press(host, search, [MOD_CTRL], KEY_R)
  type_text(host, search, "zz")
  failed += check("nothing matches", "${search.menu_rows()}|${shown(search)}", "1|")
  press(host, search, [], KEY_ESCAPE)
  failed += check(
    "escape puts it back",
    "${search.edit.content()}|${search.is_searching()}",
    "make|false"
  )
  failed
}

// Tab: the request it makes, and the shell's answer — one match put in, several sharing a
// start put in as far as they agree and offered in a menu, an answer for an edited line
// dropped.
let check_completion = (host: Host) -> i64 => {
  var failed = 0
  var line = command_line([])
  type_text(host, line, "cd ly")
  failed += check(
    "tab asks",
    describe(press(host, line, [], KEY_TAB)),
    "complete cd ly at 5"
  )
  line.completed([offer("", "lyra-workspace", "/", "lyra-workspace", "")])
  failed += check("one match is put in", line.edit.content(), "cd lyra-workspace/")
  failed += check("and no menu", "${line.menu_rows()}", "0")

  var many = command_line([])
  type_text(host, many, "git ch")
  let _ = press(host, many, [], KEY_TAB)
  many.completed([
    offer("", "checkout", " ", "checkout", "switch branches"),
    offer("", "cherry-pick", " ", "cherry-pick", "apply commits"),
    offer("", "cherry", " ", "cherry", ""),
    offer("", "checkout", " ", "checkout", "switch branches"),
  ])
  failed += check("the shared start", many.edit.content(), "git che")
  failed += check("a menu of the others, once each", "${many.menu_rows()}", "3")
  press(host, many, [], KEY_DOWN_ARROW)
  press(host, many, [], KEY_TAB)
  failed += check("down, then tab: the third", "${many.chosen}", "2")
  press(host, many, [MOD_SHIFT], KEY_TAB)
  let outcome = press(host, many, [], KEY_ENTER)
  failed += check("return puts in the choice", many.edit.content(), "git cherry-pick ")
  failed += check("and does not run it", describe(outcome), "nothing")
  failed += check("the menu closes", "${many.menu_rows()}", "0")

  // A click on a row puts it in.
  var clicked = command_line([])
  type_text(host, clicked, "ls s")
  let _ = press(host, clicked, [], KEY_TAB)
  clicked.completed([offer("", "src", "/", "src", ""), offer("", "sub", "/", "sub", "")])
  // The menu's first row is the one under the command line, at the word's column (3).
  click(host, clicked, 2, 5 + 4)
  failed += check("click a completion", clicked.edit.content(), "ls sub/")

  // Escape closes the menu and leaves the text; typing closes it and is typed.
  var closing = command_line([])
  type_text(host, closing, "x")
  let _ = press(host, closing, [], KEY_TAB)
  closing.completed([offer("", "xa", " ", "xa", ""), offer("", "xb", " ", "xb", "")])
  press(host, closing, [], KEY_ESCAPE)
  failed += check(
    "escape closes",
    "${closing.menu_rows()}|${closing.edit.content()}",
    "0|x"
  )
  let _ = press(host, closing, [], KEY_TAB)
  closing.completed([offer("", "xa", " ", "xa", ""), offer("", "xb", " ", "xb", "")])
  type_text(host, closing, "y")
  // Nothing starts so here, but the shell is asked again; its answer, none, closes it.
  failed += check(
    "typing types, and asks again",
    "${closing.edit.content()}|${closing.pending != None}",
    "xy|true"
  )
  closing.completed([])
  failed += check("no answer closes", "${closing.menu_rows()}", "0")

  // Typing narrows the menu from the list zsh gave; backspace widens it again; the choice
  // stays chosen while it is there.
  var narrowing = command_line([])
  type_text(host, narrowing, "git ch")
  let _ = press(host, narrowing, [], KEY_TAB)
  narrowing.completed([
    offer("", "checkout", " ", "checkout", ""),
    offer("", "cherry-pick", " ", "cherry-pick", ""),
    offer("", "cherry", " ", "cherry", ""),
    offer("", "check-attr", " ", "check-attr", ""),
  ])
  failed += check(
    "opens on the shared start",
    "${narrowing.edit.content()}|${shown(narrowing)}",
    "git che|checkout cherry-pick cherry check-attr"
  )
  type_text(host, narrowing, "r")
  failed += check("r narrows", shown(narrowing), "cherry-pick cherry")
  press(host, narrowing, [], KEY_DOWN_ARROW)
  failed += check("choose the second", chosen(narrowing), "cherry")
  press(host, narrowing, [], KEY_BACKSPACE)
  failed += check(
    "backspace widens",
    shown(narrowing),
    "checkout cherry-pick cherry check-attr"
  )
  failed += check("the choice stays chosen", chosen(narrowing), "cherry")
  type_text(host, narrowing, "ck")
  failed += check("ck narrows", shown(narrowing), "checkout check-attr")
  failed += check("a choice gone goes to the first", chosen(narrowing), "checkout")
  press(host, narrowing, [], KEY_ENTER)
  failed += check("return puts it in", narrowing.edit.content(), "git checkout ")

  // Nothing left, the word typed in full, or the caret moving away: the menu closes.
  var gone = command_line([])
  type_text(host, gone, "ls s")
  let _ = press(host, gone, [], KEY_TAB)
  gone.completed([offer("", "src", "/", "src", ""), offer("", "sub", "/", "sub", "")])
  type_text(host, gone, "q")
  gone.completed([])
  failed += check(
    "nothing left closes",
    "${gone.menu_rows()}|${gone.edit.content()}",
    "0|ls sq"
  )
  // The shell's answer to typing is the menu as given: a match the typed word is not the
  // start of — a case-insensitive matcher's — shown, and nothing put in.
  var matched = command_line([])
  type_text(host, matched, "cd d")
  let _ = press(host, matched, [], KEY_TAB)
  matched.completed([
    offer("", "Documents", "/", "Documents", ""),
    offer("", "dev", "/", "dev", "")
  ])
  type_text(host, matched, "o")
  failed += check("narrowed meanwhile, case aside", shown(matched), "Documents")
  matched.completed([
    offer("", "Documents", "/", "Documents", ""),
    offer("", "Downloads", "/", "Downloads", "")
  ])
  failed += check(
    "the shell's answer is the menu",
    "${shown(matched)}|${matched.edit.content()}",
    "Documents Downloads|cd do"
  )
  var full = command_line([])
  type_text(host, full, "ls s")
  let _ = press(host, full, [], KEY_TAB)
  full.completed([offer("", "src", "/", "src", ""), offer("", "sub", "/", "sub", "")])
  type_text(host, full, "rc")
  failed += check(
    "typed in full closes",
    "${full.menu_rows()}|${full.edit.content()}",
    "0|ls src"
  )
  var moved = command_line([])
  type_text(host, moved, "ls s")
  let _ = press(host, moved, [], KEY_TAB)
  moved.completed([offer("", "src", "/", "src", ""), offer("", "sub", "/", "sub", "")])
  press(host, moved, [], KEY_LEFT_ARROW)
  failed += check("moving off the word closes", "${moved.menu_rows()}", "0")
  var spaced = command_line([])
  type_text(host, spaced, "ls s")
  let _ = press(host, spaced, [], KEY_TAB)
  spaced.completed([offer("", "src", "/", "src", ""), offer("", "sub", "/", "sub", "")])
  type_text(host, spaced, " ")
  failed += check(
    "a space ends the word, and the menu",
    "${spaced.menu_rows()}|${spaced.edit.content()}",
    "0|ls s "
  )

  // In the box at the window's foot the menu opens upward, above the prompt's row: its
  // second row is two rows above that.
  var above = command_line([])
  let box_place = Place { PLACE | menu_above: true, lift: PLACE.cell.y }
  above.edit.paste("ls s")
  let _ = frame_at(host, above, box_place)
  above.pending = Some(("ls s", 4))
  above.completed([offer("", "src", "/", "src", ""), offer("", "sub", "/", "sub", "")])
  let _ = frame_at(host, above, box_place)
  // Rows -3 and -2 are the menu's (two items above one prompt row); -2 is "sub".
  get_io().add_mouse_pos_event(
    PLACE.origin.x + 9.25 * PLACE.cell.x,
    PLACE.origin.y - 1.5 * PLACE.cell.y
  )
  let _ = frame_at(host, above, box_place)
  get_io().add_mouse_button_event(0, true)
  let _ = frame_at(host, above, box_place)
  get_io().add_mouse_button_event(0, false)
  let _ = frame_at(host, above, box_place)
  failed += check("a menu above, clicked", above.edit.content(), "ls sub/")
  for _ in 0..<30 { let _ = frame_at(host, above, box_place) }

  // A completion's suffix gives way to what would double it or end the word: its `/` to a
  // `/`, its space to a `|`; a letter keeps it.
  var slash = command_line([])
  type_text(host, slash, "cd s")
  let _ = press(host, slash, [], KEY_TAB)
  slash.completed([offer("", "sub", "/", "sub", "")])
  type_text(host, slash, "/x")
  failed += check("a / typed after a completed /", slash.edit.content(), "cd sub/x")
  var piped = command_line([])
  type_text(host, piped, "cat pl")
  let _ = press(host, piped, [], KEY_TAB)
  piped.completed([offer("", "plain.txt", " ", "plain.txt", "")])
  type_text(host, piped, "|")
  failed += check("a | after a completed space", piped.edit.content(), "cat plain.txt|")
  var spaced_on = command_line([])
  type_text(host, spaced_on, "cat pl")
  let _ = press(host, spaced_on, [], KEY_TAB)
  spaced_on.completed([offer("", "plain.txt", " ", "plain.txt", "")])
  type_text(host, spaced_on, "x")
  failed += check("a letter keeps the space", spaced_on.edit.content(), "cat plain.txt x")

  // An answer for a line edited since is dropped.
  var stale = command_line([])
  type_text(host, stale, "ec")
  let _ = press(host, stale, [], KEY_TAB)
  type_text(host, stale, "h")
  stale.completed([offer("", "echo", " ", "echo", "")])
  failed += check("a stale answer", stale.edit.content(), "ech")
  failed
}

/// The completions a menu shows, in order.
let shown = pure (line: CommandLine) -> string => [c in line.menu | c.shown].join(" ")

/// The one chosen.
let chosen = pure (line: CommandLine) -> string =>
  if line.menu.len() == 0 { "" } else { line.menu[line.chosen].shown }

let offer = pure (
  prefix: string,
  insert: string,
  suffix: string,
  shown: string,
  description: string
) -> Completion =>
  Completion {
    prefix: prefix,
    insert: insert,
    suffix: suffix,
    shown: shown,
    description: description
  }

// The real window on a Mac: ImGui swaps Ctrl and ⌘ there (`ConfigMacOSXBehaviors`; the
// headless host turns it off), so the keys are injected as SDL reports them and must
// still mean what they say — Ctrl+A the line's start, ⌘A everything.
let check_mac_modifiers = (host: Host) -> i64 => {
  if platform() != "macOS" { return 0 }
  let io = get_io()
  io.set_config_mac_osx_behaviors(true)
  var line = command_line([])
  var failed = 0
  type_text(host, line, "echo one two")
  press(host, line, [MOD_CTRL], KEY_A)
  failed += check(
    "ctrl-a: the line's start",
    "${line.edit.cursor}:${line.edit.has_selection()}",
    "0:false"
  )
  press(host, line, [MOD_SUPER], KEY_A)
  failed += check("cmd-a: everything", line.edit.selected_text(), "echo one two")
  press(host, line, [MOD_CTRL], KEY_E)
  failed += check("ctrl-e: the line's end", "${line.edit.cursor}", "12")
  press(host, line, [MOD_SUPER], KEY_LEFT_ARROW)
  failed += check("cmd-left: the line's start", "${line.edit.cursor}", "0")
  press(host, line, [MOD_CTRL], KEY_K)
  failed += check("ctrl-k: delete to the end", line.edit.content(), "")
  press(host, line, [MOD_SUPER], KEY_Z)
  failed += check("cmd-z: undo", line.edit.content(), "echo one two")
  let sent = press(host, line, [MOD_CTRL], KEY_L)
  failed += check("ctrl-l: to the shell", describe(sent), "send \x0c")
  io.set_config_mac_osx_behaviors(false)
  failed
}

// The Edit menu's actions on the command line, what each greys out, and its keys left to
// the menu when there is one.
let check_edit_actions = (host: Host) -> i64 => {
  var failed = 0
  var line = command_line([])
  failed += check(
    "nothing to undo, cut or select",
    "${line.can(Undo)} ${line.can(Cut)} ${line.can(SelectAll)} ${line.can(Paste)}",
    "false false false true"
  )
  type_text(host, line, "echo hello")
  failed += check(
    "something to undo and select",
    "${line.can(Undo)} ${line.can(SelectAll)} ${line.can(Copy)}",
    "true true false"
  )
  line.edit_action(SelectAll)
  failed += check("select all", line.edit.selected_text(), "echo hello")
  failed += check(
    "cut and copy once selected",
    "${line.can(Cut)} ${line.can(Copy)}",
    "true true"
  )
  line.edit_action(Cut)
  failed += check("cut", line.edit.content(), "")
  line.edit_action(Undo)
  failed += check("undo the cut", line.edit.content(), "echo hello")
  failed += check("redo once undone", "${line.can(Redo)}", "true")
  line.edit_action(Redo)
  failed += check("redo the cut", line.edit.content(), "")
  line.edit_action(Undo)

  // With the menu bar's Edit menu, ⌘Z is its: pressed, it does nothing here.
  if platform() == "macOS" {
    let io = get_io()
    io.set_config_mac_osx_behaviors(true)
    var owned = command_line([])
    owned.menu_keys = true
    type_text(host, owned, "ls")
    press(host, owned, [MOD_SUPER], KEY_Z)
    failed += check("cmd-z is the menu's", owned.edit.content(), "ls")
    owned.menu_keys = false
    press(host, owned, [MOD_SUPER], KEY_Z)
    failed += check("cmd-z without a menu", owned.edit.content(), "")
    io.set_config_mac_osx_behaviors(false)
  }

  // A paste to a running program: between bracketed paste's markers when it asked, its own
  // end marker taken out so the paste cannot end itself early.
  failed += check("a plain paste", pasted("ls -l", false), "ls -l")
  failed += check("a bracketed paste", pasted("a\e[201~b", true), "\e[200~ab\e[201~")
  failed
}

// The settings: the file, the fonts found, the theme made of them, and the window.
// The menu bar Sulafat draws off macOS: a menu opened and an item clicked answer the
// item's tag, as the Mac's bar sends it; a greyed item answers nothing; the bar takes its
// height off the work area the terminal's window fills.
let check_menu_bar = (host: Host) -> i64 => {
  var failed = 0
  let tabs = [TabLabel { name: "one", id: 1 }, TabLabel { name: "two", id: 2 }]
  let none_enabled = [false, false, false, false, false, false]
  for _ in 0..<3 { let _ = menu_frame(host, tabs, none_enabled) }
  failed += check(
    "the bar is above the work area",
    "${get_main_viewport().work_pos().y > 0.0}",
    "true"
  )
  // Its padding: taller than a bare line of text, a menu's name in its middle.
  let bar_height = get_main_viewport().work_pos().y - get_main_viewport().pos().y
  let shell_y = (spot("Shell") ?? Vec2 { x: 0.0, y: 0.0 }).y - get_main_viewport().pos().y
  failed += check("the bar has room around its text", "${bar_height > 24.0}", "true")
  failed += check(
    "a menu's name in the bar's middle",
    "${(shell_y - bar_height / 2.0).abs() < 1.5}",
    "true"
  )
  failed += check(
    "Shell ▸ New Tab",
    "${pick(host, tabs, none_enabled, "Shell", "New Tab")}",
    "${MENU_NEW_TAB}"
  )
  failed += check(
    "Window ▸ the second tab",
    "${pick(host, tabs, none_enabled, "Window", "two")}",
    "${MENU_TAB + 1}"
  )
  failed += check(
    "a greyed item",
    "${pick(host, tabs, none_enabled, "Edit", "Paste")}",
    "-1"
  )
  let all_enabled = [true, true, true, true, true, true]
  failed += check(
    "Edit ▸ Paste",
    "${pick(host, tabs, all_enabled, "Edit", "Paste")}",
    "${MENU_PASTE}"
  )
  failed
}

/// Open the menu `title` and click its item `label`, a press and a release a frame each, as
/// a hand would: the tag answered, or -1. The menu is closed after, whatever was clicked.
let pick = (
  host: Host,
  tabs: []TabLabel,
  enabled: []bool,
  title: string,
  label: string
) -> i32 => {
  click_item(host, tabs, enabled, title)
  // The menu draws its items the frame after it opens.
  let _ = menu_frame(host, tabs, enabled)
  var tag: i32 = -1
  match spot(label) {
    Some(item) => {
      let io = get_io()
      io.add_mouse_pos_event(item.x, item.y)
      for down in [false, true, false] {
        io.add_mouse_button_event(0, down)
        match menu_frame(host, tabs, enabled) {
          Some(t) => { tag = t },
          None => {},
        }
      }
    },
    None => {},
  }
  // A greyed item leaves its menu open: a click off the bar closes it.
  get_io().add_mouse_pos_event(400.0, 300.0)
  for down in [true, false] {
    get_io().add_mouse_button_event(0, down)
    let _ = menu_frame(host, tabs, enabled)
  }
  tag
}

/// Click what the last frame drew as `label`.
let click_item = (
  host: Host,
  tabs: []TabLabel,
  enabled: []bool,
  label: string
) -> void => {
  let Some(middle) = spot(label) else { return }
  let io = get_io()
  io.add_mouse_pos_event(middle.x, middle.y)
  let _ = menu_frame(host, tabs, enabled)
  io.add_mouse_button_event(0, true)
  let _ = menu_frame(host, tabs, enabled)
  io.add_mouse_button_event(0, false)
  let _ = menu_frame(host, tabs, enabled)
}

/// One frame of the menu bar alone, every menu and item it drew noted where it is.
let menu_frame = (host: Host, tabs: []TabLabel, enabled: []bool) -> Maybe<i32> => {
  if !begin_frame(host) { return None }
  spots = []
  let tag = menu_bar(host, tabs, 0, enabled, note_spot)
  end_frame(host, 0.0, 0.0, 0.0)
  tag
}

/// Where the menu bar drew each menu and item in the last frame: its label and middle.
var spots: [](string, Vec2) = []

let note_spot = (label: string) -> void => {
  let lo = get_item_rect_min()
  let hi = get_item_rect_max()
  spots.push((label, Vec2 { x: (lo.x + hi.x) / 2.0, y: (lo.y + hi.y) / 2.0 }))
}

/// Where `label` was drawn last frame.
let spot = (label: string) -> Maybe<Vec2> => {
  var found: Maybe<Vec2> = None
  for (l, p) in spots { if l == label { found = Some(p) } }
  found
}

// A glyph the family lacks — 中 in SF Mono or DejaVu Sans Mono — comes from a fallback font
// merged into it. Skipped where the machine has no family or no fallback.
let check_fallback_fonts = (host: Host) -> i64 => {
  let families = font_families()
  let fallbacks = fallback_fonts()
  if families.len() == 0 || fallbacks.len() == 0 { return 0 }
  let Some(font) = font_file(host, families[0].regular, 14.0) else { return 0 }
  var failed = 0
  failed += check(
    "a fallback merged",
    "${merge_font_file(host, font, fallbacks[0])}",
    "true"
  )
  failed += check("merged again", "${merge_font_file(host, font, fallbacks[0])}", "true")
  failed += check(
    "a missing file",
    "${merge_font_file(host, font, "/nonexistent/font.ttf")}",
    "false"
  )
  if begin_frame(host) {
    push_font_float(font, 14.0)
    let glyph = get_font_baked().find_glyph_no_fallback(u16(0x4E2D))
    failed += check("a CJK glyph from the fallback", "${glyph != nullptr}", "true")
    pop_font()
    end_frame(host, 0.0, 0.0, 0.0)
  }
  // Hinted, through FreeType: the face's advances whole pixels, and the fallback merged
  // into it still drawn. Unhinted again after, as the other checks expect.
  set_font_hinting(host, true)
  if begin_frame(host) {
    push_font_float(font, 14.0)
    let w = calc_text_size("MMMMMMMMMM").x
    failed += check(
      "hinted advances are whole pixels",
      "${(w - f32(w.round())).abs() < 0.001}",
      "true"
    )
    let glyph = get_font_baked().find_glyph_no_fallback(u16(0x4E2D))
    failed += check("a CJK glyph, hinted", "${glyph != nullptr}", "true")
    pop_font()
    end_frame(host, 0.0, 0.0, 0.0)
  }
  set_font_hinting(host, false)
  failed
}

let check_settings = (host: Host) -> i64 => {
  var failed = 0
  let d = defaults()
  failed += check(
    "a round trip",
    settings_to_json(settings_from_json(settings_to_json(d))),
    settings_to_json(d)
  )
  failed += check(
    "a broken file is the defaults",
    settings_to_json(settings_from_json("{ nope")),
    settings_to_json(d)
  )
  let odd = settings_from_json(`{"font_size": 99, "theme": "Nord", "colours": {"background": "#000000", "ansi": ["#fff"]}, "bold_is_bright": true}`)
  failed += check("a size too large is the largest", "${odd.font_size}", "32")
  failed += check(
    "the theme's colours",
    hex_of(odd.colours.fg),
    hex_of(theme_colours("Nord").fg)
  )
  failed += check("one written over them", hex_of(odd.colours.bg), "#000000")
  failed += check(
    "a short ANSI list is not taken",
    "${odd.colours.ansi.len()} ${hex_of(odd.colours.ansi[1])}",
    "16 ${hex_of(theme_colours("Nord").ansi[1])}"
  )
  failed += check("a flag", "${odd.bold_is_bright}", "true")
  // The sections', tabs' and command line's colours: a file without them takes the theme's,
  // one with them keeps them; a theme's own shades are made from its background.
  failed += check("the theme's sections", hex_of(odd.colours.input), "#3b4252")
  let tabbed = settings_from_json(`{"colours": {"tab": "#123456", "menu_chosen": "#654321"}}`)
  failed += check(
    "tab and menu colours read",
    "${hex_of(tabbed.colours.tab)} ${hex_of(tabbed.colours.menu_chosen)}",
    "#123456 #654321"
  )
  // The input section's text: the theme's text until set; set, what its rows are drawn in.
  failed += check(
    "input text, the text's",
    hex_of(d.colours.input_text),
    hex_of(d.colours.fg)
  )
  let greened = Settings { d | colours: Colours { d.colours | input_text: 0x00FF00 } }
  failed += check(
    "input rows' text",
    hex(theme_of(greened).for_input().fg),
    hex(abgr(0x00FF00))
  )
  // Saved themes: the colours under a name of the user's (not one of Sulafat's), chosen
  // then; kept in the file, a theme named there found among them; deleted, Custom.
  var mine = Settings { d | colours: Colours { d.colours | bg: 0x101010 } }
  failed += check(
    "Sulafat's names are not to save as",
    "${can_save_as("Nord")}|${can_save_as(" ")}|${can_save_as("Mine")}",
    "false|false|true"
  )
  save_theme(mine, " Mine ")
  failed += check("saved and chosen", "${mine.themes.len()}|${mine.theme_name}", "1|Mine")
  mine.colours = Colours { mine.colours | bg: 0x202020 }
  save_theme(mine, "Mine")
  failed += check(
    "saved again, replaced",
    "${mine.themes.len()}|${hex_of(mine.themes[0].colours.bg)}",
    "1|#202020"
  )
  let reread = settings_from_json(settings_to_json(mine))
  failed += check("kept in the file", settings_to_json(reread), settings_to_json(mine))
  let named = settings_from_json(`{"theme": "Mine", "themes": [{"name": "Mine", "colours": {"background": "#303030"}}]}`)
  failed += check("a saved theme by name", hex_of(named.colours.bg), "#303030")
  delete_theme(mine, "Mine")
  failed += check(
    "deleted, the colours stay",
    "${mine.themes.len()}|${mine.theme_name}|${hex_of(mine.colours.bg)}",
    "0|Custom|#202020"
  )
  failed += check(
    "sections made from the background",
    "${hex_of(sections_of(0x181A1E).0)} ${hex_of(sections_of(0xFAF8F5).0)}",
    "#26282c #eeece9"
  )
  failed += check("a colour read", "${colour_of("#1a2B3c") ?? 0}", "${u32(0x1A2B3C)}")
  failed += check(
    "not a colour",
    "${colour_of("#12345") == None} ${colour_of("zzzzzz") == None}",
    "true true"
  )
  failed += check("a colour written", hex_of(0x0A0B0C), "#0a0b0c")
  failed += check(
    "picker channels and back",
    hex_of(packed(channels(0x3A6EA5))),
    "#3a6ea5"
  )

  // Font files grouped into families: faces by suffix, the unoffered weights left out, and
  // a file that does not look monospaced passed over.
  let found = families_of([
    "/f/JetBrainsMono-Regular.ttf",
    "/f/JetBrainsMono-Bold.ttf",
    "/f/JetBrainsMono-Italic.ttf",
    "/f/JetBrainsMono-BoldItalic.ttf",
    "/f/JetBrainsMono-Light.ttf",
    "/f/Arial.ttf",
    "/f/FiraCode-Regular.otf",
    "/f/OnlyBoldMono-Bold.ttf",
    "/f/Arial Unicode.ttf",
    "/f/Courier New.ttf",
    "/f/Courier New Bold.ttf",
    "/f/Courier New Italic.ttf",
    "/f/Courier New Bold Italic.ttf",
  ])
  failed += check(
    "families",
    [f in found | f.name].join(","),
    "Courier New,Fira Code,JetBrains Mono"
  )
  let courier = found[0]
  failed += check(
    "faces after a space",
    "${courier.bold != ""} ${courier.italic != ""} ${courier.bold_italic != ""}",
    "true true true"
  )
  failed += check(
    "their faces",
    "${found[2].bold != ""} ${found[2].italic != ""} ${found[2].bold_italic != ""} ${found[1].bold == ""}",
    "true true true true"
  )
  let here = font_families()
  failed += check("some family installed", "${here.len() > 0}", "true")
  // A font file chosen instead: a family of its one face, kept in the file, and chosen over
  // the family named.
  let file = file_family("/Users/me/Fonts/BerkeleyMono-Regular.otf")
  failed += check(
    "a file's family",
    "${file.name}|${file.regular}|${file.bold}",
    "Berkeley Mono|/Users/me/Fonts/BerkeleyMono-Regular.otf|"
  )
  var with_file = defaults()
  with_file.font_file = "/Users/me/Fonts/BerkeleyMono-Regular.otf"
  failed += check(
    "the file over the family",
    (family_for(with_file, here) ?? file).name,
    "Berkeley Mono"
  )
  failed += check(
    "kept in the file",
    settings_from_json(settings_to_json(with_file)).font_file,
    with_file.font_file
  )
  failed += check("no file: the family", (family_for(d, here) ?? file).name, here[0].name)

  // The theme the settings make.
  let t = theme_of(d)
  failed += check("the theme's background", hex(t.bg), hex(abgr(d.colours.bg)))
  failed += check("the selection is translucent", "${(t.selection >> 24) < 0xFF}", "true")
  failed += check(
    "the palette from the ANSI colours",
    hex(t.palette[4]),
    hex(abgr(d.colours.ansi[4]))
  )

  // The settings draw, unchanged without input.
  var s = defaults()
  var changed = false
  for _ in 0..<3 { changed = settings_frame(host, s, here) }
  failed += check("the settings draw, unchanged", "${changed}", "false")
  failed
}

/// One frame with only the settings, in a window as the Settings tab's area would be.
let settings_frame = (host: Host, s: mut Settings, families: []FontFamily) -> bool => {
  if !begin_frame(host) { return false }
  var typed = ""
  set_next_window_pos(Vec2 { x: 0.0, y: 0.0 })
  set_next_window_size(Vec2 { x: 800.0, y: 400.0 })
  let _ = begin("settings", WINDOW_FLAGS_NO_DECORATION)
  let ask = settings_panel(s, families, typed)
  end()
  end_frame(host, 0.0, 0.0, 0.0)
  ask.changed || ask.choose_file
}

// Alt as Meta, and bold as bright.
let check_meta_and_bright = () -> i64 => {
  var failed = 0
  failed += check("meta", meta("bf").replace("\e", "^"), "^b^f")
  let off = dark_theme()
  let on = Theme { off | bold_is_bright: true }
  let bold_red = Cell { ch: 'x', fg: indexed(1), bg: DEFAULT, attrs: BOLD }
  failed += check("bold red, as asked", hex(off.colours(bold_red).0), hex(off.palette[1]))
  failed += check("bold red, bright", hex(on.colours(bold_red).0), hex(off.palette[9]))
  let bold_208 = Cell { ch: 'x', fg: indexed(208), bg: DEFAULT, attrs: BOLD }
  failed += check(
    "past the first eight, as asked",
    hex(on.colours(bold_208).0),
    hex(off.palette[208])
  )
  let plain_red = Cell { ch: 'x', fg: indexed(1), bg: DEFAULT, attrs: 0 }
  failed += check("not bold, as asked", hex(on.colours(plain_red).0), hex(off.palette[1]))
  failed
}

// The mouse as a program that asked is told of it.
let check_mouse_reports = () -> i64 => {
  var failed = 0
  failed += check(
    "SGR press",
    shown_bytes(mouse_report(0, 4, 9, true, true)),
    "\\e[<0;5;10M"
  )
  failed += check(
    "SGR release",
    shown_bytes(mouse_report(2, 0, 0, false, true)),
    "\\e[<2;1;1m"
  )
  failed += check(
    "SGR wheel down, ctrl",
    shown_bytes(mouse_report(65 + 16, 1, 1, true, true)),
    "\\e[<81;2;2M"
  )
  failed += check(
    "SGR drag",
    shown_bytes(mouse_report(32, 300, 1, true, true)),
    "\\e[<32;301;2M"
  )
  failed += check(
    "X10 press",
    shown_bytes(mouse_report(0, 4, 9, true, false)),
    "\\e[M 32 37 42"
  )
  failed += check(
    "X10 release is button 3",
    shown_bytes(mouse_report(2, 0, 0, false, false)),
    "\\e[M 35 33 33"
  )
  failed += check(
    "X10 stops at 223",
    shown_bytes(mouse_report(0, 400, 0, true, false)),
    "\\e[M 32 255 33"
  )
  failed += check("wheel up as arrows", wheel_keys(1, false), "\e[A\e[A\e[A")
  failed += check("wheel down, cursor keys", wheel_keys(-1, true), "\eOB\eOB\eOB")
  failed
}

/// Bytes as text: an ESC as `\e`, the printable rest as itself, other bytes after `[M` by
/// their numbers (X10's place bytes).
let shown_bytes = pure (bytes: []u8) -> string => {
  if bytes.len() == 6 && bytes[2] == 0x4D {
    return "\\e[M ${bytes[3]} ${bytes[4]} ${bytes[5]}"
  }
  bytes.decode_utf8().replace("\e", "\\e")
}

// Tabs dragged into a new order: the bar's order read back, and the list kept in it.
let check_tab_drag = (host: Host) -> i64 => {
  var failed = 0
  failed += check("order by place", ints(order_by([30.0, 10.0, 20.0])), "1 2 0")
  failed += check("order already so", ints(order_by([1.0, 2.0, 3.0])), "0 1 2")
  var tabs = [
    TabLabel { name: "one", id: 1 },
    TabLabel { name: "two", id: 2 },
    TabLabel { name: "three", id: 3 },
  ]
  var active = 0
  // A tab bar lays its tabs out over its first frames: let it settle before aiming.
  var bar = bar_frame(host, tabs, active)
  for _ in 0..<3 { bar = bar_frame(host, tabs, active) }
  failed += check("as given", names(tabs), "one two three")
  // Drag the first tab past the last, a few points a frame, as a hand would.
  let from = bar.centres[0]
  let to = Vec2 { x: bar.centres[2].x + 40.0, y: from.y }
  let io = get_io()
  io.add_mouse_pos_event(from.x, from.y)
  bar = bar_frame(host, tabs, active)
  io.add_mouse_button_event(0, true)
  bar = bar_frame(host, tabs, active)
  var x = from.x
  while x < to.x {
    x += 8.0
    io.add_mouse_pos_event(x, from.y)
    bar = bar_frame(host, tabs, active)
    (tabs, active) = follow(tabs, active, bar)
  }
  io.add_mouse_button_event(0, false)
  for _ in 0..<5 {
    bar = bar_frame(host, tabs, active)
    (tabs, active) = follow(tabs, active, bar)
  }
  failed += check("dragged to the end", names(tabs), "two three one")
  failed += check("the shown tab is still the dragged one", tabs[active].name, "one")
  // A click on a tab shows it.
  let two = bar.centres[0]
  io.add_mouse_pos_event(two.x, two.y)
  bar = bar_frame(host, tabs, active)
  io.add_mouse_button_event(0, true)
  bar = bar_frame(host, tabs, active)
  io.add_mouse_button_event(0, false)
  bar = bar_frame(host, tabs, active)
  active = bar.shown
  bar = bar_frame(host, tabs, active)
  failed += check("a click shows it", tabs[bar.shown].name, "two")
  // The Settings tab: shown when asked for, until a key chooses a terminal's tab.
  var on = settings_bar_frame(host, tabs, bar.shown, None, true)
  for _ in 0..<3 { on = settings_bar_frame(host, tabs, bar.shown, None, false) }
  failed += check("the settings tab shown", "${on.settings_shown}", "true")
  on = settings_bar_frame(host, tabs, bar.shown, Some(0), false)
  for _ in 0..<2 { on = settings_bar_frame(host, tabs, 0, None, false) }
  failed += check(
    "a terminal's tab chosen over it",
    "${on.settings_shown}|${on.shown}",
    "false|0"
  )
  failed
}

/// One frame of a window holding the tab bar with a Settings tab, made the shown one when
/// `select_settings`.
let settings_bar_frame = (
  host: Host,
  tabs: []TabLabel,
  active: i64,
  select: Maybe<i64>,
  select_settings: bool
) -> TabBar => {
  let none = TabBar {
    shown: active,
    closing: None,
    add: false,
    order: [],
    centres: [],
    settings_shown: false,
    settings_closed: false,
  }
  if !begin_frame(host) { return none }
  set_next_window_pos(Vec2 { x: 0.0, y: 0.0 })
  set_next_window_size(Vec2 { x: 800.0, y: 400.0 })
  let _ = begin("bar", WINDOW_FLAGS_NO_DECORATION)
  let bar = tab_bar(tabs, active, select, dark_theme(), true, select_settings)
  end()
  end_frame(host, 0.0, 0.0, 0.0)
  bar
}

/// One frame of a window holding the tab bar alone.
let bar_frame = (host: Host, tabs: []TabLabel, active: i64) -> TabBar => {
  let none = TabBar {
    shown: active,
    closing: None,
    add: false,
    order: [],
    centres: [],
    settings_shown: false,
    settings_closed: false,
  }
  if !begin_frame(host) { return none }
  set_next_window_pos(Vec2 { x: 0.0, y: 0.0 })
  set_next_window_size(Vec2 { x: 800.0, y: 400.0 })
  let _ = begin("bar", WINDOW_FLAGS_NO_DECORATION)
  let bar = tab_bar(tabs, active, None, dark_theme(), false, false)
  end()
  end_frame(host, 0.0, 0.0, 0.0)
  bar
}

/// The tabs put in the bar's order, and the shown one followed, as Sulafat's loop does.
let follow = pure (tabs: []TabLabel, active: i64, bar: TabBar) -> ([]TabLabel, i64) => {
  var moved: []TabLabel = []
  var now = active
  for i in 0..<bar.order.len() {
    moved.push(tabs[bar.order[i]])
    if bar.order[i] == active { now = i }
  }
  (moved, now)
}

let ints = pure (xs: []i64) -> string => [x in xs | "${x}"].join(" ")

let names = pure (tabs: []TabLabel) -> string => [t in tabs | t.name].join(" ")

// The tab shortcuts on a Mac, with ImGui's Ctrl/⌘ swap on as the real window has it.
let check_tab_keys = (host: Host) -> i64 => {
  if platform() != "macOS" { return 0 }
  let io = get_io()
  io.set_config_mac_osx_behaviors(true)
  var failed = 0
  failed += check("cmd-t", tab_key(host, [MOD_SUPER], KEY_T, 0, 3), "new")
  failed += check("cmd-w", tab_key(host, [MOD_SUPER], KEY_W, 0, 3), "close")
  failed += check("cmd-3", tab_key(host, [MOD_SUPER], KEY_3, 0, 5), "show 2")
  failed += check(
    "cmd-3 of two: the last",
    tab_key(host, [MOD_SUPER], KEY_3, 0, 2),
    "show 1"
  )
  failed += check("cmd-9: the last", tab_key(host, [MOD_SUPER], KEY_9, 0, 5), "show 4")
  failed += check(
    "cmd-shift-]: the next",
    tab_key(host, [MOD_SUPER, MOD_SHIFT], KEY_RIGHT_BRACKET, 1, 3),
    "show 2"
  )
  failed += check(
    "cmd-shift-] round the end",
    tab_key(host, [MOD_SUPER, MOD_SHIFT], KEY_RIGHT_BRACKET, 2, 3),
    "show 0"
  )
  failed += check(
    "cmd-shift-[ round the start",
    tab_key(host, [MOD_SUPER, MOD_SHIFT], KEY_LEFT_BRACKET, 0, 3),
    "show 2"
  )
  // ⌘= ⌘- ⌘0: the font's size — the View menu's, with the bar.
  failed += check("cmd-=", tab_key(host, [MOD_SUPER], KEY_EQUAL, 0, 3), "bigger")
  failed += check("cmd--", tab_key(host, [MOD_SUPER], KEY_MINUS, 0, 3), "smaller")
  failed += check("cmd-0", tab_key(host, [MOD_SUPER], KEY_0, 0, 3), "default size")
  failed += check(
    "cmd-= is the menu's",
    tab_key_menus(host, [MOD_SUPER], KEY_EQUAL, 0, 3),
    "none"
  )
  failed += check(
    "View's items",
    [t in [MENU_BIGGER, MENU_SMALLER, MENU_DEFAULT_SIZE] | describe_tab(menu_command(t, 0, 3))].join(","),
    "bigger,smaller,default size"
  )
  // Ctrl+T and Ctrl+W are the shell's (transpose, delete a word), not the tabs'.
  failed += check("ctrl-t is the shell's", tab_key(host, [MOD_CTRL], KEY_T, 0, 3), "none")
  failed += check("ctrl-w is the shell's", tab_key(host, [MOD_CTRL], KEY_W, 0, 3), "none")
  // With the menu bar's items, ⌘T, ⌘W and ⌘⇧[ ⌘⇧] are theirs — read here too they would
  // act twice — and ⌘1–⌘9, which have none, stay keys.
  failed += check(
    "cmd-t is the menu's",
    tab_key_menus(host, [MOD_SUPER], KEY_T, 0, 3),
    "none"
  )
  failed += check(
    "cmd-w is the menu's",
    tab_key_menus(host, [MOD_SUPER], KEY_W, 0, 3),
    "none"
  )
  failed += check(
    "cmd-shift-] is the menu's",
    tab_key_menus(host, [MOD_SUPER, MOD_SHIFT], KEY_RIGHT_BRACKET, 0, 3),
    "none"
  )
  failed += check(
    "cmd-3 is still a key",
    tab_key_menus(host, [MOD_SUPER], KEY_3, 0, 5),
    "show 2"
  )
  failed += check(
    "the menu's new tab",
    describe_tab(menu_command(MENU_NEW_TAB, 0, 3)),
    "new"
  )
  failed += check(
    "the menu's close tab",
    describe_tab(menu_command(MENU_CLOSE_TAB, 0, 3)),
    "close"
  )
  failed += check(
    "the menu's previous tab",
    describe_tab(menu_command(MENU_PREVIOUS_TAB, 0, 3)),
    "show 2"
  )
  failed += check(
    "the menu's next tab",
    describe_tab(menu_command(MENU_NEXT_TAB, 2, 3)),
    "show 0"
  )
  failed += check(
    "the menu's settings",
    describe_tab(menu_command(MENU_SETTINGS, 0, 3)),
    "settings"
  )
  io.set_config_mac_osx_behaviors(false)
  failed
}

let tab_key_menus = (
  host: Host,
  mods: []i32,
  key: i32,
  active: i64,
  count: i64
) -> string =>
  tab_key_with(host, mods, key, active, count, true)

let describe_tab = pure (c: TabCommand) -> string => match c {
  NoCommand => "none",
  NewTab => "new",
  CloseTab => "close",
  ShowTab(n) => "show ${n}",
  OpenSettings => "settings",
  FontBigger => "bigger",
  FontSmaller => "smaller",
  FontDefault => "default size",
}

/// The tab command for a key pressed with `mods` held, with tab `active` of `count` shown.
let tab_key = (host: Host, mods: []i32, key: i32, active: i64, count: i64) -> string =>
  tab_key_with(host, mods, key, active, count, false)

let tab_key_with = (
  host: Host,
  mods: []i32,
  key: i32,
  active: i64,
  count: i64,
  menus: bool
) -> string => {
  let io = get_io()
  for m in mods { io.add_key_event(m, true) }
  io.add_key_event(key, true)
  var got = "none"
  if begin_frame(host) {
    got = describe_tab(tab_command(active, count, menus))
    end_frame(host, 0.0, 0.0, 0.0)
  }
  io.add_key_event(key, false)
  for m in mods { io.add_key_event(m, false) }
  if begin_frame(host) { end_frame(host, 0.0, 0.0, 0.0) }
  got
}

// Real tabs: a tab named by its program's title, then by its directory, and one whose
// program ends found ended.
let check_sessions = () -> i64 => {
  var failed = 0
  let Some(titled) = open_session(
    ["/bin/sh", "-c", "printf '\\033]0;builds\\007'; sleep 2"],
    None,
    1
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var a = titled
  failed += check("a program's name first", tab_title(a, "/home/me"), "sh")
  for _ in 0..<2000000 { if a.shown.title == "" { a.step(true) } }
  failed += check("its title once set", tab_title(a, "/home/me"), "builds")
  close_session(a)
  let Some(placed) = open_session(
    ["/bin/sh", "-c", "printf '\\033]7;file://host/Users/me/dev%%20box\\007'; sleep 2"],
    None,
    2
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var b = placed
  for _ in 0..<2000000 { if b.shown.cwd == "" { b.step(false) } }
  failed += check("named by its directory", tab_title(b, "/Users/me"), "dev box")
  failed += check(
    "a tab beside it starts there",
    "${directory(b) ?? "none"}",
    "/Users/me/dev box"
  )
  failed += check("output unseen while hidden", "${b.unseen}", "true")
  b.step(true)
  failed += check("seen once shown", "${b.unseen}", "false")
  close_session(b)
  // A command's block, from a shell's marks: its prompt's line, where its output began and
  // ended, its status. A screen erased whole takes the blocks on it.
  let marks = "printf '\\033]133;A\\007$ \\033]133;B\\007ls\\r\\n\\033]133;C\\007out\\r\\n\\033]133;D;2\\007\\033]133;A\\007$ \\033]133;B\\007'"
  let Some(blocked) = open_session(["/bin/sh", "-c", "${marks}; sleep 2"], None, 5) else {
    return check("open a tab", "failed", "opened")
  }
  var e = blocked
  for _ in 0..<2000000 { if e.blocks.len() == 0 { e.step(true) } }
  failed += check(
    "a command's block",
    [x in e.blocks | "${x.prompt}-${x.output}-${x.end} ${x.status}"].join(","),
    "0-1-2 2"
  )
  // Its room, a row 20 points high: above its input the margin and padding (16), between
  // input and output the padding of each (12), below the output padding (6).
  let rows = block_rows_layout(e, 0.0, 0, 20.0, 3)
  failed += check(
    "a block's rows",
    "${rows.y_of(0)} ${rows.y_of(1)} ${rows.y_of(2)} ${rows.line_at_y(50.0, 3)}",
    "16 48 74 1"
  )
  close_session(e)
  let Some(cleared) = open_session(
    ["/bin/sh", "-c", "${marks}; sleep 0.3; printf '\\033[2J'; sleep 2"],
    None,
    6
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var f = cleared
  var seen_block = false
  for _ in 0..<4000000 {
    if f.blocks.len() > 0 { seen_block = true }
    if !(seen_block && f.blocks.len() == 0) { f.step(true) }
  }
  failed += check(
    "erased whole, its blocks go",
    "${seen_block}|${f.blocks.len()}",
    "true|0"
  )
  close_session(f)
  let Some(brief) = open_session(["/bin/sh", "-c", "exit 0"], None, 3) else {
    return check("open a tab", "failed", "opened")
  }
  // A tab the user closes stays closed, though its program is still running.
  let Some(running) = open_session(["/bin/sh", "-c", "sleep 5"], None, 4) else {
    return check("open a tab", "failed", "opened")
  }
  var d = running
  d.step(true)
  d.request_close()
  for _ in 0..<1000 { d.step(true) }
  failed += check("a closed tab stays closed", "${d.alive}", "false")
  close_session(d)
  // A tab's grid: Select All takes everything, and Copy is then there to choose.
  let Some(printing) = open_session(
    ["/bin/sh", "-c", "printf 'first\\nsecond\\n'; sleep 5"],
    None,
    5
  ) else {
    return check("open a tab", "failed", "opened")
  }
  var e = printing
  // Read until the second line has arrived.
  for _ in 0..<2000000 { if e.shown.line(1)[0].ch != 's' { e.step(true) } }
  failed += check(
    "nothing selected yet",
    "${e.has_selection()} ${e.can(Copy)}",
    "false false"
  )
  e.edit_action(SelectAll)
  failed += check("select all", e.selected_text().trim(), "first\nsecond")
  failed += check("copy then", "${e.can(Copy)} ${e.can(SelectAll)}", "true true")
  close_session(e)
  var c = brief
  for _ in 0..<2000000 { if c.alive { c.step(true) } }
  failed += check("a tab whose program ended", "${c.alive}", "false")
  close_session(c)
  failed
}

// Keys typed ahead: raw keys made into lines, and the lines handed to prompts in turn.
let check_typed_ahead = () -> i64 => {
  var failed = 0
  failed += check("text and backspace", typed_lines("git statx\x7fus"), "git status")
  failed += check("an arrow is dropped", typed_lines("ab\e[Dc"), "abc")
  failed += check("return ends a line", typed_lines("make\nls -l"), "make\nls -l")
  failed += check("carriage return too", typed_lines("make\rls"), "make\nls")
  failed += check("ctrl-u clears the line", typed_lines("oops\x15ls"), "ls")
  failed += check(
    "ctrl-w takes a word",
    typed_lines("git push --force\x17--dry-run"),
    "git push --dry-run"
  )
  failed += check("non-ASCII", typed_lines("echo größe"), "echo größe")
  failed += check("backspace on nothing", typed_lines("\x7f\x7fx"), "x")

  var line = command_line([])
  line.typed_ahead("make\nls -l\ngit st")
  let one = line.take_typed_ahead() ?? "none"
  let two = line.take_typed_ahead() ?? "none"
  let three = line.take_typed_ahead() ?? "none"
  failed += check("commands in turn", "${one}|${two}|${three}", "make|ls -l|none")
  failed += check("then the rest in the editor", line.edit.content(), "git st")
  failed += check("and nothing after", "${line.take_typed_ahead() ?? "none"}", "none")
  line.typed_ahead("us")
  let _ = line.take_typed_ahead()
  failed += check("more joins at the caret", line.edit.content(), "git stus")
  failed
}

// The theme: what a cell's recorded colours look like.
let check_theme = () -> i64 => {
  let t = dark_theme()
  var failed = 0
  failed += check("256 entries", "${t.palette.len()}", "256")
  // The cube's corner and the greys' first step, as xterm has them.
  failed += check("cube white", hex(t.palette[231]), hex(abgr(0xFFFFFF)))
  failed += check("cube 0,95,135", hex(t.palette[16 + 1 * 6 + 2]), hex(abgr(0x005F87)))
  failed += check("first grey", hex(t.palette[232]), hex(abgr(0x080808)))
  failed += check("24-bit", hex(t.colour(rgb(1, 2, 3), 0)), hex(abgr(0x010203)))
  let (fg, bg) = t.colours(Cell { ch: 'x', fg: DEFAULT, bg: DEFAULT, attrs: 0 })
  failed += check("plain", "${hex(fg)} ${bg == None}", "${hex(t.fg)} true")
  let (ifg, ibg) = t.colours(Cell { ch: 'x', fg: DEFAULT, bg: DEFAULT, attrs: INVERSE })
  failed += check(
    "inverse of the defaults",
    "${hex(ifg)} ${hex(ibg ?? 0)}",
    "${hex(t.bg)} ${hex(t.fg)}"
  )
  let (
    rfg,
    rbg
  ) = t.colours(Cell { ch: 'x', fg: indexed(1), bg: indexed(4), attrs: INVERSE })
  failed += check(
    "inverse of colours",
    "${hex(rfg)} ${hex(rbg ?? 0)}",
    "${hex(t.palette[4])} ${hex(t.palette[1])}"
  )
  let (
    hfg,
    _
  ) = t.colours(Cell { ch: 'x', fg: indexed(1), bg: indexed(4), attrs: HIDDEN })
  failed += check("hidden is the background", hex(hfg), hex(t.palette[4]))
  let (dfg, _) = t.colours(Cell { ch: 'x', fg: DEFAULT, bg: DEFAULT, attrs: DIM })
  failed += check("dim is nearer the background", "${hex(dfg) != hex(t.fg)}", "true")
  failed
}

let hex = pure (c: u32) -> string => "${c}"

// ── Driving ──────────────────────────────────────────────────────────────────

/// One frame with the command line in a window covering the host, focused, at `at`.
let frame_at = (host: Host, line: mut CommandLine, at: Place) -> Outcome => {
  if !begin_frame(host) { return Nothing }
  set_next_window_pos(Vec2 { x: 0.0, y: 0.0 })
  set_next_window_size(Vec2 { x: 800.0, y: 400.0 })
  let _ = begin("checks", WINDOW_FLAGS_NO_DECORATION)
  let style = Style {
    text: 0xFFFFFFFF,
    caret: 0xFFFFFFFF,
    selection: 0x80808080,
    menu: 0xFF202020,
    menu_chosen: 0xFF404040,
    faint: 0xFF808080,
    command: 0xFF00FF00,
    option: 0xFFFFFF00,
    quoted: 0xFF00FFFF,
    variable: 0xFFFF00FF,
    operator: 0xFFFF0000,
  }
  let outcome = line.update(at, get_window_draw_list(), style, true)
  end()
  end_frame(host, 0.0, 0.0, 0.0)
  outcome
}

/// One frame with the command line in a window covering the host, focused.
let frame = (host: Host, line: mut CommandLine) -> Outcome => {
  if !begin_frame(host) { return Nothing }
  set_next_window_pos(Vec2 { x: 0.0, y: 0.0 })
  set_next_window_size(Vec2 { x: 800.0, y: 400.0 })
  let _ = begin("checks", WINDOW_FLAGS_NO_DECORATION)
  let style = Style {
    text: 0xFFFFFFFF,
    caret: 0xFFFFFFFF,
    selection: 0x80808080,
    menu: 0xFF202020,
    menu_chosen: 0xFF404040,
    faint: 0xFF808080,
    command: 0xFF00FF00,
    option: 0xFFFFFF00,
    quoted: 0xFF00FFFF,
    variable: 0xFFFF00FF,
    operator: 0xFFFF0000,
  }
  let outcome = line.update(PLACE, get_window_draw_list(), style, true)
  end()
  end_frame(host, 0.0, 0.0, 0.0)
  outcome
}

let type_text = (host: Host, line: mut CommandLine, s: string) -> void => {
  get_io().add_input_characters_utf8(s)
  let _ = frame(host, line)
}

/// Press and release `key` with the modifiers `mods` held; what the press frame answered.
let press = (host: Host, line: mut CommandLine, mods: []i32, key: i32) -> Outcome => {
  let io = get_io()
  for m in mods { io.add_key_event(m, true) }
  io.add_key_event(key, true)
  let outcome = frame(host, line)
  io.add_key_event(key, false)
  for m in mods { io.add_key_event(m, false) }
  let _ = frame(host, line)
  outcome
}

/// The middle of the cell at `row`, `col`.
let at = pure (row: i64, col: i64) -> Vec2 => Vec2 {
  x: PLACE.origin.x + (f32(col) + 0.5) * PLACE.cell.x,
  y: PLACE.origin.y + (f32(row) + 0.5) * PLACE.cell.y,
}

let move_to = (host: Host, line: mut CommandLine, p: Vec2) -> void => {
  get_io().add_mouse_pos_event(p.x, p.y)
  let _ = frame(host, line)
}

let button = (host: Host, line: mut CommandLine, down: bool) -> void => {
  get_io().add_mouse_button_event(0, down)
  let _ = frame(host, line)
}

let clicks = (host: Host, line: mut CommandLine, row: i64, col: i64, n: i64) -> void => {
  // In the cell's left quarter: a caret goes to the nearer of its edges, and a word is the
  // rune in it, so this is unambiguous for both.
  let p = at(row, col)
  move_to(host, line, Vec2 { x: p.x - PLACE.cell.x * 0.25, y: p.y })
  for _ in 0..<n {
    button(host, line, true)
    button(host, line, false)
  }
  // Let ImGui's double-click time pass, so the next click starts a count of its own.
  for _ in 0..<30 { let _ = frame(host, line) }
}

let click = (host: Host, line: mut CommandLine, row: i64, col: i64) -> void =>
  clicks(host, line, row, col, 1)

let double_click = (host: Host, line: mut CommandLine, row: i64, col: i64) -> void =>
  clicks(host, line, row, col, 2)

let triple_click = (host: Host, line: mut CommandLine, row: i64, col: i64) -> void =>
  clicks(host, line, row, col, 3)

let drag = (host: Host, line: mut CommandLine, row: i64, from: i64, to: i64) -> void => {
  move_to(
    host,
    line,
    Vec2 { x: PLACE.origin.x + f32(from) * PLACE.cell.x, y: at(row, 0).y }
  )
  button(host, line, true)
  move_to(
    host,
    line,
    Vec2 { x: PLACE.origin.x + f32(to) * PLACE.cell.x, y: at(row, 0).y }
  )
  button(host, line, false)
  for _ in 0..<30 { let _ = frame(host, line) }
}

let double_click_and_drag = (
  host: Host,
  line: mut CommandLine,
  from: i64,
  to: i64
) -> void => {
  move_to(host, line, at(0, from))
  button(host, line, true)
  button(host, line, false)
  button(host, line, true)
  move_to(host, line, at(0, to))
  button(host, line, false)
  for _ in 0..<30 { let _ = frame(host, line) }
}

let describe = pure (o: Outcome) -> string => match o {
  Nothing => "nothing",
  Submit(c) => "submit ${c}",
  Send(b) => "send ${b}",
  Complete(t, c) => "complete ${t} at ${c}",
}

let check = (name: string, got: string, want: string) -> i64 => {
  if got == want { 0 } else {
    println("FAIL ${name}: got «${got}», want «${want}»")
    1
  }
}
