// uitest — the command line's widget on a headless ImGui host: typed text, keys and the
// mouse injected as a person's would arrive (a click is a press and a release, a frame
// each), and the editor checked afterwards — double-clicking a word among them.
//
//   build/uitest               every check; exits 1 naming each that failed

import bindings.sdl3.{ platform }
import bindings.imgui.{
  create_headless_host,
  begin_frame,
  end_frame,
  destroy_host,
  begin,
  end,
  get_io,
  get_window_draw_list,
  set_next_window_pos,
  set_next_window_size,
  Host,
  Vec2,
  font_file,
  merge_font_file,
  set_font_hinting,
  push_font_float,
  pop_font,
  get_font_baked,
  calc_text_size,
  get_item_rect_min,
  get_item_rect_max,
  get_main_viewport,
  WINDOW_FLAGS_NO_DECORATION,
  KEY_LEFT_ARROW,
  KEY_UP_ARROW,
  KEY_DOWN_ARROW,
  KEY_HOME,
  KEY_END,
  KEY_TAB,
  KEY_ESCAPE,
  KEY_BACKSPACE,
  KEY_ENTER,
  KEY_A,
  KEY_Z,
  KEY_T,
  KEY_W,
  KEY_3,
  KEY_9,
  KEY_R,
  KEY_EQUAL,
  KEY_MINUS,
  KEY_0,
  KEY_LEFT_BRACKET,
  KEY_RIGHT_BRACKET,
  KEY_E,
  KEY_K,
  KEY_L,
  MOD_SHIFT,
  MOD_SUPER,
  MOD_CTRL,
  MOD_ALT,
}
import ui.{
  command_line,
